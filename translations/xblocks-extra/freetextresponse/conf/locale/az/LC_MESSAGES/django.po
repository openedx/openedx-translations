#: models.py:38
msgid "Display Correctness?"
msgstr "Düzgünlüyü Göstər?"

#: models.py:40
msgid ""
"This is a flag that indicates if the indicator icon should be displayed "
"after a student enters their response"
msgstr ""
"Bu, tələbə cavabını daxil etdikdən sonra göstərici ikonunun göstərilib-"
"göstərilməyəcəyini göstərən bir bayraqdır."

#: models.py:48
msgid "Display Other Student Responses"
msgstr "Digər Tələbə Cavablarını Göstər"

#: models.py:49
msgid ""
"This will display other student responses to the student after they submit "
"their response."
msgstr ""
"Bu, tələbə cavabını təqdim etdikdən sonra digər tələbə cavablarını tələbəyə "
"göstərəcək."

#: models.py:56
msgid "System selected answers to give to students"
msgstr "Sistem tərəfindən seçilmiş cavablar tələbələrə təqdim olunur"

#: models.py:59
msgid "Display Name"
msgstr "Görünüş adı"

#: models.py:60
msgid "This is the title for this question type"
msgstr "Bu sual növü üçün başlıq budur"

#: models.py:65
msgid "Full-Credit Key Phrases"
msgstr "Tam Kreditli Açar İfadələr"

#: models.py:67
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive full credit"
msgstr ""
"Bu, tələbənin cavabının tam kredit alması üçün mövcud olması lazım olan "
"sözlər və ya ifadələr siyahısıdır."

#: models.py:75
msgid "Half-Credit Key Phrases"
msgstr "Yarım Kreditli Açar Sözlər"

#: models.py:77
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive half credit"
msgstr ""
"Bu, tələbənin cavabının yarım bal alması üçün mövcud olmalı olan söz və ya "
"ifadələrin siyahısıdır."

#: models.py:85
msgid "Maximum Number of Attempts"
msgstr "Cəhdlərin Maksimum Sayı"

#: models.py:86
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr "Bu, tələbənin problemi həll etməyə cəhd edə biləcəyi maksimum saydır."

#: models.py:92
msgid "Maximum Word Count"
msgstr "Maksimum Söz Sayı"

#: models.py:93
msgid "This is the maximum number of words allowed for this question"
msgstr "Bu sual üçün icazə verilən maksimum söz sayı budur."

#: models.py:99
msgid "Minimum Word Count"
msgstr "Minimum Söz Sayı"

#: models.py:100
msgid "This is the minimum number of words required for this question"
msgstr "Bu sual üçün tələb olunan minimum söz sayı budur."

#: models.py:106
msgid "Prompt"
msgstr "Tez"

#: models.py:107
msgid ""
"This is the prompt students will see when asked to enter their response"
msgstr ""
"Bu, tələbələrdən cavablarını daxil etmələri istənildikdə görəcəkləri "
"təlimatdır."

#: models.py:113
msgid "Submission Received Message"
msgstr "Təqdimat qəbul edildi mesajı"

#: models.py:114
msgid "This is the message students will see upon submitting their response"
msgstr ""
"Bu, tələbələrin cavablarını təqdim etdikdən sonra görəcəkləri mesajdır."

#: models.py:119
msgid "Weight"
msgstr "Çəki"

#: models.py:120
msgid "This assigns an integer value representing the weight of this problem"
msgstr "Bu, bu problemin çəkisini təmsil edən tam ədədi dəyəri təyin edir."

#: models.py:126
msgid "Draft Received Message"
msgstr "Qəbul edilmiş qaralama mesajı"

#: models.py:127
msgid "This is the message students will see upon submitting a draft response"
msgstr ""
"Bu, tələbələrin qaralama cavabını təqdim etdikdən sonra görəcəkləri "
"mesajdır."

#: templates/view.html:16
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr ""
"Cavabımın, digər öyrənənlər öz cavablarını təqdim etdikdən sonra görünə "
"biləcəyinə icazə ver"

#: templates/view.html:23 templates/view.html:26
msgid "Checking..."
msgstr "Yoxlanılır..."

#: templates/view.html:23 templates/view.html:24
msgid "Submit"
msgstr "Təqdim edin"

#: templates/view.html:26 templates/view.html:27
msgid "Save"
msgstr "Yaddaşda saxlayın"

#: templates/view.html:36
msgid "Hide"
msgstr "Gizlət"

#: templates/view.html:37
msgid "Show"
msgstr "Göstərin"

#: templates/view.html:38
msgid "peer responses"
msgstr "həmkarların cavabları"

#: templates/view.html:40
msgid "Submissions by others"
msgstr "Başqalarının təqdimatları"

#: templates/view.html:41 templates/view.html:45
msgid "No responses to show at this time"
msgstr "Hazırda göstəriləcək cavab yoxdur"

#: views.py:146
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "Siz {max_attempts} göndərişdən {count_attempts} istifadə etmisiniz"
msgstr[1] "Siz {max_attempts} göndərişdən {count_attempts} istifadə etmisiniz"

#: views.py:170
#, python-brace-format
msgid "Your response must be between {min} and {max} word."
msgid_plural "Your response must be between {min} and {max} words."
msgstr[0] "Cavabınız {min} və {max} söz arasında olmalıdır."
msgstr[1] "Cavabınız {min} və {max} söz arasında olmalıdır."

#: views.py:256
#, python-brace-format
msgid "Invalid Word Count. {word_count_message}"
msgstr "Səhv Söz Sayı. {word_count_message}"
