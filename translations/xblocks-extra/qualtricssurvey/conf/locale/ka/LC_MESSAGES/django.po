#: models.py:23
msgid "Display Name:"
msgstr "საჩვენებელი სახელი:"

#: models.py:26
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "სახელი გამოჩნდება გვერდის ზედა ნაწილის ჰორიზონტალური ნავიგაციაზე."

#: models.py:29
msgid "Link Text:"
msgstr "ბმულის ტექსტი:"

#: models.py:32
msgid "This is the text that will link to your survey."
msgstr "ეს არის ტექსტი, რომელიც თქვენს გამოკითხვასთან იქნება დაკავშირებული."

#: models.py:35
msgid "Message:"
msgstr "შეტყობინება:"

#: models.py:38
msgid "This is the text that will be displayed above the link to your survey."
msgstr "ეს არის ტექსტი, რომელიც გამოჩნდება თქვენი გამოკითხვის ბმულის ზემოთ."

#: models.py:41
msgid "Extra Parameters:"
msgstr "დამატებითი პარამეტრები:"

#: models.py:45
msgid ""
"Additional query parameters to include in the survey URL. Format: "
"key1=value1&key2=value2. If blank, no extra parameters are added."
msgstr ""
"დამატებითი მოთხოვნის პარამეტრები, რომლებიც უნდა ჩაერთოს გამოკითხვის URL-ში. "
"ფორმატი: key1=value1&key2=value2. თუ ცარიელია, დამატებითი პარამეტრები არ "
"დაემატება."

#: models.py:51
msgid "Survey ID:"
msgstr "გამოკითხვის ID:"

#: models.py:55
msgid ""
"This is the ID that Qualtrics uses for the survey, which can include numbers"
" and letters, and should be entered in the following format: "
"SV_###############"
msgstr ""
"ეს არის ID, რომელსაც Qualtrics იყენებს გამოკითხვისთვის, რომელიც შეიძლება "
"შეიცავდეს ციფრებს და ასოებს და უნდა შეიყვანოთ შემდეგი ფორმატით: "
"SV_#################"

#: models.py:61
msgid "Your University:"
msgstr "თქვენი უნივერსიტეტი:"

#: models.py:65
msgid ""
"The subdomain for your university's Qualtrics account "
"(e.g.'stanforduniversity'). If left blank, the system-wide default is used."
msgstr ""
"თქვენი უნივერსიტეტის Qualtrics ანგარიშის ქვედომენი (მაგ., "
"„stanforduniversity“). თუ ცარიელი დარჩა, გამოყენებული იქნება სისტემის "
"ნაგულისხმევი პარამეტრები."
