#: block.py:153
msgid "Display Name"
msgstr "Megjelenített név"

#: block.py:154
msgid "The display name for this component."
msgstr "Ennek az összetevőnek a megjelenített neve."

#: block.py:158
msgid "Text"
msgstr "Szöveg"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "A blokkhoz megjelenítendő Html tartalom"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Felsőbb szintű HTML-tartalom az adatmező tárolásához"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "LaTeX dokumentumok forráskódja. Ez a funkció nem jól támogatott."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Engedélyezed a LaTeX sablont?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Válassza a Vizualis lehetőséget a tartalom beviteléhez, és a szerkesztő "
"automatikusan létrehozza a HTML-t. Válassza a Nyers lehetőséget a HTML "
"közvetlen szerkesztéséhez. Ha változtatja ezt a beállítást, mentenie kell a "
"komponenst, majd újra meg kell nyitnia a szerkesztéshez."

#: block.py:177
msgid "Editor"
msgstr "Szerkesztő"

#: block.py:179
msgid "Visual"
msgstr "Vizuális"

#: block.py:179
msgid "Raw"
msgstr "Nyers"
