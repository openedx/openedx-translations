#: block.py:153
msgid "Display Name"
msgstr "Visningsnamn"

#: block.py:154
msgid "The display name for this component."
msgstr "Visningsnamnet för den här komponenten."

#: block.py:158
msgid "Text"
msgstr "Text"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Html-innehåll som ska visas för det här blocket"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Uppströms html-innehåll för att lagra uppströms datafält"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "Källkod för LaTeX-dokument. Den här funktionen stöds inte väl."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Aktivera LaTeX mallar?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Välj Visuell för att ange innehåll och låta redigeraren automatiskt skapa "
"HTML. Välj Rå för att redigera HTML direkt. Om du ändrar denna inställning "
"måste du spara komponenten och sedan öppna den igen för redigering."

#: block.py:177
msgid "Editor"
msgstr "Redaktör"

#: block.py:179
msgid "Visual"
msgstr "Visuell"

#: block.py:179
msgid "Raw"
msgstr "Rå"
