#: block.py:153
msgid "Display Name"
msgstr "Görünüş adı"

#: block.py:154
msgid "The display name for this component."
msgstr "Bu komponent üçün görünüş adı."

#: block.py:158
msgid "Text"
msgstr "Tekst"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Bu blok üçün Html məzmunlar"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Yuxarı axın məlumat sahəsini saxlamaq üçün yuxarı axın html məzmunu"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "LaTeX sənədlər üçün mənbə kodu. Bu xüsusiyyət yaxşı dəstəklənmir."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "LaTeX şablonları aktivləşsin?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Vizual seçin ki, məzmunu daxil edin və redaktor avtomatik olaraq HTML "
"yaratsın. HTML-i birbaşa redaktə etmək üçün Xam seçin. Bu parametri "
"dəyişdirsəniz, komponenti yadda saxlamalı və sonra redaktə etmək üçün "
"yenidən açmalısınız."

#: block.py:177
msgid "Editor"
msgstr "Redaktor"

#: block.py:179
msgid "Visual"
msgstr "Vizual"

#: block.py:179
msgid "Raw"
msgstr "Xam"
