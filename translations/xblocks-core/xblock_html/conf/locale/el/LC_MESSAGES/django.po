#: block.py:153
msgid "Display Name"
msgstr "Εμφανιζόμενο όνομα"

#: block.py:154
msgid "The display name for this component."
msgstr "Το εμφανιζόμενο όνομα για αυτό το στοιχείο."

#: block.py:158
msgid "Text"
msgstr "Κείμενο"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Περιεχόμενο HTML για εμφάνιση για αυτό το μπλοκ"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Περιεχόμενα html ανάντη για αποθήκευση πεδίου δεδομένων ανάντη"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"Πηγαίος κώδικας για έγγραφα LaTeX. Αυτή η δυνατότητα δεν έχει καλή "
"υποστήριξη."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Ενεργοποίηση των προτύπων LaTeX;"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Επιλέξτε Visual για να εισαγάγετε περιεχόμενο και να ζητήσετε από το "
"πρόγραμμα επεξεργασίας να δημιουργήσει αυτόματα το HTML. Επιλέξτε Raw για να"
" επεξεργαστείτε απευθείας HTML. Εάν αλλάξετε αυτήν τη ρύθμιση, πρέπει να "
"αποθηκεύσετε το στοιχείο και στη συνέχεια να το ανοίξετε ξανά για "
"επεξεργασία."

#: block.py:177
msgid "Editor"
msgstr "Συντάκτης"

#: block.py:179
msgid "Visual"
msgstr "Οπτικό"

#: block.py:179
msgid "Raw"
msgstr "Ακατέργαστο"
