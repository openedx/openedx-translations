#: block.py:153
msgid "Display Name"
msgstr "نام نمایشی"

#: block.py:154
msgid "The display name for this component."
msgstr "نام نمایشی این مؤلفه"

#: block.py:158
msgid "Text"
msgstr "متن"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "محتوای Html برای نمایش برای این بلوک"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "محتوای HTML بالادستی برای ذخیره‌سازی فیلد داده بالادستی"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "کد منبع برای اسناد LaTeX. این ویژگی به خوبی پشتیبانی نمی شود."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "قالب های LaTeX را فعال کنید؟"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Visual را انتخاب کنید تا محتوا را وارد کنید و ویرایشگر به طور خودکار HTML را"
" ایجاد کند. Raw را برای ویرایش مستقیم HTML انتخاب کنید. اگر این تنظیمات را "
"تغییر دهید، باید کامپوننت را ذخیره کنید و سپس دوباره آن را برای ویرایش باز "
"کنید."

#: block.py:177
msgid "Editor"
msgstr "ویرایشگر"

#: block.py:179
msgid "Visual"
msgstr "دیداری"

#: block.py:179
msgid "Raw"
msgstr "خام"
