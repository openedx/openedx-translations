#: block.py:153
msgid "Display Name"
msgstr "Jina la Kuonyesha"

#: block.py:154
msgid "The display name for this component."
msgstr "Jina la onyesho la sehemu hii."

#: block.py:158
msgid "Text"
msgstr "Maandishi"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Maudhui ya Html ya kuonyesha kwa kizuizi hiki"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Maudhui ya html ya juu kuhifadhi uwanja wa data wa juu"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "Msimbo wa chanzo wa hati za LaTeX. Kipengele hiki hakitumiki vyema."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Je, ungependa kuwasha violezo vya LaTeX?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Chagua Visual ili kuingiza maudhui na kihariri kutengeneza HTML kiotomatiki."
" Chagua Ghafi ili kuhariri HTML moja kwa moja. Ukibadilisha mpangilio huu, "
"lazima uhifadhi kijenzi kisha ukifungue tena kwa kuhaririwa."

#: block.py:177
msgid "Editor"
msgstr "Mhariri"

#: block.py:179
msgid "Visual"
msgstr "Visual"

#: block.py:179
msgid "Raw"
msgstr "Mbichi"
