#: block.py:153
msgid "Display Name"
msgstr "Nome de exibição"

#: block.py:154
msgid "The display name for this component."
msgstr "Nome de exibição para este componente."

#: block.py:158
msgid "Text"
msgstr "Texto"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Conteúdo HTML a ser exibido para este bloco"

#: block.py:162
