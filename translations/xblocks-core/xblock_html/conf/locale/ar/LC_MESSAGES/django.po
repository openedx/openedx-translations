#: block.py:153
msgid "Display Name"
msgstr "الاسم الظاهر"

#: block.py:154
msgid "The display name for this component."
msgstr "الاسم الظاهر لهذا المكون."

#: block.py:158
msgid "Text"
msgstr "النص"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "محتويات Html المراد عرضها لهذه اللبنة"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "محتويات HTML من المصدر لتخزين حقل بيانات المصدر"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"الكود المصدري للمستندات المنسّقة باستخدام LaTeX . هذه الميزة غير مدعومة "
"جيّدًا."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "هل تريد تفعيل قوالب LaTeX؟"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"يُرجى اختيار ’مرئي‘ أو ’Visual‘ لإدخال المحتوى وتمكين المحرّر من إنشاء نصوص "
"بلغة HTML تلقائيًا. يمكن اختيار ’أوليّ‘ أو ’Raw‘ لتعديل نص HTML مباشرةً. في "
"حال غيّرت هذا الإعداد، يجب حفظ المكوِّن أولًا ثمّ إعادة فتحه لإجراء التعديل."

#: block.py:177
msgid "Editor"
msgstr "محرر"

#: block.py:179
msgid "Visual"
msgstr "مرئي"

#: block.py:179
msgid "Raw"
msgstr "أوّلي"
