#: block.py:153
msgid "Display Name"
msgstr "显示名称"

#: block.py:154
msgid "The display name for this component."
msgstr "组件显示的名称。"

#: block.py:158
msgid "Text"
msgstr "文本"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "为此块显示的 HTML 内容"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "上游 HTML 内容以存储上游数据字段"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "此功能不支持LaTeX文件的源代码。"

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "启用LaTeX模板？"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"选择“可视化”时，您只需输入内容，编辑器将生成相应的 HTML 代码。选择“代码”时，您可以直接编辑 HTML "
"代码。如果您改变了该设置，则该设置将在您保存并重新打开编辑器才生效。"

#: block.py:177
msgid "Editor"
msgstr "编辑器"

#: block.py:179
msgid "Visual"
msgstr "可视化"

#: block.py:179
msgid "Raw"
msgstr "代码"
