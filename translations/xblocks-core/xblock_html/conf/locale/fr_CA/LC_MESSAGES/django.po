#: block.py:153
msgid "Display Name"
msgstr "Nom d&#39;affichage"

#: block.py:154
msgid "The display name for this component."
msgstr "Nom d&#39;affichage de ce composant."

#: block.py:158
msgid "Text"
msgstr "Texte"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Contenu HTML à afficher pour ce bloc"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Contenu HTML en amont pour stocker le champ de données en amont"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"Code source des documents LaTeX. Cette fonctionnalité n'est pas bien prise "
"en charge."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Activé les gabarits LaTeX?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Sélectionner Visual pour entrer du contenu et pour permettre à l'éditeur "
"d'automatiquement créer le HTML. Sélectionner Raw pour éditer le HTML "
"directement. Si vous changez ce paramètre, vous devez sauvegarder le "
"composant et le réouvrir pour l'éditer."

#: block.py:177
msgid "Editor"
msgstr "Éditeur"

#: block.py:179
msgid "Visual"
msgstr "Visuel"

#: block.py:179
msgid "Raw"
msgstr "Cru"
