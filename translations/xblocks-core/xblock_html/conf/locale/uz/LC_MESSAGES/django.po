#: block.py:153
msgid "Display Name"
msgstr "Ko‘rsatiladigan ism"

#: block.py:154
msgid "The display name for this component."
msgstr "Ushbu komponent uchun ko'rsatiladigan nom."

#: block.py:158
msgid "Text"
msgstr "Matn"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Ushbu blok uchun ko'rsatiladigan HTML tarkibi"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Yuqori oqim ma'lumot maydonini saqlash uchun yuqori oqim html mazmuni"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"LaTeX hujjatlari uchun manba kodi. Bu xususiyat yaxshi qo'llab-"
"quvvatlanmaydi."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "LaTeX andozalari yoqilsinmi?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Tarkibni kiritish uchun Visual ni tanlang va muharrir avtomatik ravishda "
"HTMLni yaratsin. HTMLni to'g'ridan-to'g'ri tahrirlash uchun Raw-ni tanlang. "
"Agar siz ushbu sozlamani o'zgartirsangiz, komponentni saqlashingiz va keyin "
"tahrirlash uchun uni qayta ochishingiz kerak."

#: block.py:177
msgid "Editor"
msgstr "muharrir"

#: block.py:179
msgid "Visual"
msgstr "Vizual"

#: block.py:179
msgid "Raw"
msgstr "Xom"
