#: block.py:153
msgid "Display Name"
msgstr "Weergavenaam"

#: block.py:154
msgid "The display name for this component."
msgstr "De weergavenaam voor dit onderdeel."

#: block.py:158
msgid "Text"
msgstr "Tekst"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Html-inhoud die voor dit blok moet worden weergegeven"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Upstream html-inhoud om upstream-gegevensveld op te slaan"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"Broncode voor LaTeX-documenten. Deze functie wordt niet goed ondersteund."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "LaTeX-sjablonen inschakelen?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Selecteer Visueel om inhoud in te voeren en laat de editor automatisch de "
"HTML maken. Selecteer Raw om HTML rechtstreeks te bewerken. Als u deze "
"instelling wijzigt, moet u het onderdeel opslaan en vervolgens opnieuw "
"openen om het te bewerken."

#: block.py:177
msgid "Editor"
msgstr "Editor"

#: block.py:179
msgid "Visual"
msgstr "Visueel"

#: block.py:179
msgid "Raw"
msgstr "Rauw"
