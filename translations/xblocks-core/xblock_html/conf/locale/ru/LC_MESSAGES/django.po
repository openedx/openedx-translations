#: block.py:153
msgid "Display Name"
msgstr "Отображаемое имя"

#: block.py:154
msgid "The display name for this component."
msgstr "Отображаемое название компонента"

#: block.py:158
msgid "Text"
msgstr "Текст, содержимое"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Содержимое HTML для отображения данного блока"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Верхний HTML-контент для хранения поля данных верхнего уровня"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"Исходный код для документов LaTeX. Эта функция поддерживается не полностью."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Разрешить использование шаблонов LaTeX?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Выберите «Визуальный редактор», чтобы вводимый текст автоматически "
"преобразовывался редактором в HTML. Выберите «Без обработки» для "
"непосредственного редактирования кода HTML. После изменения этой настройки "
"вам следует сохранить компонент, а затем вновь открыть его для "
"редактирования."

#: block.py:177
msgid "Editor"
msgstr "Редактор"

#: block.py:179
msgid "Visual"
msgstr "Визуальный"

#: block.py:179
msgid "Raw"
msgstr "Без обработки"
