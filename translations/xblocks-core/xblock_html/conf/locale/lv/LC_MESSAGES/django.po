#: block.py:153
msgid "Display Name"
msgstr "Parādāmais nosaukums"

#: block.py:154
msgid "The display name for this component."
msgstr "Šī komponenta parādāmais nosaukums."

#: block.py:158
msgid "Text"
msgstr "Teksts"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Html saturs, kas jāparāda šim blokam"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr "Augšupielādēt HTML saturu, lai saglabātu augšupielādes datu lauku"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "LaTeX dokumentu pirmkods. Šī funkcija netiek pietiekami atbalstīta."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Vai iespējot LaTeX veidnes?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Lai ievadītu saturu un redaktors automātiski izveidotu HTML, izvēlieties "
"Vizuālā. Atlasiet Raw, lai rediģētu HTML tieši. Ja maināt šo iestatījumu, "
"komponents ir jāsaglabā un pēc tam atkal jāatver rediģēšanai."

#: block.py:177
msgid "Editor"
msgstr "Redaktors"

#: block.py:179
msgid "Visual"
msgstr "Vizuāls"

#: block.py:179
msgid "Raw"
msgstr "Neapstrādāts"
