#: block.py:153
msgid "Display Name"
msgstr "Emri i shfaqur"

#: block.py:154
msgid "The display name for this component."
msgstr "Emri i shfaqur për këtë komponent."

#: block.py:158
msgid "Text"
msgstr "Tekst"

#: block.py:160
msgid "Html contents to display for this block"
msgstr "Përmbajtja HTML për t&#39;u shfaqur për këtë bllok"

#: block.py:162
msgid "Upstream html contents to store upstream data field"
msgstr ""
"Përmbajtjet html të burimit për të ruajtur fushën e të dhënave të burimit"

#: block.py:169
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "Kodi burimor për dokumentet LaTeX. Kjo veçori nuk mbështetet mirë."

#: block.py:171
msgid "Enable LaTeX templates?"
msgstr "Aktivizo shabllonet LaTeX?"

#: block.py:174
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Zgjidhni Visual për të futur përmbajtje dhe që redaktori të krijojë "
"automatikisht HTML. Zgjidhni Raw për të modifikuar drejtpërdrejt HTML. Nëse "
"e ndryshoni këtë cilësim, duhet ta ruani komponentin dhe më pas ta rihapni "
"për modifikim."

#: block.py:177
msgid "Editor"
msgstr "Redaktor"

#: block.py:179
msgid "Visual"
msgstr "Vizual"

#: block.py:179
msgid "Raw"
msgstr "I papërpunuar"
