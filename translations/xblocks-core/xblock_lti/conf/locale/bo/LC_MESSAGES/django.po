#: block.py:126
msgid "Display Name"
msgstr "འཆར་མིང་།"

#: block.py:128
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"གྲུབ་ཆ་འདིའི་མིང་གཏན་འཁེལ། "
"དབྱེ་ཞིབ་སྙན་ཞུ་ཡིས་ཀྱང་མིང་འདི་བཀོལ་སྤྱོད་བྱ་སྲིད།"

#: block.py:136
msgid "LTI ID"
msgstr "LTI ID"

#: block.py:139
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"ཕྱི་རོལ་གྱི་LTI མཁོ་སྤྲོད་བྱེད་མཁན་གྱི་LTI ID བླུགས། "
"རིན་ཐང་འདི་ཡར་ཐོན་སྒྲིག་སྟངས་ཤོག་ངོས་སྟེང་གི་LTI "
"ཕྱི་སྐྱོད་ལག་ཁྱེར་སྒྲིག་སྟངས་ནང་བླུགས་པའི་LTI ID "
"དང་གཅིག་པ་ཡིན་དགོས།{break_tag} སྒྲིག་སྟངས་འདིའི་སྐོར་ལ་ཞིབ་ཕྲའི་གནས་ཚུལ་ལ་ "
"{docs_anchor_open} edX LTI ཡིག་ཆ་ {anchor_close} ལ་གཟིགས།"

#: block.py:155
msgid "LTI URL"
msgstr "LTI URL"

#: block.py:158
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"ཕྱི་རོལ་ལག་ཆ་འདི་ཆ་ཤས་འདིས་འགོ་འཛུགས་བྱེད་པའི་URL་བཙུགས། "
"སྒྲིག་སྟངས་འདི་ཕྱི་རོལ་ལག་ཆ་སྦ་བ་དེ་རྫུན་མ་ལ་བེད་སྤྱོད་བྱེད།{break_tag} "
"སྒྲིག་སྟངས་འདིའི་སྐོར་ལ་ཞིབ་ཕྲའི་གནས་ཚུལ་ལ་ {docs_anchor_open} edX LTI "
"ཡིག་ཆ་ {anchor_close} ལ་གཟིགས།"

#: block.py:173
msgid "Custom Parameters"
msgstr "རང་སྒྲིག་ཚད་གཞི།"

#: block.py:176
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"གློག་དེབ་ཁ་ཕྱེ་དགོས་པའི་ཤོག་ངོས་ཡང་ན་ཆ་ཤས་འདིའི་རྒྱབ་ལྗོངས་ཚོས་གཞི་ལྟ་བུའི་སྲོལ་རྒྱུན་ཚད་གཞི་གང་རུང་ལ་ལྡེ་མིག/རིན་ཐང་ཆ་གཅིག་ཁ་སྣོན་བྱེད།{break_tag}{docs_anchor_open}edX"
" LTI "
"ཡིག་ཆ་{anchor_close}ལ་གཟིགས་ནས་སྒྲིག་སྟངས་འདིའི་སྐོར་ལ་ཞིབ་ཕྲའི་གནས་ཚུལ་ལ་གཟིགས།"

#: block.py:190
msgid "Open in New Page"
msgstr "ཤོག་ངོས་གསར་པའི་ནང་སྒོ་ཕྱེ།"

#: block.py:192
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"སྤྱིར་བཏང་བདེན་པ་འདེམས་ན་སློབ་ཕྲུག་གིས་འབྲེལ་ལམ་ཞུན་དག་བྱས་ནས་གློག་ཀླད་གྱི་ལྕོག་ལེབ་གསར་པ་ནང་འགྲོ་བཏུབ་དགོས།"
" བདེན་པ་མིན་པ་འདེམས་ན་གློག་ཀླད་གྱི་ནང་དོན་འདི་དེབ་ཤོག་གི་ནང་འགྲོ་བཏུབ་དགོས། "
"སྒྲིག་སྟངས་འདི་ཕྱི་རོལ་ལྕོག་ལེབ་སྦས་ན་བདེན་པ་མིན་པ་སྒྲིག་སྟངས་ལག་ལེན་བྱེད་དུས་རྒྱུན་ལག་ལེན་བྱེད་དགོས།"
"  "

#: block.py:201
msgid "Scored"
msgstr "སྐར་གྲངས་ཐོབ།"

#: block.py:202
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"གལ་ཏེ་ཆ་ཤས་འདི་ཕྱི་རོལ་གྱི་LTI "
"མ་ལག་ནས་ཨང་གྲངས་ཀྱི་གྲངས་ཀ་ཐོབ་ན་བདེན་པ་འདེམས།"

#: block.py:208
msgid "Weight"
msgstr "བརྒྱ་ཆ།"

#: block.py:210
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"ཆ་ཤས་འདིའི་ཆེད་དུ་འབྱུང་སྲིད་པའི་སྐར་གྲངས་བླུགས། "
"སྔོན་སྒྲིག་རིན་ཐང་ནི་1,0ཡིན། སྒྲིག་སྟངས་འདི་ Scored "
"བདེན་པ་ལ་སྒྲིག་པའི་སྐབས་རྐྱངམ་གཅིག་བེད་སྤྱོད་བྱེད།"

#: block.py:220
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"སྐར་གྲངས་དེ་xblock KVSནང་དུ་བཞག་ཡོད། -- django "
"DBནང་དུ་པར་སྐྲུན་བྱས་པའི་སྐར་གྲངས་ཀྱི་འདྲ་བཤུས།"

#: block.py:225
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "མཆན་འགྲེལ། འཛིན་གྲྭ་ནས་ཕྱིར་ལོག་བྱུང་། LTI2.0 ཆ་རྐྱེན།"

#: block.py:228
msgid "Hide External Tool"
msgstr "ཕྱི་རོལ་གྱི་ལག་ཆ་སྦས།"

#: block.py:230
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱིས་ཆ་ཤས་འདི་ཕྱི་རོལ་གྱི་ལག་ཆ་འགོ་འཛུགས་བྱེད་པ་ལས་ཕྱི་རོལ་གྱི་རིམ་པ་མ་ལག་དང་མཉམ་དུ་དུས་མཉམ་བཟོ་བའི་ས་གནས་འཛིན་མཁན་དུ་བེད་སྤྱོད་གཏོང་འདོད་ན་བདེན་པ་འདེམས།"
" སྒྲིག་སྟངས་འདིས་ཆ་ཤས་འདིའི་ཆེད་དུ་འགོ་འཛུགས་མཐེབ་དང་IFramesགང་རུང་སྦས་ཡོད།"

#: block.py:242
msgid "Request user's username"
msgstr "སྤྱོད་མཁན་མིང་རེ་ཞུ།"

#. Translators: This is used to request the user's username for a third party
#. service.
#: block.py:244
msgid "Select True to request the user's username."
msgstr "སྤྱོད་མཁན་གྱི་མིང་རེ་ཞུ་བྱེད་པར་བདེན་པ་འདེམ།"

#: block.py:250
msgid "Request user's email"
msgstr "སྤྱོད་མཁན་གྱི་ཡིག་ཟམ་རེ་ཞུ་བྱེད་པ།"

#. Translators: This is used to request the user's email for a third party
#. service.
#: block.py:252
msgid "Select True to request the user's email address."
msgstr "སྤྱོད་མཁན་གྱི་ཡིག་ཟམ་རེ་ཞུ་བྱེད་པར་ \"True\" འདེམས།"

#: block.py:258
msgid "LTI Application Information"
msgstr "LTI སྙན་ཞུའི་ཆ་འཕྲིན།"

#: block.py:260
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"ཕྱོགས་གསུམ་པའི་མཉེན་ཆས་འགྲེལ་བཤད་བྲིས། "
"སྤྱོད་མཁན་མིང་དང་/ཡང་ན་ཡིག་ཟམ་རེ་ཞུ་བྱེད་ན་སྤྱོད་མཁན་ཚོར་ཁོང་ཚོའི་སྤྱོད་མཁན་མིང་དང་/ཡང་ན་ཡིག་ཟམ་ཕྱོགས་གསུམ་པའི་མཉེན་ཆས་ལ་གཏོང་དགོས་དོན་བརྡ་སྤྲོད་བྱོས།"

#: block.py:268
msgid "Button Text"
msgstr "གནོན་མཐེབ་ཡི་གེ།"

#: block.py:269
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr "མཉེན་ཆས་གཞན་པ་འཇོག་བྱེད་ཀྱི་གནོན་ཐེབས་ཐོག་ཡི་གེ་ཕྲིས།"

#: block.py:275
msgid "Accept grades past deadline"
msgstr "དུས་བཀག་ལས་བརྒལ་བའི་སྐར་གྲངས་དང་ལེན་བྱེད་པ།"

#: block.py:276
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"ཕྱོགས་གསུམ་པའི་མ་ལག་ལ་དུས་ཚོད་ལས་བརྒལ་ཏེ་གྲུབ་འབྲས་སྤེལ་ཆོག་པའི་ཆེད་དུ་བདེན་པ་འདེམས།"

#: block.py:443
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"རྨང་གཞིའི་རྐྱེན་ཡིག་གཤིས་འཇོག་མ་ཐུབ།: {custom_parameter} འདི་ \"x=y\" "
"ཡིག་རྒྱུན་ཡིན་དགོས།"

#: block.py:989
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"LTI ཡི་ལག་དེབ་རིགས་དབྱེ་བྱེད་མ་ཐུབ།: {lti_passport}. ངེས་པར་དུ་ "
"\"id:key:secret\" ཕྲེང་བསྟར་ཡིན་དགོས།"

#. Translators:  "External resource" means that this learning module is hosted
#. on a platform external to the edX LMS
#: templates/lti.html:6
msgid "External resource"
msgstr "ཕྱི་རོལ་གྱི་ཐོན་ཁུངས།"

#. Translators: "points" is the student's achieved score on this LTI unit, and
#. "total_points" is the maximum number of points achievable.
#: templates/lti.html:13
msgid "points"
msgstr "ཐོབ་སྐར།"

#: templates/lti.html:14
#, python-brace-format
msgid "{points} / {total_points} points"
msgstr "{points} / {total_points} ཐོབ་སྐར།"

#. Translators: "total_points" is the maximum number of points achievable on
#. this LTI unit
#: templates/lti.html:18
msgid "total_points"
msgstr "སྤྱིའི་ཐོབ་སྐར།"

#: templates/lti.html:40
msgid "View resource in a new window"
msgstr "ཐོན་ཁུངས་སྒེའུ་ཁུང་གསར་པ་ཞིག་གི་ནང་སྟོན།"

#: templates/lti.html:60
msgid ""
"Please provide launch_url. Click \"Edit\", and fill in the required fields."
msgstr ""
"འཇོག་བྱེད་ཀྱི་_url མཁོ་སྤྲོད་བྱ་རོགས། \"Edit\" "
"ལ་བསྣུན་ཏེ་གྲ་སྒྲིག་བྱས་ཡོད་པའི་སྡེ་ཚན་དེའི་ནང་སྐོང་རོགས།"

#: templates/lti_form.html:28
msgid "Press to Launch"
msgstr "མནན་ནས་འགོ་འབྱེད།"
