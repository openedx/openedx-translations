#: block.py:126
msgid "Display Name"
msgstr "Ko‘rsatiladigan ism"

#: block.py:128
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"Ushbu komponent uchun ko'rsatiladigan nom. Analytics hisobotlari ushbu "
"komponentni aniqlash uchun ko'rsatilgan nomdan ham foydalanishi mumkin."

#: block.py:136
msgid "LTI ID"
msgstr "LTI ID"

#: block.py:139
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Tashqi LTI provayderi uchun LTI identifikatorini kiriting. Bu qiymat "
"Kengaytirilgan sozlamalar sahifasidagi LTI pasportlari sozlamalarida "
"kiritgan LTI identifikatori boʻlishi kerak. {break_tag} Ushbu sozlama haqida"
" batafsil ma'lumot uchun {docs_anchor_open} edX LTI hujjatlari "
"{anchor_close} ga qarang."

#: block.py:155
msgid "LTI URL"
msgstr "LTI URL"

#: block.py:158
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"Ushbu komponent ishga tushiradigan tashqi vositaning URL manzilini kiriting."
" Bu sozlama faqat “Tashqi asbobni yashirish” “False”ga o‘rnatilganda "
"qo‘llaniladi. {break_tag} Ushbu sozlama haqida batafsil ma'lumot uchun "
"{docs_anchor_open} edX LTI hujjatlari {anchor_close} ga qarang."

#: block.py:173
msgid "Custom Parameters"
msgstr "Maxsus parametrlar"

#: block.py:176
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Elektron kitobingiz ochishi kerak bo'lgan sahifa yoki ushbu komponent uchun "
"fon rangi kabi har qanday maxsus parametrlar uchun kalit/qiymat juftligini "
"qo'shing. {break_tag} Ushbu sozlama haqida batafsil ma'lumot uchun "
"{docs_anchor_open} edX LTI hujjatlari {anchor_close} ga qarang."

#: block.py:190
msgid "Open in New Page"
msgstr "Yangi sahifada ochish"

#: block.py:192
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"Talabalar yangi oynada LTI vositasini ochadigan havolani bosishlarini "
"istasangiz, \"True\" ni tanlang. Agar LTI tarkibi joriy sahifada IFrame-da "
"ochilishini istasangiz, False-ni tanlang. Bu sozlama faqat “Tashqi asbobni "
"yashirish” “False”ga o‘rnatilganda qo‘llaniladi.  "

#: block.py:201
msgid "Scored"
msgstr "Baholangan"

#: block.py:202
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Agar ushbu komponent tashqi LTI tizimidan raqamli ball oladigan bo'lsa, "
"\"True\" ni tanlang."

#: block.py:208
msgid "Weight"
msgstr "Og&#39;irligi"

#: block.py:210
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Ushbu komponent uchun mumkin bo'lgan ballar sonini kiriting. Standart qiymat"
" 1,0. Bu sozlama faqat Scored True qiymatiga o‘rnatilganda ishlatiladi."

#: block.py:220
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"Xblock KVS da saqlanadigan ball -- django DB da chop etilgan ballning "
"dublikati"

#: block.py:225
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr ""
"Baholovchi tomonidan qaytarilgan sharh, LTI2.0 spetsifikatsiyasiga ko‘ra"

#: block.py:228
msgid "Hide External Tool"
msgstr "Tashqi vositani yashirish"

#: block.py:230
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Agar siz ushbu komponentdan tashqi vositani ishga tushirish o'rniga tashqi "
"baholash tizimi bilan sinxronlash uchun joy ushlagich sifatida "
"foydalanmoqchi bo'lsangiz, \"True\" ni tanlang. Ushbu sozlama Ishga "
"tushirish tugmasi va ushbu komponent uchun har qanday IFrame'larni "
"yashiradi."

#: block.py:242
msgid "Request user's username"
msgstr "Foydalanuvchining foydalanuvchi nomini so'rang"

#. Translators: This is used to request the user's username for a third party
#. service.
#: block.py:244
msgid "Select True to request the user's username."
msgstr "Foydalanuvchining foydalanuvchi nomini so'rash uchun True ni tanlang."

#: block.py:250
msgid "Request user's email"
msgstr "Foydalanuvchining elektron pochta manzilini so'rang"

#. Translators: This is used to request the user's email for a third party
#. service.
#: block.py:252
msgid "Select True to request the user's email address."
msgstr ""
"Foydalanuvchining elektron pochta manzilini so'rash uchun True ni tanlang."

#: block.py:258
msgid "LTI Application Information"
msgstr "LTI ilovasi haqida ma'lumot"

#: block.py:260
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Uchinchi tomon ilovasining tavsifini kiriting. Agar foydalanuvchi nomi "
"va/yoki elektron pochta manzilini soʻrasangiz, foydalanuvchi nomi va/yoki "
"elektron pochta manzili nima uchun uchinchi tomon ilovasiga yuborilishi "
"haqida maʼlumot berish uchun ushbu matn maydonidan foydalaning."

#: block.py:268
msgid "Button Text"
msgstr "Matn tugmasi"

#: block.py:269
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr ""
"Uchinchi tomon ilovasini ishga tushirish uchun ishlatiladigan tugmachadagi "
"matnni kiriting."

#: block.py:275
msgid "Accept grades past deadline"
msgstr "Belgilangan muddatdan o'tgan baholarni qabul qiling"

#: block.py:276
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Uchinchi tomon tizimlariga belgilangan muddatdan o‘tgan baholarni "
"joylashtirishga ruxsat berish uchun True ni tanlang."

#: block.py:443
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"Maxsus parametrni tahlil qilib bo‘lmadi: {custom_parameter} . \"x = y\" "
"qatori bo'lishi kerak."

#: block.py:989
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"LTI pasportini tahlil qilib boʻlmadi: {lti_passport} . \"id: key: secret\" "
"qatori bo'lishi kerak."

#. Translators:  "External resource" means that this learning module is hosted
#. on a platform external to the edX LMS
#: templates/lti.html:6
msgid "External resource"
msgstr "Tashqi manba"

#. Translators: "points" is the student's achieved score on this LTI unit, and
#. "total_points" is the maximum number of points achievable.
#: templates/lti.html:13
msgid "points"
msgstr "ball"

#: templates/lti.html:14
#, python-brace-format
msgid "{points} / {total_points} points"
msgstr "{points} / {total_points} ball"

#. Translators: "total_points" is the maximum number of points achievable on
#. this LTI unit
#: templates/lti.html:18
msgid "total_points"
msgstr "umumiy_ballar"

#: templates/lti.html:40
msgid "View resource in a new window"
msgstr "Resursni yangi oynada ko'ring"

#: templates/lti.html:60
msgid ""
"Please provide launch_url. Click \"Edit\", and fill in the required fields."
msgstr ""
"Iltimos, launch_url manzilini kiriting. \"Tahrirlash\" tugmasini bosing va "
"kerakli maydonlarni to'ldiring."

#: templates/lti_form.html:28
msgid "Press to Launch"
msgstr "Ishga tushirish uchun bosing"
