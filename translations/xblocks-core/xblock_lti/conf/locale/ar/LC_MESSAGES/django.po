#: block.py:126
msgid "Display Name"
msgstr "الاسم الظاهر"

#: block.py:128
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"الاسم الظاهر لهذا المكون. قد تستخدم تقارير التحليلات أيضاً الاسم الظاهر "
"لتعريف هذا المكون."

#: block.py:136
msgid "LTI ID"
msgstr "الرقم التعريفي لـ ’LTI‘"

#: block.py:139
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"أدخل معرف LTI لمزود LTI الخارجي. يجب أن تكون هذه القيمة هي نفس معرّف الLTI "
"الذي أدخلته في إعداد LTI Passports في صفحة الإعدادات المتقدمة. {break_tag} "
"راجع {docs_anchor_open} وثائق edX LTI {anchor_close} لمزيد من التفاصيل حول "
"هذا الإعداد."

#: block.py:155
msgid "LTI URL"
msgstr "رابط LTI"

#: block.py:158
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"أدخِل رابط الأداة الخارجية التي يشغلها هذا المكون. يُستخدم هذا الإعداد فقط "
"عند تعيين خيار \"اخفِ الأداة الخارجية\" على \"لا\". {break_tag}اطّلِع على "
"{docs_anchor_open}وثائق edX LTI{anchor_close} لمعرفة المزيد من التفاصيل حول "
"هذا الإعداد."

#: block.py:173
msgid "Custom Parameters"
msgstr "المُعطيات المُخصّصة"

#: block.py:176
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"أضِف زوجاً من المفاتيح أو القِيم لأيّ متغيرات مخصصة، مثل الصفحة التي ينبغي "
"أن يُفتح عليها كتابك الإلكتروني أو لون الخلفية لهذا المكون. {break_tag} "
"اطّلِع على {docs_anchor_open} وثائق LTI الخاصة بإدكس {anchor_close} للمزيد "
"من التفاصيل حول هذا الإعداد."

#: block.py:190
msgid "Open in New Page"
msgstr "افتح في صفحة جديدة"

#: block.py:192
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"اختَر خيار \"نعم\" إذا أردت أن يضغط الطلاب على رابط يفتح أداة LTI في نافذة "
"جديدة. اختَر خيار \"لا\" إذا أردت أن يُفتح محتوى LTI في IFrame في الصفحة "
"الحالية. يُستخدم هذا الإعداد فقط عند تعيين خيار \"اخفِ الأداة الخارجية\" على"
" \"لا"

#: block.py:201
msgid "Scored"
msgstr "مقيّمة"

#: block.py:202
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"يُرجى اختيار \"نعم\" إذا كان هذا المكون سوف يتلقى النتيجة الرقمية من نظام "
"LTI الخارجي."

#: block.py:208
msgid "Weight"
msgstr "الثقل"

#: block.py:210
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"أدخِل عدد الدرجات الممكنة لهذا المكون. العدد الافتراضي هو 1.0. يُستخدم هذا "
"الإعداد فقط عند تعيين خيار 'Scored' على \"نعم\"."

#: block.py:220
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"حُفظت النتيجة في xblock KVS -- وهي نسخة مطابقة للنتيجة المنشورة في قاعدة "
"بيانات django"

#: block.py:225
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "التعليق العائد من المصحّح، LTI2.0 spec"

#: block.py:228
msgid "Hide External Tool"
msgstr "اخفِ الأداة الخارجية "

#: block.py:230
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"اختَر \"نعم\" إذا أردت استخدام هذا المكون كبديل للمزامنة مع نظام تقييم خارجي"
" بدلاً من تشغيل أداة خارجية. سيخفي هذا الإعداد زر التشغيل وكل عناصر IFrames "
"لهذا المكون."

#: block.py:242
msgid "Request user's username"
msgstr "اطلب اسم المستخدم"

#. Translators: This is used to request the user's username for a third party
#. service.
#: block.py:244
msgid "Select True to request the user's username."
msgstr "يُرجى اختيار \"نعم\" لطلب اسم المستخدم."

#: block.py:250
msgid "Request user's email"
msgstr "اطلب البريد الإلكتروني للمستخدم"

#. Translators: This is used to request the user's email for a third party
#. service.
#: block.py:252
msgid "Select True to request the user's email address."
msgstr "يُرجى اختيار \"نعم\" لطلب البريد الإلكتروني للمستخدم."

#: block.py:258
msgid "LTI Application Information"
msgstr "معلومات تطبيق LTI"

#: block.py:260
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"أدخِل وصفاً لتطبيق الجهة الخارجية. وفي حال طلب اسم المستخدم و/أو البريد "
"الإلكتروني، فاستخدِم هذا الصندوق النصي لإعلام المستخدمين عن سبب إرسال اسم "
"المستخدم و/أو البريد الإلكتروني الخاص بهم إلى تطبيق لجهة خارجية."

#: block.py:268
msgid "Button Text"
msgstr "النص المكتوب على الزر"

#: block.py:269
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr "أدخِل النص الظاهر على الزر المستخدم لتشغيل تطبيق الجهة الخارجية."

#: block.py:275
msgid "Accept grades past deadline"
msgstr "اقبَل الدرجات بعد انقضاء الموعد النهائي "

#: block.py:276
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"يُرجى اختيار \"نعم\" للسماح لأنظمة خارجية بنشر الدرجات بعد انقضاء الموعد "
"النهائي."

#: block.py:443
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"تعذّر تفسير المُعطيات المُخصّصة: {custom_parameter}. يجب أن يكون مُدخلاً "
"بنَسَق \"x=y\"."

#: block.py:989
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"لا يمكن إعراب تصاريح LTI: {lti_passport}. يجب أن يكون النص على شكل "
"\"id:key:secret\"."

#. Translators:  "External resource" means that this learning module is hosted
#. on a platform external to the edX LMS
#: templates/lti.html:6
msgid "External resource"
msgstr "مصدر خارجي"

#. Translators: "points" is the student's achieved score on this LTI unit, and
#. "total_points" is the maximum number of points achievable.
#: templates/lti.html:13
msgid "points"
msgstr "الدرجات"

#: templates/lti.html:14
#, python-brace-format
msgid "{points} / {total_points} points"
msgstr "{points} / {total_points} درجة"

#: templates/lti.html:40
msgid "View resource in a new window"
msgstr "الاطلاع على المصدر في نافذة جديدة"

#: templates/lti.html:60
msgid ""
"Please provide launch_url. Click \"Edit\", and fill in the required fields."
msgstr ""
"يُرجى توفير الرابط launch_url. اضغط على \"تعديل\"، ثمّ املأ الحقول المطلوبة."

#: templates/lti_form.html:28
msgid "Press to Launch"
msgstr "انقر للتشغيل"
