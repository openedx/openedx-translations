#: block.py:126
msgid "Display Name"
msgstr "Emri i shfaqur"

#: block.py:128
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"Emri i shfaqur për këtë komponent. Raportet e analitikës mund të përdorin "
"gjithashtu emrin e shfaqur për të identifikuar këtë komponent."

#: block.py:136
msgid "LTI ID"
msgstr "ID LTI"

#: block.py:139
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Futni ID LTI për ofruesin e jashtëm LTI. Kjo vlerë duhet të jetë e njëjta ID"
" LTI që keni futur në cilësimin LTI Passports në faqen e Konfigurimet E "
"Avancuara.{break_tag} Shih {docs_anchor_open} dokumentacionin edX LTI "
"{anchor_close} për më shumë detaje mbi këtë cilësim."

#: block.py:155
msgid "LTI URL"
msgstr "URL LTI"

#: block.py:158
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"Futni URL-në e mjetit të jashtëm që lëshon ky komponent. Ky cilësim përdoret"
" vetëm kur Hide External Tool është caktuar në False.{break_tag} Shih "
"{docs_anchor_open} dokumentacionin edX LTI {anchor_close} për më shumë "
"detaje mbi këtë cilësim."

#: block.py:173
msgid "Custom Parameters"
msgstr "Parametrat e personalizuar"

#: block.py:176
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Shtoni çiftin çelës/vlerë për çdo parametër të personalizuar, si p.sh. faqja"
" në të cilën duhet të hapet e-libri juaj ose ngjyra e sfondit për këtë "
"komponent.{break_tag} Shih {docs_anchor_open} dokumentacionin edX LTI "
"{anchor_close} për më shumë detaje mbi këtë cilësim."

#: block.py:190
msgid "Open in New Page"
msgstr "Hapni në Faqe të Re"

#: block.py:192
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"Zgjidhni \"E vërtetë\" nëse dëshironi që studentët të klikojnë një lidhje që"
" hap mjetin LTI në një dritare të re. Zgjidhni False nëse dëshironi që "
"përmbajtja LTI të hapet në një IFrame në faqen aktuale. Ky cilësim përdoret "
"vetëm kur Hide External Tool është caktuar në False.  "

#: block.py:201
msgid "Scored"
msgstr "Shënoi"

#: block.py:202
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Zgjidhni \"E vërtetë\" nëse ky komponent do të marrë një rezultat numerik "
"nga sistemi i jashtëm LTI."

#: block.py:208
msgid "Weight"
msgstr "Pesha"

#: block.py:210
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Futni numrin e pikëve të mundshme për këtë komponent. Vlera e paracaktuar "
"është 1.0. Ky cilësim përdoret vetëm kur Scored është caktuar në True."

#: block.py:220
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"Rezultati ruhet në xblock KVS -- dublikatë e rezultatit të publikuar në "
"django DB"

#: block.py:225
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "Koment si i kthyer nga grader, specifikim LTI2.0"

#: block.py:228
msgid "Hide External Tool"
msgstr "Fshihni mjetin e jashtëm"

#: block.py:230
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Zgjidhni \"E vërtetë\" nëse dëshironi ta përdorni këtë komponent si një "
"mbajtëse vendi për sinkronizimin me një sistem të jashtëm klasifikimi në "
"vend që të hapni një mjet të jashtëm. Ky cilësim fsheh butonin Launch dhe "
"çdo IFrame për këtë komponent."

#: block.py:242
msgid "Request user's username"
msgstr "Kërkoni emrin e përdoruesit"

#. Translators: This is used to request the user's username for a third party
#. service.
#: block.py:244
msgid "Select True to request the user's username."
msgstr ""
"Zgjidhni Të vërtetë për të kërkuar emrin e përdoruesit të përdoruesit."

#: block.py:250
msgid "Request user's email"
msgstr "Kërkoni emailin e përdoruesit"

#. Translators: This is used to request the user's email for a third party
#. service.
#: block.py:252
msgid "Select True to request the user's email address."
msgstr "Zgjidhni Të vërtetë për të kërkuar adresën e emailit të përdoruesit."

#: block.py:258
msgid "LTI Application Information"
msgstr "Informacioni për Aplikimin LTI"

#: block.py:260
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Futni një përshkrim të aplikacionit të palës së tretë. Nëse kërkoni emrin e "
"përdoruesit dhe/ose email, përdorni këtë kuti teksti për të informuar "
"përdoruesit pse emri i përdoruesit dhe/ose emaili i tyre do të përcillet te "
"një aplikacion i palës së tretë."

#: block.py:268
msgid "Button Text"
msgstr "Teksti i butonit"

#: block.py:269
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr ""
"Fut tekstin në butonin e përdorur për të nisur aplikacionin e palës së "
"tretë."

#: block.py:275
msgid "Accept grades past deadline"
msgstr "Prano notat pas afatit"

#: block.py:276
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Zgjidhni \"E vërtetë\" për të lejuar sistemet e palëve të treta të postojnë "
"notat pas afatit."

#: block.py:443
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"Nuk mund të analizohej parametri i personalizuar: {custom_parameter}. Duhet "
"të jetë vargu \"x=y\"."

#: block.py:989
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"Nuk mund të analizohej pasaporta LTI: {lti_passport}. Duhet të jetë vargu "
"\"id:key:secret\"."

#. Translators:  "External resource" means that this learning module is hosted
#. on a platform external to the edX LMS
#: templates/lti.html:6
msgid "External resource"
msgstr "Burim i jashtëm"

#. Translators: "points" is the student's achieved score on this LTI unit, and
#. "total_points" is the maximum number of points achievable.
#: templates/lti.html:13
msgid "points"
msgstr "pikë"

#: templates/lti.html:14
#, python-brace-format
msgid "{points} / {total_points} points"
msgstr "{points} / {total_points} pikë"

#: templates/lti.html:40
msgid "View resource in a new window"
msgstr "Shikoni burimin në një dritare të re"

#: templates/lti.html:60
msgid ""
"Please provide launch_url. Click \"Edit\", and fill in the required fields."
msgstr ""
"Ju lutemi jepni nisjen_url. Klikoni \"Edit\", dhe plotësoni fushat e "
"kërkuara."

#: templates/lti_form.html:28
msgid "Press to Launch"
msgstr "Shtypni për të nisur"
