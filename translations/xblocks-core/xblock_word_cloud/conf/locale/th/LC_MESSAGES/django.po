#: block.py:50
msgid "Display Name"
msgstr "ชื่อที่แสดง"

#: block.py:51
msgid "The display name for this component."
msgstr "ชื่อที่แสดงสำหรับส่วนประกอบนี้"

#: block.py:56
msgid "Instructions"
msgstr "คำแนะนำ"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"เพิ่มคำแนะนำเพื่อช่วยให้ผู้เรียนเข้าใจวิธีใช้คำว่าคลาวด์ "
"คำแนะนำที่ชัดเจนเป็นสิ่งสำคัญ "
"โดยเฉพาะสำหรับผู้เรียนที่มีข้อกำหนดด้านการช่วยเหลือพิเศษ"

#: block.py:64
msgid "Inputs"
msgstr "งานที่นำเข้า"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr "จำนวนกล่องข้อความที่ผู้เรียนสามารถเพิ่มคำและประโยคได้"

#: block.py:71
msgid "Maximum Words"
msgstr "จำนวนคำสูงสุด"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "จำนวนคำสูงสุดที่แสดงในคลาวด์คำที่สร้างขึ้น"

#: block.py:78
msgid "Show Percents"
msgstr "แสดงร้อยละ"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "สถิติจะแสดงคำที่ใส่เข้ามาใกล้เคียงกับคำนั้นๆ"

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "ไม่ว่าผู้เรียนรายนี้จะโพสต์คำศัพท์ไปยังคลาวด์หรือไม่"

#: block.py:88
msgid "Student answer."
msgstr "คำตอบของนักเรียน"

#: block.py:89
msgid "All possible words from all learners."
msgstr "ทุกคำที่เป็นไปได้จากผู้เรียนทุกคน"

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "คำอันดับสูงสุดสำหรับคลาวด์"

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s จาก %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "บันทึก"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "ข้อความของคุณ คือ :"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "รวมส่งทั้งหมด {start_strong}{total}{end_strong} คำ"
