#: block.py:50
msgid "Display Name"
msgstr "Görünüş adı"

#: block.py:51
msgid "The display name for this component."
msgstr "Bu komponent üçün görünüş adı."

#: block.py:56
msgid "Instructions"
msgstr "Təlimatlar"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Söz buludundan necə istifadə ediləcəyini tələbələrə izah etməyə kömək etmək "
"üçün təlimat əlavə edin. Xüsusilə giriş tələblərinə sahib olan tələbələr "
"üçün açıq təlimat vacibdir."

#: block.py:64
msgid "Inputs"
msgstr "Girişlər"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Tələbələrin söz və cümlələri əlavə etməsi üçün mövcud mətn qutularının sayı."

#: block.py:71
msgid "Maximum Words"
msgstr "Maksimum söz sayı"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Yaradılmış söz buludunda göstərilən maksimum söz sayı."

#: block.py:78
msgid "Show Percents"
msgstr "Faizləri göstərin"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Statistika həmin sözün yaxınlığında daxil edilmiş sözlər üçün göstərilir."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Bu tələbənin buluda sözləri post edibmi?"

#: block.py:88
msgid "Student answer."
msgstr "Tələbə cavabı."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Bütün tələbələrdən bütün mümkün sözlər."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Söz buludu üçün ən num_top_words sözlər"

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s / %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Yaddaşda saxlayın"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Sizin sözləriniz:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "Ümumi olaraq {start_strong}{total}{end_strong} sayda söz göndərildi."
