#: block.py:50
msgid "Display Name"
msgstr "Εμφανιζόμενο όνομα"

#: block.py:51
msgid "The display name for this component."
msgstr "Το εμφανιζόμενο όνομα για αυτό το στοιχείο."

#: block.py:56
msgid "Instructions"
msgstr "Οδηγίες"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Προσθέστε οδηγίες για να βοηθήσετε τους σπουδαστές να κατανοήσουν πώς να "
"χρησιμοποιούν τη λέξη σύννεφο. Οι σαφείς οδηγίες είναι σημαντικές, ειδικά "
"για σπουδαστές που έχουν απαιτήσεις προσβασιμότητας."

#: block.py:64
msgid "Inputs"
msgstr "Είσοδοι"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Ο αριθμός των πλαισίων κειμένου που είναι διαθέσιμα στους σπουδαστές για να "
"προσθέσουν λέξεις και προτάσεις."

#: block.py:71
msgid "Maximum Words"
msgstr "Μέγιστο πλήθος λέξεων"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"Ο μέγιστος αριθμός λέξεων που εμφανίζεται στο δημιουργημένο σύννεφο λέξεων."

#: block.py:78
msgid "Show Percents"
msgstr "Εμφάνιση ποσοστών"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Εμφανίζονται στατιστικά στοιχεία για τις εισαγόμενες λέξεις κοντά σε αυτήν "
"τη λέξη."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Εάν αυτός ο σπουδαστής έχει δημοσιεύσει λέξεις στο σύννεφο."

#: block.py:88
msgid "Student answer."
msgstr "Απάντηση σπουδαστή."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Όλες οι πιθανές λέξεις από όλους τους σπουδαστές."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Κορυφαίες num_top_words λέξεις για σύννεφο λέξεων."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s από %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Αποθήκευση"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Οι λέξεις σου ήταν:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} λέξεις υποβλήθηκαν συνολικά."
