#: block.py:49
msgid "Display Name"
msgstr "Emri i shfaqur"

#: block.py:50
msgid "The display name for this component."
msgstr "Emri i shfaqur për këtë komponent."

#: block.py:55
msgid "Instructions"
msgstr "Udhëzimet"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Shtoni udhëzime për t'i ndihmuar nxënësit të kuptojnë se si të përdorin "
"fjalën re. Udhëzimet e qarta janë të rëndësishme, veçanërisht për nxënësit "
"që kanë kërkesa për aksesueshmëri."

#: block.py:63
msgid "Inputs"
msgstr "Inputet"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Numri i kutive të tekstit në dispozicion për nxënësit për të shtuar fjalë "
"dhe fjali."

#: block.py:70
msgid "Maximum Words"
msgstr "Fjalët maksimale"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Numri maksimal i fjalëve që shfaqen në renë e fjalëve të krijuara."

#: block.py:77
msgid "Show Percents"
msgstr "Shfaq përqindjet"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "Statistikat tregojnë për fjalët e futura pranë asaj fjale."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Nëse ky nxënës ka postuar fjalë në re."

#: block.py:87
msgid "Student answer."
msgstr "Përgjigja e nxënësit."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Të gjitha fjalët e mundshme nga të gjithë nxënësit."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Fjalët kryesore për renë e fjalëve num_top_words."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Ruaj"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Fjalët e tua ishin:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} fjalë të dorëzuara në total."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "tekst_fjala_{uniqueId} title_word_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "titull_fjalë_ {uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "teksti_fjala_{uniqueId}"
