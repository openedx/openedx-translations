#: block.py:50
msgid "Display Name"
msgstr "Ім'я, що відображається"

#: block.py:51
msgid "The display name for this component."
msgstr "Відображена назва для цього компоненту. "

#: block.py:56
msgid "Instructions"
msgstr "Інструкція"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Додайте інструкції, щоб допомогти учням зрозуміти, як використовувати хмару "
"слів. Важливі чіткі інструкції, особливо для учнів, які мають вимоги до "
"доступності даних."

#: block.py:64
msgid "Inputs"
msgstr "Вхідні дані"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Кількість текстових полів, доступних слухачам для введення слів / фраз."

#: block.py:71
msgid "Maximum Words"
msgstr "Максимальна кількість слів"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Максимальна кількість слів, що відображається у створеній хмарі слів."

#: block.py:78
msgid "Show Percents"
msgstr "Показати у відсотках"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "Статистичні дані для кожного слова відображаються поруч з цим словом."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Чи додав студент слова до хмари."

#: block.py:88
msgid "Student answer."
msgstr "Відповідь студента."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Всі можливі слова від слухачів."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Слова num_top_words, що найбільш часто зустрічаються в хмарі."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s з %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Зберегти"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Ваші слова:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} подано слів загалом."
