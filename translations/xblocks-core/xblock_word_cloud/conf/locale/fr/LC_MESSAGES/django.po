#: block.py:50
msgid "Display Name"
msgstr "Nom d'affichage"

#: block.py:51
msgid "The display name for this component."
msgstr "Le nom d'affichage de ce composant."

#: block.py:56
msgid "Instructions"
msgstr "Instructions"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Ajoutez des instructions pour aider les apprenants à comprendre comment "
"utiliser le nuage de mots. Des instructions claires sont importantes, en "
"particulier pour les apprenants qui ont des conditions nécessaires en "
"matière d&#39;accessibilité."

#: block.py:64
msgid "Inputs"
msgstr "Contributions"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Le nombre de zones de texte disponibles pour que les apprenants puissent "
"ajouter des mots et des phrases."

#: block.py:71
msgid "Maximum Words"
msgstr "Nombre maximum de mots"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Le nombre maximum de mots affichés dans le nuage de mots généré."

#: block.py:78
msgid "Show Percents"
msgstr "Afficher les pourcentages"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Des statistiques sont affichées pour les mots saisis à proximité de ce mot."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Indique si cet apprenant poste des mots dans le cloud."

#: block.py:88
msgid "Student answer."
msgstr "Réponse de l&#39;apprenant."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Tous les mots possibles de tous les apprenants."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Top num_top_words mots pour le nuage de mots."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s sur %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Enregistrer"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Vos mots étaient :"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} mots soumis au total."
