#: block.py:50
msgid "Display Name"
msgstr "Megjelenített név"

#: block.py:51
msgid "The display name for this component."
msgstr "Ennek az összetevőnek a megjelenített neve."

#: block.py:56
msgid "Instructions"
msgstr "Utasítások"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Adj utasításokat, hogy segítsd a tanulókat megérteni, hogyan használják a "
"szófelhőt. A világos utasítások különösen fontosak azok számára, akiknek "
"akadálymentesítési igényeik vannak."

#: block.py:64
msgid "Inputs"
msgstr "Bemenetek"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"A tanulók számára elérhető szövegdobozok száma, ahová szavakat és mondatokat"
" adhatnak hozzá."

#: block.py:71
msgid "Maximum Words"
msgstr "Maximum szó"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "A generált szófelhőben megjelenített szavak maximális száma."

#: block.py:78
msgid "Show Percents"
msgstr "Százalék megjelenítése"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "A statisztikák a megadott szavak mellett jelennek meg."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Hogy ez a tanuló feltöltött-e szavakat a felhőbe."

#: block.py:88
msgid "Student answer."
msgstr "Tanuló válasz."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Minden lehetséges szó minden tanulótól."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "A szófelhő num_top_words leggyakoribb szavai."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s a %(num_inputs)s-ből\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Mentés"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "A szavaid a következők voltak:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "Összesen {start_strong}{total}{end_strong} szó beküldve."
