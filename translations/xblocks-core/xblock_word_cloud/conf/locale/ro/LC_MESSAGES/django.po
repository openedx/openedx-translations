#: block.py:50
msgid "Display Name"
msgstr "Nume afișare"

#: block.py:51
msgid "The display name for this component."
msgstr "Numele afișat pentru componenta aceasta."

#: block.py:56
msgid "Instructions"
msgstr "Instrucţiuni"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Reclamă instrucțiuni pentru a ajuta cursanții să înțeleagă cum să folosească"
" norul de cuvinte. Instrucțiuni clare sunt importante, în special pentru "
"cursanții care au cerințe de accesibilitate."

#: block.py:64
msgid "Inputs"
msgstr "Intrări"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Numărul de casete de text disponibile pentru ca cursanții să adauge cuvinte "
"și propoziții."

#: block.py:71
msgid "Maximum Words"
msgstr "Numărul Maxim de Cuvinte"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Numărul maxim de cuvinte afișate în norul de cuvinte generat."

#: block.py:78
msgid "Show Percents"
msgstr "Arătați procentele"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "Statistica este afișată pentru cuvintele introduse lângă acel cuvânt."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Dacă acest cursant a postat cuvinte în cloud."

#: block.py:88
msgid "Student answer."
msgstr "Răspunsul elevului."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Toate cuvintele posibile de la toți cursanții."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Top num_top_words cuvinte pentru nor de cuvinte."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Salvează"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Cuvintele tale au fost:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} cuvinte trimise în total."
