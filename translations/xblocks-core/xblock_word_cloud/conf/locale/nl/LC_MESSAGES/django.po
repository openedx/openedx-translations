#: block.py:50
msgid "Display Name"
msgstr "Weergavenaam"

#: block.py:51
msgid "The display name for this component."
msgstr "De weergavenaam voor dit onderdeel."

#: block.py:56
msgid "Instructions"
msgstr "Instructies"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Voeg instructies toe om leerlingen te helpen begrijpen hoe ze de woordwolk "
"moeten gebruiken. Duidelijke instructies zijn belangrijk, vooral voor "
"leerlingen die toegankelijkheidseisen hebben."

#: block.py:64
msgid "Inputs"
msgstr "Ingangen"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Het aantal tekstvakken dat beschikbaar is voor leerlingen om woorden en "
"zinnen toe te voegen."

#: block.py:71
msgid "Maximum Words"
msgstr "Maximale woorden"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"Het maximale aantal woorden dat wordt weergegeven in de gegenereerde "
"woordwolk."

#: block.py:78
msgid "Show Percents"
msgstr "Toon percentages"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Er worden statistieken weergegeven voor ingevoerde woorden in de buurt van "
"dat woord."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Of deze leerling woorden naar de cloud heeft gepost."

#: block.py:88
msgid "Student answer."
msgstr "Student antwoord."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Alle mogelijke woorden van alle leerlingen."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Top num_top_words woorden voor woordwolk."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s van %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Opslaan"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Jouw woorden waren:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} in totaal ingediende woorden."
