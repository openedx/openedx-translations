#: block.py:49
msgid "Display Name"
msgstr "نام نمایشی"

#: block.py:50
msgid "The display name for this component."
msgstr "نام نمایشی این مؤلفه"

#: block.py:55
msgid "Instructions"
msgstr "دستورالعمل‌ها"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"دستورالعمل‌هایی را اضافه کنید تا به زبان‌آموزان در درک نحوه استفاده از کلمه "
"ابری کمک کنید. دستورالعمل‌های واضح، به‌ویژه برای یادگیرندگانی که شرایط "
"دسترسی دارند، مهم هستند."

#: block.py:63
msgid "Inputs"
msgstr "ورودی ها"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr "تعداد کادرهای متنی در دسترس زبان آموزان برای افزودن کلمات و جملات."

#: block.py:70
msgid "Maximum Words"
msgstr "حداکثر کلمات"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "حداکثر تعداد کلمات نمایش داده شده در ابر کلمه تولید شده."

#: block.py:77
msgid "Show Percents"
msgstr "نمایش درصدها"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "آمار برای کلمات وارد شده در نزدیکی آن کلمه نشان داده می شود."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "آیا این یادگیرنده کلماتی را در ابر پست کرده است یا خیر."

#: block.py:87
msgid "Student answer."
msgstr "پاسخ دانش آموز"

#: block.py:88
msgid "All possible words from all learners."
msgstr "تمام کلمات ممکن از همه زبان آموزان."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "کلمات num_top_word برتر برای ابر کلمه."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s از %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "ذخیره"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "حرف شما این بود:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} کل کلمات ارسال شده‌اند."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "text_word_ {uniqueId} title_word_ {uniqueId}"

