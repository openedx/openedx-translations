#: block.py:49
msgid "Display Name"
msgstr "Visningsnavn"

#: block.py:50
msgid "The display name for this component."
msgstr "Visningsnavnet for denne komponent."

#: block.py:55
msgid "Instructions"
msgstr "Instruktioner"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Tilføj instruktioner for at hjælpe eleverne med at forstå, hvordan man "
"bruger ordskyen. Tydelige instruktioner er vigtige, især for elever, der har"
" behov for tilgængelighed."

#: block.py:63
msgid "Inputs"
msgstr "Input"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Antallet af tekstbokse, der er tilgængelige for eleverne til at tilføje ord "
"og sætninger."

#: block.py:70
msgid "Maximum Words"
msgstr "Maks. antal ord"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Det maksimale antal ord, der vises i den genererede ordsky."

#: block.py:77
msgid "Show Percents"
msgstr "Vis procent"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "Der vises statistik for indtastede ord i nærheden af det ord."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Om denne elev har lagt ord til skyen."

#: block.py:87
msgid "Student answer."
msgstr "Besvarelse."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Alle mulige ord fra alle elever."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Top num_top_words ord til ord-sky."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Gem"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Dine ord var:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} indsendte ord i alt."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "tekst_ord_{uniqueId} title_word_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "title_word_{uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "tekst_ord_{uniqueId}"
