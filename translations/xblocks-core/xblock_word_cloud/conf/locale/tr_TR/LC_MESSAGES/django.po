#: block.py:49
msgid "Display Name"
msgstr "Görünen Ad"

#: block.py:50
msgid "The display name for this component."
msgstr "Bu bileşen için gösterilecek ad."

#: block.py:55
msgid "Instructions"
msgstr "Talimatlar"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Öğrencilere kelime bulutunu nasıl kullanacaklarına dair yönergeler ekleyin. "
"Anlaşılır yönergeler, özellikle erişilebilirlik sorunu olan engelli "
"öğrenciler için son derece önemlidir."

#: block.py:63
msgid "Inputs"
msgstr "Girdiler"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Öğrencilerin kelime ve cümle eklemeleri için mevcut olan metin kutularının "
"sayısı."

#: block.py:70
msgid "Maximum Words"
msgstr "Maksimum Kelime"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Oluşturulan kelime bulutunda gösterilecek maksimum kelime sayısı. "

#: block.py:77
msgid "Show Percents"
msgstr "Yüzdelikleri Göster"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "Girilen kelimeye yakın olan kelime için gösterilen istatistikler."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Bu öğrencinin buluta kelime gönderip göndermediği."

#: block.py:87
msgid "Student answer."
msgstr "Öğrenci cevabı."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Tüm öğrencilerden gelen tüm mümkün kelimeler."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Kelime bulutu için en iyi num_top_words kelimeleri."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s / %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Kaydet"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Senin kelimelerin:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "Toplamda {start_strong}{total}{end_strong} kelime gönderildi."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "text_word_{uniqueId} title_word_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "title_word_{uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "text_word_{uniqueId}"
