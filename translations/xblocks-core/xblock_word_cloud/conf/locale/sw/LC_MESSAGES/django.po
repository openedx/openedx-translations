#: block.py:49
msgid "Display Name"
msgstr "Jina la Kuonyesha"

#: block.py:50
msgid "The display name for this component."
msgstr "Jina la onyesho la sehemu hii."

#: block.py:55
msgid "Instructions"
msgstr "Maagizo"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Ongeza maagizo ili kuwasaidia wanafunzi kuelewa jinsi ya kutumia neno wingu."
" Maagizo wazi ni muhimu, haswa kwa wanafunzi ambao wana mahitaji ya "
"ufikiaji."

#: block.py:63
msgid "Inputs"
msgstr "Ingizo"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Idadi ya masanduku ya maandishi yanayopatikana kwa wanafunzi ili kuongeza "
"maneno na sentensi."

#: block.py:70
msgid "Maximum Words"
msgstr "Upeo Maneno"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"Idadi ya juu zaidi ya maneno inayoonyeshwa kwenye wingu la maneno "
"lililozalishwa."

#: block.py:77
msgid "Show Percents"
msgstr "Onyesha Asilimia"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "Takwimu zinaonyeshwa kwa maneno yaliyoingizwa karibu na neno hilo."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Iwapo mwanafunzi huyu amechapisha maneno kwenye wingu."

#: block.py:87
msgid "Student answer."
msgstr "Jibu la mwanafunzi."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Maneno yote yanayowezekana kutoka kwa wanafunzi wote."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Maneno_ya_maneno_ya_juu_ya_maneno ya neno wingu."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Hifadhi"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Maneno yako yalikuwa:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr ""
"{start_strong} {total} {end_strong} maneno yaliyowasilishwa kwa jumla."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "maandishi_neno_ {uniqueId} title_word_ {uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "title_neno_{uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "neno_maandishi_{uniqueId}"
