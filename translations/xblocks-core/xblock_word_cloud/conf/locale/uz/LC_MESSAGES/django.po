#: block.py:50
msgid "Display Name"
msgstr "Ko‘rsatiladigan ism"

#: block.py:51
msgid "The display name for this component."
msgstr "Ushbu komponent uchun ko'rsatiladigan nom."

#: block.py:56
msgid "Instructions"
msgstr "Ko'rsatmalar"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"O'quvchilarga bulut so'zidan qanday foydalanishni tushunishlariga yordam "
"berish uchun ko'rsatmalar qo'shing. Aniq ko'rsatmalar, ayniqsa foydalanish "
"imkoniyatiga ega bo'lgan o'quvchilar uchun muhimdir."

#: block.py:64
msgid "Inputs"
msgstr "Kirishlar"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"O'quvchilar so'z va jumlalarni qo'shishlari mumkin bo'lgan matn qutilari "
"soni."

#: block.py:71
msgid "Maximum Words"
msgstr "Maksimal so'zlar"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Yaratilgan so'z bulutida ko'rsatiladigan so'zlarning maksimal soni."

#: block.py:78
msgid "Show Percents"
msgstr "Foizlarni ko'rsatish"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Ushbu so'z yaqinidagi kiritilgan so'zlar uchun statistika ko'rsatiladi."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Bu oʻquvchi soʻzlarni bulutga joylashtirganmi yoki yoʻqmi."

#: block.py:88
msgid "Student answer."
msgstr "Talaba javobi."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Barcha o'quvchilarning barcha mumkin bo'lgan so'zlari."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Soʻz buluti uchun eng yaxshi soʻzlar soni."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Saqlash"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Sizning so'zlaringiz:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} jami yuborilgan so'zlar."
