#: block.py:50
msgid "Display Name"
msgstr "འཆར་མིང་།"

#: block.py:51
msgid "The display name for this component."
msgstr "གྲུབ་ཆ་འདིའི་འཆར་རྒྱུའི་མིང་།"

#: block.py:56
msgid "Instructions"
msgstr "བཀོད་སྒྲིག་"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"སློབ་གཉེར་བ་རྣམས་སྤྲིན་སྟེགས་ཀྱི་ཐ་སྙད་བཀོལ་སྤྱོད་ཚུལ་ཤེས་ཕྱིར་མཛུབ་སྟོན་ཁ་སྣོན་བྱོས།"
" མཛུབ་སྟོན་གསལ་བོ་བྱེད་ནི་གལ་འགངས་ཤིན་ཏུ་ཆེ་ཞིང་། "
"ཁྱད་པར་དུ་སློབ་སྤྱོང་གི་མཁོ་ཆས་རིགས་བཀོལ་སྤྱོད་ཀྱི་ཆོག་མཆན་ཡོད་པའི་གཉེར་བ་ལ་ལྷག་པར་དུ་མཁོ།"

#: block.py:64
msgid "Inputs"
msgstr "ནང་འཇུག་ཁག"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr "སློབ་གཉེར་བས་ཚིག་དང་ཚིག་གྲུབ་རེ་ཟུང་འབྲི་སའི་འབྲི་སྒམ་འགའ་ཤས་བཞག་ཡོད།"

#: block.py:71
msgid "Maximum Words"
msgstr "ཡིག་འབྲུའི་མང་མཐའ།"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"ད་ལྟ་བཟོས་པའི་ཡིག་འབྲུ་སྤྲིན་ཕུང་ནང་སྟོན་རྒྱུའི་ཆེས་མང་མཐའི་ཡིག་འབྲུའི་གྲངས།"

#: block.py:78
msgid "Show Percents"
msgstr "བརྒྱ་ཆ་སྟོན།"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "ནང་འཇུག་བྱས་པའི་ཡིག་འབྲུ་དེའི་འགྲམ་ལ་དེའི་བསྡོམས་རྩིས་ཀྱི་གྲངས་སྟོན།"

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "སློབ་གཉེར་བས་སྤྲིན་མཛོད་ནང་ཡིག་འབྲུ་འཇུག་བྱས་ཡོད་དམ།"

#: block.py:88
msgid "Student answer."
msgstr "སློབ་མའི་དྲི་ལན།"

#: block.py:89
msgid "All possible words from all learners."
msgstr "སློབ་གཉེར་བ་ཡོངས་ཀྱིས་བཀོལ་སྲིད་པའི་ཡིག་འབྲུ་ཁག"

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "ཡིག་འབྲུ་སྤྲིན་མཛོད་ཀྱི་ཡིག་འབྲུ་རྣམས་ Top num_top_words"

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s ནས་ %(num_inputs)s བར།\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "ཉར་ཚགས།"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "ཁྱེད་ཀྱི་མིང་ཚིག་དག་ནི་"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} words submitted in total."
