#: block.py:49
msgid "Display Name"
msgstr "Nombre para mostrar"

#: block.py:50
msgid "The display name for this component."
msgstr "El nombre para mostrar de este componente."

#: block.py:55
msgid "Instructions"
msgstr "Instrucciones"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Añada instrucciones para ayudar a los alumnos a entender cómo utilizar la "
"palabra nube. Las instrucciones claras son importantes, especialmente para "
"los estudiantes que tienen requisitos de accesibilidad."

#: block.py:63
msgid "Inputs"
msgstr "Entradas"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"La cantidad de cuadros de texto disponibles para que los alumnos agreguen "
"palabras y oraciones."

#: block.py:70
msgid "Maximum Words"
msgstr "Máximo de palabras"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"El número máximo de palabras que se muestran en la nube de palabras "
"generada."

#: block.py:77
msgid "Show Percents"
msgstr "Mostrar porcentajes"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Las estadísticas se muestran para las palabras introducidas que están cerca "
"de esa palabra."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Si este alumno ha publicado palabras en la nube."

#: block.py:87
msgid "Student answer."
msgstr "Respuesta del alumno."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Todas las palabras posibles de todos los alumnos."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Máximo num_top_words para la nube de palabras."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s de %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Guardar"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Sus palabras fueron:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} palabras enviadas en total."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "text_word_{uniqueId} title_word_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "title_word_{uniqueId}"

#: static/js/src/word_cloud.js:277
