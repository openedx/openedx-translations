#: block.py:50
msgid "Display Name"
msgstr "Tên hiển thị"

#: block.py:51
msgid "The display name for this component."
msgstr "Tên hiển thị cho thành phần này."

#: block.py:56
msgid "Instructions"
msgstr "Hướng dẫn"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Thêm hướng dẫn để giúp người học hiểu cách sử dụng đám mây từ. Hướng dẫn rõ "
"ràng rất quan trọng, đặc biệt đối với những người học có yêu cầu về khả năng"
" tiếp cận."

#: block.py:64
msgid "Inputs"
msgstr "Đầu vào"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr "Số lượng hộp văn bản có sẵn để người học thêm từ và câu."

#: block.py:71
msgid "Maximum Words"
msgstr "Số từ tối đa"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Số lượng từ tối đa được hiển thị trong đám mây từ được tạo."

#: block.py:78
msgid "Show Percents"
msgstr "Hiển thị phần trăm"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "Thống kê được hiển thị cho các từ đã nhập gần từ đó."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Liệu người học này đã đăng từ lên đám mây hay chưa."

#: block.py:88
msgid "Student answer."
msgstr "Câu trả lời của học sinh."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Tất cả các từ có thể từ tất cả người học."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Từ num_top_words hàng đầu cho đám mây từ."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s trong tổng số %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Lưu"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Lời nói của bạn là:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "Tổng cộng {start_strong} {total} {end_strong} từ đã gửi."
