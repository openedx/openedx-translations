#: block.py:49
msgid "Display Name"
msgstr "Nome"

#: block.py:50
msgid "The display name for this component."
msgstr "O nome exibido para este componente."

#: block.py:55
msgid "Instructions"
msgstr "Instruções"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Adicione instruções para ajudar os estudantes a entender como usar a nuvem "
"de palavras. Instruções claras são importantes, especialmente para "
"estudantes que possuem requisitos de acessibilidade."

#: block.py:63
msgid "Inputs"
msgstr "Entradas"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"O número de caixas de texto disponíveis para que os estudantes adicionem "
"palavras e frases."

#: block.py:70
msgid "Maximum Words"
msgstr "Máximo de palavras"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "O número máximo de palavras exibidas na nuvem de palavras gerada."

#: block.py:77
msgid "Show Percents"
msgstr "Mostrar percentagens"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr ""
"São mostradas estatísticas para palavras introduzidas perto dessa palavra."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Se este estudante publicou palavras na nuvem."

#: block.py:87
msgid "Student answer."
msgstr "Resposta do estudante."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Todas as palavras possíveis de todos os estudantes."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Top de palavras num_top_words para nuvem de palavras."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s de %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Guardar"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "As suas palavras foram:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong}{total}{end_strong} palavras apresentadas no total."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "texto_palavra_{uniqueId} título_palavra_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "título_palavra_{uniqueId}"

