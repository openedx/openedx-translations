#: block.py:49
msgid "Display Name"
msgstr "Wyświetlana nazwa"

#: block.py:50
msgid "The display name for this component."
msgstr "Nazwa wyświetlana tego komponentu."

#: block.py:55
msgid "Instructions"
msgstr "Instrukcje"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Dodaj instrukcje, które pomogą uczniom zrozumieć, jak używać chmury słów. "
"Jasne instrukcje są ważne, zwłaszcza dla uczniów, którzy mają wymagania "
"dotyczące dostępności."

#: block.py:63
msgid "Inputs"
msgstr "Wejścia"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Liczba pól tekstowych dostępnych dla uczniów, w których mogą dodawać słowa i"
" zdania."

#: block.py:70
msgid "Maximum Words"
msgstr "Maksymalna liczba słów"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Maksymalna liczba słów wyświetlana w wygenerowanej chmurze słów."

#: block.py:77
msgid "Show Percents"
msgstr "Pokaż procenty"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr ""
"Statystyki są wyświetlane dla słów wprowadzonych w pobliżu tego słowa."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Czy ten uczeń wprowadził słowa do chmury."

#: block.py:87
msgid "Student answer."
msgstr "Odpowiedź studenta."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Wszystkie możliwe słowa od wszystkich uczniów."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Najpopularniejsze słowa w chmurze słów: num_top_words."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s z %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Zapisz"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Twoje słowa brzmiały:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "W sumie {start_strong}{total}{end_strong} słów."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "tekst_słowo_{uniqueId} tytuł_słowo_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "tytuł_słowo_{uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "tekst_słowo_{uniqueId}"
