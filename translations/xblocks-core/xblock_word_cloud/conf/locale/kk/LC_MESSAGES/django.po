#: block.py:49
msgid "Display Name"
msgstr "Көрсетілетін атау"

#: block.py:50
msgid "The display name for this component."
msgstr "Осы құрамдас үшін көрсетілетін атау."

#: block.py:55
msgid "Instructions"
msgstr "Нұсқаулар"

#: block.py:57
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Оқушыларға бұлт сөзін қалай пайдалану керектігін түсінуге көмектесу үшін "
"нұсқауларды қосыңыз. Нұсқаулардың анық болуы, әсіресе қолжетімділік "
"талаптары бар оқушылар үшін маңызды."

#: block.py:63
msgid "Inputs"
msgstr "Кірістері"

#: block.py:64
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Оқушыларға сөздер мен сөйлемдерді қосу үшін қолжетімді мәтін ұяларының саны."

#: block.py:70
msgid "Maximum Words"
msgstr "Максималды сөздер"

#: block.py:71
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Жасалған сөз бұлтында көрсетілетін сөздердің максималды саны."

#: block.py:77
msgid "Show Percents"
msgstr "Проценттерді көрсету"

#: block.py:78
msgid "Statistics are shown for entered words near that word."
msgstr "Осы сөздің жанында енгізілген сөздер үшін статистика көрсетіледі."

#: block.py:85
msgid "Whether this learner has posted words to the cloud."
msgstr "Оқушы бұлтқа сөздерді жариялады ма."

#: block.py:87
msgid "Student answer."
msgstr "Оқушы жауабы."

#: block.py:88
msgid "All possible words from all learners."
msgstr "Барлық оқушылардан барлық мүмкін сөздер."

#: block.py:89
msgid "Top num_top_words words for word cloud."
msgstr "Сөз бұлтындағы ең көп_сөздердің_саны."

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Сақтау"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Сіздің сөздеріңіз болды:"

#: static/js/src/word_cloud.js:218
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} барлығы жіберілген сөздер."

#: static/js/src/word_cloud.js:245
msgid "text_word_{uniqueId} title_word_{uniqueId}"
msgstr "text_word_{uniqueId} title_word_{uniqueId}"

#: static/js/src/word_cloud.js:255
msgid "title_word_{uniqueId}"
msgstr "title_word_{uniqueId}"

#: static/js/src/word_cloud.js:277
msgid "text_word_{uniqueId}"
msgstr "text_word_{uniqueId}"
