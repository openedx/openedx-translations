#: block.py:50
msgid "Display Name"
msgstr "Vertoon Naam"

#: block.py:51
msgid "The display name for this component."
msgstr "Die vertoonnaam vir hierdie komponent."

#: block.py:56
msgid "Instructions"
msgstr "Instruksies"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Voeg instruksies by om leerders te help verstaan hoe om die woordwolk te "
"gebruik. Duidelike instruksies is belangrik, veral vir leerders wat "
"toeganklikheidsvereistes het."

#: block.py:64
msgid "Inputs"
msgstr "Insette"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Die aantal tekskassies beskikbaar vir leerders om woorde en sinne by te "
"voeg."

#: block.py:71
msgid "Maximum Words"
msgstr "Maksimum woorde"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"Die maksimum aantal woorde wat in die gegenereerde woordwolk vertoon word."

#: block.py:78
msgid "Show Percents"
msgstr "Wys persentasies"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "Statistieke word gewys vir ingevoerde woorde naby daardie woord."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Of hierdie leerder woorde in die wolk geplaas het."

#: block.py:88
msgid "Student answer."
msgstr "Studente antwoord."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Alle moontlike woorde van alle leerders."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Top num_top_words woorde vir woordwolk."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s van %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Stoor"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Jou woorde was:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} woorde in totaal ingedien."
