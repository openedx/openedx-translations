#: block.py:50
msgid "Display Name"
msgstr "Parādāmais nosaukums"

#: block.py:51
msgid "The display name for this component."
msgstr "Šī komponenta parādāmais nosaukums."

#: block.py:56
msgid "Instructions"
msgstr "Instrukcija"

#: block.py:58
msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"Pievienojiet instrukcijas, lai palīdzētu dalībniekiem saprast, kā izmantot "
"vārdu mākoni. Skaidras instrukcijas ir svarīgas, jo īpaši dalībniekiem, "
"kuriem ir piekļuves prasības."

#: block.py:64
msgid "Inputs"
msgstr "Ievades"

#: block.py:65
msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr ""
"Tekstlodziņu skaits, kas dalībniekiem ir pieejams vārdu un teikumu "
"pievienošanai."

#: block.py:71
msgid "Maximum Words"
msgstr "Maksimālais vārdu skaits"

#: block.py:72
msgid "The maximum number of words displayed in the generated word cloud."
msgstr "Maksimālais vārdu skaits, kas tiek parādīts ģenerētajā vārdu mākonī."

#: block.py:78
msgid "Show Percents"
msgstr "Rādīt procentus"

#: block.py:79
msgid "Statistics are shown for entered words near that word."
msgstr "Statistika tiek rādīta par ievadītajiem vārdiem šī vārda tuvumā."

#: block.py:86
msgid "Whether this learner has posted words to the cloud."
msgstr "Vai šis kursa dalībnieks ir ievietojis vārdus mākonī."

#: block.py:88
msgid "Student answer."
msgstr "Dalībnieku atbilde."

#: block.py:89
msgid "All possible words from all learners."
msgstr "Visi iespējamie vārdi no visiem dalībniekiem."

#: block.py:90
msgid "Top num_top_words words for word cloud."
msgstr "Populārākie vārdu_skaitlis_vārdu_mākonis."

#: templates/word_cloud.html:28
#, python-format
msgid ""
"\n"
"                            %(num)s of %(num_inputs)s\n"
"                        "
msgstr ""
"\n"
"                            %(num)s no %(num_inputs)s\n"
"                        "

#: templates/word_cloud.html:39
msgid "Save"
msgstr "Saglabāt"

#: templates/word_cloud.html:46
msgid "Your words were:"
msgstr "Tavi vārdi bija:"

#: static/js/src/word_cloud.js:227
msgid "{start_strong}{total}{end_strong} words submitted in total."
msgstr "{start_strong} {total} {end_strong} kopā iesniegtie vārdi."
