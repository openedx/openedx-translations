#: block.py:24
msgid "Display Name"
msgstr "Görünen Ad"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "Bu ad, sayfanın üst kısmındaki yatay gezinme alanında görünür."

#: block.py:31
msgid "PDF URL"
msgstr "PDF URL"

#: block.py:34
msgid "The URL for your PDF."
msgstr "PDF'niz için URL."

#: block.py:38
msgid "PDF Download Allowed"
msgstr "PDF İndirmeye İzin Veriliyor"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Bu PDF dosyası için bir indirme düğmesi göster."

#: block.py:45
msgid "Source document button text"
msgstr "Kaynak belge düğmesi metni"

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"PDF'nizin kaynak dosyası için bir indirme bağlantısı ekleyin. Örneğin, bu "
"PDF'yi oluşturmak için kullanılan PowerPoint dosyasını sağlamak için "
"kullanın. "

#: block.py:55
msgid "Source document URL"
msgstr "Kaynak belge URL'i"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "PDF'yi İndir"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr "(İndirme bağlantısına sağ tıklayın veya uzun basıp şunu seçin: \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Kaynak belgeyi indir"
