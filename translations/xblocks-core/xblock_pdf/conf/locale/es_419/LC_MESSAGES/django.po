#: block.py:24
msgid "Display Name"
msgstr "Nombre a mostrar"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr ""
"Este nombre aparece en la navegación horizontal en la parte superior de la "
"página."

#: block.py:31
msgid "PDF URL"
msgstr "URL del PDF"

#: block.py:34
msgid "The URL for your PDF."
msgstr "La URL para su PDF"

#: block.py:38
msgid "PDF Download Allowed"
msgstr "Descarga permitida del PDF"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Mostrar un botón de descarga para este PDF."

#: block.py:45
msgid "Source document button text"
msgstr "Texto del botón del documento de origen."

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"Añada un enlace de descarga para el archivo de origen de su PDF. Úselo, por "
"ejemplo, para proporcionar el archivo PowerPoint usado para crear este PDF."

#: block.py:55
msgid "Source document URL"
msgstr "URL del documento fuente"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "Descargar el PDF"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr ""
"(Haz clic con el botón secundario o mantén presionado el enlace de descarga "
"y selecciona \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Descargar el documento de fuente"
