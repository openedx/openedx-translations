#: block.py:24
msgid "Display Name"
msgstr "Ko‘rsatiladigan ism"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr ""
"Ushbu nom sahifaning yuqori qismidagi gorizontal navigatsiyada ko‘rinadi."

#: block.py:31
msgid "PDF URL"
msgstr "PDF URL"

#: block.py:32
msgid "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"
msgstr "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"

#: block.py:34
msgid "The URL for your PDF."
msgstr "PDF faylingiz uchun URL."

#: block.py:38
msgid "PDF Download Allowed"
msgstr "PDF yuklab olishga ruxsat berilgan"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Ushbu PDF uchun yuklab olish tugmasini ko‘rsatish."

#: block.py:45
msgid "Source document button text"
msgstr "Manba hujjati tugmasi matni"

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"PDF manba faylingiz uchun yuklab olish havolasini qoʻshing. Masalan, ushbu "
"PDFni yaratish uchun ishlatilgan PowerPoint faylini taqdim etish uchun "
"foydalaning."

#: block.py:55
msgid "Source document URL"
msgstr "Manba hujjati URL manzili"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "PDF faylni yuklab olish"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr ""
"(Yuklab olish havolasini sichqonchaning o'ng tugmasi bilan bosing yoki uzoq "
"bosib turing va quyidagini tanlang: \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Asosiy hujjatni yuklab olish"
