#: block.py:24
msgid "Display Name"
msgstr "Tên hiển thị"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "Tên này xuất hiện trong điều hướng ngang ở đầu trang."

#: block.py:31
msgid "PDF URL"
msgstr "URL của PDF"

#: block.py:32
msgid "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"
msgstr "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"

#: block.py:34
msgid "The URL for your PDF."
msgstr "URL cho tệp PDF của bạn."

#: block.py:38
msgid "PDF Download Allowed"
msgstr "Cho phép tải xuống PDF"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Hiển thị nút tải xuống cho tệp PDF này."

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"Thêm liên kết tải xuống cho tệp nguồn của PDF của bạn. Ví dụ: sử dụng liên "
"kết này để cung cấp tệp PowerPoint đã dùng để tạo PDF này."

#: block.py:55
msgid "Source document URL"
msgstr "URL tài liệu nguồn"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "Tải tệp PDF xuống"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr "(Nhấp chuột phải hoặc nhấn giữ vào liên kết tải xuống và chọn \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Tải tài liệu gốc"
