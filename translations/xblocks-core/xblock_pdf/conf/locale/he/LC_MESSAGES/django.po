msgid "Display Name"
msgstr "שם לתצוגה"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "שם זה מופיע בתפריט הניווט בחלק העליון של העמוד."

#: block.py:31
msgid "PDF URL"
msgstr "כתובת URL של PDF"

#: block.py:32
msgid "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"
