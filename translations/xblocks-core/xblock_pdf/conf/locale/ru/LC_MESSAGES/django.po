#: block.py:24
msgid "Display Name"
msgstr "Отображаемое имя"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "Данное имя отображается в горизонтальной навигации вверху страницы."

#: block.py:31
msgid "PDF URL"
msgstr "PDF URL"

#: block.py:34
msgid "The URL for your PDF."
msgstr "URL-адрес вашего PDF-файла."

#: block.py:38
msgid "PDF Download Allowed"
msgstr "Разрешить скачивание PDF"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Отобразите кнопку загрузки для этого PDF-файла."

#: block.py:45
msgid "Source document button text"
msgstr "Текст кнопки исходного документа"

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"Добавьте ссылку для скачивания исходного файла вашего PDF-файла. Используйте"
" его, например, чтобы предоставить файл PowerPoint, используемый для "
"создания этого PDF-файла."

#: block.py:55
msgid "Source document URL"
msgstr "URL исходного документа"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "Скачать PDF"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr ""
"(Нажмите правой кнопкой мыши или удерживайте ссылку для скачивания и "
"выберите \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Скачать исходный документ"
