#: block.py:24
msgid "Display Name"
msgstr "Görünüş adı"

#: block.py:25
msgid "PDF"
msgstr "PDF"

#: block.py:27
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr "Bu ad səhifənin yuxarı hissəsindəki üfüqi naviqasiyada görünür."

#: block.py:31
msgid "PDF URL"
msgstr "PDF URL"

#: block.py:32
msgid "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"
msgstr "https://tutorial.math.lamar.edu/pdf/Trig_Cheat_Sheet.pdf"

#: block.py:34
msgid "The URL for your PDF."
msgstr "PDF üçün URL."

#: block.py:38
msgid "PDF Download Allowed"
msgstr "PDF yükləməsinə icazə verilir"

#: block.py:41
msgid "Display a download button for this PDF."
msgstr "Bu PDF üçün endirmə düyməsini göstərin."

#: block.py:45
msgid "Source document button text"
msgstr "Mənbə sənəd düyməsinin mətni"

#: block.py:49 block.py:59
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"PDF faylınızın mənbə faylı üçün endirmə keçidi əlavə edin. Məsələn, bunu bu "
"PDF-i yaratmaq üçün istifadə olunan PowerPoint faylını təqdim etmək üçün "
"istifadə edin."

#: block.py:55
msgid "Source document URL"
msgstr "Mənbə sənədinin URL-i"

#: templates/html/pdf.html:11
msgid "Download the PDF"
msgstr "PDF faylını yükləyin"

#: templates/html/pdf.html:12
msgid "(Right click or long press on the download link and select the \\"
msgstr "(Yükləmə linkinə sağ klikləyin və ya uzun müddət basın, sonra seçin \\"

#: templates/html/pdf.html:17
msgid "Download the source document"
msgstr "Mənbə sənədini yüklə"
