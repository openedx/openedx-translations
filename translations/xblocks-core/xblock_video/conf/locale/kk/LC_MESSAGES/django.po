#: block.py:142
msgid "Basic"
msgstr "Негізгі"

#: block.py:143
msgid "Advanced"
msgstr "Жетілдірілген"

#: block.py:572
#, python-brace-format
msgid "There is no transcript file associated with the {lang} language."
msgid_plural ""
"There are no transcript files associated with the {lang} languages."
msgstr[0] "Транскрипт файлы {lang} тілімен байланыстырылмаған."
msgstr[1] "{lang} тілдерімен байланыстырылған транскрипт файлдары жоқ."

#: block.py:828
msgid ""
"The URL for your video. This can be a YouTube URL or a link to an .mp4, "
".ogg, or .webm video file hosted elsewhere on the Internet."
msgstr ""
"Бейнеңіздің URL мекенжайы. Бұл YouTube URL мекенжайы немесе Интернетте басқа"
" жерде орналастырылған .mp4, .ogg немесе .webm бейне файлына сілтеме болуы "
"мүмкін."

#: block.py:831
msgid "Default Video URL"
msgstr "Әдепкі бейне URL мекенжайы"

#: mixin.py:29
msgid "License"
msgstr "Лицензия"

#: mixin.py:30
msgid ""
"A license defines how the contents of this block can be shared and reused."
msgstr ""
"Лицензия осы блоктың мазмұнын қалай бөлісуге және қайта пайдалануға "
"болатындығын анықтайды."

#: templates/video.html:23
msgid "Loading video player"
msgstr "Бейне ойнатқыш жүктелуде"

#: templates/video.html:25 assets/js/src/09_poster.js:25
msgid "Play video"
msgstr "Бейнені ойнату"

#: templates/video.html:29
msgid "No playable video sources found."
msgstr "Ойнатуға болатын бейне көздері табылмады."

#: templates/video.html:31
msgid ""
"Your browser does not support this video format. Try using a different "
"browser."
msgstr ""
"Сіздің браузеріңіз бұл бейне пішімін қолдамайды. Басқа браузерді пайдаланып "
"көріңіз."

#: templates/video.html:52
msgid "Downloads and transcripts"
msgstr "Жүктеулер мен транскрипттер"

#: templates/video.html:56
msgid "Video"
msgstr "Бейне"

#: templates/video.html:62
msgid "Download video file"
msgstr "Бейне файлды жүктеп алыңыз"

#: templates/video.html:71 templates/video.html:74
msgid "Share this video"
msgstr "Осы бейнені бөлісіңіз"

#: templates/video.html:104
#, python-format
msgid "Share on %(site)s"
msgstr "%(site)s арқылы бөлісіңіз"

#: templates/video.html:116
msgid "Copy"
msgstr "Көшіру"

#: templates/video.html:126
msgid "Transcripts"
msgstr "Транскрипт"

#: templates/video.html:134
#, python-format
msgid "Download %(file)s"
msgstr "%(file)s жүктеп алыңыз"

#: templates/video.html:140
msgid "Download transcript"
msgstr "Транскриптті жүктеп алыңыз"

#: templates/video.html:146
msgid "Handouts"
msgstr "Үлестірмелі материалдар"

#: templates/video.html:147
