#: block.py:572
#, python-brace-format
msgid "There is no transcript file associated with the {lang} language."
msgid_plural ""
"There are no transcript files associated with the {lang} languages."
msgstr[0] ""
"Δεν υπάρχει αρχείο μεταγραφής που να σχετίζεται με τη γλώσσα {lang}."
msgstr[1] ""
"Δεν υπάρχουν αρχεία μεταγραφής που να σχετίζονται με τις γλώσσες {lang}."

#: block.py:828
msgid ""
"The URL for your video. This can be a YouTube URL or a link to an .mp4, "
".ogg, or .webm video file hosted elsewhere on the Internet."
msgstr ""
"Το URL για το βίντεό σας. Αυτό μπορεί να είναι μια διεύθυνση URL του YouTube"
" ή ένας σύνδεσμος προς ένα αρχείο βίντεο .mp4, .ogg ή .webm που φιλοξενείται"
" αλλού στο Διαδίκτυο."

#: block.py:831
msgid "Default Video URL"
msgstr "Προεπιλεγμένη διεύθυνση URL βίντεο"

#: mixin.py:29
msgid "License"
msgstr "Άδεια"

#: mixin.py:30
msgid ""
"A license defines how the contents of this block can be shared and reused."
msgstr ""
"Μια άδεια καθορίζει πώς το περιεχόμενο αυτού του μπλοκ μπορεί να μοιραστεί "
"και να επαναχρησιμοποιηθεί."

#: templates/video.html:23
