msgid_plural ""
"There are no transcript files associated with the {lang} languages."
msgstr[0] "{lang} ენასთან ასოცირებული სუბტიტრის ფაილები ვერ მოიძებნა."
msgstr[1] "{lang} ენასთან ასოცირებული სუბტიტრის ფაილები ვერ მოიძებნა."

#: block.py:812
