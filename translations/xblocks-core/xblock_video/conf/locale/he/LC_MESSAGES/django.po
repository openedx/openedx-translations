#: assets/js/src/00_i18n.js:18 assets/js/src/07_video_volume_control.js:70
msgid "Volume"
msgstr "עוצמת הקול"

#. Translators: Volume level equals 0%.
#: assets/js/src/00_i18n.js:20
msgid "Muted"
msgstr "מושתק"

#. Translators: Volume level in range ]0,20]%
#: assets/js/src/00_i18n.js:22
msgid "Very low"
msgstr "נמוך מאד"

#. Translators: Volume level in range ]20,40]%
#: assets/js/src/00_i18n.js:24
msgid "Low"
msgstr "נמוך"

#. Translators: Volume level in range ]40,60]%
#: assets/js/src/00_i18n.js:26
