#: assets/js/src/02_html5_video.js:82
msgid "This browser cannot play .mp4, .ogg, or .webm files."
msgstr "این مرورگر نمی‌تواند فایل‌های mp4، .ogg یا webm. را پخش کند."

#: assets/js/src/02_html5_video.js:83
msgid "Try using a different browser, such as Google Chrome."
msgstr "سعی کنید از مرورگر دیگری مانند Google Chrome استفاده کنید."

#: assets/js/src/05_video_quality_control.js:22
msgid "High Definition"
