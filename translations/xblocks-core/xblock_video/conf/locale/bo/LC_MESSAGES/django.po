#: block.py:556
#, python-brace-format
msgid "There is no transcript file associated with the {lang} language."
msgid_plural ""
"There are no transcript files associated with the {lang} languages."
msgstr[0] "{lang} སྐད་ཡིག་དང་མཉམ་སྦྱར་བྱས་པའི་བརྙན་ཡིག་ཅིག་མི་འདུག།"

#: block.py:812
msgid ""
"The URL for your video. This can be a YouTube URL or a link to an .mp4, "
".ogg, or .webm video file hosted elsewhere on the Internet."
msgstr ""
"ཁྱེད་ཀྱི་བརྙན་གྱི་དྲ་ཐག འདི་ནི YouTube ཀྱི་དྲ་ཐག་ཡིན་པ་དང་ཡང་ན། "
"བརྙན་གྱི་རྣམ་སྒྲིག་ .mp4, .ogg, or .webm ཡི་བརྙན་དང་འབྲེལ་བ་ཡོད་པ་གང་ཞིག "
"དྲ་ལམ་གཞན་ནས་བླངས་པ་ཡང་ཡིན་ཆོག།"

#: block.py:815
msgid "Default Video URL"
msgstr "བརྙན་གྱི་རྩ་བའི་དྲ་ཐག"

#: mixin.py:29
msgid "License"
msgstr "ཆོག་མཆན།"

#: mixin.py:30
msgid ""
"A license defines how the contents of this block can be shared and reused."
msgstr ""
"ཆོག་མཆན་གྱིས་སྡེ་ཚན་འདིའི་ནང་དོན་བརྒྱུད་སྐུར་དང་བསྐྱར་དུ་བཀོལ་ཚུལ་བཅས་ལ་འགྲེལ་བརྗོད་བྱེད།"

