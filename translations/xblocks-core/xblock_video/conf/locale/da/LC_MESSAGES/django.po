msgstr "Valgfri, til ældre browsere: YouTube ID for .75x hastighed."

#: video_xfields.py:41
msgid "YouTube ID for .75x speed"
msgstr "YouTube ID for .75x hastighed"

#: video_xfields.py:46
msgid ""
