msgstr "Vị trí video. Nhấn phím cách để chuyển đổi phát lại"

#: assets/js/src/06_video_progress_slider.js:299
msgid "Video ended"
msgstr "Video đã kết thúc"

#: assets/js/src/06_video_progress_slider.js:303
msgid "Video position"
