msgstr "Bản ghi có mã ngôn ngữ &quot; {language_code} &quot; đã tồn tại."

#: video_handlers.py:382
msgid "A transcript file is required."
msgstr "Cần có một tập tin bảng điểm."

#: video_handlers.py:440 video_handlers.py:477
