#: block.py:235
msgid "Display Name"
msgstr "Megjelenített név"

#: block.py:236
msgid "The display name for this component."
msgstr "Ennek az összetevőnek a megjelenített neve."

#: block.py:240
msgid "Blank Problem"
msgstr "Üres feladat"

#: block.py:243
msgid "Number of attempts taken by the student on this problem"
msgstr "A diák által a feladat megoldására tett próbálkozások száma"

#: block.py:246
msgid "Maximum Attempts"
msgstr "Próbálkozások maximális száma"

#: block.py:248
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Meghatározza, hogy hányszor próbálkozhat a diák a feladat megoldásával. Ha "
"az érték nincs beállítva, végtelen próbálkozások engedélyezettek."

#: block.py:255
msgid "Grading Method"
msgstr "Osztályozási módszer"

#: block.py:257
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Határozza meg a feladat értékelési módszerét. Alapértelmezés szerint ez a "
"hallgató által benyújtott utolsó beküldés pontszáma."

#: block.py:263 block.py:558
msgid "Last Score"
msgstr "Utolsó pontszám"

#: block.py:264 block.py:559
msgid "First Score"
msgstr "Első pontszám"

#: block.py:265 block.py:560
msgid "Highest Score"
msgstr "Legmagasabb pontszám"

#: block.py:266 block.py:561
msgid "Average Score"
msgstr "Átlagos pontszám"

#: block.py:269
msgid "Date that this problem is due by"
msgstr "Feladat megoldásának esedékességi dátuma"

#: block.py:271
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "A határidő lejárta után mennyi ideig fogaható el a feladatbeadás"

#: block.py:274
msgid "Show Results"
msgstr "Eredmények megjelenítése"

#: block.py:276
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Meghatározza, hogy mikor kell megmutatni, hogy a tanuló a problémára adott "
"válasz helyes-e. Az alszakaszban konfigurálva."

#: block.py:281 block.py:292 block.py:336
msgid "Always"
msgstr "Mindig"

#: block.py:282 block.py:299 block.py:338
msgid "Never"
msgstr "Soha"

#: block.py:283 block.py:298
msgid "Past Due"
msgstr "Lejárt"

#: block.py:287
msgid "Show Answer"
msgstr "Válasz mutatása"

#: block.py:288
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Meghatározza, hogy mikor jelenjen meg a válasz a problémára. Az "
"alapértelmezett érték a Speciális beállításokban állítható be."

#: block.py:293
msgid "Answered"
msgstr "Megválaszolt"

#: block.py:294
msgid "Attempted or Past Due"
msgstr "Megpróbált vagy lejárt"

#: block.py:295
msgid "Closed"
msgstr "Lezárt"

#: block.py:296
msgid "Finished"
msgstr "Befejezve"

#: block.py:297
msgid "Correct or Past Due"
msgstr "Helyes vagy lejárt határidejű"

#: block.py:300
msgid "After Some Number of Attempts"
msgstr "Néhány próbálkozás után"

#: block.py:301
msgid "After All Attempts"
msgstr "Minden Próbálkozások után"

#: block.py:302
msgid "After All Attempts or Correct"
msgstr "Minden próbálkozások után vagy helyesen"

#: block.py:303
msgid "Attempted"
msgstr "Megpróbált"

#: block.py:307
msgid "Show Answer: Number of Attempts"
msgstr "Válasz megjelenítése: Próbálkozások száma"

#: block.py:309
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"A hallgatónak ennyiszer kell próbálkoznia a kérdés megválaszolásával, "
"mielőtt a \"Válasz megjelenítése\" gomb megjelenik."

#: block.py:316
msgid "Whether to force the save button to appear on the page"
msgstr "A mentés gomb mindenképpen megjelenjen-e az oldalon"

#: block.py:319
msgid "Show Reset Button"
msgstr "Mutasd a visszaállító gombot"

#: block.py:321
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Meghatározza, hogy megjelenjen-e egy „Visszaállítás” gomb, amely lehetővé "
"teszi a felhasználó számára a válasz visszaállítását. Alapértelmezett érték "
"beállítható a Speciális beállításokban."

#: block.py:328
msgid "Randomization"
msgstr "Véletlenszerűsítés"

#: block.py:330
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Meghatározza, mikor kell randomizálni a kapcsolódó Python szkriptben "
"megadott változókat. Azoknál a feladatoknál, amelyeknél nem randomizálják az"
" értékeket, adja meg, hogy \"Soha\". "

#: block.py:337
msgid "On Reset"
msgstr "Visszaállításkor"

#: block.py:339
msgid "Per Student"
msgstr "Tanulónként"

#: block.py:343
msgid "XML data for the problem"
msgstr "Feladat XML adatai"

#: block.py:349
msgid "Dictionary with the correctness of current student answers"
msgstr "A jelenlegi diák válaszainak helyességét tartalmazó szótár"

#: block.py:351
msgid "List of correctness maps for each attempt"
msgstr "A helyességi térképek listája minden próbálkozáshoz"

#: block.py:352
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Szótár az inputtípusok állapotának fenntartásához"

#: block.py:353
msgid "Dictionary with the current student responses"
msgstr "A jelenlegi diák válaszainak szótára"

#: block.py:355
msgid "List of student answers for each attempt"
msgstr "A diákok válaszainak listája minden próbálkozásra"

#: block.py:359
msgid "Dictionary with the current student score"
msgstr "A jelenlegi tanulói pontszámot tartalmazó szótár"

#: block.py:361
msgid "List of scores for each attempt"
msgstr "Az egyes próbálkozások pontszámainak listája"

#: block.py:364
msgid "Whether or not the answers have been saved since last submit"
msgstr "Mentve lettek a válaszok az utolsó beküldés óta?"

#: block.py:366
msgid "Whether the student has answered the problem"
msgstr "Hogy a diák megoldotta-e a feladatot"

#: block.py:367
msgid "Random seed for this student"
msgstr "A diák véletlenszerű magja"

#: block.py:368
msgid "Last submission time"
msgstr "Utolsó beadási idő"

#: block.py:370
msgid "Timer Between Attempts"
msgstr "Próbálkozások közötti várakozás"

#: block.py:371
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"A másodpercek száma, amennyit a diáknak várnia kell a beküldések között egy "
"több próbálkozásos feladat esetén."

#: block.py:376
msgid "Problem Weight"
msgstr "Feladat súlyozása"

#: block.py:378
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Meghatározza, hogy hány pontot ér egy-egy feladat. Ha az érték nincs "
"beállítva, a feladat minden válaszmezője egy pontot ér."

#: block.py:384
msgid "Markdown source of this module"
msgstr "Ennek a modulnak a Markdown forrása"

#: block.py:386
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr "LaTeX és Word problémák forráskódja. Ez a funkció nem jól támogatott."

#: block.py:388
msgid "Enable LaTeX templates?"
msgstr "Engedélyezed a LaTeX sablont?"

#: block.py:390
msgid "Matlab API key"
msgstr "Matlab API kulcs"

#: block.py:392
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Adja meg a MathWorks által biztosított API-kulcsot a MATLAB Hosted Service "
"eléréséhez. Ez a kulcs kizárólagos használatra van megadva ebben a kurzusban"
" a megadott időtartamra. Ne ossza meg az API-kulcsot más kurzusokkal. "
"Azonnal értesítse a MathWorks-t, ha úgy véli, hogy a kulcs kiszivárgott vagy"
" veszélybe került. Ha kulcsot szeretne szerezni a kurzusához, vagy problémát"
" szeretne jelenteni, kérjük, lépjen kapcsolatba a moocsupport@mathworks.com "
"címen."

#: block.py:401
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Jelzi, hogy a problémát a Markdown szerkesztővel módosították-e az Authoring"
" MFE-ben."

#: block.py:486
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Sajnáljuk, hiba történt a kérés feldolgozása során. Kérjük, próbálja meg "
"újratölteni az oldalt, és próbálja újra."

#: block.py:491
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"A probléma állapota változott, mióta betöltötte ezt az oldalt. Kérjük, "
"frissítse az oldalt."

#: block.py:811 block.py:828
msgid "Answer ID"
msgstr "Válasz ID"

#: block.py:812 block.py:829
msgid "Question"
msgstr "Kérdés"

#: block.py:813 block.py:830 capa/responsetypes.py:434
msgid "Answer"
msgstr "Válasz"

#: block.py:816
msgid "Correct Answer"
msgstr "Helyes válasz"

#: block.py:1062
msgid "Submit"
msgstr "Küldés"

#: block.py:1075
msgid "Submitting"
msgstr "Beküldés"

#: block.py:1197
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Figyelem: A probléma vissza lett állítva az eredeti állapotába!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1201
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"A probléma állapota egy érvénytelen beküldés miatt sérült. A beküldés a "
"következőkből állt:"

#: block.py:1208
msgid "If this error persists, please contact the course staff."
msgstr ""
"Ha ez a hiba továbbra is fennáll, kérjük, vegye fel a kapcsolatot a kurzus "
"személyzetével."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1263
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1269
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Tipp ({hint_num} a {hints_count}-ból): "

#: block.py:1350
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"A válaszait korábban elmentettük. Kattintson a(z) '{button_name}' gombra az "
"értékeléshez."

#: block.py:1426
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Helytelen ({progress} pont)"
msgstr[1] "Helytelen ({progress} pont)"

#: block.py:1429 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Helytelen"

#: block.py:1433
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Helyes ({progress} pont)"
msgstr[1] "Helyes ({progress} pont)"

#: block.py:1436 capa/capa_problem.py:754
msgid "Correct"
msgstr "Helyes"

#: block.py:1440
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Részben helyes ({progress} pont)"
msgstr[1] "Részben helyes ({progress} pont)"

#: block.py:1445
msgid "Partially Correct"
msgstr "Részben helyes"

#: block.py:1447
msgid "Answer submitted."
msgstr "A válasz beküldve."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1839 block.py:2163
msgid "Problem is closed."
msgstr "Feladatmegoldás lezárult."

#: block.py:1845
msgid "Problem must be reset before it can be submitted again."
msgstr "A problémát alaphelyzetbe kell állítani, mielőtt újra elküldhető."

#: block.py:1855
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Várjon legalább {wait} másodpercet a beküldések között."

#: block.py:1865
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Legalább {wait_secs} másodpercet várnod kell az ismételt elküldéshez. "
"{remaining_secs} másodperc még hátravan."

#: block.py:2038
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} óra"
msgstr[1] "{num_hour} óra"

#: block.py:2043
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} perc"
msgstr[1] "{num_minute} perce"

#: block.py:2049
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} másodperc"
msgstr[1] "{num_second} másodperc"

#: block.py:2171
msgid "Problem needs to be reset prior to save."
msgstr "A problémát vissza kell állítani a mentés előtt."

#: block.py:2180
msgid "Your answers have been saved."
msgstr "A válaszok el lettek mentve."

#: block.py:2182
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"A válaszokat elmentettük, de nem értékeltük. Kattints a(z) '{button_name}' "
"gombra az értékeléshez."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2211
msgid "You cannot select Reset for a problem that is closed."
msgstr "Nem választhatja a Visszaállítást egy lezárt problémához."

#: block.py:2219
msgid "You must submit an answer before you can select Reset."
msgstr "Választ kell benyújtania, mielőtt kiválaszthatja az Alaphelyzetet."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2275
msgid "Problem's definition does not support rescoring."
msgstr "A probléma definíciója nem támogatja az újrapontozást."

#: block.py:2280
msgid "Problem must be answered before it can be graded again."
msgstr "A problémát meg kell válaszolni, mielőtt újra osztályozható lenne."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr "A lehetséges fájlbeküldésekkel kapcsolatos problémák nem javíthatók"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Kérdés {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "helyes"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "nem helyes"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "részben helyes"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "nincs kész"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "megválaszolatlan"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "beküldött"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "feldolgozás"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Ez a válasz helyes."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Ez a válasz helytelen."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Ez a válasz részben helyes."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "A válasz feldolgozása folyamatban van."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Még nincs megválaszolva."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Válassz egy lehetőséget"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: váratlan címke {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1717
msgid "Answer received."
msgstr "Válasz megérkezett."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Vártunk egy <choice> vagy <compoundhint> címkét; ehelyett {given_tag} "
"érkezett"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"A fájlokat elküldtük. Amint a beadványát osztályozzák, ezt az üzenetet az "
"osztályozó visszajelzése váltja fel."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Válaszát elküldtük. Amint osztályozzák a válaszát, ezt az üzenetet az "
"osztályozó visszajelzése váltja fel."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} szerkesztő"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Nyomja meg az ESC, majd a TAB billentyűt, vagy kattintson a kódszerkesztőn "
"kívülre a kilépéshez"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Beküldve. Amint válasz érkezik, ezt az üzenetet felváltja a visszajelzés."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Nem érkezett válasz az Xqueue-tól {xqueue_timeout} másodpercen belül. "
"Megszakítva."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Hiba a kód futtatása során."

#: capa/inputtypes.py:982
msgid "Cannot connect to the queue"
msgstr "Nem sikerült csatlakozni a folyamathoz"

#: capa/inputtypes.py:1215 capa/inputtypes.py:1299
msgid "No formula specified."
msgstr "Nincs képlet megadva."

#: capa/inputtypes.py:1221
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Nem sikerült a képlet értelmezése {error_msg}"

#: capa/inputtypes.py:1225 capa/inputtypes.py:1321
msgid "Error while rendering preview"
msgstr "Hiba történt az előnézet elkészítése közben"

#: capa/inputtypes.py:1317
msgid "Sorry, couldn't parse formula"
msgstr "Sajnálom, de nem tudjuk feldolgozni a képletet"

#: capa/inputtypes.py:1694
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: hibás címke {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1779
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "{expected_tag} címke helyett: {given_tag} címke szerepel"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:278
#, python-brace-format
msgid "Question {index}"
msgstr "Kérdés {index}"

#: capa/responsetypes.py:389
msgid "Correct:"
msgstr "Helyes:"

#: capa/responsetypes.py:391
msgid "Incorrect:"
msgstr "Helytelen:"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Hiba {err} a {hintfn} súgó funkció kiértékelésekor."

#: capa/responsetypes.py:514
msgid "(Source code line unavailable)"
msgstr "(A forráskód sor nem elérhető)"

#: capa/responsetypes.py:515
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Nézze meg az XML forrás {sourcenum} sorát."

#: capa/responsetypes.py:683
msgid "Checkboxes"
msgstr "Jelölőnégyzetek"

#: capa/responsetypes.py:1013
msgid "Multiple Choice"
msgstr "Több Lehetőség"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1234
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Ne használja egyszerre a keverést és a válaszárat"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1317
msgid "answer-pool value should be an integer"
