msgstr[0] "Incorrect (point {progress} )"
msgstr[1] "Incorrect ({progress} points)"
msgstr[2] "Incorrect ({progress} points)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Incorrect"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Correct (point {progress} )"
msgstr[1] "Correct ({progress} points)"
msgstr[2] "Correct ({progress} points)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Correct"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Partially correct (point {progress} )"
msgstr[1] "Partiellement correct ({progress} points)"
msgstr[2] "Partiellement correct ({progress} points)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Partiellement correct"

#: block.py:1443
msgid "Answer submitted."
msgstr "Réponse soumise."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "L'exercice est fermé."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr ""
"Le problème doit être réinitialisé avant de pouvoir être soumis à nouveau."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Vous devez attendre au moins {wait} secondes entre les réponses."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Vous devez attendre au moins {wait_secs} entre les réponses. "
"{remaining_secs} restant."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} heure"
msgstr[1] "{num_hour} heures"
msgstr[2] "{num_hour} heures"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minute"
msgstr[1] "{num_minute} minutes"
msgstr[2] "{num_minute} minutes"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} seconde"
msgstr[1] "{num_second} secondes"
msgstr[2] "{num_second} secondes"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "L'exercice doit être réinitialisé avant d'être enregistré."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Vos réponses ont été enregistrées."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Vos réponses ont été enregistrées mais pas encore évaluées. Cliquez sur "
"'{button_name}' pour les évaluer."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Vous ne pouvez pas réinitialiser un exercice fermé."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr ""
"Vous devez soumettre une réponse avant de pouvoir sélectionner "
"Réinitialiser."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "La définition de l'exercice ne prend pas en charge la réévaluation."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr ""
"L'exercice doit recevoir une réponse avant de pouvoir être à nouveau noté."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Impossible de réévaluer des exercices avec d&#39;éventuelles soumissions de "
"fichiers"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Question {}"

