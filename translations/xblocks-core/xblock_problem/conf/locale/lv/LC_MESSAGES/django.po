#: block.py:236
msgid "Display Name"
msgstr "Parādāmais nosaukums"

#: block.py:237
msgid "The display name for this component."
msgstr "Šī komponenta parādāmais nosaukums."

#: block.py:241
msgid "Blank Problem"
msgstr "Tukšs uzdevums"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Dalībnieka mēģinājumu skaits šīs uzdevumi risināšanā"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Maksimālais mēģinājumu skaits"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Nosaka, cik reižu dalībnieks var mēģināt atbildēt uz šo uzdevumu. Ja vērtība"
" nav iestatīta, ir atļauti bezgalīgi mēģinājumi."

#: block.py:256
msgid "Grading Method"
msgstr "Vērtēšanas metode"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Definējiet šīs uzdevumi vērtēšanas metodi. Pēc noklusējuma tas ir dalībnieka"
" pēdējā iesnieguma rezultāts."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Pēdējais rezultāts"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Pirmais rezultāts"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Augstākais rezultāts"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Vidējais rādītājs"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Datums, kad šī uzdevums rodas līdz"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Laiks pēc termiņa, kurā iesniegumi tiks pieņemti"

#: block.py:275
msgid "Show Results"
msgstr "Rādīt rezultātus"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Nosaka, kad jāparāda, vai dalībnieka atbilde uz uzdevumu ir pareiza. "
"Konfigurēts apakšsadaļā."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Vienmēr"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Nekad"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Nokavēts termiņš"

#: block.py:288
msgid "Show Answer"
msgstr "Parādi atbildi"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Nosaka, kad parādīt problēmas atbildi. Noklusējuma vērtību var iestatīt "
"sadaļā Paplašinātie iestatījumi."

#: block.py:294
msgid "Answered"
msgstr "Atbildēja"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Mēģināts vai nokavēts"

#: block.py:296
msgid "Closed"
msgstr "Slēgts"

#: block.py:297
msgid "Finished"
msgstr "Pabeigts"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Pareizs vai nokavēts"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Pēc dažiem mēģinājumiem"

#: block.py:302
msgid "After All Attempts"
msgstr "Pēc visiem mēģinājumiem"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Pēc visiem mēģinājumiem vai labot"

#: block.py:304
msgid "Attempted"
msgstr "Mēģināja"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Rādīt atbildi: mēģinājumu skaits"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Cik reižu kursa dalībniekam jāmēģina atbildēt uz jautājumu, pirms tiek "
"parādīta poga Rādīt atbildi."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Vai obligāti parādīties saglabāšanas pogai lapā."

#: block.py:320
msgid "Show Reset Button"
msgstr "Rādīt atiestatīšanas pogu"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Nosaka, vai tiek parādīta poga \"Atiestatīt\", lai lietotājs varētu atjaunot"
" savu atbildi. Noklusējuma vērtību var iestatīt Paplašinātajos iestatījumos."

#: block.py:329
msgid "Randomization"
msgstr "Randomizācija"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Nosaka, kad randomizēt saistītā Python skripta norādītos mainīgos. "
"Problēmām, kurās vērtības netiek nejauši atlasītas, norādiet \"Nekad\". "

#: block.py:338
msgid "On Reset"
msgstr "Atiestatīt"

#: block.py:340
msgid "Per Student"
msgstr "Katram dalībniekam"

#: block.py:344
msgid "XML data for the problem"
msgstr "XML dati par uzdevumu"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Vārdnīca ar aktuālo dalībnieku atbilžu pareizību"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Katra mēģinājuma pareizības karšu saraksts"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Vārdnīca ievades veidu stāvokļa uzturēšanai"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Vārdnīca ar pašreizējām dalībnieku atbildēm"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Dalībnieku atbilžu saraksts katram mēģinājumam"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Vārdnīca ar pašreizējo dalībnieku rezultātu"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Katra mēģinājuma rezultātu saraksts"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr ""
"Neatkarīgi no tā, vai atbildes ir saglabātas kopš pēdējās iesniegšanas"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Vai dalībnieks ir izpildījis uzdevumu"

#: block.py:368
msgid "Random seed for this student"
msgstr "Nejaušais sēklas kods sēkla šim dalībniekam"

#: block.py:369
msgid "Last submission time"
msgstr "Pēdējais iesniegšanas laiks"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Taimeris starp mēģinājumiem"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Sekundes, kas dalībniekam jāgaida starp mēģinājumiem uzdevuma iesniegšanai."

#: block.py:377
msgid "Problem Weight"
msgstr "Uzdevumi svars"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Nosaka punktu skaitu, kas ir vērts katrai problēmai. Ja šī vērtība nav "
"iestatīta, katra uzdevuma atbildes lauka vērtība ir viens punkts."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Šī moduļa atzīmes avots"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Avota kods LaTeX un Word problēmām. Šī funkcija netiek pietiekami "
"atbalstīta."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Vai iespējot LaTeX veidnes?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Norāda, vai problēma ir rediģēta, izmantojot Markdown redaktoru autoru "
"veidošanas MFE."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Atvainojamies, bet, apstrādājot jūsu pieprasījumu, ir pieļauta kļūda. Lūdzu,"
" mēģiniet ielādēt lapu no jauna un mēģiniet vēlreiz."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Kopš ielādējāt šo lapu, šīs problēmas stāvoklis ir mainījies. Lūdzu, "
"atsvaidziniet lapu."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "Atbildes ID"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Jautājums"

#: block.py:810 block.py:827 capa/responsetypes.py:432
msgid "Answer"
msgstr "Atbilde"

#: block.py:813
msgid "Correct Answer"
msgstr "Pareizā atbilde"

#: block.py:1058
msgid "Submit"
msgstr "Iesniegt"

#: block.py:1071
msgid "Submitting"
msgstr "Notiek iesniegšana"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Brīdinājums: uzdevums ir atiestatīta sākotnējā stāvoklī!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Uzdevumi stāvokli sabojāja nederīgs iesniegums. Iesniegums sastāvēja no:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "Ja šī kļūda saglabājas, lūdzu, sazinieties ar kursa darbiniekiem."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Padoms ({hint_num} no {hints_count}): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Jūsu atbildes tika iepriekš saglabātas. Noklikšķiniet uz {button_name}, lai "
"tos novērtētu."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Nepareizi ( {progress} punkti)"
msgstr[1] "Nepareizi ( {progress} punkts)"
msgstr[2] "Nepareizi ({progress} punkti)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Nepareizi"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Pareizi ( {progress} punkti)"
msgstr[1] "Pareizi ( {progress} punkts)"
msgstr[2] "Pareizi ({progress} punkti)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Pareizi"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Daļēji pareizi ( {progress} punkti)"
msgstr[1] "Daļēji pareizi ( {progress} punkts)"
msgstr[2] "Daļēji pareizi ({progress} punkti)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Daļēji pareizi"

#: block.py:1443
msgid "Answer submitted."
msgstr "Atbilde iesniegta."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Uzdevums ir slēgts."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Lai to varētu atkārtoti iesniegt, uzdevums ir jāatiestata."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Starp iesniegšanas reizēm ir jāgaida vismaz {wait} sekundes."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Starp iesniegšanas reizēm ir jāgaida vismaz {wait_secs} . Atlikušais "
"{remaining_secs} ."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} stundas"
msgstr[1] "{num_hour} stunda"
msgstr[2] "{num_hour} stundas"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minūtes"
msgstr[1] "{num_minute} minūte"
msgstr[2] "{num_minute} minūtes"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} sekundes"
msgstr[1] "{num_second} sekunde"
msgstr[2] "{num_second} sekundes"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Pirms saglabāšanas uzdevums ir jāatiestata."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Jūsu atbildes ir saglabātas."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Jūsu atbildes ir saglabātas, bet nav novērtētas. Noklikšķiniet uz "
"{button_name}, lai tos novērtētu."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Nav iespējams atlasīt Atiestatīt uzdevumam, kas ir beidzies."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Pirms varat izvēlēties Atiestatīt, jums ir jāiesniedz atbilde."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Uzdevumi definīcija neatbalsta atkārtotu uzskaiti."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Uzdevums ir jāatbild, pirms to var atkārtoti novērtēt."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "Nevar atkārtoti novērst problēmas ar iespējamu failu iesniegšanu"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "jautājums {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "pareizi"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "nepareizi"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "daļēji pareizi"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "nepilnīgs"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "neatbildēts"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "iesniegts"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "apstrāde"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Šī atbilde ir pareiza."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Šī atbilde ir nepareiza."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Šī atbilde ir daļēji pareiza."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Šī atbilde tiek apstrādāta."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Vēl nav atbildēts."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Izvēlieties opciju"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: negaidīts tags {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Atbilde saņemta."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Paredzams a<choice> vai<compoundhint> tags; tā vietā ieguva {given_tag}"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Jūsu faili ir iesniegti. Tiklīdz jūsu iesniegums tiks novērtēts, šis "
"ziņojums tiks aizstāts ar vērtētāja atsauksmi."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Jūsu atbilde ir iesniegta. Tiklīdz jūsu iesniegums tiks novērtēts, šis "
"ziņojums tiks aizstāts ar vērtētāja atsauksmi."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} redaktors"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Nospiediet ESC un pēc tam TAB vai noklikšķiniet ārpus koda redaktora, lai "
"izietu"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Nav norādīta formula."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Nevarēja parsēt formulu: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Kļūda renderējot priekšskatījumu"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Diemžēl formulu nevarēja parsēt"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : negaidīts tags {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Paredzēts {expected_tag} tags; tā vietā ieguva {given_tag}"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
msgid "Question {index}"
msgstr "Jautājums {index}"

#: capa/responsetypes.py:387
msgid "Correct:"
msgstr "Pareizi:"

#: capa/responsetypes.py:389
msgid "Incorrect:"
msgstr "Nepareizi:"

#: capa/responsetypes.py:512
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Kļūda {err} , novērtējot mājiena funkciju {hintfn} ."

#: capa/responsetypes.py:513
msgid "(Source code line unavailable)"
msgstr "(Avota koda rinda nav pieejama)"

#: capa/responsetypes.py:514
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Skatiet XML avota līniju {sourcenum} ."

#: capa/responsetypes.py:682
msgid "Checkboxes"
msgstr "izvēles rūtiņas"

#: capa/responsetypes.py:1012
msgid "Multiple Choice"
msgstr "Vairāku atbilžu variantu izvēle"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1233
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Neizmantojiet nejaušo secību un atbilžu kopu vienlaikus."

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1316
msgid "answer-pool value should be an integer"
msgstr "atbilžu kopas vērtībai ir jābūt veselam skaitlim"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1383
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr "Izvēļu grupā ir jāietver vismaz 1 pareiza un 1 nepareiza izvēle"

#: capa/responsetypes.py:1408
msgid "True/False Choice"
msgstr "True/False izvēle"

#: capa/responsetypes.py:1453
msgid "Dropdown"
msgstr "Nolaižamā izvēlne"

#: capa/responsetypes.py:1531
msgid "Numerical Input"
msgstr "Skaitliskā ievade"

#: capa/responsetypes.py:1567 capa/responsetypes.py:1594
msgid "There was a problem with the staff answer to this problem."
msgstr "Radās problēma ar personāla atbildi uz šo problēmu."

#: capa/responsetypes.py:1617
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Nevarēja interpretēt '{student_answer}' kā skaitli."

#: capa/responsetypes.py:1635
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Faktoriāla funkcija, kas novērtēta ārpus tā domēna:'{student_answer}'"

#: capa/responsetypes.py:1642
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Nederīga matemātiskā sintakse: '{student_answer}'"

#: capa/responsetypes.py:1673
msgid "You may not use complex numbers in range tolerance problems"
