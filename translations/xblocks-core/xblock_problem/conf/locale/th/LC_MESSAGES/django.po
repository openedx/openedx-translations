#: block.py:236
msgid "Display Name"
msgstr "ชื่อที่แสดง"

#: block.py:237
msgid "The display name for this component."
msgstr "ชื่อที่แสดงสำหรับส่วนประกอบนี้"

#: block.py:241
msgid "Blank Problem"
msgstr "ปัญหาว่างเปล่า"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "จำนวนนักเรียนที่พยายามแก้ปัญหานี้"

#: block.py:247
msgid "Maximum Attempts"
msgstr "ความพยายามสูงสุด"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"กำหนดจำนวนครั้งของนักเรียนที่จะพยายามตอบคำถาม. ถ้าไม่กำหนด "
"สามารถตอบได้ไม่จำกัด"

#: block.py:256
msgid "Grading Method"
msgstr "วิธีการให้คะแนน"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"กำหนดวิธีการให้คะแนนสำหรับปัญหานี้ โดยค่าเริ่มต้น "
"จะเป็นคะแนนของการส่งครั้งล่าสุดที่นักเรียนทำ"

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "คะแนนล่าสุด"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "คะแนนแรก"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "คะแนนสูงสุด"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "คะแนนเฉลี่ย"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "วันที่กำหนดส่งปัญหานี้โดย"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "จำนวนครั้งหลังจากวันสุดท้ายที่การส่งสามารถยอมรับได้"

#: block.py:275
msgid "Show Results"
msgstr "แสดงผลลัพธ์"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"กำหนดเวลาที่จะแสดงว่าคำตอบของผู้เรียนต่อปัญหานั้นถูกต้องหรือไม่ "
"กำหนดค่าไว้ในส่วนย่อย"

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "เสมอ"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "ไม่เคย"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "เลยวันครบกำหนด"

#: block.py:288
msgid "Show Answer"
msgstr "แสดงคำตอบ"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"กำหนดว่าเมื่อไหร่จะแสดงคำตอบ "
"และค่าเริ่มต้นสามารถถูกกำหนดไว้ในการตั้งค่าขั้นสูง"

#: block.py:294
msgid "Answered"
msgstr "ตอบ"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "ได้ทำหรือพ้นกำหนดแล้ว"

#: block.py:296
msgid "Closed"
msgstr "ปิด"

#: block.py:297
msgid "Finished"
msgstr "เสร็จสิ้น"

#: block.py:298
msgid "Correct or Past Due"
msgstr "ถูกหรือเลยวันครอบกำหนด"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "หลังจากการได้ทำแล้วจำนวนหนึ่ง"

#: block.py:302
msgid "After All Attempts"
msgstr "หลังจากการทำทั้งหมด"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "หลังจากพยายามทั้งหมดหรือเมื่อถูกต้องแล้ว"

#: block.py:304
msgid "Attempted"
msgstr "ทำแล้ว"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "แสดงคำตอบ: จำนวนครั้งที่ทำ"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr "นักเรียนต้องพยายามตอบคำถามหลายครั้งก่อนที่ปุ่ม \"แสดงคำตอบ\" จะปรากฏขึ้น"

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "ไม่ว่าจะบังคับปุ่มบันทึกให้ปรากฏบนเพจนี้"

#: block.py:320
msgid "Show Reset Button"
msgstr "แสดงปุ่มรีเซ็ท"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"กำหนดว่าถ้าหากปุ่ม'ตั้งค่าใหม่'ถูกแสดง ผู้ใช้อาจตั้งค่าคำตอบใหม่ได้ "
"ค่าเบื้องต้นจะสามารถกำหนดได้ในการตั้งค่าขั้นสูง"

#: block.py:329
msgid "Randomization"
msgstr "การสุ่ม"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"ระบุว่าเมื่อใดต้องสุ่มประเภทของตัวแปรที่เกี่ยวข้องกับPython "
"สำหรับปัญหาที่ไม่ได้ถูกสุ่มค่าที่ตัวแปรให้ระบุ\"ไม่เคย\" "

#: block.py:338
msgid "On Reset"
msgstr "ขณะรีเซ็ท"

#: block.py:340
msgid "Per Student"
msgstr "ต่อนักเรียนหนึ่งคน"

#: block.py:344
msgid "XML data for the problem"
msgstr "ข้อมูล XML สำหรับปัญหา"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "พจนานุกรมกับความถูกต้องของคำตอบปัจจุบันของนักเรียน"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "รายการแผนที่ความถูกต้องสำหรับความพยายามแต่ละครั้ง"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "พจนานุกรมสำหรับการรักษาสถานะของชนิดของข้อมูลที่ป้อน"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "พจนานุกรมกับคำตอบปัจจุบันของนักเรียน"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "รายการคำตอบของนักเรียนสำหรับความพยายามแต่ละครั้ง"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "พจนานุกรมที่มีคะแนนนักเรียนปัจจุบัน"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "รายการคะแนนสำหรับความพยายามแต่ละครั้ง"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "คำตอบได้รับการบันทึกตั้งแต่ส่งครั้งล่าสุดหรือไม่"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "ถ้านักเรียนตอบคำถาม"

#: block.py:368
msgid "Random seed for this student"
msgstr "สุ่มผู้ที่ได้รับการคัดเลือก"

#: block.py:369
msgid "Last submission time"
msgstr "การส่งงานครั้งล่าสุด"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "ตั้งเวลาระหว่างความพยายาม"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr "นักเรียนต้องรอสักครู่ระหว่างการเสนอปัญหาและการพยายามหลายครั้ง"

#: block.py:377
msgid "Problem Weight"
msgstr "น้ำหนักของปัญหา"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"กำหนดค่าจำนวนของคะแนนที่แต่ละปัญหา ถ้าไม่ได้ตั้งค่า "
"แต่ละการตอบปัญหาจะมีค่าเท่ากับหนึ่งคะแนน"

#: block.py:385
msgid "Markdown source of this module"
msgstr "แหล่งที่มาของ Markdown ของโมดูลนี้"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"แหล่งที่มาของโค้ด LaTeX และปัญหาของ Word "
"คุณลักษณะนี้ไม่ได้รับการสนับสนุนที่ดี"

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "เปิดการใช้งาน LaTeX เทมเพลต"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"ระบุว่าปัญหาได้รับการแก้ไขโดยใช้ตัวแก้ไข Markdown ใน Authoring MFE หรือไม่"

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"เราเสียใจ, เกิดข้อผิดพลาดในการประมวลคำขอของคุณ กรุณาโหลดหน้านี้ใหม่อีกครั้ง"

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"สถานะของปัญหานี้ถูกเปลี่ยนไปตั้งแต่คุณโหลดหน้านี้ "
"กรุณาโหลดหน้านี้ใหม่อีกครั้ง"

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "ID ของคำตอบ"

#: block.py:809 block.py:826
msgid "Question"
msgstr "คำถาม"

#: block.py:810 block.py:827 capa/responsetypes.py:432
msgid "Answer"
msgstr "คำตอบ"

#: block.py:813
msgid "Correct Answer"
msgstr "คำตอบที่ถูกต้อง"

#: block.py:1058
msgid "Submit"
msgstr "ส่ง"

#: block.py:1071
msgid "Submitting"
msgstr "กำลังส่ง"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "คำเตือน: ปัญหาถูกตั้งค่าเริ่มต้น"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr "สถานะของปัญหาเกิดความเสียหายโดยการส่งที่ไม่ถูกต้อง การส่งได้แก่:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "ถ้าข้อผิดพลาดยังคงอยู่ กรุณาติดต่อเจ้าหน้าที่หลักสูตร"

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "คำใบ้ ({hint_num} จาก {hints_count}): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr "คำตอบของคุณถูกบันทึกไว้ก่อนหน้านี้ คลิก '{button_name}' เพื่อให้คะแนน"

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "ไม่ถูกต้อง ({progress} คะแนน)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "ไม่ถูกต้อง"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "ถูกต้อง ({progress} คะแนน)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "ถูกต้อง"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "ถูกต้องบางส่วน ({progress} คะแนน)"

#: block.py:1441
msgid "Partially Correct"
msgstr "ถูกบางส่วน"

#: block.py:1443
msgid "Answer submitted."
msgstr "ส่งคำตอบแล้ว"

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "ปัญหาถูกปิดแล้ว"

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "ต้องดำเนินการรีเซ็ทปัญหาก่อนจึงจะส่งใหม่ได้อีก"

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "คุณต้องรออย่างน้อย {wait} วินาทีในระหว่างการส่ง"

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"คุณต้องรออย่างน้อย {wait_secs} วินาที ในระหว่างการส่ง เหลือ {remaining_secs}"
" วินาที"

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} ชั่วโมง"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} นาที"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} วินาที"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "ต้องรีเซ็ทปัญหาก่อนที่จะบันทึก"

#: block.py:2153
msgid "Your answers have been saved."
msgstr "คำตอบของคุณได้รับการบันทึกแล้ว"

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"คำตอบของคุณถูกบันทึกแต่ยังไม่นับคะแนน คลิก '{button_name}' เพื่อให้คะแนน"

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "คุณไม่สามารถเลือกรีเซ็ตสำหรับปัญหาที่ปิดได้"

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "คุณต้องส่งคำตอบก่อนจึงจะสามารถเลือกรีเซ็ตได้"

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "คำจำกัดความของปัญหาไม่ได้สนับสนุนการให้คะแนน"

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "ปัญหาต้องได้รับการตอบก่อนที่มันจะถูกให้คะแนนอีกครั้ง"

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "ไม่สามารถปรับคะแนนใหม่ให้กับปัญหาที่มีการส่งไฟล์ได้"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "คำถาม {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "ถูกต้อง"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "ผิด"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "ถูกต้องบางส่วน"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "ไม่สมบูรณ์"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "ยังไม่ตอบ"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "ส่งแล้ว"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "กำลังประมวลผล"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "คำตอบนี้คือคำตอบที่ถูกต้อง"

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "คำตอบนี้ ไม่ถูกต้อง"

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "คำตอบนี้ถูกต้องบางส่วน"

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "กำลังประมวลผลคำตอบ"

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "ยังไม่ได้ตอบ"

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "เลือกหนึ่งตัวเลือก"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ตัวเลือก: แท็กที่ไม่คาดคิด {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "ได้รับคำตอบ"

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr "ต้องเป็น <choice> หรือ <compoundhint> แต่ได้รับ {given_tag}"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"ได้ส่งไฟล์ของคุณแล้ว ทันทีที่การส่งของคุณถูกให้คะแนน "
"ข้อความนี้ถูกแทนที่ด้วยผลตอบรับของผู้ให้คะแนน"

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"คำตอบของคุณได้ถูกส่งแล้ว ทันทีที่การส่งของคุณถูกให้คะแนน "
"ข้อความนี้ถูกแทนที่ด้วยผลตอบรับของผู้ให้คะแนน"

