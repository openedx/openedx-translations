#: block.py:236
msgid "Display Name"
msgstr "نام نمایشی"

#: block.py:237
msgid "The display name for this component."
msgstr "نام نمایشی این مؤلفه"

#: block.py:241
msgid "Blank Problem"
msgstr "مسئله خالی"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "تعداد تلاش‌های انجام‌شده توسط دانش‌آموز برای این مسئله"

#: block.py:247
msgid "Maximum Attempts"
msgstr "حداکثر تلاش"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"تعداد دفعاتی را مشخص کنید که فراگیر می‌تواند برای پاسخ به این مسأله تلاش "
"کند. اگر مقداری برای آن در نظر گرفته نشود، مجاز است بی‌نهایت دفعه تلاش کند."

#: block.py:256
msgid "Grading Method"
msgstr "روش درجه بندی"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"روش درجه بندی این مشکل را تعریف کنید. به طور پیش فرض، این امتیاز آخرین "
"ارسالی است که توسط دانش آموز ارائه شده است."

#: block.py:264 block.py:573
msgid "Last Score"
msgstr "آخرین امتیاز"

#: block.py:265 block.py:574
msgid "First Score"
msgstr "امتیاز اول"

#: block.py:266 block.py:575
msgid "Highest Score"
msgstr "بالاترین امتیاز"

#: block.py:267 block.py:576
msgid "Average Score"
msgstr "میانگین امتیاز"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "تاریخ سررسید این مسئله"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "مدت زمان پس از موعد مقرر که ارسال ها پذیرفته می شوند"

#: block.py:275
msgid "Show Results"
msgstr "نمایش نتایج"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"مشخص می‌کند که چه زمانی باید نشان دهد که آیا پاسخ دانش‌پذیر به مسئله صحیح "
"است یا خیر. این مورد در پیکربندی زیربخش مشخص شده است."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "همیشه"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "هرگز"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "سررسید گذشته"

#: block.py:288
msgid "Show Answer"
msgstr "نمایش پاسخ"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"مشخص می‌کند که چه زمانی باید پاسخ مسئله نمایش داده شود. مقدار پیش‌فرض را "
"می‌توان در تنظیمات پیشرفته تنظیم کرد."

#: block.py:294
msgid "Answered"
msgstr "جواب داد"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "تلاش‌شده یا سررسید گذشته"

#: block.py:296
msgid "Closed"
msgstr "بسته شد"

#: block.py:297
msgid "Finished"
msgstr "پایان‌یافته"

#: block.py:298
msgid "Correct or Past Due"
msgstr "سررسید صحیح یا گذشته"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "پس از چند تلاش"

#: block.py:302
msgid "After All Attempts"
msgstr "بعد از همۀ تلاش‌ها"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "بعد از همۀ تلاش‌ها یا درست"

#: block.py:304
msgid "Attempted"
msgstr "تلاش‌شده"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "نمایش پاسخ: تعداد تلاش"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"تعداد دفعاتی که دانش آموز باید قبل از ظاهر شدن دکمه Show Answer به سوال پاسخ"
" دهد."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "اینکه آیا باید دکمه ذخیره را مجبور به نمایش در صفحه کنیم"

#: block.py:320
msgid "Show Reset Button"
msgstr "نمایش دکمه تنظیم مجدد"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"تعیین می کند که آیا یک دکمه &quot;تنظیم مجدد&quot; نشان داده می شود تا کاربر"
" بتواند پاسخ خود را بازنشانی کند. یک مقدار پیش فرض را می توان در تنظیمات "
"پیشرفته تنظیم کرد."

#: block.py:329
msgid "Randomization"
msgstr "تصادفی سازی"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"زمان تصادفی سازی متغیرهای مشخص شده در اسکریپت پایتون مرتبط را مشخص می کند. "
"برای مشکلاتی که مقادیر را تصادفی نمی کنند، &quot;هرگز&quot; را مشخص کنید. "

#: block.py:338
msgid "On Reset"
msgstr "در حالت بازنشانی"

#: block.py:340
msgid "Per Student"
msgstr "هر دانش آموز"

#: block.py:344
msgid "XML data for the problem"
msgstr "داده‌های XML مسئله"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "فرهنگ لغت با صحت پاسخ های فعلی دانش آموزان"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "فهرست نقشه های صحت برای هر تلاش"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "فرهنگ لغت برای حفظ وضعیت انواع ورودی"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "فرهنگ لغت با پاسخ های دانش آموز فعلی"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "لیست پاسخ های دانش آموزان برای هر تلاش"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "فرهنگ لغت با نمره فعلی دانش آموز"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "لیست امتیازات برای هر تلاش"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "اینکه آیا پاسخ ها از زمان آخرین ارسال ذخیره شده اند یا خیر"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "آیا دانش‌آموز به مسئله پاسخ داده است یا خیر"

#: block.py:368
msgid "Random seed for this student"
msgstr "دانه تصادفی برای این دانش آموز"

#: block.py:369
msgid "Last submission time"
msgstr "آخرین زمان ارسال"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "تایمر بین تلاش ها"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"چند ثانیه، دانش‌آموز باید بین ارسال‌ها برای مشکلی با تلاش‌های متعدد منتظر "
"بماند."

#: block.py:377
msgid "Problem Weight"
msgstr "وزن مسأله"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"تعداد امتیازهای هر مسئله را مشخص می‌کند. اگر مقداری مشخص نشده باشد، هر قسمت "
"پاسخ مسئله یک امتیاز دارد."

#: block.py:385
msgid "Markdown source of this module"
msgstr "منبع علامت گذاری این ماژول"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr "کد منبع برای مسائل LaTeX و Word. این ویژگی به خوبی پشتیبانی نمی‌شود."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "قالب های LaTeX را فعال کنید؟"

#: block.py:391
msgid "Matlab API key"
msgstr "کلید Matlab API"

#: block.py:393
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"کلید API ارائه شده توسط MathWorks برای دسترسی به سرویس میزبانی MATLAB را "
"وارد کنید. این کلید برای استفاده انحصاری توسط این دوره برای مدت زمان مشخص "
"داده شده است. لطفاً کلید API را با دوره‌های دیگر به اشتراک نگذارید و اگر فکر"
" می‌کنید کلید فاش شده یا در معرض خطر است، فوراً به MathWorks اطلاع دهید. "
"برای به دست آوردن کلید دوره خود، یا گزارش یک مشکل، لطفاً با "
"moocsupport@mathworks.com تماس بگیرید"

#: block.py:402
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"نشان می دهد که آیا مشکل با استفاده از ویرایشگر Markdown در Authoring MFE "
"ویرایش شده است یا خیر."

#: block.py:501
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"متأسفیم، در پردازش درخواست شما خطایی روی داد. لطفاً صفحه خود را دوباره "
"بارگیری کنید و دوباره امتحان کنید."

#: block.py:506
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"وضعیت این مسئله از زمانی که این صفحه را بارگیری کرده‌اید تغییر کرده است. "
"لطفاً صفحه خود را به‌روز کنید."

#: block.py:826 block.py:843
msgid "Answer ID"
msgstr "شناسه پاسخ"

#: block.py:827 block.py:844
msgid "Question"
msgstr "سوال"

#: block.py:828 block.py:845 capa/responsetypes.py:432
msgid "Answer"
msgstr "پاسخ"

#: block.py:831
msgid "Correct Answer"
msgstr "پاسخ صحیح"

#: block.py:1077
msgid "Submit"
msgstr "ثبت"

#: block.py:1090
msgid "Submitting"
msgstr "درحال ثبت"

#: block.py:1212
msgid "Warning: The problem has been reset to its initial state!"
msgstr "هشدار: مسئله به حالت اولیه خود بازنشانی شد!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1216
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"وضعیت مسئله به دلیل یک ارسال نامعتبر خراب شد. ارسال شامل موارد زیر بود:"

#: block.py:1223
msgid "If this error persists, please contact the course staff."
msgstr "اگر این خطا ادامه داشت، لطفا با کارکنان دوره تماس بگیرید."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1278
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1284
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "راهنمایی ( {hint_num} از {hints_count} ): "

#: block.py:1365
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"پاسخ‌های شما قبلاً ذخیره شده بود. برای نمره دادن به آنها روی "
"&quot;{button_name}&quot; کلیک کنید."

#: block.py:1441
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "نادرست (نقطه {progress} )"
msgstr[1] "نادرست ( امتیاز {progress} )"

#: block.py:1444 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "غلط"

#: block.py:1448
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "صحیح ( نقطه {progress} )"
msgstr[1] "صحیح ( امتیاز {progress} )"

#: block.py:1451 capa/capa_problem.py:754
msgid "Correct"
msgstr "درست"

#: block.py:1455
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "تا حدی درست است ( نقطه {progress} )"
msgstr[1] "تا حدی درست است ( {progress} امتیاز)"

#: block.py:1460
msgid "Partially Correct"
msgstr "تا حدی درست"

#: block.py:1462
msgid "Answer submitted."
msgstr "پاسخ ارسال شد."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1854 block.py:2178
msgid "Problem is closed."
msgstr "این مسئله بسته شده است."

#: block.py:1860
msgid "Problem must be reset before it can be submitted again."
msgstr "مسئله باید قبل از ارسال مجدد بازنشانی شود."

#: block.py:1870
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "بین ارسال‌ها باید حداقل {wait} ثانیه صبر کنید."

#: block.py:1880
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"بین ارسال‌ها باید حداقل {wait_secs} صبر کنید. {remaining_secs} باقی مانده "
"است."

#: block.py:2053
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} ساعت"
msgstr[1] "{num_hour} ساعت"

#: block.py:2058
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "دقیقه {num_minute}"
msgstr[1] "دقیقه {num_minute}"

#: block.py:2064
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} ثانیه"
msgstr[1] "{num_second} ثانیه"

#: block.py:2186
msgid "Problem needs to be reset prior to save."
msgstr "مسئله باید قبل از ذخیره‌سازی بازنشانی شود."

#: block.py:2195
msgid "Your answers have been saved."
msgstr "پاسخ های شما ذخیره شده است."

#: block.py:2197
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"پاسخ های شما ذخیره شده است اما درجه بندی نشده است. برای نمره دادن به آنها "
"روی &quot;{button_name}&quot; کلیک کنید."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2226
msgid "You cannot select Reset for a problem that is closed."
msgstr "شما نمی‌توانید مسئله‌ای که بسته شده است را بازنشانی کنید."

#: block.py:2234
msgid "You must submit an answer before you can select Reset."
msgstr "قبل از اینکه بتوانید Reset را انتخاب کنید، باید یک پاسخ ارسال کنید."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2290
msgid "Problem's definition does not support rescoring."
msgstr "تعریف مسئله از نمرده‌دهی مجدد پشتیبانی نمی‌کند."

#: block.py:2295
msgid "Problem must be answered before it can be graded again."
msgstr "باید قبل از نمره‌دهی مجدد به مسئله پاسخ داده شود."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"امکان نمره‌دهی مجدد مسئله‌هایی که فایل‌های بارگذاری احتمالی دارند، وجود "
"ندارد."

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "سوال {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "درست"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "غلط"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "تا حدی درست"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "ناقص"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "بی پاسخ"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "ارسال شده"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "در حال پردازش"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "این پاسخ صحیح است."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "این پاسخ نادرست است."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "این پاسخ تا حدی درست است."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "این پاسخ در حال پردازش است."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "هنوز پاسخ داده نشده است."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "یک گزینه را انتخاب کنید"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: برچسب غیرمنتظره {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1719
msgid "Answer received."
msgstr "پاسخ دریافت شد."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"مورد انتظار الف<choice> یا<compoundhint> برچسب در عوض {given_tag} دریافت "
"کردم"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"فایل های شما ارسال شد به محض اینکه ارسال شما درجه بندی شد، این پیام با "
"بازخورد نمره دهنده جایگزین می شود."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"پاسخ شما ارسال شد به محض اینکه ارسال شما درجه بندی شد، این پیام با بازخورد "
"نمره دهنده جایگزین می شود."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "ویرایشگر {programming_language}"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "برای خروج ESC و سپس TAB را فشار دهید یا خارج از ویرایشگر کد کلیک کنید"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr "ارسال شده. به محض بازگشت پاسخ، این پیام با آن بازخورد جایگزین می شود."

