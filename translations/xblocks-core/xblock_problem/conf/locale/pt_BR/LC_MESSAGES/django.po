#: block.py:235
msgid "Display Name"
msgstr "Nome de exibição"

#: block.py:236
msgid "The display name for this component."
msgstr "Nome de exibição para este componente."

#: block.py:240
msgid "Blank Problem"
msgstr "Problema em branco"

#: block.py:243
msgid "Number of attempts taken by the student on this problem"
msgstr "Número de tentativas feitas pelo aluno neste problema"

#: block.py:246
msgid "Maximum Attempts"
msgstr "Máximo de tentativas"

#: block.py:248
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Define o número de tentativas que os estudantes podem fazer para resolver "
"este problema. Se o valor não for definido, infinitas tentativas serão "
"permitidas."

#: block.py:255
msgid "Grading Method"
msgstr "Método de classificação"

#: block.py:257
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Defina o método de classificação para este problema. Por padrão, é a "
"pontuação do último envio feito pelo aluno."

#: block.py:263 block.py:558
msgid "Last Score"
msgstr "Última pontuação"

#: block.py:264 block.py:559
msgid "First Score"
msgstr "Primeira pontuação"

#: block.py:265 block.py:560
msgid "Highest Score"
msgstr "Maior pontuação"

#: block.py:266 block.py:561
msgid "Average Score"
msgstr "Pontuação Média"

#: block.py:269
msgid "Date that this problem is due by"
msgstr "Data do prazo do problema"

#: block.py:271
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Período posterior à data de vencimento durante o qual o envio de tarefas "
"será aceito"

#: block.py:274
msgid "Show Results"
msgstr "Mostrar Resultados"

#: block.py:276
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Definem quando mostrar se a resposta de um estudante ao problema está "
"correta. Configurado na subseção."

#: block.py:281 block.py:292 block.py:336
msgid "Always"
msgstr "Sempre"

#: block.py:282 block.py:299 block.py:338
msgid "Never"
msgstr "Nunca"

#: block.py:283 block.py:298
msgid "Past Due"
msgstr "Expirada"

#: block.py:287
msgid "Show Answer"
msgstr "Exibir resposta"

#: block.py:288
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Determina quando mostrar a resposta para o problema. Um valor definido por "
"padrão pode ser alterado nas Configurações Avançadas."

#: block.py:293
msgid "Answered"
msgstr "Respondido"

#: block.py:294
msgid "Attempted or Past Due"
msgstr "Tentativas ou Atrasadas"

#: block.py:295
msgid "Closed"
msgstr "Fechado"

#: block.py:296
msgid "Finished"
msgstr "Finalizada"

#: block.py:297
msgid "Correct or Past Due"
msgstr "Correto ou Atrasado"

#: block.py:300
msgid "After Some Number of Attempts"
msgstr "Após algum número de tentativas"

#: block.py:301
msgid "After All Attempts"
msgstr "Após todas as tentativas"

#: block.py:302
msgid "After All Attempts or Correct"
msgstr "Depois de todas as tentativas ou corrigidas"

#: block.py:303
msgid "Attempted"
msgstr "Tentativa"

#: block.py:307
msgid "Show Answer: Number of Attempts"
msgstr "Mostrar a Resposta: número de tentativas"

#: block.py:309
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Número de vezes que o aluno deve tentar responder à pergunta antes que o "
"botão Mostrar Resposta apareça."

#: block.py:316
msgid "Whether to force the save button to appear on the page"
msgstr "Determina se forçará o botão de salvar a aparecer na página."

#: block.py:319
msgid "Show Reset Button"
msgstr "Mostar botão de reiniciar"

#: block.py:321
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Determina se um botão 'Limpar' é mostrado quando o usuário puder limpar sua "
"resposta. Um valor padrão pode ser configurado em Configurações Avançadas."

#: block.py:328
msgid "Randomization"
msgstr "Ordenamento aleatório"

#: block.py:330
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Define quando randomizar as variáveis especificadas no script associado "
"Python. Para problemas que não randomizam valores, especifique \"Nunca\"."

#: block.py:337
msgid "On Reset"
msgstr "Ao redefinir"

#: block.py:339
msgid "Per Student"
msgstr "Por aluno"

#: block.py:343
msgid "XML data for the problem"
msgstr "Dados do XML para o problema"

#: block.py:349
msgid "Dictionary with the correctness of current student answers"
msgstr "Dicionário com as correções das respostas atuais do aluno"

#: block.py:351
msgid "List of correctness maps for each attempt"
msgstr "Lista de mapas de correção para cada tentativa"

#: block.py:352
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Dicionário para manutenção do status de tipos de entrada"

#: block.py:353
msgid "Dictionary with the current student responses"
msgstr "Dicionário com as respostas atuais do aluno"

#: block.py:355
msgid "List of student answers for each attempt"
msgstr "Lista de respostas dos alunos para cada tentativa"

#: block.py:359
msgid "Dictionary with the current student score"
msgstr "Dicionário com a pontuação atual do aluno"

#: block.py:361
msgid "List of scores for each attempt"
msgstr "Lista de pontuações para cada tentativa"

#: block.py:364
msgid "Whether or not the answers have been saved since last submit"
msgstr "Se as respostas foram salvas desde o último envio ou não"

#: block.py:366
msgid "Whether the student has answered the problem"
msgstr "Se o estudante respondeu o problema"

#: block.py:367
msgid "Random seed for this student"
msgstr "Base aleatória para este aluno"

#: block.py:368
msgid "Last submission time"
msgstr "Último horário de envio de tarefa"

#: block.py:370
msgid "Timer Between Attempts"
msgstr "Temporizador entre tentativas"

#: block.py:371
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Segundos que um aluno deve esperar entre envios para um problema com "
"múltiplas tentativas"

#: block.py:376
msgid "Problem Weight"
msgstr "Valor do problema"

#: block.py:378
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Define o número de pontos que cada problema vale. Se o valor não for "
"configurado, cada campo de resposta do problema valerá um ponto."

#: block.py:384
msgid "Markdown source of this module"
msgstr "Fonte de Markdown deste módulo"

#: block.py:386
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Código fonte para problemas do LaTeX e Word. Esta funcionalidade não é "
"suportada corretamente."

#: block.py:388
msgid "Enable LaTeX templates?"
msgstr "Ativar modelos LaTeX?"

#: block.py:390
msgid "Matlab API key"
msgstr "Chave API do Matlab"

#: block.py:392
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Digite a chave de API fornecida pela MathWorks para acessar o Serviço "
"Hospedado MATLAB. Esta chave é concedida para uso exclusivo neste curso na "
"duração especificada. Não compartilhar a chave de API com outros cursos. "
"Notificar MathWorks imediatamente se você acredita que a chave foi exposta "
"ou comprometida. Para obter uma chave para o seu curso, ou para relatar um "
"problema, por favor contate moocsupport@mathworks.com"

#: block.py:401
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Indica-se se o problema foi editado usando o editor Markdown no Authoring "
"MFE."

#: block.py:486
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Desculpe, ocorreu um erro durante o processamento da sua solicitação. Por "
"favor, recarregue a página e tente novamente."

#: block.py:491
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"O status deste problema mudou desde que esta página foi carregada. Por "
"favor, atualize a página."

#: block.py:811 block.py:828
msgid "Answer ID"
msgstr "Identificação da resposta"

#: block.py:812 block.py:829
msgid "Question"
msgstr "Pergunta"

#: block.py:813 block.py:830 capa/responsetypes.py:434
msgid "Answer"
msgstr "Resposta"

#: block.py:816
msgid "Correct Answer"
msgstr "Resposta Correta"

#: block.py:1062
msgid "Submit"
msgstr "Enviar"

#: block.py:1075
msgid "Submitting"
msgstr "Enviando"

#: block.py:1197
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Aviso: o problema foi redefinido com o seu status inicial!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1201
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"O status do problema foi corrompido por um envio inválido composto por:"

#: block.py:1208
msgid "If this error persists, please contact the course staff."
msgstr ""
"Se o erro persistir, por favor, entre em contato com a equipe do curso."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1263
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1269
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Sugestão ({hint_num} de {hints_count}):"

#: block.py:1350
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Suas respostas foram salvas anteriormente. Clique '{button_name}' para "
"corrigi-las."

#: block.py:1426
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Incorreto ({progress} ponto)"
msgstr[1] "Incorreta ({progress} pontos)"
msgstr[2] "Incorreta ({progress} pontos)"

#: block.py:1429 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Incorreto"

#: block.py:1433
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Correto ({progress} ponto)"
msgstr[1] "Correto ({progress} pontos)"
msgstr[2] "Correto ({progress} pontos)"

#: block.py:1436 capa/capa_problem.py:754
msgid "Correct"
msgstr "Correto"

#: block.py:1440
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Parcialmente correta ({progress} ponto)"
msgstr[1] "Parcialmente correta ({progress} pontos)"
msgstr[2] "Parcialmente correta ({progress} pontos)"

#: block.py:1445
msgid "Partially Correct"
msgstr "Parcialmente correto"

#: block.py:1447
msgid "Answer submitted."
msgstr "Resposta submetida."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1839 block.py:2163
msgid "Problem is closed."
msgstr "O problema está encerrado."

#: block.py:1845
msgid "Problem must be reset before it can be submitted again."
msgstr "O problema deve ser reiniciado antes de poder ser enviado novamente."

#: block.py:1855
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Você deve aguardar pelo menos {wait} segundos entre os envios."

#: block.py:1865
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Você deve esperar no mínimo {wait_secs} entre os envios. {remaining_secs} "
"restantes."

#: block.py:2038
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} horas"
msgstr[1] "{num_hour} horas"
msgstr[2] "{num_hour} horas"

#: block.py:2043
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minuto"
msgstr[1] "{num_minute} minutos"
msgstr[2] "{num_minute} minutos"

#: block.py:2049
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} segundo"
msgstr[1] "{num_second} segundos"
msgstr[2] "{num_second} segundos"

#: block.py:2171
msgid "Problem needs to be reset prior to save."
msgstr "O problema deve ser redefinido antes de salvar."

#: block.py:2180
msgid "Your answers have been saved."
msgstr "As suas respostas foram salvas."

#: block.py:2182
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Suas respostas foram salvas mas não avaliadas. Clique '{button_name}' para "
"corrigi-las."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2211
msgid "You cannot select Reset for a problem that is closed."
msgstr ""
"Você não pode selecionar Redefinir para um problema que esteja fechado."

#: block.py:2219
msgid "You must submit an answer before you can select Reset."
msgstr "Você deve enviar uma resposta antes de selecionar Redefinir."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2275
msgid "Problem's definition does not support rescoring."
msgstr "A definição do problema não suporta uma nova correção."

#: block.py:2280
msgid "Problem must be answered before it can be graded again."
msgstr "O problema deve ser respondido para poder ser avaliado novamente."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Não foi possível reavaliar os problemas com os possíveis envios de arquivos"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Questão {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "correta"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "incorreta"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "parcialmente correta"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "incompleto"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "não respondida"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "enviado"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "processando"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Esta resposta está correta."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Esta resposta está incorreta."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Esta resposta está parcialmente correta."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Esta resposta está sendo processada."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Não respondida ainda."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Selecionar uma opção"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "GrupoDeEscolha: marcação inesperada {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1717
msgid "Answer received."
msgstr "Resposta recebida."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Era esperada a marcação <choice> ou <compoundhint>, mas {given_tag} foi "
"obtida."

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Seus arquivos foram enviados. Assim que o seu exercício for avaliado, esta "
"mensagem será substituída pelo parecer do avaliador."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Sua resposta foi enviada. Assim que a sua tarefa for avaliada, esta mensagem"
" será substituída pelo parecer do avaliador."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "Editor de {programming_language}"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "Press ESC então TAB ou clique fora do editor de código para sair"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Enviado. Assim que houver uma resposta, esta mensagem será substituída pelo "
"parecer correspondente."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Sem resposta do Xqueue por {xqueue_timeout} segundos. Processo interrompido."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Erro ao executar código."

#: capa/inputtypes.py:982
msgid "Cannot connect to the queue"
msgstr "Não é possível conectar à fila"

#: capa/inputtypes.py:1215 capa/inputtypes.py:1299
msgid "No formula specified."
msgstr "Sem fórmula especificada."

#: capa/inputtypes.py:1221
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Não foi possível analisar a fórmula: {error_msg}"

#: capa/inputtypes.py:1225 capa/inputtypes.py:1321
msgid "Error while rendering preview"
msgstr "Erro ao renderizar a visualização"

#: capa/inputtypes.py:1317
msgid "Sorry, couldn't parse formula"
msgstr "Desculpe, não foi possível analisar a fórmula"

#: capa/inputtypes.py:1694
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: marcação inesperada {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1779
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Era esperada a marcação {expected_tag}, mas {given_tag} foi obtida."

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:278
#, python-brace-format
msgid "Question {index}"
msgstr "Questão {index}"

#: capa/responsetypes.py:389
msgid "Correct:"
msgstr "Correto:"

#: capa/responsetypes.py:391
msgid "Incorrect:"
msgstr "A resposta está incorreta:"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Ocorreu um erro {err} ao avaliar a função de sugestão {hintfn}."

#: capa/responsetypes.py:514
msgid "(Source code line unavailable)"
msgstr "(A linha de código fonte não está disponível)"

#: capa/responsetypes.py:515
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Veja a linha do código fonte em XML {sourcenum}."

#: capa/responsetypes.py:683
msgid "Checkboxes"
msgstr "Caixas de seleção"

#: capa/responsetypes.py:1013
msgid "Multiple Choice"
msgstr "Múltipla escolha"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1234
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Não use shuffle e answer-pool ao mesmo tempo"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1317
msgid "answer-pool value should be an integer"
msgstr "O valor de resposta-questionário deve ser um número inteiro"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1384
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr ""
"O GrupoDeEscolha deve incluir pelo menos 1 resposta correta e 1 incorreta"

#: capa/responsetypes.py:1409
msgid "True/False Choice"
msgstr "Questão Verdadeiro/Falso"

#: capa/responsetypes.py:1454
msgid "Dropdown"
msgstr "Menu de Seleção"

#: capa/responsetypes.py:1532
msgid "Numerical Input"
msgstr "Entrada numérica"

#: capa/responsetypes.py:1568 capa/responsetypes.py:1595
msgid "There was a problem with the staff answer to this problem."
msgstr "Houve um problema com a resposta da equipe para este problema."

#: capa/responsetypes.py:1618
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Não foi possível interpretar '{student_answer}' como um número."

#: capa/responsetypes.py:1636
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr ""
"A Função Fatorial foi avaliada fora do seu domínio: '{student_answer}'"

#: capa/responsetypes.py:1643
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Sintaxe matemática inválida: '{student_answer}'"

#: capa/responsetypes.py:1674
msgid "You may not use complex numbers in range tolerance problems"
msgstr ""
"Não é permitido usar números complexos em problemas com tolerância de "
"variação"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1682
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Houve um problema com a resposta da equipe para este problema: limite "
"complexo."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1688
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr ""
"Houve um problema com a resposta da equipe para este problema: limite vazio."

#. Translators: Separator used in NumericalResponse to display multiple
