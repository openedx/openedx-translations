#: block.py:236
msgid "Display Name"
msgstr "Vertoon Naam"

#: block.py:237
msgid "The display name for this component."
msgstr "Die vertoonnaam vir hierdie komponent."

#: block.py:241
msgid "Blank Problem"
msgstr "Leë probleem"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Aantal pogings wat die student op hierdie probleem geneem het"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Maksimum pogings"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Definieer die aantal kere wat &#39;n student kan probeer om hierdie probleem"
" te beantwoord. As die waarde nie gestel is nie, word oneindige pogings "
"toegelaat."

#: block.py:256
msgid "Grading Method"
msgstr "Graderingsmetode"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Definieer die graderingsmetode vir hierdie probleem. By verstek is dit die "
"telling van die laaste voorlegging wat deur die student gemaak is."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Laaste telling"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Eerste telling"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Hoogste telling"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Gemiddelde telling"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Datum waarop hierdie probleem verskuldig is"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Hoeveelheid tyd na die sperdatum wat voorleggings aanvaar sal word"

#: block.py:275
msgid "Show Results"
msgstr "Wys resultate"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Definieer wanneer om te wys of 'n leerder se antwoord op die probleem korrek"
" is. Gekonfigureer op die onderafdeling."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Altyd"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Nooit nie"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Verlede"

#: block.py:288
msgid "Show Answer"
msgstr "Wys antwoord"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Definieer wanneer om die antwoord op die probleem te wys. 'n Standaardwaarde"
" kan in Gevorderde instellings gestel word."

#: block.py:294
msgid "Answered"
msgstr "Beantwoord"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Poging of Verval"

#: block.py:296
msgid "Closed"
msgstr "Gesluit"

#: block.py:297
msgid "Finished"
msgstr "Klaar"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Korrek of agterstallig"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Na 'n aantal pogings"

#: block.py:302
msgid "After All Attempts"
msgstr "Na alle pogings"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Na alle pogings of korrek"

#: block.py:304
msgid "Attempted"
msgstr "Poging"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Wys Antwoord: Aantal pogings"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Aantal kere wat die student moet probeer om die vraag te beantwoord voordat "
"die Wys Antwoord-knoppie verskyn."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Of die stoorknoppie moet dwing om op die bladsy te verskyn"

#: block.py:320
msgid "Show Reset Button"
msgstr "Wys Herstel-knoppie"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Bepaal of 'n 'Herstel'-knoppie gewys word sodat die gebruiker hul antwoord "
"kan terugstel. 'n Standaardwaarde kan in Gevorderde instellings gestel word."

#: block.py:329
msgid "Randomization"
msgstr "Randomisering"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Definieer wanneer om die veranderlikes wat in die geassosieerde Python-skrif"
" gespesifiseer word, ewekansig te maak. Vir probleme wat nie waardes "
"ewekansig maak nie, spesifiseer \"Nooit\". "

#: block.py:338
msgid "On Reset"
msgstr "Op Herstel"

#: block.py:340
msgid "Per Student"
msgstr "Per Student"

#: block.py:344
msgid "XML data for the problem"
msgstr "XML-data vir die probleem"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Woordeboek met die korrektheid van huidige studenteantwoorde"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Lys van korrektheid kaarte vir elke poging"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Woordeboek vir die handhawing van die toestand van invoertipes"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Woordeboek met die huidige studenteantwoorde"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Lys van studenteantwoorde vir elke poging"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Woordeboek met die huidige studentetelling"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Lys van tellings vir elke poging"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Of die antwoorde sedert die laaste indiening gestoor is of nie"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Of die student die probleem beantwoord het"

#: block.py:368
msgid "Random seed for this student"
msgstr "Willekeurige saad vir hierdie student"

#: block.py:369
msgid "Last submission time"
msgstr "Laaste inhandigingstyd"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Timer tussen pogings"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Sekondes moet 'n student wag tussen voorleggings vir 'n probleem met "
"veelvuldige pogings."

#: block.py:377
msgid "Problem Weight"
msgstr "Probleem Gewig"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Definieer die aantal punte wat elke probleem werd is. As die waarde nie "
"gestel is nie, is elke antwoordveld in die probleem een punt werd."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Afmerkbron van hierdie module"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Bronkode vir LaTeX- en Word-probleme. Hierdie kenmerk word nie goed "
"ondersteun nie."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Aktiveer LaTeX-sjablone?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Dui aan of die probleem geredigeer is deur die Markdown-redigeerder in die "
"Authoring MFE te gebruik."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Ons is jammer, daar was 'n fout met die verwerking van jou versoek. Probeer "
"asseblief om jou bladsy te herlaai en probeer weer."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Die toestand van hierdie probleem het verander sedert jy hierdie bladsy "
"gelaai het. Herlaai asseblief jou bladsy."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "Antwoord ID"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Vraag"

#: block.py:810 block.py:827 capa/responsetypes.py:431
msgid "Answer"
msgstr "Antwoord"

#: block.py:813
msgid "Correct Answer"
msgstr "Korrekte antwoord"

#: block.py:1058
msgid "Submit"
msgstr "Indien"

#: block.py:1071
msgid "Submitting"
msgstr "Dien tans in"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Waarskuwing: Die probleem is teruggestel na sy aanvanklike toestand!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Die probleem se toestand is beskadig deur 'n ongeldige indiening. Die "
"voorlegging het bestaan uit:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "As hierdie fout voortduur, kontak asseblief die kursuspersoneel."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Wenk ( {hint_num} van {hints_count} ): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Jou antwoorde is voorheen gestoor. Klik '{button_name}' om hulle te gradeer."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Verkeerd ( {progress} punt)"
msgstr[1] "Verkeerd ( {progress} punte)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Verkeerd"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Korrek ( {progress} punt)"
msgstr[1] "Korrek ( {progress} punte)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Korrek"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Gedeeltelik korrek ( {progress} punt)"
msgstr[1] "Gedeeltelik korrek ( {progress} punte)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Gedeeltelik korrek"

#: block.py:1443
msgid "Answer submitted."
msgstr "Antwoord ingedien."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Probleem is gesluit."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Probleem moet teruggestel word voordat dit weer ingedien kan word."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Jy moet ten minste {wait} sekondes wag tussen voorleggings."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Jy moet ten minste {wait_secs} wag tussen voorleggings. {remaining_secs} "
"oor."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} uur"
msgstr[1] "{num_hour} ure"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minuut"
msgstr[1] "{num_minute} minute"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} tweede"
msgstr[1] "{num_second} sekondes"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Probleem moet teruggestel word voordat dit gestoor word."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Jou antwoorde is gestoor."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Jou antwoorde is gestoor, maar nie gegradeer nie. Klik '{button_name}' om "
"hulle te gradeer."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Jy kan nie Herstel kies vir 'n probleem wat gesluit is nie."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Jy moet 'n antwoord indien voordat jy Herstel kan kies."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Probleem se definisie ondersteun nie hertelling nie."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Probleem moet beantwoord word voordat dit weer gegradeer kan word."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "Kan nie probleme met moontlike lêervoorleggings herstel nie"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Vraag {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "korrek"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "verkeerd"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "gedeeltelik korrek"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "onvolledig"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "onbeantwoord"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "ingedien"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "verwerking"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Hierdie antwoord is korrek."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Hierdie antwoord is verkeerd."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Hierdie antwoord is gedeeltelik korrek."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Hierdie antwoord word verwerk."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Nog nie beantwoord nie."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Kies 'n opsie"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "Keusegroep: onverwagte merker {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Antwoord ontvang."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Verwag a<choice> of<compoundhint> merker; het eerder {given_tag} gekry"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Jou lêers is ingedien. Sodra jou voorlegging gegradeer is, sal hierdie "
"boodskap vervang word met die gradeerder se terugvoer."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Jou antwoord is ingedien. Sodra jou voorlegging gegradeer is, sal hierdie "
"boodskap vervang word met die gradeerder se terugvoer."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} redakteur"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "Druk ESC en dan TAB of klik buite die koderedigeerder om af te sluit"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Geen formule gespesifiseer nie."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Kon nie formule: {error_msg} ontleed nie"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Fout tydens die lewering van voorskou"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Jammer, kon nie formule ontleed nie"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : onverwagte merker {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Verwag 'n {expected_tag} merker; het eerder {given_tag} gekry"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:275
#, python-brace-format
msgid "Question {index}"
msgstr "Vraag {index}"

#: capa/responsetypes.py:386
msgid "Correct:"
msgstr "Korrek:"

#: capa/responsetypes.py:388
msgid "Incorrect:"
msgstr "Verkeerd:"

#: capa/responsetypes.py:511
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Fout {err} met die evaluering van wenkfunksie {hintfn} ."

#: capa/responsetypes.py:512
msgid "(Source code line unavailable)"
msgstr "(Bronkodereël nie beskikbaar nie)"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Sien XML-bronreël {sourcenum} ."

#: capa/responsetypes.py:681
msgid "Checkboxes"
msgstr "Merkblokkies"

#: capa/responsetypes.py:1011
msgid "Multiple Choice"
msgstr "Meervoudige Keuse"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1232
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Moenie skuifel en antwoordpoel gelyktydig gebruik nie"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1315
msgid "answer-pool value should be an integer"
msgstr "antwoordpoelwaarde moet 'n heelgetal wees"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1382
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr "Keusegroep moet ten minste 1 korrekte en 1 verkeerde keuse insluit"

#: capa/responsetypes.py:1407
msgid "True/False Choice"
msgstr "Ware/Onwaar Keuse"

#: capa/responsetypes.py:1452
msgid "Dropdown"
msgstr "Aftreklys"

#: capa/responsetypes.py:1530
msgid "Numerical Input"
msgstr "Numeriese Invoer"

#: capa/responsetypes.py:1566 capa/responsetypes.py:1593
msgid "There was a problem with the staff answer to this problem."
msgstr ""
"Daar was 'n probleem met die personeel se antwoord op hierdie probleem."

#: capa/responsetypes.py:1616
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Kon nie '{student_answer}' as 'n getal interpreteer nie."

#: capa/responsetypes.py:1634
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Faktoriale funksie buite sy domein geëvalueer:'{student_answer}'"

#: capa/responsetypes.py:1641
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Ongeldige wiskundige sintaksis: '{student_answer}'"

#: capa/responsetypes.py:1672
msgid "You may not use complex numbers in range tolerance problems"
msgstr "Jy mag nie komplekse getalle in reekstoleransieprobleme gebruik nie"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1680
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Daar was 'n probleem met die personeel se antwoord op hierdie probleem: "
"komplekse grens."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1686
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr ""
"Daar was 'n probleem met die personeel se antwoord op hierdie probleem: leë "
"grens."

#. Translators: Separator used in NumericalResponse to display multiple
#. answers.
#. Translators: Separator used in StringResponse to display multiple answers.
#. Example: "Answer: Answer_1 or Answer_2 or Answer_3".
#: capa/responsetypes.py:1794 capa/responsetypes.py:2071
msgid "or"
msgstr "of"

#: capa/responsetypes.py:1872
msgid "Text Input"
msgstr "Teksinvoer"

#: capa/responsetypes.py:2043
msgid "error"
msgstr "fout"

#: capa/responsetypes.py:2085
msgid "Custom Evaluated Script"
msgstr "Pasgemaakte Geëvalueerde Skrip"

#: capa/responsetypes.py:2195
#, python-brace-format
msgid "error getting student answer from {student_answers}"
msgstr "fout kry studenteantwoord van {student_answers}"

#: capa/responsetypes.py:2219
msgid "No answer entered!"
msgstr "Geen antwoord ingevoer nie!"

#: capa/responsetypes.py:2436
msgid "CustomResponse: check function returned an invalid dictionary!"
msgstr "CustomResponse: tjekfunksie het 'n ongeldige woordeboek teruggegee!"

#: capa/responsetypes.py:2528
msgid "Symbolic Math Input"
msgstr "Simboliese wiskunde-invoer"

#: capa/responsetypes.py:2608
msgid "Code Input"
msgstr "Kode Invoer"

#: capa/responsetypes.py:2657
msgid "No answer provided."
msgstr "Geen antwoord verskaf nie."

#: capa/responsetypes.py:2679
