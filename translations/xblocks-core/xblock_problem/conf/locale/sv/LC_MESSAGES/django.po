#: block.py:236
msgid "Display Name"
msgstr "Visningsnamn"

#: block.py:237
msgid "The display name for this component."
msgstr "Visningsnamnet för den här komponenten."

#: block.py:241
msgid "Blank Problem"
msgstr "Tomt problem"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Antal försök som studenten har gjort på detta problem"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Maximala försök"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Definierar hur många gånger en elev kan försöka svara på det här problemet. "
"Om värdet inte är inställt är oändliga försök tillåtna."

#: block.py:256
msgid "Grading Method"
msgstr "Betygsmetod"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Definiera betygsmetoden för detta problem. Som standard är det poängen från "
"den senaste inlämningen som studenten gjort."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Senaste poäng"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Första poäng"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Högsta poäng"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Genomsnittlig poäng"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Datum då detta problem beror på"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Mängd tid efter förfallodagen att inlämnanden kommer att accepteras"

#: block.py:275
msgid "Show Results"
msgstr "Visa resultat"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Definierar när det ska visas om en elevs svar på problemet är korrekt. "
"Konfigureras på underavsnittet."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Alltid"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Aldrig"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Gått över tiden"

#: block.py:288
msgid "Show Answer"
msgstr "Visa svar"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Definierar när svaret på problemet ska visas. Ett standardvärde kan ställas "
"in i Avancerade Inställningar."

#: block.py:294
msgid "Answered"
msgstr "svarade"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Försökt eller förfallna"

#: block.py:296
msgid "Closed"
msgstr "Stängd"

#: block.py:297
msgid "Finished"
msgstr "Färdiga"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Rätt eller förfallna"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Efter ett antal försök"

#: block.py:302
msgid "After All Attempts"
msgstr "Efter alla försök"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Efter alla försök eller korrekt"

#: block.py:304
msgid "Attempted"
msgstr "Försökte"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Visa svar: Antal försök"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Antal gånger eleven måste försöka svara på frågan innan knappen Visa svar "
"visas."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Om du vill tvinga spara knappen för att visas på sidan"

#: block.py:320
msgid "Show Reset Button"
msgstr "Visa Återställningsknappen"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Avgör om en 'Återställ'-knapp visas så att användaren kan återställa sitt "
"svar. Ett standardvärde kan ställas in i Avancerade Inställningar."

#: block.py:329
msgid "Randomization"
msgstr "randomisering"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Definierar när du vill randomisera variablerna som anges i det tillhörande "
"Python-skriptet. För problem som inte randomiserar värden, ange \"Aldrig\". "

#: block.py:338
msgid "On Reset"
msgstr "Vid återställning"

#: block.py:340
msgid "Per Student"
msgstr "Per student"

#: block.py:344
msgid "XML data for the problem"
msgstr "XML-data för problemet"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Ordlista med korrektheten av nuvarande student svar"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Lista över korrekthetskartor för varje försök"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Ordbok för att upprätthålla tillståndet för inputtyper"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Ordbok med aktuella studentreaktioner"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Lista över studenternas svar för varje försök"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Ordbok med nuvarande studentpoäng"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Lista över poäng för varje försök"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Huruvida svaren har sparats sedan senaste inlämning"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Huruvida studenten har svarat på problemet"

#: block.py:368
msgid "Random seed for this student"
msgstr "Slumptal för denna student"

#: block.py:369
msgid "Last submission time"
msgstr "Senaste inlämningstid"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Timer mellan försök"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Sekunder en elev måste vänta mellan inlämningar för ett problem med flera "
"försök."

#: block.py:377
msgid "Problem Weight"
msgstr "Problem Vikt"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Definierar antalet poäng varje problem är värt. Om värdet inte är inställt, "
"är varje svarsfält i problemet värt en poäng."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Markdown-källan för denna modul"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Källkod för LaTeX- och Word-problem. Den här funktionen stöds inte väl."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Aktivera LaTeX mallar?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Anger om problemet redigerades med Markdown-redigeraren i Authoring MFE."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Vi beklagar att det hade uppstått ett fel vid behandlingen av din förfrågan."
" Försök ladda om sidan och försök igen."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Det här problemet har förändrats sedan du laddade den här sidan. Uppdatera "
"sidan."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "Svars-id"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Fråga"

#: block.py:810 block.py:827 capa/responsetypes.py:431
msgid "Answer"
msgstr "Svar"

#: block.py:813
msgid "Correct Answer"
msgstr "Rätt svar"

#: block.py:1058
msgid "Submit"
msgstr "Skicka"

#: block.py:1071
msgid "Submitting"
msgstr "Skicka in"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Varning: Problemet har återställts till sitt ursprungliga tillstånd!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Problemets tillstånd var korrumperat av en ogiltig inlämning. Inlämnandet "
"bestod av:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "Om detta fel kvarstår, vänligen kontakta kursansvarig."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Tips ({hint_num} av {hints_count}): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Dina svar sparades tidigare. Klicka på '{button_name}' för att betygsätta "
"dem."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Fel ({progress} poäng)"
msgstr[1] "Fel ({progress} poäng)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Felaktig"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Korrekt ({progress} poäng)"
msgstr[1] "Korrekt ({progress} poäng)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Rätt"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Delvis korrekt ({progress} poäng)"
msgstr[1] "Delvis korrekt ({progress} poäng)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Delvis korrekt"

#: block.py:1443
msgid "Answer submitted."
msgstr "Svar skickat."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Problemet är stängt."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Problemet måste återställas innan det kan skickas in igen."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Du måste vänta minst {wait} sekunder mellan inlämningarna."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Du måste vänta minst {wait_secs} mellan inlägg. {remaining_secs} kvar."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} timme"
msgstr[1] "{num_hour} timmar"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minut"
msgstr[1] "{num_minute} minuter"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} sekund"
msgstr[1] "{num_second} sekunder"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Problemet måste återställas innan du sparar."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Dina svar har sparats."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Dina svar har blivit sparade men inte betygsatta. Klicka på '{button_name}' "
"för att betygsätta dem."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Du kan inte välja Återställ för ett problem som är stängt."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Du måste skicka ett svar innan du kan välja Återställ."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Problemets definition stöder inte återställning."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Problemet måste besvaras innan det kan graderas igen."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "Det går inte att lösa problem med möjliga filinsatser"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Fråga {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "rätt"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "felaktig"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "delvis rätt"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "Ofullständig"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "obesvarad"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "inlämnad"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "bearbetar"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Detta svar är korrekt."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Detta svar är felaktigt."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Detta svar är delvis korrekt."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Detta svar behandlas."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Inte besvarad än."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Välj ett alternativ"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: oväntad tagg {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Svar mottaget."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr "<choice> eller <compoundhint> taggen förväntades, inte {given_tag}"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Dina filer har skickats in. Så snart din inlämning är graderad kommer detta "
"meddelande att ersättas med graderens feedback."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Ditt svar har skickats in. Så snart din inlämning är graderad kommer detta "
"meddelande att ersättas med graderens feedback."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} redaktör"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Tryck på ESC sedan TAB eller klicka utanför kodredigeraren för att avsluta"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Ingen angiven formel."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Det gick inte att analysera formeln: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Ett fel uppstod när förhandsvisning gjordes"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Ursäkta, kunde inte tolka formeln"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: oväntad tag {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Förväntade en {expected_tag} tagg; fick {given_tag} istället"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:275
#, python-brace-format
msgid "Question {index}"
msgstr "Fråga {index}"

#: capa/responsetypes.py:386
msgid "Correct:"
msgstr "Rätt:"

#: capa/responsetypes.py:388
msgid "Incorrect:"
msgstr "Felaktig"

#: capa/responsetypes.py:511
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Fel {err} vid utvärdering av tipsfunktion {hintfn}."

#: capa/responsetypes.py:512
msgid "(Source code line unavailable)"
msgstr "(Rad för källkod ej tillgänglig)"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Se XML-källrad {sourcenum}."

#: capa/responsetypes.py:681
msgid "Checkboxes"
msgstr "kryss~~POS=TRUNC"

#: capa/responsetypes.py:1011
msgid "Multiple Choice"
msgstr "Flera val"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1232
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Använd inte shuffle och answer-pool samtidigt"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1315
msgid "answer-pool value should be an integer"
msgstr "värdet för svarspoolen ska vara ett heltal"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1382
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr "Valgrupp måste innehålla minst 1 korrekt och 1 felaktigt val"

#: capa/responsetypes.py:1407
msgid "True/False Choice"
msgstr "True / False Choice"

#: capa/responsetypes.py:1452
msgid "Dropdown"
msgstr "Rullgardinsmeny"

#: capa/responsetypes.py:1530
msgid "Numerical Input"
msgstr "Numerisk inmatning"

#: capa/responsetypes.py:1566 capa/responsetypes.py:1593
msgid "There was a problem with the staff answer to this problem."
msgstr "Det var ett problem med personalen svar på detta problem."

#: capa/responsetypes.py:1616
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Kunde inte tolka &quot;{student_answer}&quot; som ett nummer."

#: capa/responsetypes.py:1634
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Faktoriell funktion utvärderad utanför dess domän: '{student_answer}'"

#: capa/responsetypes.py:1641
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Ogiltig matematiksyntax: '{student_answer}'"

#: capa/responsetypes.py:1672
msgid "You may not use complex numbers in range tolerance problems"
msgstr "Du får inte använda komplexa tal inom toleransproblem"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1680
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Det var ett problem med personalen svar på det här problemet: komplicerad "
"gräns."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1686
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr ""
"Det var ett problem med personalens svar på det här problemet: tom gräns."

#. Translators: Separator used in NumericalResponse to display multiple
#. answers.
#. Translators: Separator used in StringResponse to display multiple answers.
#. Example: "Answer: Answer_1 or Answer_2 or Answer_3".
#: capa/responsetypes.py:1794 capa/responsetypes.py:2071
msgid "or"
msgstr "eller"

#: capa/responsetypes.py:1872
msgid "Text Input"
msgstr "Textinmatning"

#: capa/responsetypes.py:2043
msgid "error"
msgstr "fel"

#: capa/responsetypes.py:2085
msgid "Custom Evaluated Script"
msgstr "Anpassad utvärderad Script"

#: capa/responsetypes.py:2195
#, python-brace-format
msgid "error getting student answer from {student_answers}"
msgstr "fel att få student svar från {student_answers}"

#: capa/responsetypes.py:2219
msgid "No answer entered!"
msgstr "Inget svar inmatat!"

#: capa/responsetypes.py:2436
msgid "CustomResponse: check function returned an invalid dictionary!"
msgstr "CustomResponse: checkfunktionen returnerade en ogiltig ordlista!"

#: capa/responsetypes.py:2528
msgid "Symbolic Math Input"
msgstr "Symbolisk matematisk ingång"

#: capa/responsetypes.py:2608
msgid "Code Input"
msgstr "Kodinmatning"

#: capa/responsetypes.py:2657
msgid "No answer provided."
msgstr "Inget svar angivet."

#: capa/responsetypes.py:2679
msgid "MATLAB problems can no longer be graded."
msgstr "MATLAB-problem kan inte längre bedömas."

#: capa/responsetypes.py:2684
msgid "Error: No grader has been set up for this problem."
msgstr "Fel: Ingen grader har ställts in för detta problem."

#: capa/responsetypes.py:2747
#, python-brace-format
msgid ""
"Unable to deliver your submission to grader (Reason: {error_msg}). Please "
"try again later."
msgstr ""
"Det gick inte att leverera din inlämning till grader (Orsak: {error_msg}). "
"Vänligen försök igen senare."

#. Translators: 'grader' refers to the edX automatic code grader.
#: capa/responsetypes.py:2770
msgid "Invalid grader reply. Please contact the course staff."
msgstr "Ogiltigt svar från bedömaren. Vänligen kontakta kursens personal."

#: capa/responsetypes.py:2880
msgid "External Grader"
msgstr "Extern grader"

#: capa/responsetypes.py:3031
msgid "Math Expression Input"
msgstr "Inmatning av matematiskt uttryck"

#: capa/responsetypes.py:3118
