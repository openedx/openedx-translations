#: block.py:236
msgid "Display Name"
msgstr "Ko‘rsatiladigan ism"

#: block.py:237
msgid "The display name for this component."
msgstr "Ushbu komponent uchun ko'rsatiladigan nom."

#: block.py:241
msgid "Blank Problem"
msgstr "Bo'sh muammo"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Ushbu muammo bo'yicha talaba tomonidan qilingan urinishlar soni"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Maksimal urinishlar"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Talaba bu masalaga necha marta javob berishga harakat qilishi mumkinligini "
"belgilaydi. Agar qiymat o‘rnatilmagan bo‘lsa, cheksiz urinishlarga ruxsat "
"beriladi."

#: block.py:256
msgid "Grading Method"
msgstr "Baholash usuli"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Ushbu muammoni baholash usulini aniqlang. Odatiy bo'lib, bu talaba tomonidan"
" taqdim etilgan oxirgi taqdimotning ballidir."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Oxirgi ball"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Birinchi ball"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Eng yuqori ball"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "O'rtacha ball"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Ushbu muammo yuzaga kelgan sana"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Murojaatlarni qabul qilish muddati tugagandan keyingi vaqt miqdori"

#: block.py:275
msgid "Show Results"
msgstr "Natijalarni ko'rsatish"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"O'quvchining muammoga bergan javobi to'g'ri yoki yo'qligini ko'rsatishni "
"belgilaydi. Pastki bo'limda sozlangan."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Har doim"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Hech qachon"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Muddati o‘tgan"

#: block.py:288
msgid "Show Answer"
msgstr "Javobni ko‘rsatish"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Muammoning javobini qachon ko'rsatishni belgilaydi. Standart qiymat "
"Kengaytirilgan sozlamalarda o'rnatilishi mumkin."

#: block.py:294
msgid "Answered"
msgstr "Javob berdi"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Urinish yoki muddati o‘tgan"

#: block.py:296
msgid "Closed"
msgstr "Yopiq"

#: block.py:297
msgid "Finished"
msgstr "Tugallandi"

#: block.py:298
msgid "Correct or Past Due"
msgstr "To‘g‘ri yoki muddati o‘tgan"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Bir necha urinishlardan keyin"

#: block.py:302
msgid "After All Attempts"
msgstr "Barcha urinishlardan keyin"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Barcha urinishlardan keyin yoki to‘g‘ri"

#: block.py:304
msgid "Attempted"
msgstr "Urinish"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Javobni ko'rsatish: Urinishlar soni"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Javobni ko'rsatish tugmasi paydo bo'lgunga qadar talaba savolga javob "
"berishga urinishlar soni."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Saqlash tugmasi sahifada paydo bo'lishiga majbur qilish kerakmi"

#: block.py:320
msgid "Show Reset Button"
msgstr "Qayta tiklash tugmachasini ko'rsatish"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Foydalanuvchi o'z javobini qayta o'rnatishi uchun \"Qayta o'rnatish\" "
"tugmasi ko'rsatilishini aniqlaydi. Standart qiymat Kengaytirilgan "
"sozlamalarda o'rnatilishi mumkin."

#: block.py:329
msgid "Randomization"
msgstr "Tasodifiylashtirish"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Bog'langan Python skriptida ko'rsatilgan o'zgaruvchilarni qachon "
"randomizatsiya qilishni belgilaydi. Qiymatlar tasodifiy bo'lmagan muammolar "
"uchun \"Hech qachon\" ni belgilang. "

#: block.py:338
msgid "On Reset"
msgstr "Qayta tiklashda"

#: block.py:340
msgid "Per Student"
msgstr "Talaba uchun"

#: block.py:344
msgid "XML data for the problem"
msgstr "Muammo uchun XML ma'lumotlari"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Talabalarning joriy javoblarining to'g'riligi bilan lug'at"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Har bir urinish uchun to'g'rilik xaritalari ro'yxati"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Kirish turlari holatini saqlash uchun lug'at"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Talabalarning hozirgi javoblari bilan lug'at"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Har bir urinish uchun talabalar javoblari ro'yxati"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Talabaning joriy balli bilan lug'at"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Har bir urinish uchun ballar ro'yxati"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Javoblar oxirgi yuborilganidan keyin saqlanganmi yoki yo'qmi"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Talaba muammoga javob berdimi"

#: block.py:368
msgid "Random seed for this student"
msgstr "Bu talaba uchun tasodifiy urug'"

#: block.py:369
msgid "Last submission time"
msgstr "Oxirgi topshirish vaqti"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Urinishlar orasidagi taymer"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Talaba bir nechta urinishlar bilan bog'liq muammoni topshirishlar orasida "
"bir necha soniya kutishi kerak."

#: block.py:377
msgid "Problem Weight"
msgstr "Muammo qiyinligi"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Har bir muammoga arziydigan ball sonini belgilaydi. Agar qiymat "
"o'rnatilmagan bo'lsa, muammodagi har bir javob maydoni bir ballga teng "
"bo'ladi."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Ushbu modulning markdown manbasi"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"LaTeX va Word muammolari uchun manba kodi. Bu xususiyat yaxshi qo'llab-"
"quvvatlanmaydi."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "LaTeX andozalari yoqilsinmi?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Muammo Authoring MFE-dagi Markdown muharriri yordamida tahrirlanganligini "
"ko'rsatadi."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Kechirasiz, so‘rovingizni ko‘rib chiqishda xatolik yuz berdi. Iltimos, "
"sahifangizni qayta yuklang va qaytadan urining."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Ushbu sahifani yuklaganingizdan beri bu muammoning holati o'zgardi. Iltimos,"
" sahifangizni yangilang."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "Javob identifikatori"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Savol"

#: block.py:810 block.py:827 capa/responsetypes.py:432
msgid "Answer"
msgstr "Javob"

#: block.py:813
msgid "Correct Answer"
msgstr "To'g'ri javob"

#: block.py:1058
msgid "Submit"
msgstr "Yuborish"

#: block.py:1071
msgid "Submitting"
msgstr "Yuborish"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Ogohlantirish: Muammo dastlabki holatiga qaytarildi!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Muammoning holati noto‘g‘ri taqdimnoma tufayli buzilgan. Taqdimot "
"quyidagilardan iborat edi:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "Agar bu xato davom etsa, kurs xodimlariga murojaat qiling."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Maslahat ( {hint_num} / {hints_count} ): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Javoblaringiz avval saqlangan. Ularni baholash uchun “{button_name}” "
"tugmasini bosing."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Noto'g'ri ( {progress} ball)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Noto‘g‘ri"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "To'g'ri ( {progress} ball)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "To‘g‘ri"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Qisman to'g'ri ( {progress} ball)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Qisman To'g'ri"

#: block.py:1443
msgid "Answer submitted."
msgstr "Javob yuborildi."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Muammo yopildi."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Muammoni qayta yuborishdan oldin uni qayta tiklash kerak."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Taqdimotlar orasida kamida {wait} soniya kutishingiz kerak."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Taqdimotlar orasida kamida {wait_secs} kutishingiz kerak. {remaining_secs} "
"qoldi."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} soat"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} daqiqa"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} soniya"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Saqlashdan oldin muammoni qayta tiklash kerak."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Javoblaringiz saqlandi."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Javoblaringiz saqlangan, lekin baholanmagan. Ularni baholash uchun "
"“{button_name}” tugmasini bosing."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Yopiq muammo uchun Reset ni tanlay olmaysiz."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Qayta tiklashni tanlashdan oldin javob yuborishingiz kerak."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Muammoning ta'rifi qayta baholashni qo'llab-quvvatlamaydi."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Muammoni qayta baholashdan oldin unga javob berish kerak."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Mumkin bo'lgan fayllarni yuborish bilan bog'liq muammolarni bartaraf etib "
"bo'lmaydi"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Savol {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "to'g'ri"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "noto'g'ri"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "qisman to'g'ri"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "to'liqsiz"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "javobsiz"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "topshirildi"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "qayta ishlash"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Bu javob to'g'ri."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Bu javob noto'g'ri."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Bu javob qisman to'g'ri."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Bu javob qayta ishlanmoqda."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Hali javob berilmagan."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Variantni tanlang"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: kutilmagan teg {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Javob qabul qilindi."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Kutilayotgan a<choice> yoki<compoundhint> teg; o'rniga {given_tag} oldi"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Fayllaringiz yuborildi. Taqdimotingiz baholanishi bilan bu xabar "
"baholovchining fikr-mulohazasi bilan almashtiriladi."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Javobingiz yuborildi. Taqdimotingiz baholanishi bilan bu xabar "
"baholovchining fikr-mulohazasi bilan almashtiriladi."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} muharriri"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Chiqish uchun ESC, keyin TAB tugmasini bosing yoki kod muharriridan "
"tashqariga bosing"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Hech qanday formula belgilanmagan."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Formulani tahlil qilib bo‘lmadi: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Ko‘rib chiqishda xatolik yuz berdi"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Kechirasiz, formulani tahlil qilib boʻlmadi"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : kutilmagan teg {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "{expected_tag} tegi kutilmoqda; o'rniga {given_tag} oldi"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
msgid "Question {index}"
msgstr "Savol {index}"

#: capa/responsetypes.py:387
msgid "Correct:"
msgstr "To'g'ri:"

#: capa/responsetypes.py:389
msgid "Incorrect:"
msgstr "Noto'g'ri:"

#: capa/responsetypes.py:512
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Maslahat funktsiyasini baholashda xato {err} {hintfn} ."

#: capa/responsetypes.py:513
msgid "(Source code line unavailable)"
msgstr "(Manba kod qatori mavjud emas)"

#: capa/responsetypes.py:514
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "XML manba qatoriga qarang {sourcenum} ."

#: capa/responsetypes.py:682
msgid "Checkboxes"
msgstr "Belgilash katakchalari"

#: capa/responsetypes.py:1012
msgid "Multiple Choice"
msgstr "Ko'p tanlov"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1233
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Bir vaqtning o'zida aralash va javob pulidan foydalanmang"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1316
msgid "answer-pool value should be an integer"
msgstr "javob pulining qiymati butun son bo'lishi kerak"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1383
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr ""
"Tanlov guruhi kamida 1 ta toʻgʻri va 1 ta notoʻgʻri tanlovni oʻz ichiga "
"olishi kerak"

#: capa/responsetypes.py:1408
msgid "True/False Choice"
msgstr "To'g'ri/noto'g'ri tanlov"

#: capa/responsetypes.py:1453
msgid "Dropdown"
msgstr "Ochiladigan ro'yxat"

#: capa/responsetypes.py:1531
msgid "Numerical Input"
msgstr "Raqamli kiritish"

#: capa/responsetypes.py:1567 capa/responsetypes.py:1594
msgid "There was a problem with the staff answer to this problem."
msgstr "Bu muammoga xodimlar javob berishda muammo yuzaga keldi."

#: capa/responsetypes.py:1617
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "“{student_answer}”ni raqam sifatida izohlab bo‘lmadi."

#: capa/responsetypes.py:1635
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr ""
"Faktorial funksiya uning domenidan tashqarida baholanadi:'{student_answer}'"

#: capa/responsetypes.py:1642
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Matematik sintaksisi noto‘g‘ri: '{student_answer}'"

#: capa/responsetypes.py:1673
msgid "You may not use complex numbers in range tolerance problems"
msgstr ""
"Diapazonga chidamlilik muammolarida murakkab raqamlardan foydalana olmaysiz"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1681
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr "Bu muammoga xodimlar javobida muammo bor edi: murakkab chegara."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1687
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr "Bu muammoga xodimlar javobida muammo bor edi: bo'sh chegara."

#. Translators: Separator used in NumericalResponse to display multiple
#. answers.
#. Translators: Separator used in StringResponse to display multiple answers.
#. Example: "Answer: Answer_1 or Answer_2 or Answer_3".
#: capa/responsetypes.py:1795 capa/responsetypes.py:2072
msgid "or"
msgstr "yoki"

#: capa/responsetypes.py:1873
msgid "Text Input"
msgstr "Matn kiritish"

#: capa/responsetypes.py:2044
msgid "error"
msgstr "xato"

#: capa/responsetypes.py:2086
