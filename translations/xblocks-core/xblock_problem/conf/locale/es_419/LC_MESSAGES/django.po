#: block.py:236
msgid "Display Name"
msgstr "Nombre a mostrar"

#: block.py:237
msgid "The display name for this component."
msgstr "El nombre para mostrar para este componente. "

#: block.py:241
msgid "Blank Problem"
msgstr "Problema en blanco"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Número de intentos tomadas por el estudiante en este problema"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Número Máximo de intentos"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Define el número de veces que un estudiante puede intentar responder a este "
"problema. Si el valor no está establecido, se permiten intentos infinitos."

#: block.py:256
msgid "Grading Method"
msgstr "Método de calificación"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Defina el método de calificación para este problema. Por defecto, es la "
"puntuación del último envío realizado por el estudiante."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Última puntuación"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Primera puntuación"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Puntuación más alta"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Puntuación media"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Fecha en que se debe entregar esta actividad"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Cantidad de tiempo después de la fecha de vencimiento que se aceptarán "
"presentaciones"

#: block.py:275
msgid "Show Results"
msgstr "Mostrar Resultados"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Determina cuándo mostrar si la respuesta del estudiante al problema sea "
"correcta. Configurado en la subsección."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Siempre"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Nunca"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Vencido"

#: block.py:288
msgid "Show Answer"
msgstr "Mostrar Respuesta"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Define cuándo mostrar la respuesta al problema. Un valor predeterminado "
"puede establecerse en la página de Configuración avanzada."

#: block.py:294
msgid "Answered"
msgstr "Respondido"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Intentado o Vencido"

#: block.py:296
msgid "Closed"
msgstr "Cerrado"

#: block.py:297
msgid "Finished"
msgstr "Finalizado"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Correcto o fecha vencida"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Después de un cierto número de intentos"

#: block.py:302
msgid "After All Attempts"
msgstr "Después de todos los Intentos"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Después de todos los intentos o de corregir"

#: block.py:304
msgid "Attempted"
msgstr "Intentos"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Mostrar respuesta: Número de intentos"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Número de veces que el estudiante debe intentar responder la pregunta antes "
"de que el botón Mostrar Respuesta aparezca."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Presiona el botón guardar para que aparezca en la página"

#: block.py:320
msgid "Show Reset Button"
msgstr "Mostrar botón de reiniciar"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Determina si un Botón de \"reinicio\" es mostrado al usuario , entonces el "
"usuario puede reiniciar la respuesta. El valor por defecto puede "
"configurarse en la página Configuración avanzada."

#: block.py:329
msgid "Randomization"
msgstr "Aleatorización de problemas:"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Defina cuando aleatorizar las variables especificadas en el script de Python"
" asociado. Para problemas que no tienen valores aleatorizados, ingrese "
"\"Nunca\"."

#: block.py:338
msgid "On Reset"
msgstr "Reiniciar"

#: block.py:340
msgid "Per Student"
msgstr "Por estudiante"

#: block.py:344
msgid "XML data for the problem"
msgstr "Datos XML para el problema"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr ""
"Diccionario con la corrección de las actuales respuestas de los estudiantes"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Lista de mapas de corrección para cada intento."

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Diccionario para mantener el estado de los tipos de entrada"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Diccionario con las respuestas de los estudiantes actuales"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Lista de respuestas de los estudiantes para cada intento."

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Diccionario con la calificación actual del estudiante"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Lista de puntuaciones de cada intento."

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Si las respuestas se han guardado después del último envío o no"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Si el estudiante ha contestado el problema"

#: block.py:368
msgid "Random seed for this student"
msgstr "Semilla aleatoria para este estudiante"

#: block.py:369
msgid "Last submission time"
msgstr "Última vez enviado"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Tiempo entre los intentos"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Segundos que un estudiante debe esperar entre los envíos de un problema con "
"múltiples intentos."

#: block.py:377
msgid "Problem Weight"
msgstr "Valor del problema"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Define el número de puntos que cada problema vale. Si el valor no está "
"establecido, cada campo de respuesta en el problema vale un punto."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Marcar la fuente de este módulo"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Código fuente  de LaTeX y los problemas de palabras. Esta función no está "
"completamente  soportada."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Habilitar plantillas de LaTeX?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Indica si el problema fue editado usando el editor Markdown en el MFE de "
"autoría."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Lo sentimos, hubo un error procesando su solicitud. Por favor intente "
"recargar su página e intentarlo de nuevo."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"El estado de este problema ha cambiado desde que usted cargó esta página. "
"Por favor recargue la página."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "ID de la respuesta"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Pregunta"

#: block.py:810 block.py:827 capa/responsetypes.py:431
msgid "Answer"
msgstr "Respuesta"

#: block.py:813
msgid "Correct Answer"
msgstr "Respuesta Correcta"

#: block.py:1058
msgid "Submit"
msgstr "Enviar"

#: block.py:1071
msgid "Submitting"
msgstr "Enviando"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Atención: El problema ha sido reiniciado a su estado inicial!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"El estado del problema estaba corrupto por un envío inválido. El envío "
"consistió en:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr ""
"Si este problema persiste, por favor contacte al personal de apoyo del "
"curso."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Consejo ({hint_num} de {hints_count}):"

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Sus respuestas han sido guardadas. Haga clic en '{button_name}' para "
"calificarlas."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Incorrecto (punto {progress} )"
msgstr[1] "Incorrecto ( {progress} puntos)"
msgstr[2] "Incorrecto ( {progress} puntos)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Incorrecto"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Correcto (punto {progress} )"
msgstr[1] "Correcto ( {progress} puntos)"
msgstr[2] "Correcto ( {progress} puntos)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Correcto"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Parcialmente correcto (punto {progress} )"
msgstr[1] "Parcialmente correcto ( {progress} puntos)"
msgstr[2] "Parcialmente correcto ( {progress} puntos)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Parcialmente correcto"

#: block.py:1443
msgid "Answer submitted."
msgstr "Respuesta enviada."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "El problema está cerrado."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr ""
"El problema debe ser restablecido antes de que pueda ser enviado nuevamente."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Debe esperar por lo menos {wait} segundos entre envíos."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Debe esperar por lo menos {wait_secs} entre envíos. Quedan {remaining_secs}."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} hora"
msgstr[1] "{num_hour} horas"
msgstr[2] "{num_hour} horas"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minuto"
msgstr[1] "{num_minute} minutos"
msgstr[2] "{num_minute} minutos"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} segundo"
msgstr[1] "{num_second} segundos"
msgstr[2] "{num_second} segundos"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "El problema debe ser reiniciado antes de guardar."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Sus respuestas has sido guardadas."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Sus respuestas han sido guardadas pero no calificadas. Haga clic en "
"'{button_name}' para calificarlas."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "No puede seleccionar Restablecer, para un problema que está cerrado."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Debe enviar una respuesta antes de poder seleccionar Reiniciar."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "La definición del problema no permite el recálculo de puntaje"

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr ""
"El problema debe ser respondido antes de que pueda ser calificado "
"nuevamente."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"No se pueden volver a calcular los puntajes de problemas con posibles envíos"
" de archivos."

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Pregunta {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "correcto"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "incorrecto"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "parcialmente correcto"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "Incompleto"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "sin responder"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "enviado"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "procesando"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Esta respuesta es correcta."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Esta respuesta es incorrecta."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Esta respuesta es parcialmente correcta."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Esta respuesta está siendo procesada."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "No respondido aún."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Seleccione una opción"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: tag inesperado {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Respuesta recibida"

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Se esperaba una etiqueta <choice> o <compoundhint>; pero en lugar se obtuvo "
"una etiqueta {given_tag}"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Sus archivos o ficheros han sido enviados. Una vez evaluados, los "
"comentarios del evaluador sustituirán este mensaje."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Su respuesta ha sido enviada. Tan pronto su envío sea calificado, este "
"mensaje será reemplazado por los comentarios del evaluador."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "editor de {programming_language}"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Presione ESC y después TAB o haga clic afuera del editor de código para "
"salir"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "No se especificó una fórmula"

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "No pude analizar la fórmula: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Error al renderizar la vista previa"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Lo siento, no se puede analizar la fórmula."

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: no esperaba etiqueta {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr ""
"Esperaba una etiqueta {expected_tag} pero recibí una de tipo {given_tag}"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:275
#, python-brace-format
msgid "Question {index}"
msgstr "Pregunta {index}"

#: capa/responsetypes.py:386
msgid "Correct:"
msgstr "Correcto:"

#: capa/responsetypes.py:388
msgid "Incorrect:"
msgstr "Incorrecto:"

#: capa/responsetypes.py:511
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Error {err} al evaluar la función de ayuda contextual {hintfn}."

#: capa/responsetypes.py:512
msgid "(Source code line unavailable)"
msgstr "(línea de código fuente no disponible)"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Ver la línea de código fuente {sourcenum}."

#: capa/responsetypes.py:681
msgid "Checkboxes"
msgstr "Casillas de verificación"

#: capa/responsetypes.py:1011
msgid "Multiple Choice"
msgstr "Opción múltiple"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1232
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "No utilice los atributos 'shuffle' y 'answer-pool' simultaneamente"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1315
msgid "answer-pool value should be an integer"
msgstr "Valores de lista de respuestas deben ser números enteros."

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1382
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr ""
"Grupo de opciones debe incluir al menos una correcta y una incorrecta."

#: capa/responsetypes.py:1407
msgid "True/False Choice"
msgstr "Selección Verdadero / Falso"

#: capa/responsetypes.py:1452
msgid "Dropdown"
msgstr "Desplegar"

#: capa/responsetypes.py:1530
msgid "Numerical Input"
msgstr "Entrada numérica"

#: capa/responsetypes.py:1566 capa/responsetypes.py:1593
msgid "There was a problem with the staff answer to this problem."
msgstr ""
"Hubo un inconveniente con la respuesta del personal de apoyo sobre este "
"problema"

#: capa/responsetypes.py:1616
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "No fue posible interpretar '{student_answer}' como un número."

#: capa/responsetypes.py:1634
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Función factorial evaluada afuera de su dominio:'{student_answer}'"

#: capa/responsetypes.py:1641
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Sintaxis matemática inválida: '{student_answer}'"

#: capa/responsetypes.py:1672
msgid "You may not use complex numbers in range tolerance problems"
msgstr "No puede usar números complejos en problemas con rango de tolerancia"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1680
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Ocurrió un error con la respuesta del personal de apoyo para este problema: "
"límites complejos."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1686
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr ""
"Ocurrió un error con la respuesta del personal de apoyo para este problema: "
"límites vacíos."

#. Translators: Separator used in NumericalResponse to display multiple
#. answers.
#. Translators: Separator used in StringResponse to display multiple answers.
#. Example: "Answer: Answer_1 or Answer_2 or Answer_3".
#: capa/responsetypes.py:1794 capa/responsetypes.py:2071
msgid "or"
msgstr "o"

#: capa/responsetypes.py:1872
msgid "Text Input"
msgstr "Entrada de texto"

#: capa/responsetypes.py:2043
msgid "error"
msgstr "error"

#: capa/responsetypes.py:2085
msgid "Custom Evaluated Script"
msgstr "Script personalizado de evaluación"

#: capa/responsetypes.py:2195
#, python-brace-format
msgid "error getting student answer from {student_answers}"
msgstr "error obteniendo respuesta del estudiante {student_answers}"

#: capa/responsetypes.py:2219
msgid "No answer entered!"
msgstr "No se ingresó una respuesta!"

#: capa/responsetypes.py:2436
msgid "CustomResponse: check function returned an invalid dictionary!"
msgstr ""
"Respuesta Personalizada: La función de verificación retornó un diccionario "
"inválido!"

#: capa/responsetypes.py:2528
msgid "Symbolic Math Input"
msgstr "Respuesta en simbolos matemáticos"

#: capa/responsetypes.py:2608
msgid "Code Input"
msgstr "Entrada de texto"

#: capa/responsetypes.py:2657
msgid "No answer provided."
msgstr "No se suministró una respuesta."

#: capa/responsetypes.py:2679
msgid "MATLAB problems can no longer be graded."
msgstr "Los problemas de MATLAB ya no se pueden calificar."

