#: block.py:236
msgid "Display Name"
msgstr "Tên hiển thị"

#: block.py:237
msgid "The display name for this component."
msgstr "Tên hiển thị cho thành phần này."

#: block.py:241
msgid "Blank Problem"
msgstr "Vấn đề trống"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Số lần học sinh thực hiện bài toán này"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Số lần thử tối đa"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Xác định số lần học sinh có thể cố gắng trả lời vấn đề này. Nếu giá trị "
"không được đặt, số lần thử vô hạn được cho phép."

#: block.py:256
msgid "Grading Method"
msgstr "Phương pháp chấm điểm"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Xác định phương pháp chấm điểm cho vấn đề này. Theo mặc định, đó là điểm của"
" bài nộp cuối cùng của học sinh."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Điểm cuối cùng"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Điểm đầu tiên"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Điểm cao nhất"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Điểm trung bình"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Ngày xảy ra sự cố này"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Khoảng thời gian sau ngày hết hạn mà bài nộp sẽ được chấp nhận"

#: block.py:275
msgid "Show Results"
msgstr "Hiển thị kết quả"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Xác định thời điểm hiển thị câu trả lời của người học cho vấn đề này có đúng"
" hay không. Cấu hình trên tiểu mục."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Luôn luôn"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Không bao giờ"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Quá hạn"

#: block.py:288
msgid "Show Answer"
msgstr "Hiển thị câu trả lời"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Xác định thời điểm hiển thị câu trả lời cho vấn đề. Giá trị mặc định có thể "
"được đặt trong Cài đặt nâng cao."

#: block.py:294
msgid "Answered"
msgstr "Đã trả lời"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Đã cố gắng hoặc quá hạn"

#: block.py:296
msgid "Closed"
msgstr "Đã đóng"

#: block.py:297
msgid "Finished"
msgstr "Hoàn thành"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Đúng hoặc Quá hạn"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Sau một số lần thử"

#: block.py:302
msgid "After All Attempts"
msgstr "Sau Mọi Nỗ Lực"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Sau Tất Cả Những Nỗ Lực Hoặc Đúng"

#: block.py:304
msgid "Attempted"
msgstr "Đã cố gắng"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Hiển thị câu trả lời: Số lần thử"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Số lần học sinh phải cố gắng trả lời câu hỏi trước khi nút Hiển thị câu trả "
"lời xuất hiện."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Có buộc nút lưu xuất hiện trên trang hay không"

#: block.py:320
msgid "Show Reset Button"
msgstr "Hiển thị nút đặt lại"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Xác định xem nút &#39;Đặt lại&#39; có được hiển thị hay không để người dùng "
"có thể đặt lại câu trả lời của họ. Giá trị mặc định có thể được đặt trong "
"Cài đặt nâng cao."

#: block.py:329
msgid "Randomization"
msgstr "Ngẫu nhiên hóa"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Xác định thời điểm ngẫu nhiên hóa các biến được chỉ định trong tập lệnh "
"Python được liên kết. Đối với các bài toán không ngẫu nhiên hóa giá trị, hãy"
" chỉ định &quot;Không bao giờ&quot;. "

#: block.py:338
msgid "On Reset"
msgstr "Khi đặt lại"

#: block.py:340
msgid "Per Student"
msgstr "Mỗi học sinh"

#: block.py:344
msgid "XML data for the problem"
msgstr "Dữ liệu XML cho vấn đề"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Từ điển với tính chính xác của câu trả lời của học sinh hiện tại"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Danh sách bản đồ chính xác cho mỗi lần thử"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Từ điển để duy trì trạng thái của kiểu đầu vào"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Từ điển với các câu trả lời của sinh viên hiện tại"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Danh sách câu trả lời của học sinh cho mỗi lần thử"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Từ điển với điểm số hiện tại của sinh viên"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Danh sách điểm cho mỗi lần thử"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Câu trả lời có được lưu kể từ lần gửi cuối cùng hay không"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Liệu học sinh đã trả lời được vấn đề chưa"

#: block.py:368
msgid "Random seed for this student"
msgstr "Hạt giống ngẫu nhiên cho học sinh này"

#: block.py:369
msgid "Last submission time"
msgstr "Thời gian nộp bài cuối cùng"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Hẹn giờ giữa các lần thử"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Số giây mà học sinh phải đợi giữa các lần nộp bài đối với một bài toán phải "
"thực hiện nhiều lần."

#: block.py:377
msgid "Problem Weight"
msgstr "Vấn đề cân nặng"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Xác định số điểm mà mỗi vấn đề có giá trị. Nếu giá trị không được đặt thì "
"mỗi trường phản hồi trong bài toán có giá trị một điểm."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Nguồn đánh dấu của mô-đun này"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Mã nguồn cho các vấn đề về LaTeX và Word. Tính năng này không được hỗ trợ "
"tốt."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Bật mẫu LaTeX?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Cho biết liệu sự cố có được chỉnh sửa bằng trình soạn thảo Markdown trong "
"Authoring MFE hay không."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Rất tiếc, đã xảy ra lỗi khi xử lý yêu cầu của bạn. Vui lòng thử tải lại "
"trang của bạn và thử lại."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Trạng thái của sự cố này đã thay đổi kể từ khi bạn tải trang này. Vui lòng "
"làm mới trang của bạn."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "ID câu trả lời"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Câu hỏi"

#: block.py:810 block.py:827 capa/responsetypes.py:431
msgid "Answer"
msgstr "Trả lời"

#: block.py:813
msgid "Correct Answer"
msgstr "Câu trả lời chính xác"

#: block.py:1058
msgid "Submit"
msgstr "Nộp"

#: block.py:1071
msgid "Submitting"
msgstr "Đang nộp"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Cảnh báo: Sự cố đã được đặt lại về trạng thái ban đầu!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr "Trạng thái của sự cố đã bị hỏng do gửi không hợp lệ. Bài nộp bao gồm:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "Nếu lỗi này vẫn tiếp diễn, vui lòng liên hệ với nhân viên khóa học."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Gợi ý ( {hint_num} của {hints_count} ): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Câu trả lời của bạn đã được lưu trước đó. Nhấp vào &#39;{button_name}&#39; "
"để chấm điểm chúng."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Không chính xác ( {progress} điểm)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Không đúng"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Đúng ( {progress} điểm)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Chính xác"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Đúng một phần ( {progress} điểm)"

#: block.py:1441
msgid "Partially Correct"
msgstr "Đúng một phần"

#: block.py:1443
msgid "Answer submitted."
msgstr "Đã nộp câu trả lời."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Vấn đề đã được đóng lại."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Sự cố phải được đặt lại trước khi có thể gửi lại."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Bạn phải đợi ít nhất {wait} giây giữa các lần gửi."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Bạn phải đợi ít nhất {wait_secs} giữa các lần gửi. {remaining_secs} còn lại."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} giờ"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} phút"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} giây"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Vấn đề cần phải được thiết lập lại trước khi lưu."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Câu trả lời của bạn đã được lưu."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Câu trả lời của bạn đã được lưu nhưng chưa được chấm điểm. Nhấp vào "
"&#39;{button_name}&#39; để chấm điểm chúng."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Bạn không thể chọn Đặt lại cho sự cố đã được giải quyết."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Bạn phải gửi câu trả lời trước khi có thể chọn Đặt lại."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Định nghĩa của vấn đề không hỗ trợ tính điểm lại."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Vấn đề phải được trả lời trước khi nó có thể được chấm điểm lại."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "Không thể khắc phục sự cố khi gửi tệp có thể"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Câu hỏi {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "Chính xác"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "không đúng"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "đúng một phần"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "chưa hoàn thiện"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "chưa được trả lời"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "đã nộp"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "xử lý"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Câu trả lời này là chính xác."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Câu trả lời này không chính xác."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Câu trả lời này đúng một phần."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Câu trả lời này đang được xử lý."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Vẫn chưa trả lời."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Chọn một tùy chọn"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: thẻ không mong muốn {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Đã nhận được câu trả lời."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Dự kiến một<choice> hoặc<compoundhint> nhãn; thay vào đó có {given_tag}"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Các tập tin của bạn đã được gửi. Ngay sau khi bài nộp của bạn được chấm "
"điểm, thông báo này sẽ được thay thế bằng phản hồi của người chấm điểm."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Câu trả lời của bạn đã được gửi. Ngay sau khi bài nộp của bạn được chấm "
"điểm, thông báo này sẽ được thay thế bằng phản hồi của người chấm điểm."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language}"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "Nhấn ESC rồi TAB hoặc nhấp vào bên ngoài trình soạn thảo mã để thoát"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Không có công thức được chỉ định."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Không thể phân tích cú pháp công thức: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Lỗi khi hiển thị bản xem trước"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Xin lỗi, không thể phân tích công thức"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : thẻ không mong muốn {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Dự kiến có thẻ {expected_tag} ; thay vào đó có {given_tag}"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:275
#, python-brace-format
msgid "Question {index}"
msgstr "Câu {index}"

#: capa/responsetypes.py:386
msgid "Correct:"
msgstr "Chính xác:"

#: capa/responsetypes.py:388
msgid "Incorrect:"
msgstr "Không đúng:"

#: capa/responsetypes.py:511
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Lỗi {err} khi đánh giá hàm gợi ý {hintfn} ."

#: capa/responsetypes.py:512
msgid "(Source code line unavailable)"
msgstr "(Dòng mã nguồn không có sẵn)"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Xem dòng nguồn XML {sourcenum} ."

#: capa/responsetypes.py:681
msgid "Checkboxes"
