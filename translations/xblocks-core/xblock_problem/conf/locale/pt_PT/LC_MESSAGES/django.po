#: block.py:236
msgid "Display Name"
msgstr "Nome de exibição"

#: block.py:237
msgid "The display name for this component."
msgstr "O nome exibido para este componente."

#: block.py:241
msgid "Blank Problem"
msgstr "Problema em branco"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Número de tentativas efetuadas pelo estudante neste problema"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Máximo de tentativas"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Define o número de vezes que um estudante pode tentar responder a este "
"problema. Se o valor não estiver definido, é permitido um número infinito de"
" tentativas."

#: block.py:256
msgid "Grading Method"
msgstr "Método de Classificação"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Defina o método de avaliação para este problema. Por predefinição, é a "
"pontuação da última submissão feita pelo aluno. "

#: block.py:264 block.py:573
msgid "Last Score"
msgstr "Última Pontuação"

#: block.py:265 block.py:574
msgid "First Score"
msgstr "Primeira Pontuação"

#: block.py:266 block.py:575
msgid "Highest Score"
msgstr "Pontuação Mais Alta"

#: block.py:267 block.py:576
msgid "Average Score"
msgstr "Pontuação Média"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Data em que expira este problema"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Tempo após a data limite em que submissões ainda serão aceites"

#: block.py:275
msgid "Show Results"
msgstr "Mostrar resultados"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Define quando mostrar se a resposta do estudante para o problema está "
"correta. Configurado na subsecção."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Sempre"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Nunca"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Prazo Ultrapassado"

#: block.py:288
msgid "Show Answer"
msgstr "Mostrar Resposta"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Define quando mostrar a resposta ao problema. Um valor padrão pode ser "
"definido nas Configurações Avançadas."

#: block.py:294
msgid "Answered"
msgstr "Respondido"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Tentativa ou Vencido"

#: block.py:296
msgid "Closed"
msgstr "Fechado"

#: block.py:297
msgid "Finished"
msgstr "Concluído"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Correto ou Prazo Vencido"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Depois de Algumas Tentativas"

#: block.py:302
msgid "After All Attempts"
msgstr "Depois de todas as tentativas"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Depois de todas as tentativas ou correto"

#: block.py:304
msgid "Attempted"
msgstr "Tentativa"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Mostrar Resposta: Número de Tentativas"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Número de vezes que o aluno deve tentar responder à pergunta antes de "
"aparecer o botão Mostrar Resposta."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Se forçar o botão de guardar a aparecer na página"

#: block.py:320
msgid "Show Reset Button"
msgstr "Mostrar botão de reiniciar"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Determina se um botão de 'Reiniciar' é apresentado de modo a que o "
"utilizador possa redefinir a sua resposta. Um valor padrão pode ser definido"
" nas Configurações Avançadas."

#: block.py:329
msgid "Randomization"
msgstr "Aleatoriedade"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Define quando se deve aleatorizar as variáveis especificadas no script "
"Python associado. Para problemas que não tornam os valores aleatórios, "
"especifique \"Nunca\". "

#: block.py:338
msgid "On Reset"
msgstr "A Redefinir"

#: block.py:340
msgid "Per Student"
msgstr "Por Estudante"

#: block.py:344
msgid "XML data for the problem"
msgstr "Dados XML para o problema"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Dicionário com a correção das respostas atuais dos estudantes"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Lista de mapas de correção para cada tentativa"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Dicionário para manter o estado dos tipos de entrada"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Dicionário com as respostas atuais dos estudantes"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Lista de respostas dos alunos para cada tentativa"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Dicionário com a classificação atual do estudante"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Lista de pontuações para cada tentativa"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Se as respostas foram ou não guardadas desde a última submissão"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Se o estudante respondeu ao problema"

#: block.py:368
msgid "Random seed for this student"
msgstr "Origem aleatória para este estudante"

#: block.py:369
msgid "Last submission time"
msgstr "Última hora de submissão"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Tempo entre tentativas"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Segundos que um estudante deve esperar entre submissões de um exercício com "
"múltiplas tentativas"

#: block.py:377
msgid "Problem Weight"
msgstr "Importância do problema"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Define o número de pontos que cada problema vale. Se um valor não for "
"definido, cada campo de resposta no problema vale um ponto."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Marcar a fonte deste módulo"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Código fonte para problemas LaTeX e Word. Esta funcionalidade não é bem "
"suportada."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Ativar modelos LaTeX?"

#: block.py:391
msgid "Matlab API key"
msgstr "Chave Matlab API"

#: block.py:393
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Digite a chave da API fornecida pelo MathWorks para aceder ao serviço "
"hospedado pelo MATLAB. Esta chave é concedida para uso exclusivo por este "
"curso durante a duração especificada. Não compartilhe a chave da API com "
"outros cursos e notifique o MathWorks imediatamente se acreditar que a chave"
" está exposta ou comprometida. Para obter uma chave para o seu curso ou para"
" reportar um problema, entre em contacto com moocsupport@mathworks.com"

#: block.py:402
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Indica se o exercício foi editado utilizando o editor Markdown na interface "
"de criação (MFE)."

#: block.py:501
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Desculpe, ocorreu um erro ao processar o seu pedido. Por favor, recarregue a"
" página e tente novamente."

#: block.py:506
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"O estado deste problema mudou desde que carregou esta página. Por favor, "
"atualize a sua página."

#: block.py:826 block.py:843
msgid "Answer ID"
msgstr "ID da Resposta"

#: block.py:827 block.py:844
msgid "Question"
msgstr "Questão"

#: block.py:828 block.py:845 capa/responsetypes.py:432
msgid "Answer"
msgstr "Resposta"

#: block.py:831
msgid "Correct Answer"
msgstr "Resposta Correta"

#: block.py:1077
msgid "Submit"
msgstr "Enviar"

#: block.py:1090
msgid "Submitting"
msgstr "A submeter"

#: block.py:1212
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Aviso: O problema foi redefinido para o seu estado inicial!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1216
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"O status do problema foi corrompido por uma submissão inválida. A submissão "
"consistiu de:"

#: block.py:1223
msgid "If this error persists, please contact the course staff."
msgstr ""
"Se o erro persistir, por favor, entre em contacto com a equipa do curso."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1278
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1284
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Dica ({hint_num} de {hints_count}): "

#: block.py:1365
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"As suas respostas foram previamente guardadas. Clique em '{button_name}' "
"para as classificar."

#: block.py:1441
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Incorreto ({progress} ponto)"
msgstr[1] "Incorreto ({progress} pontos)"
msgstr[2] "Incorreto ({progress} pontos)"

#: block.py:1444 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Incorreto"

#: block.py:1448
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Correto ({progress} ponto)"
msgstr[1] "Correto ({progress} pontos)"
msgstr[2] "Correto ({progress} pontos)"

#: block.py:1451 capa/capa_problem.py:754
msgid "Correct"
msgstr "Correto"

#: block.py:1455
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Parcialmente correto ({progress} ponto)"
msgstr[1] "Parcialmente correto ({progress} pontos)"
msgstr[2] "Parcialmente correto ({progress} pontos)"

#: block.py:1460
msgid "Partially Correct"
msgstr "Parcialmente Correto"

#: block.py:1462
msgid "Answer submitted."
msgstr "Resposta submetida."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1854 block.py:2178
msgid "Problem is closed."
msgstr "O problema está fechado."

#: block.py:1860
msgid "Problem must be reset before it can be submitted again."
msgstr "O problema deve ser reiniciado antes de tentar nova submissão."

#: block.py:1870
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Aguarde pelo menos {wait} segundos entre as submissões."

#: block.py:1880
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Deve aguardar pelo menos {wait_secs} segundos entre submissões. Restam "
"{remaining_secs}."

#: block.py:2053
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} hora"
msgstr[1] "{num_hour} horas"
msgstr[2] "{num_hour} horas"

#: block.py:2058
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minuto"
msgstr[1] "{num_minute} minutos"
msgstr[2] "{num_minute} minutos"

#: block.py:2064
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} segundo"
msgstr[1] "{num_second} segundos"
msgstr[2] "{num_second} segundos"

#: block.py:2186
msgid "Problem needs to be reset prior to save."
msgstr "O problema deve ser redefinido antes de guardar."

#: block.py:2195
msgid "Your answers have been saved."
msgstr "As suas respostas foram guardadas."

#: block.py:2197
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"As suas respostas foram guardadas mas não classificadas. Clique "
"'{button_name}' para as classificar."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2226
msgid "You cannot select Reset for a problem that is closed."
msgstr ""
"Não pode selecionar Reiniciar para um problema que se encontra fechado."

#: block.py:2234
msgid "You must submit an answer before you can select Reset."
msgstr "Deve submeter uma resposta antes de selecionar Reiniciar."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2290
msgid "Problem's definition does not support rescoring."
msgstr "A definição do problema não suporta uma nova correção."

#: block.py:2295
msgid "Problem must be answered before it can be graded again."
msgstr ""
"O problema deve ser respondido antes de poder ser novamente classificado."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Não foi possível corrigir novamente os problemas com os possíveis envios de "
"ficheiros"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Questão {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "correto"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "incorreto"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "parcialmente correto"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "incompleto"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "sem resposta"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "submetido"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "processando"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "A resposta está correta."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "A resposta está incorreta."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "A resposta está parcialmente correta."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "A resposta está em processamento."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Ainda não respondido."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Selecione uma opção"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: etiqueta inesperada {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1719
msgid "Answer received."
msgstr "Resposta recebida."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Esperada uma etiqueta <choice> ou <compoundhint>; mas foi obtida a etiqueta "
"{given_tag}"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Os seus ficheiros foram enviados. Assim que sua submissão for avaliada, esta"
" mensagem será substituída pelo feedback do avaliador."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"A sua resposta foi submetida. Assim que a sua submissão seja corrigida, esta"
" mensagem será substituída pelo comentário da classificação."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} editor"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Pressione ESC e depois TAB ou clique fora do editor de código para sair"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Submetido. Assim que uma resposta for devolvida, esta mensagem será "
"substituída por esse feedback."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Sem resposta de Xqueue em {xqueue_timeout} segundos. Operação abortada."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Erro ao executar o código."

#: capa/inputtypes.py:952
msgid "Your code is still being run. Refresh the page to see updates."
msgstr ""
"O seu código ainda está a ser executado. Atualize a página para ver as "
"atualizações."

#: capa/inputtypes.py:984
msgid "Cannot connect to the queue"
msgstr "Não foi possível conectar-se à fila"

#: capa/inputtypes.py:1217 capa/inputtypes.py:1301
msgid "No formula specified."
msgstr "Nenhuma fórmula foi especificada."

#: capa/inputtypes.py:1223
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Não foi possível analisar a fórmula: {error_msg}"

#: capa/inputtypes.py:1227 capa/inputtypes.py:1323
msgid "Error while rendering preview"
msgstr "Erro durante a pré-visualização"

#: capa/inputtypes.py:1319
msgid "Sorry, couldn't parse formula"
msgstr "Desculpe, não foi possível analisar a fórmula"

#: capa/inputtypes.py:1696
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: etiqueta inesperada {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1781
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr ""
"Esperada uma etiqueta {expected_tag}; mas foi obtida uma etiqueta "
"{given_tag}"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
msgid "Question {index}"
msgstr "Pergunta {index}"

#: capa/responsetypes.py:387
msgid "Correct:"
msgstr "Correto:"

#: capa/responsetypes.py:389
msgid "Incorrect:"
msgstr "Incorreto:"

#: capa/responsetypes.py:512
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Ocorreu um erro {err} ao avaliar a função de sugestão {hintfn}."

#: capa/responsetypes.py:513
msgid "(Source code line unavailable)"
msgstr "(A linha de código fonte não está disponível)"

#: capa/responsetypes.py:514
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Veja a linha de origem em XML {sourcenum}."

#: capa/responsetypes.py:682
msgid "Checkboxes"
msgstr "Caixas de seleção"

#: capa/responsetypes.py:1012
msgid "Multiple Choice"
msgstr "Escolha múltipla"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1233
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Não utilize os atributos 'shuffle' e 'answer-pool' simultaneamente"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1316
msgid "answer-pool value should be an integer"
msgstr "o valor da answer-pool deve ser um número inteiro"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1383
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr ""
"O grupo de opções deve incluir pelo menos uma opção correta e uma incorreta"

#: capa/responsetypes.py:1408
msgid "True/False Choice"
msgstr "Seleção verdadeiro/falso"

#: capa/responsetypes.py:1453
msgid "Dropdown"
msgstr "Menu suspenso"

#: capa/responsetypes.py:1531
msgid "Numerical Input"
msgstr "Campo numérico"

#: capa/responsetypes.py:1567 capa/responsetypes.py:1594
msgid "There was a problem with the staff answer to this problem."
msgstr "Houve um problema com a resposta da equipa para este problema."

#: capa/responsetypes.py:1617
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Não foi possível interpretar '{student_answer}' como um número."

#: capa/responsetypes.py:1635
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Função fatorial avaliada fora do seu domínio: '{student_answer}'"

#: capa/responsetypes.py:1642
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Sintaxe matemática inválida: '{student_answer}'"

#: capa/responsetypes.py:1673
msgid "You may not use complex numbers in range tolerance problems"
msgstr "Não pode usar números complexos no intervalo, problema de tolerância"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1681
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Ocorreu um erro com a resposta da equipa de suporte para este problema: "
"limite complexo."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1687
