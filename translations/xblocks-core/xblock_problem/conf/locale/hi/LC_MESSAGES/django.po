msgid "{earned}/{possible} point (graded)"
msgid_plural "{earned}/{possible} points (graded)"
msgstr[0] "{earned} / {possible} पॉइंट (ग्रेडेड)"
msgstr[1] "{earned}/{possible} अंक (वर्गीकृत)"

#. Translators: {earned} is the number of points earned. {possible} is the
#. total number of points (examples: 0/1, 1/1, 2/3, 5/10). The total number of
#. points will always be at least 1. We pluralize based on the total number of
#. points (example: 0/1 point; 1/2 points);
#: assets/static/js/display.js:211
msgid "{earned}/{possible} point (ungraded)"
msgid_plural "{earned}/{possible} points (ungraded)"
msgstr[0] "{earned}/{possible} पॉइंट (अनग्रदेड)"
msgstr[1] "{earned}/{possible} अंक (अनग्रेडेड)"

#: assets/static/js/display.js:292
msgid "The grading process is still running. Refresh the page to see updates."
msgstr ""
"ग्रेडिंग प्रक्रिया अभी भी चल रही है। अपडेट देखने के लिए पेज को रिफ्रेश करें।"

#: assets/static/js/display.js:400
msgid "Could not grade your answer. The submission was aborted."
msgstr "आपका उत्तर ग्रेड नहीं कर सका। सबमिशन निरस्त कर दिया गया।"

#: assets/static/js/display.js:472
msgid ""
"Submission aborted! Sorry, your browser does not support file uploads. If "
"you can, please use Chrome or Safari which have been verified to support "
"file uploads."
msgstr ""
"सबमिशन निरस्त कर दिया! क्षमा करें, आपका ब्राउज़र फ़ाइल अपलोड का समर्थन नहीं "
"करता है। यदि आप कर सकते हैं, तो कृपया क्रोम या सफारी का उपयोग करें जिन्हें "
"फ़ाइल अपलोड का समर्थन करने के लिए सत्यापित किया गया है।"

#: assets/static/js/display.js:500
msgid "You submitted {filename}; only {allowedFiles} are allowed."
msgstr "आपने {filename} सबमिट किया; केवल {allowedFiles} की अनुमति है।"

#: assets/static/js/display.js:513
msgid "Your file {filename} is too large (max size: {maxSize}MB)."
msgstr "आपकी फ़ाइल {filename} बहुत बड़ी है (अधिकतम आकार: {maxSize} MB)।"

#: assets/static/js/display.js:529
msgid "You did not submit the required files: {requiredFiles}."
msgstr "आपने आवश्यक फ़ाइलें सबमिट नहीं कीं: {requiredFiles}।"

#: assets/static/js/display.js:539
msgid "You did not select any files to submit."
msgstr "आपने सबमिट करने के लिए किसी भी फाइल का चयन नहीं किया।"

