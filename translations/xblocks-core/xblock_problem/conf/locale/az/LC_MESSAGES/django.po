#: block.py:236
msgid "Display Name"
msgstr "Görünüş adı"

#: block.py:237
msgid "The display name for this component."
msgstr "Bu komponent üçün görünüş adı."

#: block.py:241
msgid "Blank Problem"
msgstr "Boş Problem"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Tələbənin bu məsələ üzərində etdiyi cəhdlərin sayı"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Maksimum cəhdlər"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Bu tapşırığa cavab vermək üçün tələbənin edə biləcəyi cəhdlərin sayını "
"müəyyənləşdirin. Əgər dəyər quaşdırılmayıbsa, sonsuz sayda cəhdlərə icazə "
"verilir."

#: block.py:256
msgid "Grading Method"
msgstr "Qiymətləndirmə Metodu"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Qiymətləndirmə metodunu bu problem üçün müəyyən edin. Varsayılan olaraq, bu,"
" tələbənin etdiyi son təqdimatın balıdır."

#: block.py:264 block.py:573
msgid "Last Score"
msgstr "Son Qiymət"

#: block.py:265 block.py:574
msgid "First Score"
msgstr "İlk Bal"

#: block.py:266 block.py:575
msgid "Highest Score"
msgstr "Ən Yüksək Bal"

#: block.py:267 block.py:576
msgid "Average Score"
msgstr "Orta Bal"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Bu tapşırıq üçün son tarix"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Göndərilənin qəbul edildiyi son tarixdən sonrakı müddət"

#: block.py:275
msgid "Show Results"
msgstr "Nəticələri Göstər"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Tapşırığa bir şagirdin cavabının doğru olub-olmadığını göstərmək üçün "
"müəyyənləşdirir. Alt bölmədə konfiqurasiya olunmuşdur."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Həmişə"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Heç vaxt"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Vaxtı keçib"

#: block.py:288
msgid "Show Answer"
msgstr "Qısa cavab"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Tapşırığın cavabını nə vaxt göstərəcəyini müəyyənləşdirir. Standart dəyər "
"Qabaqcıl parametrlərdə quraşdırıla bilər."

#: block.py:294
msgid "Answered"
msgstr "Cavablandırıldı"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Cəhd edilib və ya Vaxtı Keçib"

#: block.py:296
msgid "Closed"
msgstr "Bağlı"

#: block.py:297
msgid "Finished"
msgstr "Bitdi"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Doğrudur və ya vaxtı keçib"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Bir neçə cəhdlərin sayından sonra"

#: block.py:302
msgid "After All Attempts"
msgstr "Bütün cəhdlərdən sonra"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Bütün cəhdlərdən sonra və ya düzgün"

#: block.py:304
msgid "Attempted"
msgstr "Cəhd edildi"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Cavabı göstərin: cəhdlərin sayı"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Cavabı göstərin düyməsi görünməzdən öncə suala cavab vermək üçün tələbənin "
"cəhdlərinin sayı."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Yaddaşda saxla düyməsinin səhifədə görünməsini təmin edin"

#: block.py:320
msgid "Show Reset Button"
msgstr "Geri Düzəltmə Düyməsini Göstər"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Müəyyən edir ki, istifadəçi cavabını sıfırlaya bilsin deyə 'Sıfırla' düyməsi"
" göstərilsinmi. Standart dəyər Ətraflı Parametrlərdə təyin edilə bilər."

#: block.py:329
msgid "Randomization"
msgstr "Təsadüfi seçim"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Müvafiq Python skriptində göstərilən dəyişənləri təsadüfi təyin etmək üçün "
"müəyyənləşdirir. Dəyərləri təsadüfi olmayan tapşırıqlar üçün \"Heç vaxt\" "
"seçin. "

#: block.py:338
msgid "On Reset"
msgstr "Sıfırlama zamanı"

#: block.py:340
msgid "Per Student"
msgstr "Tələbə başına"

#: block.py:344
msgid "XML data for the problem"
msgstr "Tapşırıq üçün XML data"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Cari tələbə cavablarının düzgünlüyünə görə lüğət"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Hər bir cəhd üçün düzgünlük xəritələrinin siyahısı"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Giriş növlərinin vəziyyətini saxlamaq üçün lüğət"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Cari tələbə cavablarına görə lüğət"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Hər cəhd üçün tələbə cavablarının siyahısı"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Cari tələbə xalına görə lüğət"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Hər cəhd üçün balların siyahısı"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Cavabların son göndərişdən sonra yadda saxlanılıb-saxlanılmadığı"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Görəsən, tələbə tapşırığa cavab verdimi"

#: block.py:368
msgid "Random seed for this student"
msgstr "Bu tələbə üçün təsadüfi toxum"

#: block.py:369
msgid "Last submission time"
msgstr "Son təqdimetmə vaxtı"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Cəhdlər arasındakı vaxt"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Tələbənin çoxsaylı cəhdləri olan bir problemi təqdim etməzdən əvvəl "
"gözləməli olduğu saniyələr."

#: block.py:377
msgid "Problem Weight"
msgstr "Tapşırığın çəkisi"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Hər bir məsələnin neçə xal dəyərində olduğunu müəyyən edir. Əgər dəyər təyin"
" edilməyibsə, məsələdəki hər bir cavab sahəsi bir xal dəyərindədir."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Bu modulun Markdown mənbəyi"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"LaTeX və Word problemləri üçün mənbə kodu. Bu xüsusiyyət yaxşı dəstəklənmir."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "LaTeX şablonları aktivləşsin?"

#: block.py:391
msgid "Matlab API key"
msgstr "Matlab API açarı"

#: block.py:393
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"MATLAB Hosted Service-ə daxil olmaq üçün MathWorks tərəfindən verilən API "
"əsasını daxil edin. Bu açar müəyyən müddət üçün bu kursla xüsusi istifadə "
"üçün verilir. Zəhmət olmasa, API açarını digər dərslər ilə bölüşməyin və "
"açarın açıq və ya təhlükəli olduğuna inanırsınızsa, dərhal MathWorks-a "
"bildirin. Kursunuz üçün bir açar almaq və ya bir problemi bildirmək üçün "
"moocsupport@mathworks.com ilə əlaqə saxlayın"

#: block.py:402
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Göstərir ki, problem Müəlliflik MFE-də Markdown redaktoru istifadə edilərək "
"redaktə edilib."

#: block.py:501
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Üzr istəyirik, sizin istəyinizi yerinə yetirərkən xəta baş verdi. Zəhmət "
"olmasa, səhifənizi yenidən yükləyərək bir daha cəhd edin."

#: block.py:506
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Siz bu səhifəni açdığınızdan bəri bu tapşırığın statusu dəyişib. Zəhmət "
"olmasa, səhifəni yeniləyin."

#: block.py:826 block.py:843
msgid "Answer ID"
msgstr "Cavab ID-si"

#: block.py:827 block.py:844
msgid "Question"
msgstr "Sual"

#: block.py:828 block.py:845 capa/responsetypes.py:432
msgid "Answer"
msgstr "Cavab"

#: block.py:831
msgid "Correct Answer"
msgstr "Doğru cavab"

#: block.py:1077
msgid "Submit"
msgstr "Təqdim edin"

#: block.py:1090
msgid "Submitting"
msgstr "Göndərilir"

#: block.py:1212
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Xəbərdarlıq: Problem ilkin vəziyyətinə qaytarıldı!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1216
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Tapşırığın vəziyyəti etibarsız göndərilmə ilə pozulub. Bu göndərilmə "
"aşağıdakılardan ibarətdir:"

#: block.py:1223
msgid "If this error persists, please contact the course staff."
msgstr ""
"Əgər bu xəta təkrarlanırsa, zəhmət olmasa, kurs heyəti ilə əlaqə saxlayın."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1278
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1284
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "İpucu ({hint_num} / {hints_count}): "

#: block.py:1365
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Sizin cavablarınız daha öncədən yaddaşda saxlanıldı. Onları qiymətləndirmək "
"üçün '{button_name}' düyməsinə klikləyin."

#: block.py:1441
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Səhv ({progress} bal)"
msgstr[1] "Səhv ({progress} xal)"

#: block.py:1444 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Yanlış"

#: block.py:1448
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Düzgün ({progress} xal)"
msgstr[1] "Düzgün ({progress} xal)"

#: block.py:1451 capa/capa_problem.py:754
msgid "Correct"
msgstr "Doğru"

#: block.py:1455
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Qismən düzgün ({progress} xal)"
msgstr[1] "Qismən düzgün ({progress} xal)"

#: block.py:1460
msgid "Partially Correct"
msgstr "Qismən doğru"

#: block.py:1462
msgid "Answer submitted."
msgstr "Cavab göndərildi."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1854 block.py:2178
msgid "Problem is closed."
msgstr "Tapşırıq bağlanır."

#: block.py:1860
msgid "Problem must be reset before it can be submitted again."
msgstr "Tapşırığın yenidən göndərilməsi üçün o sıfırlanmalıdır."

#: block.py:1870
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Təqdimatlar arasında ən azı {wait} saniyə gözləməlisiniz."

#: block.py:1880
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Siz göndərilmələr arası ən azı {wait_secs} saniyə gözləməlisiniz. "
"{remaining_secs} saniyə qalır."

#: block.py:2053
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} saat"
msgstr[1] "{num_hour} saat"

#: block.py:2058
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} dəqiqə"
msgstr[1] "{num_minute} dəqiqə"

#: block.py:2064
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} saniyə"
msgstr[1] "{num_second} saniyə"

#: block.py:2186
msgid "Problem needs to be reset prior to save."
msgstr "Yaddaşa verilmədən öncə tapşırıq sıfırlanmalıdır."

#: block.py:2195
msgid "Your answers have been saved."
msgstr "Cavablarınız yadda saxlanıldı."

#: block.py:2197
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Sizin cavablarınız yaddaşda saxlanılıb, ancaq qiymətləndirilməyib. Onları "
"qiymətləndirmək üçün '{button_name}' düyməsinə klikləyin."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2226
msgid "You cannot select Reset for a problem that is closed."
msgstr "Siz vaxtı bilmiş tapşırıq üçün Sıfırlayın seçimini edə bilməzsiniz."

#: block.py:2234
msgid "You must submit an answer before you can select Reset."
msgstr "Siz Sıfırlayın seçimini etmədən öncə cavabı göndərməlisiniz."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2290
msgid "Problem's definition does not support rescoring."
msgstr "Tapşırığın tərifi yenidən qiymətləndirməni dəstəkləmir."

#: block.py:2295
msgid "Problem must be answered before it can be graded again."
msgstr "Yenidən qiymətləndirilmədən əvvəl tapşırıq cavablandırılmalıdır."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Mümkün olan fayl göndərilmələri ilə tapşırıqlar yenidən qiymətləndirilə "
"bilməz"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Sual {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "düzgün"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "yalnış"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "qismən doğru"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "yarımçıq"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "cavablanmamış"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "göndərilib"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "emal"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Cavab doğrudur."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Cavab yanlışdır."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Bu cavab qismən doğrudur."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Sizin cavabınız yoxlanılır."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Hələ cavablandırılmayıb."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Seçim edin"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: gözlənilməyən təq {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1719
msgid "Answer received."
msgstr "Cavab alındı."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"<choice> və ya <compoundhint> təq gözlənilir; əvəzinə {given_tag} əldə "
"edildi"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Sizin fayllarınız göndərilib. Göndərdiyiniz qiymətləndirilən kimi bu məktub "
"qiymət qoyanın əks əlaqəsi ilə əvəz ediləcək."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Sizin cavabınız göndərilib. Göndərdiyiniz qiymətləndirilən kimi bu məktub "
"qiymət qoyanın əks əlaqəsi ilə əvəz ediləcək."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} redaktoru"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Çıxmaq üçün ESC sonra isə TAB-ı basın və ya kod redaktoru pəncərəsinin "
"kənarına klik edin"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Göndərildi. Cavab göndərilən kimi bu məktub həmin əks əlaqə ilə əvəz "
"ediləcəkdir."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Xqueue-dan {xqueue_timeout} saniyə içərisində cavab gəlmədi. Ləğv edildi."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Kodun işə salınması zamanı səhv."

#: capa/inputtypes.py:984
msgid "Cannot connect to the queue"
msgstr "Növbəyə qoşula bilinmədi."

#: capa/inputtypes.py:1217 capa/inputtypes.py:1301
msgid "No formula specified."
msgstr "Heç bir düstur müəyyənləşdirilmədi."

#: capa/inputtypes.py:1223
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Düsturu təhlil edə bilmədi: {error_msg}"

#: capa/inputtypes.py:1227 capa/inputtypes.py:1323
msgid "Error while rendering preview"
msgstr "Görüntünün hazırlanması zamanı xəta"

#: capa/inputtypes.py:1319
msgid "Sorry, couldn't parse formula"
msgstr "Üzr istəyirik, düsturları təhlil edə bilmədik"

#: capa/inputtypes.py:1696
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: gözlənilməyən təq {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1781
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Gözlənilən {expected_tag} təq; əvəzinə {given_tag} əldə edildi"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
