#: block.py:236
msgid "Display Name"
msgstr "Отображаемое имя"

#: block.py:237
msgid "The display name for this component."
msgstr "Отображаемое название компонента"

#: block.py:241
msgid "Blank Problem"
msgstr "Пустая проблема"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Количество попыток, использованных слушателем при выполнении задания"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Максимальное количество попыток"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Определяет, сколько раз слушатель может давать ответ на задание.  Если "
"значение не установлено, предоставляется неограниченное количество попыток."

#: block.py:256
msgid "Grading Method"
msgstr "Метод оценки"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Определите метод оценки этой задачи. По умолчанию это оценка последней "
"подачи документов, отправленной учащимся."

#: block.py:264 block.py:573
msgid "Last Score"
msgstr "Последний счет"

#: block.py:265 block.py:574
msgid "First Score"
msgstr "Первый балл"

#: block.py:266 block.py:575
msgid "Highest Score"
msgstr "Наивысший балл"

#: block.py:267 block.py:576
msgid "Average Score"
msgstr "Средний балл"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Срок сдачи данного задания"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Время, на протяжении которого будут приниматься ответы по истечении срока "
"сдачи задания"

#: block.py:275
msgid "Show Results"
msgstr "Показать результат"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Определяет, когда отображать результат проверки ответа слушателя. "
"Настраивается для подраздела."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Всегда"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Никогда"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Прошёл срок сдачи"

#: block.py:288
msgid "Show Answer"
msgstr "Показать ответ"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Определяет, когда отображать ответ на задание.  В расширенных настройках "
"можно установить значение по умолчанию."

#: block.py:294
msgid "Answered"
msgstr "Дан ответ"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Attempted or Past Due"

#: block.py:296
msgid "Closed"
msgstr "Закрыто, завершено"

#: block.py:297
msgid "Finished"
msgstr "Выполнено"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Ответ верен или прошёл срок сдачи"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "После нескольких попыток"

#: block.py:302
msgid "After All Attempts"
msgstr "После всех Попыток"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "После Всех попыток или Исправлений"

#: block.py:304
msgid "Attempted"
msgstr "Попытка"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Показать ответ: Количество попыток"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Количество попыток студентов ответить на вопрос до появления кнопки Показать"
" ответ."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Условия отображения кнопки «Сохранить» на странице"

#: block.py:320
msgid "Show Reset Button"
msgstr "Показать кнопку сброса"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Определяет, показывать ли кнопку «Сбросить», с помощью которой пользователь "
"может сбросить свой ответ. Значение по умолчанию можно установить в "
"расширенных настройках."

#: block.py:329
msgid "Randomization"
msgstr "Рандомизация"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Определяет, когда следует использовать случайные значения переменных, "
"указанных в сценарии на языке Python. Для задач, не требующих подстановки "
"случайного значения переменных, выберите «Никогда»."

#: block.py:338
msgid "On Reset"
msgstr "При сбросе"

#: block.py:340
msgid "Per Student"
msgstr "Для каждого слушателя"

#: block.py:344
msgid "XML data for the problem"
msgstr "Данные, связанные с заданием, в формате XML"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Словарь, определяющий правильность ответов"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Список карт правильности для каждой попытки"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Словарь для сохранения состояний полей ввода"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Словарь, содержащий ответы слушателей"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Список ответов учащихся для каждой попытки"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Словарь с текущей оценкой слушателя"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Список очков за каждую попытку"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Сохранены ли ответы с момента последней отправки"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Ответил ли слушатель на задание"

#: block.py:368
msgid "Random seed for this student"
msgstr "Инициализация случайного значения для данного слушателя"

#: block.py:369
msgid "Last submission time"
msgstr "Время последней сдачи задания"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Время между попытками"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Секунды, которые студент должен выждать между сдачей задания с несколькими "
"попытками."

#: block.py:377
msgid "Problem Weight"
msgstr "Вес задания"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Определяет количество баллов за каждое задание.  Если значение не указано, "
"каждое поле ответа в задании будет оцениваться в один балл."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Мarkdown-код этого модуля"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Исходный код заданий в формате LaTeX и Word. Данная функция поддерживается "
"не полностью."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Разрешить использование шаблонов LaTeX?"

#: block.py:391
msgid "Matlab API key"
msgstr "Ключ Matlab API"

#: block.py:393
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Введите API-ключ, предоставленный компанией MathWorks для доступа к сервису "
"MATLAB. Этот ключ предоставляется для использования исключительно в рамках "
"данного курса в указанный период времени. Не используйте API-ключ в других "
"курсах. Немедленно уведомите MathWorks, если считаете, что ключ стал "
"известен посторонним. Для получения ключа для вашего курса или отправки "
"сообщения о проблеме, пожалуйста, свяжитесь с moocsupport@mathworks.com"

#: block.py:402
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Указывает, редактировался ли проблема с помощью редактора markdown в "
"Authoring MFE."

#: block.py:501
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"К сожалению, при обработке вашего запроса произошла ошибка.  Пожалуйста, "
"перезагрузите страницу и попробуйте ещё раз."

#: block.py:506
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Статус этого задания изменился после того, как вы загрузили страницу.  "
"Пожалуйста, перезагрузите страницу."

#: block.py:826 block.py:843
msgid "Answer ID"
msgstr "ID ответа"

#: block.py:827 block.py:844
msgid "Question"
msgstr "Вопрос"

#: block.py:828 block.py:845 capa/responsetypes.py:432
msgid "Answer"
msgstr "Ответ"

#: block.py:831
msgid "Correct Answer"
msgstr "Верный ответ"

#: block.py:1077
msgid "Submit"
msgstr "Отправить"

#: block.py:1090
msgid "Submitting"
msgstr "Отправка"

#: block.py:1212
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Внимание: задание было сброшено к исходному состоянию!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1216
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Состояние задание повреждено из-за неверного формата ответа. Ответ состоял "
"из:"

#: block.py:1223
msgid "If this error persists, please contact the course staff."
msgstr ""
"Если это сообщение об ошибке продолжает появляться, пожалуйста, свяжитесь с "
"сотрудниками курса."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1278
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1284
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Подсказка ({hint_num} из {hints_count}): "

#: block.py:1365
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Ваши ответы были сохранены. Нажмите «{button_name}», чтобы получить оценку."

#: block.py:1441
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Неверно ({progress} балл)"
msgstr[1] "Неверно ({progress} баллов)"
msgstr[2] "Неверно ({progress} баллов)"
msgstr[3] "Неверно ({progress} баллов)"

#: block.py:1444 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Неверных"

#: block.py:1448
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Правильно ({progress} балл)"
msgstr[1] "Правильно ({progress} баллов)"
msgstr[2] "Правильно ({progress} баллов)"
msgstr[3] "Правильно ({progress} баллов)"

#: block.py:1451 capa/capa_problem.py:754
msgid "Correct"
msgstr "Верных"

#: block.py:1455
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Частично верно ({progress} балл)"
msgstr[1] "Частично верно ({progress} баллов)"
msgstr[2] "Частично верно ({progress} баллов)"
msgstr[3] "Частично верно ({progress} баллов)"

#: block.py:1460
msgid "Partially Correct"
msgstr "Частично верно"

#: block.py:1462
msgid "Answer submitted."
msgstr "Ответ отправлен на проверку."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1854 block.py:2178
msgid "Problem is closed."
msgstr "Срок сдачи задания прошёл."

#: block.py:1860
msgid "Problem must be reset before it can be submitted again."
msgstr ""
"Необходимо перезагрузить задание, прежде чем снова сдать ответ на проверку."

#: block.py:1870
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Подождите по крайней мере {wait} секунд между попытками."

#: block.py:1880
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Подождите по крайней мере {wait_secs} между попытками. Осталось "
"{remaining_secs} . "

#: block.py:2053
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} час"
msgstr[1] "{num_hour} часов"
msgstr[2] "{num_hour} часов"
msgstr[3] "{num_hour} часов"

#: block.py:2058
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} минута"
msgstr[1] "{num_minute} минут"
msgstr[2] "{num_minute} минут"
msgstr[3] "{num_minute} минут"

#: block.py:2064
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} секунда"
msgstr[1] "{num_second} секунд"
msgstr[2] "{num_second} секунд"
msgstr[3] "{num_second} секунд"

#: block.py:2186
msgid "Problem needs to be reset prior to save."
msgstr "Задание нужно сбросить перед сохранением."

#: block.py:2195
msgid "Your answers have been saved."
msgstr "Ваши ответы сохранены."

#: block.py:2197
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Ваши ответы сохранены, но не оценены. Нажмите '{button_name}', чтобы "
"получить оценку."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2226
msgid "You cannot select Reset for a problem that is closed."
msgstr "Вы не можете обновить условия задания, срок сдачи которого прошёл."

#: block.py:2234
msgid "You must submit an answer before you can select Reset."
msgstr ""
"Прежде чем обновить условия задания, вам необходимо отправить задание на "
"проверку."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2290
msgid "Problem's definition does not support rescoring."
msgstr "Условия задания не позволяют его переоценку."

#: block.py:2295
msgid "Problem must be answered before it can be graded again."
msgstr ""
"На задание должен быть дан ответ перед тем, как оно будет оценено снова."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr "Не удалось скорректировать оценки за задания с прикреплёнными файлами"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Вопрос {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "верно"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "неверно"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "частично верно"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "не закончено"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "нет ответа"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "отправлено"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "обработка"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Это правильный ответ."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Это неправильный ответ."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Это частично правильный ответ."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Этот ответ в процессе оценки."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Ответ пока не дан."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Выберите опцию"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: неопределённый тег {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1719
msgid "Answer received."
msgstr "Получен ответ."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr "Вместо <choice> или <compoundhint> обнаружен тег {given_tag}"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Файлы отправлены. После проверки работы вместо этого сообщения появится "
"оценка."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Ответ отправлен. После его проверки вместо этого сообщения появится оценка."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "Редактор {programming_language}"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "Чтобы выйти, нажмите ESC и затем TAB или щёлкните вне редактора кода."

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Отправлено. Как только будет получен ответ, он появится вместо этого "
"сообщения."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Нет отклика от подсистемы Xqueue в течение {xqueue_timeout}. Работа "
"прекращена."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Ошибка выполнения кода."

#: capa/inputtypes.py:952
msgid "Your code is still being run. Refresh the page to see updates."
msgstr ""
"Ваш код все еще выполняется. Обновите страницу, чтобы увидеть изменения."

#: capa/inputtypes.py:984
msgid "Cannot connect to the queue"
msgstr "Невозможно подключиться к очереди"

#: capa/inputtypes.py:1217 capa/inputtypes.py:1301
msgid "No formula specified."
msgstr "Формула не указана."

#: capa/inputtypes.py:1223
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Не удалось разобрать формулу: {error_msg}"

#: capa/inputtypes.py:1227 capa/inputtypes.py:1323
msgid "Error while rendering preview"
msgstr "Ошибка при формировании предварительного просмотра"

#: capa/inputtypes.py:1319
msgid "Sorry, couldn't parse formula"
msgstr "Не удалось разобрать формулу"

#: capa/inputtypes.py:1696
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: неопределённый тег {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1781
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Требуется тег {expected_tag}. Вместо него введён тег {given_tag}."

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
