#: block.py:236
msgid "Display Name"
msgstr "Emri i shfaqur"

#: block.py:237
msgid "The display name for this component."
msgstr "Emri i shfaqur për këtë komponent."

#: block.py:241
msgid "Blank Problem"
msgstr "Problem bosh"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Numri i përpjekjeve të bëra nga studenti për këtë problem"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Përpjekjet maksimale"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Përcakton numrin e herëve që një student mund të përpiqet t'i përgjigjet "
"këtij problemi. Nëse vlera nuk është caktuar, lejohen përpjekje të pafundme."

#: block.py:256
msgid "Grading Method"
msgstr "Metoda e notimit"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Përcaktoni metodën e vlerësimit për këtë problem. Si parazgjedhje, është "
"rezultati i paraqitjes së fundit të bërë nga studenti."

#: block.py:264 block.py:573
msgid "Last Score"
msgstr "Rezultati i fundit"

#: block.py:265 block.py:574
msgid "First Score"
msgstr "Rezultati i parë"

#: block.py:266 block.py:575
msgid "Highest Score"
msgstr "Rezultati më i lartë"

#: block.py:267 block.py:576
msgid "Average Score"
msgstr "Shkalla mesatare"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Data kur ky problem duhet të përfundojë"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Ne pranojmë parashtresat për një kohë të caktuar pas datës së dorëzimit."

#: block.py:275
msgid "Show Results"
msgstr "Shfaq rezultatet"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Përcakton se kur duhet të tregojë nëse përgjigja e një nxënësi ndaj "
"problemit është e saktë. Konfiguruar në nënseksion."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Gjithmonë"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "kurrë"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "E vonuar"

#: block.py:288
msgid "Show Answer"
msgstr "Trego përgjigjen"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Përcakton se kur duhet të tregohet përgjigja e problemit. Një vlerë e "
"paracaktuar mund të vendoset në Konfigurimet E Avancuara."

#: block.py:294
msgid "Answered"
msgstr "U përgjigj"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Përpjekje ose të kaluar"

#: block.py:296
msgid "Closed"
msgstr "Mbyllur"

#: block.py:297
msgid "Finished"
msgstr "Përfunduar"

#: block.py:298
msgid "Correct or Past Due"
msgstr "E saktë ose e kaluar afati"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Pas një numri përpjekjesh"

#: block.py:302
msgid "After All Attempts"
msgstr "Pas të gjitha përpjekjeve"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Pas të gjitha përpjekjeve ose të sakta"

#: block.py:304
msgid "Attempted"
msgstr "U përpoq"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Trego përgjigjen: Numri i Përpjekjeve"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Numri i herëve që studenti duhet të përpiqet t'i përgjigjet pyetjes përpara "
"se të shfaqet butoni Trego përgjigjen."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Të detyrojmë butonin e ruajtjes të shfaqet në faqe"

#: block.py:320
msgid "Show Reset Button"
msgstr "Shfaq butonin e rivendosjes"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Përcakton nëse shfaqet një buton &#39;Rivendos&#39; në mënyrë që përdoruesi "
"të rivendosë përgjigjen e tij. Një vlerë e paracaktuar mund të vendoset në "
"Konfigurimet E Avancuara."

#: block.py:329
msgid "Randomization"
msgstr "Rastësi"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Përcakton se kur të rastësohen variablat e specifikuar në skriptin e lidhur "
"Python. Për problemet që nuk bëjnë rastësi vlerat, specifikoni \"Kurrë\". "

#: block.py:338
msgid "On Reset"
msgstr "Në rivendosje"

#: block.py:340
msgid "Per Student"
msgstr "Për student"

#: block.py:344
msgid "XML data for the problem"
msgstr "Të dhënat XML për problemin"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Fjalor me korrektësinë e përgjigjeve aktuale të nxënësve"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Lista e hartave të korrektësisë për çdo përpjekje"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Fjalor për ruajtjen e gjendjes së llojeve të hyrjes"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Fjalor me përgjigjet aktuale të nxënësve"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Lista e përgjigjeve të nxënësve për çdo përpjekje"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Fjalor me rezultatin aktual të nxënësit"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Lista e pikëve për çdo përpjekje"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Nëse përgjigjet janë ruajtur apo jo që nga dërgimi i fundit"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Nëse nxënësi është përgjigjur problemit"

#: block.py:368
msgid "Random seed for this student"
msgstr "Farë e rastësishme për këtë student"

#: block.py:369
msgid "Last submission time"
msgstr "Koha e fundit e dorëzimit"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Kohëmatësi ndërmjet përpjekjeve"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Një student duhet të presë sekondat ndërmjet paraqitjeve për një problem me "
"përpjekje të shumta."

#: block.py:377
msgid "Problem Weight"
msgstr "Pesha e problemit"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Përcakton numrin e pikëve që vlen çdo problem. Nëse vlera nuk është "
"vendosur, çdo fushë përgjigjeje në problem vlen një pikë."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Burimi i shënimit të këtij moduli"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Kodi burimor për problemet LaTeX dhe Word. Kjo veçori nuk mbështetet mirë."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Aktivizo shabllonet LaTeX?"

#: block.py:391
msgid "Matlab API key"
msgstr "Çelësi i Matlab API"

#: block.py:393
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Futni çelësin API të ofruar nga MathWorks për të hyrë në Shërbimin e Hosted "
"MATLAB. Ky çelës jepet për përdorim ekskluziv nga ky kurs për kohëzgjatjen e"
" specifikuar. Ju lutemi, mos e ndani çelësin API me kurse të tjera dhe "
"njoftoni menjëherë MathWorks nëse besoni se çelësi është ekspozuar ose "
"komprometuar. Për të marrë një çelës për kursin tuaj ose për të raportuar "
"një problem, ju lutemi kontaktoni moocsupport@mathworks.com"

#: block.py:402
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Tregon nëse problemi është redaktuar duke përdorur redaktorin Markdown në "
"Autoring MFE."

#: block.py:501
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Na vjen keq, ka pasur një gabim me përpunimin e kërkesës tuaj. Ju lutemi "
"provoni të ringarkoni faqen tuaj dhe provoni përsëri."

#: block.py:506
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Gjendja e këtij problemi ka ndryshuar që kur keni ngarkuar këtë faqe. Ju "
"lutemi rifreskoni faqen tuaj."

#: block.py:826 block.py:843
msgid "Answer ID"
msgstr "ID e përgjigjes"

#: block.py:827 block.py:844
msgid "Question"
msgstr "Pyetje"

#: block.py:828 block.py:845 capa/responsetypes.py:432
msgid "Answer"
msgstr "Përgjigjja"

#: block.py:831
msgid "Correct Answer"
msgstr "Përgjigje e saktë"

#: block.py:1077
msgid "Submit"
msgstr "Paraqisni"

#: block.py:1090
msgid "Submitting"
msgstr "Duke paraqitur"

#: block.py:1212
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Paralajmërim: Problemi është rivendosur në gjendjen e tij fillestare!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1216
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Gjendja e problemit u korruptua nga një paraqitje e pavlefshme. Dorëzimi "
"përbëhej nga:"

#: block.py:1223
msgid "If this error persists, please contact the course staff."
msgstr "Nëse ky gabim vazhdon, ju lutemi kontaktoni stafin e kursit."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1278
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints} {list_start_tag} {strong_text} {hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1284
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Këshillë ({hint_num} nga {hints_count}): "

#: block.py:1365
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Përgjigjet tuaja janë ruajtur më parë. Kliko '{button_name}' për t'i "
"vlerësuar ato."

#: block.py:1441
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "E pasaktë ({progress} pikë)"
msgstr[1] "E pasaktë ({progress} pikë)"

#: block.py:1444 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Gabim"

#: block.py:1448
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "E saktë ({progress} pikë)"
msgstr[1] "E saktë ({progress} pikë)"

#: block.py:1451 capa/capa_problem.py:754
msgid "Correct"
msgstr "Saktë"

#: block.py:1455
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Pjesërisht e saktë ({progress} pikë)"
msgstr[1] "Pjesërisht e saktë ({progress} pikë)"

#: block.py:1460
msgid "Partially Correct"
msgstr "Pjesërisht e saktë"

#: block.py:1462
msgid "Answer submitted."
msgstr "Përgjigja u dorëzua."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1854 block.py:2178
msgid "Problem is closed."
msgstr "Problemi është mbyllur."

#: block.py:1860
msgid "Problem must be reset before it can be submitted again."
msgstr "Problemi duhet të rivendoset përpara se të mund të dorëzohet përsëri."

#: block.py:1870
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Duhet të prisni të paktën {wait} sekonda ndërmjet paraqitjeve."

#: block.py:1880
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Duhet të prisni të paktën {wait_secs} ndërmjet paraqitjeve. {remaining_secs}"
" e mbetur."

#: block.py:2053
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} orë"
msgstr[1] "{num_hour} orë"

#: block.py:2058
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minutë"
msgstr[1] "{num_minute} minuta"

#: block.py:2064
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} sekond"
msgstr[1] "{num_second} sekonda"

#: block.py:2186
msgid "Problem needs to be reset prior to save."
msgstr "Problemi duhet të rivendoset përpara se të ruhet."

#: block.py:2195
msgid "Your answers have been saved."
msgstr "Përgjigjet tuaja janë ruajtur."

#: block.py:2197
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Përgjigjet tuaja janë ruajtur por nuk janë vlerësuar. Kliko '{button_name}' "
"për t'i vlerësuar ato."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2226
msgid "You cannot select Reset for a problem that is closed."
msgstr "Nuk mund të zgjidhni Reset për një problem që është i mbyllur."

#: block.py:2234
msgid "You must submit an answer before you can select Reset."
msgstr "Duhet të dërgoni një përgjigje përpara se të zgjidhni \"Rivendosja\"."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2290
msgid "Problem's definition does not support rescoring."
msgstr "Përkufizimi i problemit nuk e mbështet rivlerësimin."

#: block.py:2295
msgid "Problem must be answered before it can be graded again."
msgstr ""
"Problemi duhet të përgjigjet përpara se të mund të vlerësohet përsëri."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr "Nuk mund të zgjidh problemet me paraqitjet e mundshme të skedarëve"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "pyetje {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "saktë"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "i gabuar"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "pjesërisht e saktë"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "jo të plota"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "e pa përgjigjur"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "dorëzuar"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "procesim"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Kjo përgjigje është e saktë."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Kjo përgjigje është e pasaktë."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Kjo përgjigje është pjesërisht e saktë."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Kjo përgjigje është duke u përpunuar."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Ende nuk është përgjigjur."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Zgjidhni një opsion"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: etiketë e papritur {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1719
msgid "Answer received."
msgstr "Përgjigjja e marrë."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Pritet një etiketë <choice> ose <compoundhint>; mori {given_tag} në vend"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Dosjet tuaja janë dorëzuar. Sapo dorëzimi juaj të vlerësohet, ky mesazh do "
"të zëvendësohet me komentet e vlerësuesit."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Përgjigja juaj është dorëzuar. Sapo dorëzimi juaj të vlerësohet, ky mesazh "
"do të zëvendësohet me komentet e vlerësuesit."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "redaktori {programming_language}"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Shtypni ESC pastaj TAB ose kliko jashtë redaktuesit të kodit për të dalë"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Mesazhi është dorëzuar. Sapo të kthehet një përgjigje, ky mesazh do të "
"zëvendësohet nga ai reagim."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Asnjë përgjigje nga Xqueue brenda {xqueue_timeout} sekondave. Abortuar."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Gabim në ekzekutimin e kodit."

#: capa/inputtypes.py:984
msgid "Cannot connect to the queue"
msgstr "Nuk mund të lidhem me radhë"

#: capa/inputtypes.py:1217 capa/inputtypes.py:1301
msgid "No formula specified."
msgstr "Asnjë formulë e specifikuar."

#: capa/inputtypes.py:1223
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Formula nuk analizohet dot: {error_msg}"

#: capa/inputtypes.py:1227 capa/inputtypes.py:1323
msgid "Error while rendering preview"
msgstr "Pamja paraprake nuk paraqitet si duhet."

#: capa/inputtypes.py:1319
msgid "Sorry, couldn't parse formula"
msgstr "Na vjen keq, nuk mund të analizoj formulën"

#: capa/inputtypes.py:1696
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : etiketë e papritur {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1781
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Pritej një etiketë {expected_tag} ; u mor një {given_tag} në vend."

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
msgid "Question {index}"
msgstr "Pyetje {index}"

#: capa/responsetypes.py:387
msgid "Correct:"
msgstr "Kjo është e saktë:"

#: capa/responsetypes.py:389
msgid "Incorrect:"
msgstr "E gabuar:"

#: capa/responsetypes.py:512
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Gabim {err} në vlerësimin e funksionit të sugjerimit {hintfn}."

#: capa/responsetypes.py:513
msgid "(Source code line unavailable)"
msgstr "(Rreshti i kodit burimor nuk disponohet)"

#: capa/responsetypes.py:514
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Shih linjën e burimit XML {sourcenum}."

#: capa/responsetypes.py:682
msgid "Checkboxes"
msgstr "Kutitë e kontrollit"

#: capa/responsetypes.py:1012
msgid "Multiple Choice"
msgstr "Zgjedhje e shumëfishtë"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1233
msgid "Do not use shuffle and answer-pool at the same time"
