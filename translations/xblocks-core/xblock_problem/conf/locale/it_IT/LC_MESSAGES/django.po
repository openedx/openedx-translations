#: block.py:235
msgid "Display Name"
msgstr "Mostra il nome"

#: block.py:236
msgid "The display name for this component."
msgstr "Il nome visualizzato per questo componente."

#: block.py:240
msgid "Blank Problem"
msgstr "Problema vuoto"

#: block.py:243
msgid "Number of attempts taken by the student on this problem"
msgstr "Numero di tentativi intrapresi dallo studente su questo problema"

#: block.py:246
msgid "Maximum Attempts"
msgstr "Tentativi massimi"

#: block.py:248
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Definisce il numero di volte in cui uno studente può provare a rispondere a "
"questo problema. Se il valore non è impostato, vengono consentiti infiniti "
"tentativi."

#: block.py:255
msgid "Grading Method"
msgstr "Metodo di valutazione"

#: block.py:257
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Definire il metodo di valutazione per questo problema. Per impostazione "
"predefinita, è il punteggio dell&#39;ultimo invio effettuato dallo studente."

#: block.py:263 block.py:558
msgid "Last Score"
msgstr "Ultimo punteggio"

#: block.py:264 block.py:559
msgid "First Score"
msgstr "Primo punteggio"

#: block.py:265 block.py:560
msgid "Highest Score"
msgstr "Punteggio più alto"

#: block.py:266 block.py:561
msgid "Average Score"
msgstr "Punteggio medio"

#: block.py:269
msgid "Date that this problem is due by"
msgstr "Data ultima di consegna"

#: block.py:271
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Periodo di tempo dopo la data di scadenza in cui saranno accettati gli invii"

#: block.py:274
msgid "Show Results"
msgstr "Mostra risultati"

#: block.py:276
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Definisce quando mostrare se la risposta di uno studente al problema è "
"corretta. Configurato nella sottosezione."

#: block.py:281 block.py:292 block.py:336
msgid "Always"
msgstr "Sempre"

#: block.py:282 block.py:299 block.py:338
msgid "Never"
msgstr "Mai"

#: block.py:283 block.py:298
msgid "Past Due"
msgstr "Scaduto"

#: block.py:287
msgid "Show Answer"
msgstr "Mostra Risposta"

#: block.py:288
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Definisce quando mostrare la riposta al problema. È possibile impostare un "
"valore predefinito in Impostazioni avanzate."

#: block.py:293
msgid "Answered"
msgstr "Risposto"

#: block.py:294
msgid "Attempted or Past Due"
msgstr "Tentato o Scaduto"

#: block.py:295
msgid "Closed"
msgstr "Chiuso"

#: block.py:296
msgid "Finished"
msgstr "Completato"

#: block.py:297
msgid "Correct or Past Due"
msgstr "Corretto o scaduto"

#: block.py:300
msgid "After Some Number of Attempts"
msgstr "Dopo un determinato numero di tentativi"

#: block.py:301
msgid "After All Attempts"
msgstr "Dopo tutti i tentativi"

#: block.py:302
msgid "After All Attempts or Correct"
msgstr "Quando tutti i tentativi sono stati fatti o è Corretto"

#: block.py:303
msgid "Attempted"
msgstr "Tentato"

#: block.py:307
msgid "Show Answer: Number of Attempts"
msgstr "Mostra riposta: numero di tentativi"

#: block.py:309
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Numero di volte in cui lo studente deve tentare di rispondere alla domanda "
"prima che venga visualizzato il pulsante Mostra risposta."

#: block.py:316
msgid "Whether to force the save button to appear on the page"
msgstr ""
"Stabilire se forzare la visualizzazione del pulsante di salvataggio sulla "
"pagina"

#: block.py:319
msgid "Show Reset Button"
msgstr "Mostra il pulsante di reset"

#: block.py:321
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Determina se visualizzare un pulsante 'Reimposta' in modo che l'utente possa"
" reimpostare la sua risposta. È possibile impostare un valore predefinito in"
" Impostazioni avanzate."

#: block.py:328
msgid "Randomization"
msgstr "Randomizzazione "

#: block.py:330
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Definisce quando randomizzare le variabili specificate nello script Python "
"associato. Per problemi che non randomizzano i valori, specificare \"Mai\". "

#: block.py:337
msgid "On Reset"
msgstr "In caso di reset"

#: block.py:339
msgid "Per Student"
msgstr "Per studente"

#: block.py:343
msgid "XML data for the problem"
msgstr "Dati XML associati al problema"

#: block.py:349
msgid "Dictionary with the correctness of current student answers"
msgstr "Dizionario con la correttezza delle risposte di studenti correnti"

#: block.py:351
msgid "List of correctness maps for each attempt"
msgstr "Elenco delle mappe di correttezza per ogni tentativo"

#: block.py:352
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Dizionario per la conservazione dello stato di inputtypes"

#: block.py:353
msgid "Dictionary with the current student responses"
msgstr "Dizionario con le risposte di studenti correnti"

#: block.py:355
msgid "List of student answers for each attempt"
msgstr "Elenco delle risposte degli studenti per ogni tentativo"

#: block.py:359
msgid "Dictionary with the current student score"
msgstr "Dizionario con il punteggio studente corrente"

#: block.py:361
msgid "List of scores for each attempt"
msgstr "Elenco dei punteggi per ogni tentativo"

#: block.py:364
msgid "Whether or not the answers have been saved since last submit"
msgstr "Stabilisce se le risposte sono state salvate o meno dall'ultimo invio"

#: block.py:366
msgid "Whether the student has answered the problem"
msgstr "Stabilisce se lo studente ha risposto al problema"

#: block.py:367
msgid "Random seed for this student"
msgstr "Seme casuale per questo studente"

#: block.py:368
msgid "Last submission time"
msgstr "Ultimo tempo di invio"

#: block.py:370
msgid "Timer Between Attempts"
msgstr "Timer tra tentativi"

#: block.py:371
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Numero di secondi che uno studente deve attendere tra un invio e l'altro "
"riguardante un problema con tentativi multipli."

#: block.py:376
msgid "Problem Weight"
msgstr "Peso del problema"

#: block.py:378
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Definisce il valore del problema in base al numero di punti assegnato. Se "
"questo valore non è impostato, ciascun campo di risposta nel problema ha un "
"valore pari ad un punto."

#: block.py:384
msgid "Markdown source of this module"
msgstr "Sorgente Markdown di questo modulo"

#: block.py:386
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Codice sorgente per problemi LaTeX e Word. Questa funzione non è "
"perfettamente supportata."

#: block.py:388
msgid "Enable LaTeX templates?"
msgstr "Abilita template LaTeX?"

#: block.py:390
msgid "Matlab API key"
msgstr "API key di Matlab"

#: block.py:392
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Immettere la chiave API fornita da MathWorks per l'accesso al servizio "
"hosted MATLAB. Questa chiave è concessa in via esclusiva per questo corso "
"per la durata specificata. Si prega di non condividere la chiave API con "
"altri corsi e notificare immediatamente MathWorks se si crede che la chiave "
"sia esposta o compromessa. Per ottenere una chiave per il proprio corso o "
"per segnalare un errore, contattare moocsupport@mathworks.com"

#: block.py:401
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Indica se il problema è stato modificato utilizzando l&#39;editor Markdown "
"nell&#39;MFE di creazione."

#: block.py:486
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Spiacenti, si è verificato un errore durante l'elaborazione della propria "
"richiesta. Si prega di ricaricare la pagina e provare nuovamente."

#: block.py:491
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Lo stato di questo problema è cambiato dall'ultimo caricamento di questa "
"pagina. Si prega di aggiornare la pagina."

#: block.py:811 block.py:828
msgid "Answer ID"
msgstr "ID Risposta"

#: block.py:812 block.py:829
msgid "Question"
msgstr "Domanda"

#: block.py:813 block.py:830 capa/responsetypes.py:434
msgid "Answer"
msgstr "Risposta"

#: block.py:816
msgid "Correct Answer"
msgstr "Risposta corretta"

#: block.py:1062
msgid "Submit"
msgstr "Invia"

#: block.py:1075
msgid "Submitting"
msgstr "In fase di invio"

#: block.py:1197
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Avvertenza: il problema è stato reimpostato al suo stato iniziale!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1201
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Lo stato del problema è stato danneggiato in seguito ad un invio non valido."
" L'invio era costituito da:"

#: block.py:1208
msgid "If this error persists, please contact the course staff."
msgstr "Se il problema persiste, si prega di contattare lo staff del corso."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1263
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1269
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Suggerimento ({hint_num} di {hints_count}): "

#: block.py:1350
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Le risposte fornite sono state salvate in precedenza. Fare clic su "
"'{button_name}' per valutarle."

#: block.py:1426
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Incorretto ({progress} punto)"
msgstr[1] "Incorretto ({progress} punti)"
msgstr[2] "Incorretto ({progress} punti)"

#: block.py:1429 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Errato"

#: block.py:1433
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Corretto ({progress} punto)"
msgstr[1] "Corretto ({progress} punti)"
msgstr[2] "Corretto ({progress} punti)"

#: block.py:1436 capa/capa_problem.py:754
msgid "Correct"
msgstr "Corretto"

#: block.py:1440
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Parzialmente corretta ({progress} punto)"
msgstr[1] "Parzialmente corretti ({progress} punti)"
msgstr[2] "Parzialmente corretti ({progress} punti)"

#: block.py:1445
msgid "Partially Correct"
msgstr "Parzialmente Corretto"

#: block.py:1447
msgid "Answer submitted."
msgstr "Risposta inviata."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1839 block.py:2163
msgid "Problem is closed."
msgstr "Il problema è chiuso."

#: block.py:1845
msgid "Problem must be reset before it can be submitted again."
msgstr ""
"Il problema deve essere reimpostato prima che possa essere nuovamente "
"inviato."

#: block.py:1855
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "È necessario attendere almeno {wait} secondi tra gli invii."

#: block.py:1865
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"È necessario attendere almeno {wait_secs} tra gli invii. {remaining_secs} "
"rimanenti."

#: block.py:2038
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} ora"
msgstr[1] "{num_hour} ore"
msgstr[2] "{num_hour} ore"

#: block.py:2043
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minuto"
msgstr[1] "{num_minute} minuti"
msgstr[2] "{num_minute} minuti"

#: block.py:2049
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} secondo"
msgstr[1] "{num_second} secondi"
msgstr[2] "{num_second} secondi"

#: block.py:2171
msgid "Problem needs to be reset prior to save."
msgstr "Il problema deve essere reimpostato prima del salvataggio."

#: block.py:2180
msgid "Your answers have been saved."
msgstr "Le tue risposte sono state salvate."

#: block.py:2182
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Le risposte fornite sono state salvate ma non valutate. Fare clic su "
"'{button_name}' per valutarle."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2211
msgid "You cannot select Reset for a problem that is closed."
msgstr "Non è possibile selezionare Reimposta per un problema chiuso."

#: block.py:2219
msgid "You must submit an answer before you can select Reset."
msgstr ""
"È necessario inviare una risposta prima di poter selezionare Reimposta."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2275
msgid "Problem's definition does not support rescoring."
msgstr ""
"La definizione del problema non supporta l'assegnazione di un nuovo "
"punteggio."

#: block.py:2280
msgid "Problem must be answered before it can be graded again."
msgstr ""
"È necessario rispondere al problema prima di poter ricevere una nuova "
"valutazione."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Impossibile riassegnare il punteggio di problemi con possibili invii di file"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Domanda {}"

#: capa/inputtypes.py:89
msgid "correct"
msgstr "corretto"

#: capa/inputtypes.py:90
msgid "incorrect"
msgstr "sbagliato"

#: capa/inputtypes.py:91
msgid "partially correct"
msgstr "parzialmente corretto"

#: capa/inputtypes.py:92
msgid "incomplete"
msgstr "incompleto"

#: capa/inputtypes.py:93 capa/inputtypes.py:94
msgid "unanswered"
msgstr "non risposto"

#: capa/inputtypes.py:95
msgid "submitted"
msgstr "inviato"

#: capa/inputtypes.py:96
msgid "processing"
msgstr "in elaborazione"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Questa risposta è corretta."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Questa risposta è incorretta."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Questa risposta è parzialmente corretta."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Questa domanda è in corso di elaborazione."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Non ancora risposta."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Seleziona un'opzione"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: {tag_name} è un tag inatteso"

#: capa/inputtypes.py:505 capa/inputtypes.py:1717
msgid "Answer received."
msgstr "Risposta ricevuta."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Previsto un tag <choice> o <compoundhint>; ricevuto invece {given_tag}"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"I tuoi file sono stati inviati. Non appena il tuo invio sarà valutato, "
"questo messaggio verrà sostituito con il feedback dell'esaminatore."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"La tua risposta è stata inviata. Non appena il tuo invio sarà valutato, "
"questo messaggio verrà sostituito con il feedback dell'esaminatore."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "{programming_language} editor"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Premere ESC, quindi TAB oppure fare clic fuori dall'editor di codice per "
"uscire"

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Inviato. Non appena verrà restituita una risposta, questo messaggio sarà "
"sostituito con quel feedback."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr "Nessuna risposta da Xqueue in {xqueue_timeout} secondi. Interrotto."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Errore eseguendo il codice."

#: capa/inputtypes.py:982
msgid "Cannot connect to the queue"
msgstr "Impossibile connettersi alla coda"

#: capa/inputtypes.py:1215 capa/inputtypes.py:1299
msgid "No formula specified."
msgstr "Nessuna formula specificata."

#: capa/inputtypes.py:1221
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Impossibile analizzare la formula: {error_msg}"

#: capa/inputtypes.py:1225 capa/inputtypes.py:1321
msgid "Error while rendering preview"
msgstr "Errore nel rendering dell'anteprima"

#: capa/inputtypes.py:1317
msgid "Sorry, couldn't parse formula"
msgstr "Spiacente, impossibile analizzare la formula"

#: capa/inputtypes.py:1694
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: tag non previsto {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1779
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Previsto un tag {expected_tag}; ricevuto invece {given_tag}"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:278
#, python-brace-format
msgid "Question {index}"
msgstr "Domanda {index}"

#: capa/responsetypes.py:389
msgid "Correct:"
msgstr "Corrette:"

#: capa/responsetypes.py:391
msgid "Incorrect:"
msgstr "Errate:"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr ""
"Errore {err} nella valutazione della funzione di suggerimento {hintfn}."

#: capa/responsetypes.py:514
msgid "(Source code line unavailable)"
msgstr "(Linea del codice sorgente non disponibile)"

#: capa/responsetypes.py:515
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Consultare la riga di origine XML {sourcenum}."

#: capa/responsetypes.py:683
msgid "Checkboxes"
msgstr "Caselle di controllo"

#: capa/responsetypes.py:1013
msgid "Multiple Choice"
msgstr "Scelta multipla"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1234
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Non usare shuffle e answer-pool allo stesso tempo"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1317
msgid "answer-pool value should be an integer"
msgstr "Il valore del pool di risposte deve essere un numero intero"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1384
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr "Choicegroup deve includere almeno 1 scelta corretta e 1 incorretta"

#: capa/responsetypes.py:1409
msgid "True/False Choice"
msgstr "Scelta Vero/Falso"

#: capa/responsetypes.py:1454
msgid "Dropdown"
msgstr "Menù a discesa"

#: capa/responsetypes.py:1532
msgid "Numerical Input"
msgstr "Input numerico"

#: capa/responsetypes.py:1568 capa/responsetypes.py:1595
msgid "There was a problem with the staff answer to this problem."
msgstr ""
"Si è verificato un problema con la risposta dello staff a questo problema."

#: capa/responsetypes.py:1618
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Non è stato possibile interpretare '{student_answer}' come un numero."

#: capa/responsetypes.py:1636
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr "Funzione fattoriale valutata fuori dal suo dominio:'{student_answer}'"

#: capa/responsetypes.py:1643
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Sintassi matematica non valida: '{student_answer}'"

#: capa/responsetypes.py:1674
msgid "You may not use complex numbers in range tolerance problems"
msgstr ""
"Non è possibile utilizzare numeri complessi in problemi di tolleranza "
"dell'intervallo"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1682
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Si è verificato un problema con la risposta dello staff a questo problema: "
"limite complesso."

