#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:100
msgid "This answer is correct."
msgstr "Cette réponse est correcte."

#: capa/inputtypes.py:101
msgid "This answer is incorrect."
msgstr "Cette réponse est incorrecte."

#: capa/inputtypes.py:102
msgid "This answer is partially correct."
msgstr "Cette réponse est partiellement correcte."

#: capa/inputtypes.py:103
msgid "This answer is being processed."
msgstr "Cette réponse est en traitement."

#: capa/inputtypes.py:105
msgid "Not yet answered."
msgstr "Pas encore de réponse."

#: capa/inputtypes.py:438
msgid "Select an option"
msgstr "Sélectionnez une option"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:490
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup : étiquette inattendue {tag_name}"

#: capa/inputtypes.py:505 capa/inputtypes.py:1717
msgid "Answer received."
msgstr "Réponse reçue."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:539
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Attendait une étiquette <choice> ou <compoundhint>; a reçu une étiquette "
"{given_tag} au lieu"

#: capa/inputtypes.py:725
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Vos fichiers ont été soumis. Aussitôt que votre soumission est notée, ce "
"message sera remplacé par les commentaires de l'évaluateur."

#: capa/inputtypes.py:801
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Votre réponse a été soumise. Aussitôt que votre soumission est notée, ce "
"message sera remplacé par les commentaires de l'évaluateur."

#: capa/inputtypes.py:815
#, python-brace-format
msgid "{programming_language} editor"
msgstr "Editeur de {programming_language}"

#: capa/inputtypes.py:818
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Appuyez sur ÉCHAP puis sur TAB ou cliquez en dehors de l&#39;éditeur de code"
" pour quitter."

#: capa/inputtypes.py:848
msgid ""
"Submitted. As soon as a response is returned, this message will be replaced "
"by that feedback."
msgstr ""
"Soumis. Aussitôt qu'une réponse est retournée, ce message sera remplacé par "
"les commentaires."

#: capa/inputtypes.py:873
#, python-brace-format
msgid "No response from Xqueue within {xqueue_timeout} seconds. Aborted."
msgstr ""
"Aucune réponse de Xqueue à l'intérieur de {xqueue_timeout} secondes. "
"Interrompu."

#: capa/inputtypes.py:943
msgid "Error running code."
msgstr "Erreur d'exécution de code."

#: capa/inputtypes.py:982
msgid "Cannot connect to the queue"
msgstr "Ne peut se connecter à la queue"

#: capa/inputtypes.py:1215 capa/inputtypes.py:1299
msgid "No formula specified."
msgstr "Aucune formule spécifiée"

#: capa/inputtypes.py:1221
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Impossible d'analyser la formule : {error_msg}"

#: capa/inputtypes.py:1225 capa/inputtypes.py:1321
msgid "Error while rendering preview"
msgstr "Erreur pendant le rendu de l'aperçu"

#: capa/inputtypes.py:1317
msgid "Sorry, couldn't parse formula"
msgstr "Désolé, nous ne pouvons analyser la formule"

#: capa/inputtypes.py:1694
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : étiquette inattendue {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1779
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr ""
"Attendions une étiquette {expected_tag}; avons reçu {given_tag} au lieu"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:278
#, python-brace-format
msgid "Question {index}"
msgstr "Question {index}"

#: capa/responsetypes.py:389
msgid "Correct:"
msgstr "Correct :"

#: capa/responsetypes.py:391
msgid "Incorrect:"
msgstr "Incorrect :"

#: capa/responsetypes.py:513
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Erreur {err} lors de l'évaluation de la fonction d'indice {hintfn}."

#: capa/responsetypes.py:514
msgid "(Source code line unavailable)"
msgstr "(Ligne du code source non disponible)"

#: capa/responsetypes.py:515
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Voir la ligne du code sources XML {sourcenum}."

#: capa/responsetypes.py:683
msgid "Checkboxes"
msgstr "Cases à cocher"

#: capa/responsetypes.py:1013
msgid "Multiple Choice"
msgstr "Choix multiples"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1234
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Ne pas utiliser shuffle et answer-pool en même temps"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1317
msgid "answer-pool value should be an integer"
msgstr "la valeur de answer-pool devrait être un nombre entier"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1384
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr "Choicegroup doit inclue au moins 1 choix correct et 1 choix incorrect"

#: capa/responsetypes.py:1409
msgid "True/False Choice"
msgstr "Choix vrai/faux"

#: capa/responsetypes.py:1454
msgid "Dropdown"
msgstr "Liste déroulante"

#: capa/responsetypes.py:1532
msgid "Numerical Input"
msgstr "Chiffres à saisir"

#: capa/responsetypes.py:1568 capa/responsetypes.py:1595
msgid "There was a problem with the staff answer to this problem."
msgstr "Il y avait un problème avec la réponse du personnel à ce problème."

#: capa/responsetypes.py:1618
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Ne peut interpréter '{student_answer}' comme un nombre."

#: capa/responsetypes.py:1636
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr ""
"Fonction factorielle évaluée en dehors de son domaine: '{student_answer}'"

#: capa/responsetypes.py:1643
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Syntaxe mathématique invalide : '{student_answer}'"

#: capa/responsetypes.py:1674
msgid "You may not use complex numbers in range tolerance problems"
msgstr ""
"Vous ne pouvez pas utiliser les nombres complexes dans des problèmes de "
"tolérance de gamme"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1682
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Il y avait un problème avec la réponse du personnel à ce problème : limite "
"complexe."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
