#: block.py:1445
msgid "Partially Correct"
msgstr "Partiellement correct"

#: block.py:1447
msgid "Answer submitted."
msgstr "Réponse envoyée."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1839 block.py:2163
msgid "Problem is closed."
msgstr "Problème fermé."

#: block.py:1845
msgid "Problem must be reset before it can be submitted again."
msgstr ""
"Le problème doit être réinitialisé avant qu'il puisse être soumis de "
"nouveau."

#: block.py:1855
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Vous devez attendre au minimum {wait} secondes entre les soumissions."

#: block.py:1865
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Vous devez attendre au moins {wait_secs} entre deux soumissions. Il reste "
"{remaining_secs}."

#: block.py:2038
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} heure"
msgstr[1] "{num_hour} heures"
msgstr[2] "{num_hour} heures"

#: block.py:2043
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} minute"
msgstr[1] "{num_minute} minutes"
msgstr[2] "{num_minute} minutes"

#: block.py:2049
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} seconde"
msgstr[1] "{num_second} secondes"
msgstr[2] "{num_second} secondes"

#: block.py:2171
msgid "Problem needs to be reset prior to save."
msgstr "Le problème doit être réinitialisé avant d'être sauvegardé."

#: block.py:2180
msgid "Your answers have been saved."
msgstr "Vos réponses ont été sauvegardées."

#: block.py:2182
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Vos réponses ont été enregistrées, mais n’ont pas encore été notées. Cliquer"
" sur '{button_name}' pour les noter."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2211
msgid "You cannot select Reset for a problem that is closed."
msgstr "Vous ne pouvez pas sélectionner Réinitialiser pour un problème fermé."

#: block.py:2219
msgid "You must submit an answer before you can select Reset."
msgstr ""
"Vous devez soumettre une réponse avant de pouvoir sélectionner "
"Réinitialiser."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2275
msgid "Problem's definition does not support rescoring."
msgstr "La définition du problème ne supporte pas une nouvelle notation."

#: block.py:2280
msgid "Problem must be answered before it can be graded again."
msgstr "Le problème doit être répondu avant d'être noté de nouveau."

#: capa/capa_problem.py:525
msgid "Cannot rescore problems with possible file submissions"
msgstr ""
"Ne peut renoter les problèmes avec possiblement des soumissions de fichiers"

#: capa/capa_problem.py:619
msgid "Question {}"
msgstr "Question {}"

