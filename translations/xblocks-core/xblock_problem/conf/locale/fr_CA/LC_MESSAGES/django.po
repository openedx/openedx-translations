#: block.py:235
msgid "Display Name"
msgstr "Nom d&#39;affichage"

#: block.py:236
msgid "The display name for this component."
msgstr "Nom d&#39;affichage de ce composant."

#: block.py:240
msgid "Blank Problem"
msgstr "Problème vide"

#: block.py:243
msgid "Number of attempts taken by the student on this problem"
msgstr "Nombre de tentatives de l'étudiant sur ce problème"

#: block.py:246
msgid "Maximum Attempts"
msgstr "Nombre de tentatives maximum"

#: block.py:248
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Définit le nombre de fois où un étudiant peut tenter de répondre à ce "
"problème. Si cette valeur n'est pas définie, un nombre infini de tentatives "
"est permis."

#: block.py:255
msgid "Grading Method"
msgstr "Méthode de notation"

#: block.py:257
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Définissez la méthode de notation pour ce problème. Par défaut, il s'agit de"
" la note de la dernière soumission effectuée par l'étudiant."

#: block.py:263 block.py:558
msgid "Last Score"
msgstr "Dernier résultat"

#: block.py:264 block.py:559
msgid "First Score"
msgstr "Premier résultat"

#: block.py:265 block.py:560
msgid "Highest Score"
msgstr "Le résultat le plus élevé"

#: block.py:266 block.py:561
msgid "Average Score"
msgstr "Résultat moyen"

#: block.py:269
msgid "Date that this problem is due by"
msgstr "Date à laquelle ce problème doit être remis"

#: block.py:271
msgid "Amount of time after the due date that submissions will be accepted"
msgstr ""
"Laps de temps après la date d'échéance où les soumissions seront acceptées"

#: block.py:274
msgid "Show Results"
msgstr "Afficher les résultats"

#: block.py:276
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Définit quand afficher si la réponse d'un apprenant au problème est "
"correcte. Configuré dans la sous-section."

#: block.py:281 block.py:292 block.py:336
msgid "Always"
msgstr "Toujours"

#: block.py:282 block.py:299 block.py:338
msgid "Never"
msgstr "Jamais"

#: block.py:283 block.py:298
msgid "Past Due"
msgstr "En retard"

#: block.py:287
msgid "Show Answer"
msgstr "Afficher la réponse"

#: block.py:288
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Définit quand afficher la réponse au problème. Une valeur de défaut peut "
"être définie dans les paramètres avancés."

#: block.py:293
msgid "Answered"
msgstr "Répondu"

#: block.py:294
msgid "Attempted or Past Due"
msgstr "Tenté ou en retard"

#: block.py:295
msgid "Closed"
msgstr "Fermé"

#: block.py:296
msgid "Finished"
msgstr "Terminé"

#: block.py:297
msgid "Correct or Past Due"
msgstr "Correct ou en retard"

#: block.py:300
msgid "After Some Number of Attempts"
msgstr "Après un certain nombre de tentatives"

#: block.py:301
msgid "After All Attempts"
msgstr "Après toutes les tentatives"

#: block.py:302
msgid "After All Attempts or Correct"
msgstr "Après toutes les tentatives ou correct"

#: block.py:303
msgid "Attempted"
msgstr "Tenté"

#: block.py:307
msgid "Show Answer: Number of Attempts"
msgstr "Afficher la réponse : Nombre de tentatives"

#: block.py:309
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Nombre de fois où l'étudiant doit tenter de répondre à la question avant que"
" le bouton Afficher la réponse ne s'affiche."

#: block.py:316
msgid "Whether to force the save button to appear on the page"
msgstr "Forcer ou non le bouton sauvegarder à apparaître sur la page"

#: block.py:319
msgid "Show Reset Button"
msgstr "Afficher le bouton de réinitialisation"

#: block.py:321
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Détermine si le bouton 'Réinitialisation' est affiché à l'utilisateur pour "
"qu'il puisse réinitialiser sa réponse. Une valeur de défaut peut être "
"définie dans les paramètres avancés."

#: block.py:328
msgid "Randomization"
msgstr "Aléatoire"

#: block.py:330
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Définit le moment de rendre aléatoire les variables spécifiées dans le "
"script Python associé. Pour les problèmes qui n'utilisent pas de valeurs "
"aléatoires, indiquer \"Jamais\"."

#: block.py:337
msgid "On Reset"
msgstr "Sur réinitialisation"

#: block.py:339
msgid "Per Student"
msgstr "Par étudiant"

#: block.py:343
msgid "XML data for the problem"
msgstr "Données XML pour le problème"

#: block.py:349
msgid "Dictionary with the correctness of current student answers"
msgstr "Dictionaire avec l'exactitude des réponses de l'étudiant"

#: block.py:351
msgid "List of correctness maps for each attempt"
msgstr "Liste des cartes d'exactitude pour chaque tentative"

#: block.py:352
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Dictionnaire pour maintenir le statut de inputtypes"

#: block.py:353
msgid "Dictionary with the current student responses"
msgstr "Dictionnaire avec les réponses de l'étudiant"

#: block.py:355
msgid "List of student answers for each attempt"
msgstr "Liste des réponses des élèves pour chaque tentative"

#: block.py:359
msgid "Dictionary with the current student score"
msgstr "Dictionnaire avec le score actuel de l'étudiant"

#: block.py:361
msgid "List of scores for each attempt"
msgstr "Liste des résultats pour chaque tentative"

#: block.py:364
msgid "Whether or not the answers have been saved since last submit"
msgstr ""
"Si les réponses ont été enregistrées ou non depuis la dernière soumission"

#: block.py:366
msgid "Whether the student has answered the problem"
msgstr "Si l'étudiant a répondu au problème"

#: block.py:367
msgid "Random seed for this student"
msgstr "Suite aléatoire pour cet étudiant"

#: block.py:368
msgid "Last submission time"
msgstr "Dernière soumission"

#: block.py:370
msgid "Timer Between Attempts"
msgstr "Laps de temps entre les tentatives"

#: block.py:371
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Nombre de secondes que l'étudiant doit attendre entre chaque soumission pour"
" un problème avec des tentatives multiples."

#: block.py:376
msgid "Problem Weight"
msgstr "Poids du problème"

#: block.py:378
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Définit le nombre de points que chaque problème vaut. Si la valeur n'est pas"
" définie, chaque champ de réponse dans le problème vaut un point."

#: block.py:384
msgid "Markdown source of this module"
msgstr "Source markdown de ce module"

#: block.py:386
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Code source pour les problèmes LaTeX et Word. Cette fonctionnalité n'est pas"
" bien pris en charge."

#: block.py:388
msgid "Enable LaTeX templates?"
msgstr "Activé les gabarits LaTeX?"

#: block.py:390
msgid "Matlab API key"
msgstr "Clé d'API Matlab"

#: block.py:392
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Entrer la clé API fournie par MathWorks pour accéder au service hébergé de "
"MATLAB. Cette clé est permise pour une utilisation exclusive dans ce cours "
"pour une durée spécifique. Ne partagez pas cette clé AI avec d'autres cours."
" Prévenez immédiatement MathWorks si vous croyez que la clé est compromise. "
"Pour obtenir une clé pour votre cours ou pour signaler un problème, s'il "
"vous plaît contacter moocsupport@mathworks.com"

#: block.py:401
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Indique si l&#39; exercice a été édité à l'aide de l'éditeur Markdown dans "
"le MFE de création."

#: block.py:486
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Nous sommes désolés, il y a eu une erreur lors du traitement de votre "
"demande. S'il vous plaît essayer de rafraîchir votre page et essayer encore."

#: block.py:491
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Le statut de ce problème a changé depuis que vous avez téléchargé cette "
"page. S'il vous plaît rafraîchissez votre page."

#: block.py:811 block.py:828
msgid "Answer ID"
msgstr "Identifiant de la réponse"

#: block.py:812 block.py:829
msgid "Question"
msgstr "Question"

#: block.py:813 block.py:830 capa/responsetypes.py:434
msgid "Answer"
msgstr "Réponse"

#: block.py:816
msgid "Correct Answer"
msgstr "Réponse correcte"

#: block.py:1062
msgid "Submit"
msgstr "Soumettre"

#: block.py:1075
msgid "Submitting"
msgstr "Soumission"

#: block.py:1197
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Avertissement : ce problème a été réinitialisé à son statut initial!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1201
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Le statut du problème a été corrompu par une soumission invalide. La "
"soumission était composée de : "

#: block.py:1208
msgid "If this error persists, please contact the course staff."
msgstr "Si cette erreur persiste, contacter le personnel du cours."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1263
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1269
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Indice ({hint_num} de {hints_count}) : "

#: block.py:1350
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Vos réponses ont déjà été enregistrées. Cliquez sur '{button_name}' pour les"
" noter."

