msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Incorrect ({progress} point)"
msgstr[1] "Incorrect ({progress} points)"
msgstr[2] "Incorrect ({progress} points)"

#: block.py:1429 capa/capa_problem.py:749
msgid "Incorrect"
msgstr "Incorrect"

#: block.py:1433
#, python-brace-format
