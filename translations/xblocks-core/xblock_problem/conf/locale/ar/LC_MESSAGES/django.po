#: block.py:236
msgid "Display Name"
msgstr "الاسم الظاهر"

#: block.py:237
msgid "The display name for this component."
msgstr "الاسم الظاهر لهذا المكون."

#: block.py:241
msgid "Blank Problem"
msgstr "مسألة فارغة"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "عدد المرات التي حاول فيها هذا الطالب حل هذه المسألة"

#: block.py:247
msgid "Maximum Attempts"
msgstr "الحد الأقصى للمحاولات"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"تضبط هذه القيمة عدد المرّات التي يمكن فيها للطالب أن يحاول الإجابة عن هذه "
"المسألة. إذا لم تُضبط هذه القيمة، فسيُسمح بعدد غير محدود من المحاولات."

#: block.py:256
msgid "Grading Method"
msgstr "طريقة التقييم"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"حدد طريقة التقييم لهذه المسألة. بالحالة الافتراضية، يتم التقييم بناءً على "
"الدرجة التي أحرزها الطالب في آخر مرة سلّم بها إجابته. "

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "النتيجة الأخيرة"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "النتيجة الأولى"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "أعلى نتيجة"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "معدّل الدرجات"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "تاريخ استحقاق تقديم هذه المسألة"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "المدة التي تُقبل خلالها الإجابات المقدَّمة بعد تاريخ الاستحقاق"

#: block.py:275
msgid "Show Results"
msgstr "أظهِر النتائج"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"تحدد متى يُعرض ما إذا كانت إجابة المتعلم عن المسألة صحيحة أم لا. تُضبط في "
"القسم الفرعي."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "دائماً"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "نهائياً"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "انقضى الموعد!"

#: block.py:288
msgid "Show Answer"
msgstr "اعرض الجواب"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"تحدد متى تُعرض إجابة المسألة. يمكن ضبط قيمة افتراضية في الإعدادات المتقدمة."

#: block.py:294
msgid "Answered"
msgstr "أُجيب عنه"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "بعد المحاولة أو تجاوز تاريخ الاستحقاق"

#: block.py:296
msgid "Closed"
msgstr "مغلق"

#: block.py:297
msgid "Finished"
msgstr "انتهى"

#: block.py:298
msgid "Correct or Past Due"
msgstr "بعد الإجابة الصحيحة أو تجاوز تاريخ الاستحقاق"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "بعد عدد معيّن من المحاولات"

#: block.py:302
msgid "After All Attempts"
msgstr "بعد استخدام كل المحاولات"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "بعد استنفاد جميع المحاولات أو عند الإجابة الصحيحة"

#: block.py:304
msgid "Attempted"
msgstr "تمت المحاولة"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "اعرض الجواب: عدد المحاولات"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"عدد المرات التي يجب أن يحاول فيها الطالب الإجابة عن السؤال قبل ظهور زر إظهار"
" الإجابة."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "ما إذا كان سيُفرض ظهور زر الحفظ في الصفحة"

#: block.py:320
msgid "Show Reset Button"
msgstr "آظهر زرّ إعادة الضبط"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"تحدد ما إذا كان زر ‘إعادة الضبط’ يظهر ليتمكن المستخدم من إعادة ضبط إجابته. "
"يمكن تعيين قيمة افتراضية في الإعدادات المتقدمة."

#: block.py:329
msgid "Randomization"
msgstr "العشوائية"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"تحدد متى تُعيَّن قيم عشوائية للمتغيرات المحددة في برنامج بايثون النصي "
"المرتبط. في المسائل التي لا تستخدم قيماً عشوائية، حدّد \"أبداً\"."

#: block.py:338
msgid "On Reset"
msgstr "عند إعادة الضبط"

#: block.py:340
msgid "Per Student"
msgstr "لكلّ طالب"

#: block.py:344
msgid "XML data for the problem"
msgstr "بيانات XML للمسألة"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "قاموس يحوي صحة إجابات الطالب الحالية"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "قائمة خرائط الصحة لكل محاولة"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "قاموس للحفاظ على حالة أنواع المدخلات"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "قاموس بردود الطالب الحالية"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "قائمة إجابات الطالب لكل محاولة"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "قاموس لعلامة الطالب الحالية"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "قائمة النتائج لكل محاولة"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "ما إذا كانت الإجابات قد حُفظت أم لا منذ آخر تقديم"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "ما إذا أجاب الطالب عن المسألة"

#: block.py:368
msgid "Random seed for this student"
msgstr "بذرة عشوائية لهذا الطالب"

#: block.py:369
msgid "Last submission time"
msgstr "وقت آخر تقديم"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "المؤقّت بين المحاولات"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"عدد الثواني التي ينبغي على الطالب انتظارها بين إجابة وأخرى لمسألة متعددة "
"المحاولات."

#: block.py:377
msgid "Problem Weight"
msgstr "ثقل المسألة"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"يُحدِّد عدد الدرجات التي تساويها كل مسألة. إذا لم تُحدَّد القيمة، يساوي كل "
"حقل رد في المسألة درجة واحدة."

#: block.py:385
msgid "Markdown source of this module"
msgstr "مصدر Markdown لهذه الوحدة"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr "الكود المصدري لمسائل LaTeX وWord. هذه الميزة غير مدعومة دعماً جيداً."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "هل تريد تفعيل قوالب LaTeX؟"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"يُشير إلى ما إذا عُدلت المسألة باستخدام محرر Markdown في وحدة تأليف MFE."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"عُذراً، كان هناك خطأ أثناء معالجة طلبك. من فضلك أعِد تحميل صفحتك ثم حاول "
"مجدداً."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr "تغيّرت حالة هذه المسألة منذ تحميلك هذه الصفحة. يُرجى تحديث صفحتك."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "معرف الإجابة"

#: block.py:809 block.py:826
msgid "Question"
msgstr "السؤال"

#: block.py:810 block.py:827 capa/responsetypes.py:432
msgid "Answer"
msgstr "الجواب"

#: block.py:813
msgid "Correct Answer"
msgstr "إجابة صحيحة"

#: block.py:1058
msgid "Submit"
msgstr "أرسِل"

#: block.py:1071
msgid "Submitting"
msgstr "إرسال"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "تحذير: لقد أُعيد ضبط المسألة إلى حالتها الابتدائية!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"أُفسدت حالة المسألة بسبب عملية إرسال غير صحيحة. يتكون الملف المُرسل من:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "إذا استمرّ ظهور هذا الخطأ، يُرجى الاتصال بطاقم المساق."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "التلميح ({hint_num} من أصل {hints_count}):"

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr "حُفظت إجاباتك سابقاً. انقر على '{button_name}' لتقييمها."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "خطأ (لا درجات)"
msgstr[1] "خطأ (درجة واحدة)"
msgstr[2] "خطأ (درجتان)"
msgstr[3] "خطأ ({progress} درجات)"
msgstr[4] "خطأ ({progress} درجة)"
msgstr[5] "خطأ ({progress} درجة)"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "غير صحيح"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "صحيح (لا درجات)"
msgstr[1] "صحيح (درجة واحدة)"
msgstr[2] "صحيح (درجتان)"
msgstr[3] "صحيح ({progress} درجات)"
msgstr[4] "صحيح ({progress} درجة)"
msgstr[5] "صحيح ({progress} درجة)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "صحيح"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "صحيح جزئياً (لا درجات)"
msgstr[1] "صحيح جزئياً (درجة واحدة)"
msgstr[2] "صحيح جزئياً (درجتان)"
msgstr[3] "صحيح جزئياً ({progress} درجات)"
msgstr[4] "صحيح جزئياً ({progress} درجة)"
msgstr[5] "صحيح جزئياً ({progress} درجة)"

#: block.py:1441
msgid "Partially Correct"
msgstr "صحيحة جزئياً"

#: block.py:1443
msgid "Answer submitted."
msgstr "أُرسلت الإجابة."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "أُغلقت المسألة."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "يجب إعادة ضبط المسألة قبل إرسالها مرة أخرى."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "يجب أن تنتظر ما لا يقل عن {wait} بين كل إرسالين متتاليين."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"يجب أن تنتظر ما لا يقل عن {wait_secs} بين كل إرسالين متتاليين. بقيت "
"{remaining_secs}."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "لا ساعات"
msgstr[1] "ساعة واحدة"
msgstr[2] "ساعتان"
msgstr[3] "{num_hour} ساعات"
msgstr[4] "{num_hour} ساعةً"
msgstr[5] "{num_hour} ساعةٍ"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "لا دقائق"
msgstr[1] "دقيقة واحدة"
msgstr[2] "دقيقتان"
msgstr[3] "{num_minute} دقائق"
msgstr[4] "{num_minute} دقيقةً"
msgstr[5] "{num_minute} دقيقةٍ"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "لا ثوانٍ"
msgstr[1] "ثانية واحدة"
msgstr[2] "ثانيتان"
msgstr[3] "{num_second} ثوانٍ"
msgstr[4] "{num_second} ثانيةً"
msgstr[5] "{num_second} ثانيةٍ"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "يجب إعادة تعيين المسألة قبل حفظها."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "لقد حُفظت إجاباتك."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"لقد حُفظت إجاباتك، ولكن لم تُقيّم بعد. انقر على \"{button_name}\" لكي تُقيّم"
" الإجابات."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "لا يمكنك اختيار \"أعِد التعيين\" لمسألة قد أُغلقت."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "يجب تقديم إجابة قبل أن تتمكن من تحديد إعادة الضبط."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "لا يدعم تعريف المسألة عملية إعادة التقييم."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "ينبغي الإجابة عن هذه المسألة قبل أن يٌسمح بتقييمها مجدداً."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "لا يمكن إعادة تقييم المسائل التي قد تتضمن تقديم ملفات"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "سؤال {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "صحيح"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "غير صحيح"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "صحيح جزئياً"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "غير مكتمل"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "لم يُجب عنه"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "أُرسِل"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "قيد المعالجة"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "هذه الإجابة صحيحة."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "هذه الإجابة خاطئة."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "هذه الإجابة صحيحة جزئياً."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "هذه الإجابة قيد المعالجة."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "لم يُجب عنه بعد."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "اختَر خياراً"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "ChoiceGroup: وسم {tag_name} غير متوقّع"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "استُلمت الإجابة."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"كان من المتوقّع أن يُستلم أحد الوسمين <choice> أو <compoundhint> ؛ لكن حُصل "
"على {given_tag} بدلاً منهما"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"لقد أُرسلت ملفاتك. ستُستبدل هذه الرسالة بملاحظات المصحّح بمجرد انتهاء تقييم "
"إجابتك."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"لقد أُرسلت إجابتك. ستُستبدل هذه الرسالة بملاحظات المصحّح بمجرد انتهاء تقييم "
"إجابتك."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "محرر {programming_language} "

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr "اضغط ESC ثم TAB، أو انقر خارج محرر النصوص البرمجية للخروج"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "لم تُحدَّد صيغة."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "تعذر تحليل الصيغة: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "حدث خطأ أثناء عرض الإعداد لعرض المعاينة"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "عذراً، تعذر تحليل الصيغة"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type}: وسم {tag_name} غير متوقّع"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr ""
