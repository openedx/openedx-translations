#: block.py:236
msgid "Display Name"
msgstr "Jina la Kuonyesha"

#: block.py:237
msgid "The display name for this component."
msgstr "Jina la onyesho la sehemu hii."

#: block.py:241
msgid "Blank Problem"
msgstr "Tatizo Tupu"

#: block.py:244
msgid "Number of attempts taken by the student on this problem"
msgstr "Idadi ya majaribio yaliyochukuliwa na mwanafunzi juu ya tatizo hili"

#: block.py:247
msgid "Maximum Attempts"
msgstr "Upeo wa majaribio"

#: block.py:249
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Inafafanua idadi ya mara ambazo mwanafunzi anaweza kujaribu kujibu tatizo "
"hili. Ikiwa thamani haijawekwa, majaribio yasiyo na kikomo yanaruhusiwa."

#: block.py:256
msgid "Grading Method"
msgstr "Mbinu ya Kukadiria"

#: block.py:258
msgid ""
"Define the grading method for this problem. By default, it's the score of "
"the last submission made by the student."
msgstr ""
"Bainisha njia ya kuweka alama kwa tatizo hili. Kwa chaguo-msingi, ni alama "
"ya mawasilisho ya mwisho yaliyotolewa na mwanafunzi."

#: block.py:264 block.py:561
msgid "Last Score"
msgstr "Alama ya Mwisho"

#: block.py:265 block.py:562
msgid "First Score"
msgstr "Alama ya Kwanza"

#: block.py:266 block.py:563
msgid "Highest Score"
msgstr "Alama ya Juu"

#: block.py:267 block.py:564
msgid "Average Score"
msgstr "Alama ya Wastani"

#: block.py:270
msgid "Date that this problem is due by"
msgstr "Tarehe ya mwisho ya kutatua tatizo hili"

#: block.py:272
msgid "Amount of time after the due date that submissions will be accepted"
msgstr "Muda baada ya tarehe ya mwisho ambayo mawasilisho yatakubaliwa"

#: block.py:275
msgid "Show Results"
msgstr "Onyesha Matokeo"

#: block.py:277
msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"Inafafanua wakati wa kuonyesha kama jibu la mwanafunzi kwa tatizo ni sahihi."
" Imesanidiwa kwenye kifungu kidogo."

#: block.py:282 block.py:293 block.py:337
msgid "Always"
msgstr "Kila mara"

#: block.py:283 block.py:300 block.py:339
msgid "Never"
msgstr "Kamwe"

#: block.py:284 block.py:299
msgid "Past Due"
msgstr "Malipo Iliyopita"

#: block.py:288
msgid "Show Answer"
msgstr "Onyesha Jibu"

#: block.py:289
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"Inafafanua wakati wa kuonyesha jibu la tatizo. Thamani chaguo-msingi inaweza"
" kuwekwa katika Mipangilio ya Kina."

#: block.py:294
msgid "Answered"
msgstr "Akajibu"

#: block.py:295
msgid "Attempted or Past Due"
msgstr "Jaribio au Muda Uliopita"

#: block.py:296
msgid "Closed"
msgstr "Imefungwa"

#: block.py:297
msgid "Finished"
msgstr "Imekamilika"

#: block.py:298
msgid "Correct or Past Due"
msgstr "Malipo Sahihi au Iliyopita"

#: block.py:301
msgid "After Some Number of Attempts"
msgstr "Baada ya Idadi fulani ya Majaribio"

#: block.py:302
msgid "After All Attempts"
msgstr "Baada ya Majaribio Yote"

#: block.py:303
msgid "After All Attempts or Correct"
msgstr "Baada ya Majaribio Yote au Usahihi"

#: block.py:304
msgid "Attempted"
msgstr "Nilijaribu"

#: block.py:308
msgid "Show Answer: Number of Attempts"
msgstr "Onyesha Jibu: Idadi ya Majaribio"

#: block.py:310
msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"Mara ambazo mwanafunzi lazima ajaribu kujibu swali kabla ya kitufe cha "
"Onyesha Jibu kuonekana."

#: block.py:317
msgid "Whether to force the save button to appear on the page"
msgstr "Ikiwa utalazimisha kitufe cha kuhifadhi kuonekana kwenye ukurasa"

#: block.py:320
msgid "Show Reset Button"
msgstr "Onyesha Kitufe cha Kuweka Upya"

#: block.py:322
msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"Huamua kama kitufe cha &#39;Weka Upya&#39; kitaonyeshwa ili mtumiaji aweze "
"kuweka upya jibu lake. Thamani chaguo-msingi inaweza kuwekwa katika "
"Mipangilio ya Kina."

#: block.py:329
msgid "Randomization"
msgstr "Ubahatishaji"

#: block.py:331
msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Inafafanua wakati wa kubadilisha vigeu vilivyoainishwa katika hati "
"inayohusika ya Python. Kwa shida ambazo hazibadilishi maadili, taja "
"&quot;Kamwe&quot;. "

#: block.py:338
msgid "On Reset"
msgstr "Kwenye Rudisha"

#: block.py:340
msgid "Per Student"
msgstr "Kwa Mwanafunzi"

#: block.py:344
msgid "XML data for the problem"
msgstr "Data za XML kwa tatizo"

#: block.py:350
msgid "Dictionary with the correctness of current student answers"
msgstr "Kamusi yenye usahihi wa majibu ya sasa ya wanafunzi"

#: block.py:352
msgid "List of correctness maps for each attempt"
msgstr "Orodha ya ramani za usahihi kwa kila jaribio"

#: block.py:353
msgid "Dictionary for maintaining the state of inputtypes"
msgstr "Kamusi ya kudumisha hali ya aina za pembejeo"

#: block.py:354
msgid "Dictionary with the current student responses"
msgstr "Kamusi yenye majibu ya sasa ya wanafunzi"

#: block.py:356
msgid "List of student answers for each attempt"
msgstr "Orodha ya majibu ya wanafunzi kwa kila jaribio"

#: block.py:360
msgid "Dictionary with the current student score"
msgstr "Kamusi yenye alama ya sasa ya mwanafunzi"

#: block.py:362
msgid "List of scores for each attempt"
msgstr "Orodha ya alama kwa kila jaribio"

#: block.py:365
msgid "Whether or not the answers have been saved since last submit"
msgstr "Ikiwa majibu yamehifadhiwa au la tangu kuwasilishwa mara ya mwisho"

#: block.py:367
msgid "Whether the student has answered the problem"
msgstr "Ikiwa mwanafunzi amejibu shida"

#: block.py:368
msgid "Random seed for this student"
msgstr "Mbegu nasibu kwa mwanafunzi huyu"

#: block.py:369
msgid "Last submission time"
msgstr "Wakati wa mwisho wa kuwasilisha"

#: block.py:371
msgid "Timer Between Attempts"
msgstr "Әрекеттер арасындағы таймер"

#: block.py:372
msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"Sekunde ambazo mwanafunzi lazima asubiri kati ya mawasilisho kwa tatizo la "
"majaribio mengi."

#: block.py:377
msgid "Problem Weight"
msgstr "Tatizo Uzito"

#: block.py:379
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"Inafafanua idadi ya pointi kila tatizo inastahili. Ikiwa thamani haijawekwa,"
" kila sehemu ya majibu kwenye tatizo ina thamani ya pointi moja."

#: block.py:385
msgid "Markdown source of this module"
msgstr "Chanzo cha alama chini cha moduli hii"

#: block.py:387
msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"Nambari ya chanzo ya LaTeX na shida za Neno. Kipengele hiki hakitumiki "
"vyema."

#: block.py:389
msgid "Enable LaTeX templates?"
msgstr "Je, ungependa kuwasha violezo vya LaTeX?"

#: block.py:391
msgid ""
"Indicates if the problem was edited using the Markdown editor in the "
"Authoring MFE."
msgstr ""
"Inaonyesha ikiwa tatizo lilihaririwa kwa kutumia kihariri cha Markdown "
"katika Uandishi wa MFE."

#: block.py:489
msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"Samahani, kulikuwa na hitilafu katika kuchakata ombi lako. Tafadhali jaribu "
"kupakia upya ukurasa wako na ujaribu tena."

#: block.py:494
msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"Hali ya tatizo hili imebadilika tangu ulipopakia ukurasa huu. Tafadhali "
"onyesha upya ukurasa wako."

#: block.py:808 block.py:825
msgid "Answer ID"
msgstr "Kitambulisho cha kujibu"

#: block.py:809 block.py:826
msgid "Question"
msgstr "Swali"

#: block.py:810 block.py:827 capa/responsetypes.py:432
msgid "Answer"
msgstr "Jibu"

#: block.py:813
msgid "Correct Answer"
msgstr "Jibu sahihi"

#: block.py:1058
msgid "Submit"
msgstr "Wasilisha"

#: block.py:1071
msgid "Submitting"
msgstr "Inawasilisha"

#: block.py:1193
msgid "Warning: The problem has been reset to its initial state!"
msgstr "Onyo: Tatizo limewekwa upya katika hali yake ya awali!"

#. Translators: Following this message, there will be a bulleted list of
#. items.
#: block.py:1197
msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"Hali ya tatizo iliharibiwa na uwasilishaji usio sahihi. Uwasilishaji "
"ulijumuisha:"

#: block.py:1204
msgid "If this error persists, please contact the course staff."
msgstr "Hitilafu hii ikiendelea, tafadhali wasiliana na wafanyakazi wa kozi."

#. Translators: {previous_hints} is the HTML of hints that have already been
#. generated, {hint_number_prefix}
#. is a header for this hint, and {hint_text} is the text of the hint itself.
#. This string is being passed to translation only for possible reordering of
#. the placeholders.
#: block.py:1259
#, python-brace-format
msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

#. Translators: e.g. "Hint 1 of 3: " meaning we are showing the first of three
#. hints.
#. This text is shown in bold before the accompanying hint text.
#: block.py:1265
#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Kidokezo ( {hint_num} cha {hints_count} ): "

#: block.py:1346
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Majibu yako yalihifadhiwa hapo awali. Bofya '{button_name}' ili kuziweka "
"alama."

#: block.py:1422
#, python-brace-format
msgid "Incorrect ({progress} point)"
msgid_plural "Incorrect ({progress} points)"
msgstr[0] "Siyo sahihi ({progress} pointi)"
msgstr[1] "Si sahihi ( point {progress} )"

#: block.py:1425 capa/capa_problem.py:734
msgid "Incorrect"
msgstr "Si sahihi"

#: block.py:1429
#, python-brace-format
msgid "Correct ({progress} point)"
msgid_plural "Correct ({progress} points)"
msgstr[0] "Sahihi ({progress} point)"
msgstr[1] "Sahihi ({progress} point)"

#: block.py:1432 capa/capa_problem.py:739
msgid "Correct"
msgstr "Sahihi"

#: block.py:1436
#, python-brace-format
msgid "Partially correct ({progress} point)"
msgid_plural "Partially correct ({progress} points)"
msgstr[0] "Sahihi kiasi ({progress} pointi)"
msgstr[1] "Sahihi kiasi ( pointi {progress} )"

#: block.py:1441
msgid "Partially Correct"
msgstr "Sahihi kwa Kiasi"

#: block.py:1443
msgid "Answer submitted."
msgstr "Jibu limewasilishwa."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:1812 block.py:2136
msgid "Problem is closed."
msgstr "Tatizo limefungwa."

#: block.py:1818
msgid "Problem must be reset before it can be submitted again."
msgstr "Tatizo lazima liweke upya kabla ya kuwasilishwa tena."

#: block.py:1828
#, python-brace-format
msgid "You must wait at least {wait} seconds between submissions."
msgstr "Ni lazima usubiri angalau sekunde {wait} kati ya mawasilisho."

#: block.py:1838
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Ni lazima usubiri angalau {wait_secs} kati ya mawasilisho. {remaining_secs} "
"iliyosalia."

#: block.py:2011
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
msgstr[0] "{num_hour} saa"
msgstr[1] "{num_hour} masaa"

#: block.py:2016
#, python-brace-format
msgid "{num_minute} minute"
msgid_plural "{num_minute} minutes"
msgstr[0] "{num_minute} dakika"
msgstr[1] "{num_minute} dakika"

#: block.py:2022
#, python-brace-format
msgid "{num_second} second"
msgid_plural "{num_second} seconds"
msgstr[0] "{num_second} sekunde"
msgstr[1] "{num_second} sekunde"

#: block.py:2144
msgid "Problem needs to be reset prior to save."
msgstr "Tatizo linahitaji kuwekwa upya kabla ya kuhifadhi."

#: block.py:2153
msgid "Your answers have been saved."
msgstr "Majibu yako yamehifadhiwa."

#: block.py:2155
#, python-brace-format
msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"Majibu yako yamehifadhiwa lakini hayajawekwa alama. Bofya '{button_name}' "
"ili kuziweka alama."

#. Translators: 'closed' means the problem's due date has passed.
#. You may no longer attempt to solve the problem.
#: block.py:2184
msgid "You cannot select Reset for a problem that is closed."
msgstr "Huwezi kuchagua Weka Upya kwa tatizo ambalo limefungwa."

#: block.py:2192
msgid "You must submit an answer before you can select Reset."
msgstr "Unahitaji kuwasilisha jibu kabla ya kuchagua Weka Upya."

#. Translators: 'rescoring' refers to the act of re-submitting a student's
#. solution so it can get a new score.
#: block.py:2248
msgid "Problem's definition does not support rescoring."
msgstr "Ufafanuzi wa tatizo hauauni kuweka alama tena."

#: block.py:2253
msgid "Problem must be answered before it can be graded again."
msgstr "Tatizo lazima lijibiwe kabla halijawekwa alama tena."

#: capa/capa_problem.py:510
msgid "Cannot rescore problems with possible file submissions"
msgstr "Nevar atkārtoti novērtēt uzdevumus ar iespējamiem failu iesniegumiem"

#: capa/capa_problem.py:604
msgid "Question {}"
msgstr "Swali {}"

#: capa/inputtypes.py:84
msgid "correct"
msgstr "sahihi"

#: capa/inputtypes.py:85
msgid "incorrect"
msgstr "si sahihi"

#: capa/inputtypes.py:86
msgid "partially correct"
msgstr "sahihi kwa kiasi"

#: capa/inputtypes.py:87
msgid "incomplete"
msgstr "haijakamilika"

#: capa/inputtypes.py:88 capa/inputtypes.py:89
msgid "unanswered"
msgstr "bila kujibiwa"

#: capa/inputtypes.py:90
msgid "submitted"
msgstr "imewasilishwa"

#: capa/inputtypes.py:91
msgid "processing"
msgstr "usindikaji"

#. Translators: these are tooltips that indicate the state of an assessment
#. question
#: capa/inputtypes.py:95
msgid "This answer is correct."
msgstr "Jibu hili ni sahihi."

#: capa/inputtypes.py:96
msgid "This answer is incorrect."
msgstr "Jibu hili si sahihi."

#: capa/inputtypes.py:97
msgid "This answer is partially correct."
msgstr "Jibu hili ni sahihi kwa kiasi."

#: capa/inputtypes.py:98
msgid "This answer is being processed."
msgstr "Jibu hili linachakatwa."

#: capa/inputtypes.py:100
msgid "Not yet answered."
msgstr "Bado haijajibiwa."

#: capa/inputtypes.py:433
msgid "Select an option"
msgstr "Chagua chaguo fulani"

#. Translators: 'ChoiceGroup' is an input type and should not be translated.
#: capa/inputtypes.py:485
#, python-brace-format
msgid "ChoiceGroup: unexpected tag {tag_name}"
msgstr "Kikundi cha Chaguo: lebo isiyotarajiwa {tag_name}"

#: capa/inputtypes.py:500 capa/inputtypes.py:1519
msgid "Answer received."
msgstr "Jibu limepokelewa."

#. Translators: '<choice>' and '<compoundhint>' are tag names and should not
#. be translated.
#: capa/inputtypes.py:534
#, python-brace-format
msgid "Expected a <choice> or <compoundhint> tag; got {given_tag} instead"
msgstr ""
"Natarajia a<choice> au<compoundhint> tagi; nilipata {given_tag} badala yake"

#: capa/inputtypes.py:720
msgid ""
"Your files have been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Faili zako zimewasilishwa. Mara tu uwasilishaji wako unapowekwa alama, "
"ujumbe huu utabadilishwa na maoni ya mtayarishaji."

#: capa/inputtypes.py:802
msgid ""
"Your answer has been submitted. As soon as your submission is graded, this "
"message will be replaced with the grader's feedback."
msgstr ""
"Jibu lako limewasilishwa. Mara tu uwasilishaji wako unapowekwa alama, ujumbe"
" huu utabadilishwa na maoni ya mtayarishaji."

#: capa/inputtypes.py:816
#, python-brace-format
msgid "{programming_language} editor"
msgstr "mhariri wa {programming_language}"

#: capa/inputtypes.py:819
msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"Bonyeza ESC kisha TAB au ubofye nje ya kihariri cha msimbo ili kuondoka"

#: capa/inputtypes.py:1017 capa/inputtypes.py:1101
msgid "No formula specified."
msgstr "Hakuna formula iliyobainishwa."

#: capa/inputtypes.py:1023
#, python-brace-format
msgid "Couldn't parse formula: {error_msg}"
msgstr "Haikuweza kuchanganua fomula: {error_msg}"

#: capa/inputtypes.py:1027 capa/inputtypes.py:1123
msgid "Error while rendering preview"
msgstr "Hitilafu wakati wa kutoa onyesho la kukagua"

#: capa/inputtypes.py:1119
msgid "Sorry, couldn't parse formula"
msgstr "Samahani, hujaweza kuchanganua fomula"

#: capa/inputtypes.py:1496
#, python-brace-format
msgid "{input_type}: unexpected tag {tag_name}"
msgstr "{input_type} : lebo isiyotazamiwa {tag_name}"

#. Translators: a "tag" is an XML element, such as "<b>" in HTML
#: capa/inputtypes.py:1581
#, python-brace-format
msgid "Expected a {expected_tag} tag; got {given_tag} instead"
msgstr "Ilitarajiwa lebo ya {expected_tag} ; nilipata {given_tag} badala yake"

#. Translators: index here could be 1,2,3 and so on
#: capa/responsetypes.py:276
#, python-brace-format
msgid "Question {index}"
msgstr "Swali {index}"

#: capa/responsetypes.py:387
msgid "Correct:"
msgstr "Sahihi:"

#: capa/responsetypes.py:389
msgid "Incorrect:"
msgstr "Si sahihi:"

#: capa/responsetypes.py:512
#, python-brace-format
msgid "Error {err} in evaluating hint function {hintfn}."
msgstr "Kuna hitilafu {err} katika kutathmini utendaji wa kidokezo {hintfn}."

#: capa/responsetypes.py:513
msgid "(Source code line unavailable)"
msgstr "(Msimbo wa chanzo haupatikani)"

#: capa/responsetypes.py:514
#, python-brace-format
msgid "See XML source line {sourcenum}."
msgstr "Tazama mstari wa chanzo cha XML {sourcenum} ."

#: capa/responsetypes.py:682
msgid "Checkboxes"
msgstr "Visanduku vya kuteua"

#: capa/responsetypes.py:1012
msgid "Multiple Choice"
msgstr "Chaguo Nyingi"

#. Translators: 'shuffle' and 'answer-pool' are attribute names and should not
#. be translated.
#: capa/responsetypes.py:1233
msgid "Do not use shuffle and answer-pool at the same time"
msgstr "Usitumie kuchanganya na kujibu maswali kwa wakati mmoja"

#. Translators: 'answer-pool' is an attribute name and should not be
#. translated.
#: capa/responsetypes.py:1316
msgid "answer-pool value should be an integer"
msgstr "Thamani ya bwawa la majibu inapaswa kuwa nambari kamili"

#. Translators: 'Choicegroup' is an input type and should not be translated.
#: capa/responsetypes.py:1383
msgid "Choicegroup must include at least 1 correct and 1 incorrect choice"
msgstr ""
"Kikundi cha kuchagua lazima kijumuishe angalau chaguo 1 sahihi na 1 lisilo "
"sahihi"

#: capa/responsetypes.py:1408
msgid "True/False Choice"
msgstr "Chaguo la Kweli/Uongo"

#: capa/responsetypes.py:1453
msgid "Dropdown"
msgstr "Kunjuzi"

#: capa/responsetypes.py:1531
msgid "Numerical Input"
msgstr "Uingizaji wa Nambari"

#: capa/responsetypes.py:1567 capa/responsetypes.py:1594
msgid "There was a problem with the staff answer to this problem."
msgstr "Kulikuwa na tatizo na jibu la wafanyakazi kwa tatizo hili."

#: capa/responsetypes.py:1617
#, python-brace-format
msgid "Could not interpret '{student_answer}' as a number."
msgstr "Haikuweza kutafsiri \"{student_answer}\" kama nambari."

#: capa/responsetypes.py:1635
#, python-brace-format
msgid "Factorial function evaluated outside its domain:'{student_answer}'"
msgstr ""
"Kazi ya kukokotoa ya kiutendaji imetathmini nje ya kikoa "
"chake:'{student_answer}'"

#: capa/responsetypes.py:1642
#, python-brace-format
msgid "Invalid math syntax: '{student_answer}'"
msgstr "Sintaksia batil ya hesabu: '{student_answer}'"

#: capa/responsetypes.py:1673
msgid "You may not use complex numbers in range tolerance problems"
msgstr ""
"Huenda usitumie nambari changamano katika matatizo ya kustahimili masafa"

#. Translators: This is an error message for a math problem. If the instructor
#. provided a
#. boundary (end limit) for a variable that is a complex number (a + bi), this
#. message displays.
#: capa/responsetypes.py:1681
msgid ""
"There was a problem with the staff answer to this problem: complex boundary."
msgstr ""
"Kulikuwa na tatizo na jibu la wafanyakazi kwa tatizo hili: mpaka changamano."

#. Translators: This is an error message for a math problem. If the instructor
#. did not
#. provide a boundary (end limit) for a variable, this message displays.
#: capa/responsetypes.py:1687
msgid ""
"There was a problem with the staff answer to this problem: empty boundary."
msgstr ""
"Kulikuwa na tatizo na jibu la wafanyakazi kwa tatizo hili: mpaka tupu."

#. Translators: Separator used in NumericalResponse to display multiple
#. answers.
#. Translators: Separator used in StringResponse to display multiple answers.
#. Example: "Answer: Answer_1 or Answer_2 or Answer_3".
#: capa/responsetypes.py:1795 capa/responsetypes.py:2072
msgid "or"
msgstr "au"

#: capa/responsetypes.py:1873
msgid "Text Input"
