#: apps/badges/admin.py
msgid "No rules specified."
msgstr "Правила не зазначені."

#: apps/badges/admin.py
msgid "Badge templates were successfully updated."
msgstr "Шаблони емблем успішно оновлено."

#: apps/badges/admin.py
msgid "API key"
msgstr "API Ключ"

#: apps/badges/admin.py
msgid "Pre-configured from the environment."
msgstr "Попередньо налаштований з середовища."

#: apps/badges/admin.py
msgid ""
"\n"
"                    WARNING: avoid configuration updates on activated badges.\n"
"                    Active badge templates are continuously processed and learners may already have progress on them.\n"
"                    Any changes in badge template requirements (including data rules) will affect learners' experience!\n"
"                    "
msgstr ""
"\n"
"                    УВАГА: уникайте оновлення конфігурації на активованих емблемах.\n"
"                    Активні шаблони емблем обробляються безперервно, і учні можуть вже мати прогрес на них.\n"
"                    Будь-які зміни у вимогах до шаблону емблеми (включаючи правила даних) вплинуть на досвід учнів!\n"
"                    "

