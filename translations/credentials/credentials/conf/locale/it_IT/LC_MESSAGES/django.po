#: apps/badges/admin.py
msgid "No rules specified."
msgstr "Nessuna regola specificata."

#: apps/badges/admin.py
msgid "Badge templates were successfully updated."
msgstr "I modelli di badge sono stati aggiornati con successo."

#: apps/badges/admin.py
msgid "API key"
msgstr "Chiave API"

#: apps/badges/admin.py
msgid "Pre-configured from the environment."
msgstr "Preconfigurato dall'ambiente."

#: apps/badges/admin.py
msgid ""
"\n"
"                    WARNING: avoid configuration updates on activated badges.\n"
"                    Active badge templates are continuously processed and learners may already have progress on them.\n"
"                    Any changes in badge template requirements (including data rules) will affect learners' experience!\n"
"                    "
msgstr ""
"\n"
"                    ATTENZIONE: evitare aggiornamenti di configurazione sui badge attivati.\n"
"                    I modelli di badge attivi sono continuamente elaborati e i discenti potrebbero già avere progressi su di essi.\n"
"                    Qualsiasi modifica ai requisiti del modello di badge (incluse le regole sui dati) influenzerà l'esperienza dei discenti!\n"
"                    "

