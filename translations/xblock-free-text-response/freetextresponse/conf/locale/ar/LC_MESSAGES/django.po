#: models.py:63
msgid "Display Name"
msgstr "الاسم الظاهر"

#: models.py:91
msgid "Maximum Number of Attempts"
msgstr "الحد الأقصى لعدد المحاولات"

#: models.py:93
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr "الحد الأقصى للمرات المسموح فيها للطالب بمحاولة حل المسألة"

#: models.py:103
msgid "This is the maximum number of words allowed for this question"
msgstr "الحد الأقصى لعدد لكلمات المسموح بها لهذا السؤال"

#: models.py:133
msgid "This is the message students will see upon submitting their response"
msgstr "ستُعرض هذه الرسالة للطلاب أثناء تسليمهم إجاباتهم"

#: models.py:140
msgid "Weight"
msgstr "الثقل"

#: models.py:142
msgid "This assigns an integer value representing the weight of this problem"
msgstr "يحدد ذلك قيمة عدد صحيح يمثل ثقل هذه المسألة"

#: models.py:152
msgid "This is the message students will see upon submitting a draft response"
msgstr "ستُعرض هذه الرسالة للطلاب أثناء تسليمهم مسودة الإجابة"

#: templates/view.html:15
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr "اسمح بعرض إجابتي للمتعلمين الآخرين بعد أن يرسلوا إجاباتهم"

#: templates/view.html:21 templates/view.html:22
msgid "Submit"
msgstr "أرسِل"

#: templates/view.html:24 templates/view.html:25
msgid "Save"
msgstr "احفظ"

#: templates/view.html:34
msgid "Hide"
msgstr "اخفِ"

#: templates/view.html:35
msgid "Show"
msgstr "أظهِر"

#: templates/view.html:36
msgid "peer responses"
msgstr "إجابات الزملاء"

#: views.py:126
#, python-brace-format
msgid "{weight} point possible"
msgid_plural "{weight} points possible"
msgstr[0] "لا درجات ممكنة"
msgstr[1] "درجة واحدة ممكنة"
msgstr[2] "درجتان ممكنتان"
msgstr[3] "{weight} درجات ممكنة"
msgstr[4] "{weight} درجة ممكنة"
msgstr[5] "{weight} درجة ممكنة"

#: views.py:134
#, python-brace-format
msgid "{score_string}/{weight} point"
msgid_plural "{score_string}/{weight} points"
msgstr[0] "صفر {score_string}/{weight}"
msgstr[1] "درجة واحدة {score_string}/{weight}"
msgstr[2] "درجتان {score_string}/{weight}"
msgstr[3] "{score_string}/{weight} درجات"
msgstr[4] "{score_string}/{weight} درجة"
msgstr[5] "{score_string}/{weight} درجة"

#: views.py:147
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "لم تستخدم أيّ محاولة من أصل {max_attempts} لإرسال الإجابة"
msgstr[1] "لقد استخدمت محاولة واحدة من أصل {max_attempts} لإرسال الإجابة"
msgstr[2] "لقد استخدمت محاولتين من أصل {max_attempts} لإرسال الإجابة"
msgstr[3] ""
"لقد استخدمت {count_attempts} محاولات من أصل {max_attempts} لإرسال الإجابة"
msgstr[4] ""
"لقد استخدمت {count_attempts} محاولة من أصل {max_attempts} لإرسال الإجابة"
msgstr[5] ""
"لقد استخدمت {count_attempts} محاولة من أصل {max_attempts} لإرسال الإجابة"
