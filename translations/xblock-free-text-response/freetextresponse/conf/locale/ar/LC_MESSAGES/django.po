#: models.py:39
msgid "Display Correctness?"
msgstr "عرض صحة الإجابة؟"

#: models.py:41
msgid ""
"This is a flag that indicates if the indicator icon should be displayed "
"after a student enters their response"
msgstr ""
"هذه علامة تحدد ما إذا كان ينبغي عرض أيقونة المؤشر بعد أن يدخل الطالب إجابته"

#: models.py:49
msgid "Display Other Student Responses"
msgstr "عرض إجابات الطلاب الآخرين"

#: models.py:51
msgid ""
"This will display other student responses to the student after they submit "
"their response."
msgstr "سيعرض هذا الخيار إجابات الطلاب الآخرين على الطالب بعد أن يرسل إجابته."

#: models.py:60
msgid "System selected answers to give to students"
msgstr "إجابات يختارها النظام لتُعرض على الطلاب"

#: models.py:63
msgid "Display Name"
msgstr "الاسم الظاهر"

#: models.py:65
msgid "This is the title for this question type"
msgstr "هذا هو عنوان نوع السؤال"

#: models.py:71
msgid "Full-Credit Key Phrases"
msgstr "العبارات المفتاحية للدرجة الكاملة"

#: models.py:73
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive full credit"
msgstr ""
"هذه قائمة بكلمات أو عبارات يجب أن تَرِد واحدة منها على الأقل في إجابة الطالب"
" لينال الدرجة الكاملة"

#: models.py:81
msgid "Half-Credit Key Phrases"
msgstr "العبارات المفتاحية لنصف الدرجة"

#: models.py:83
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive half credit"
msgstr ""
"هذه قائمة بكلمات أو عبارات يجب أن تَرِد واحدة منها على الأقل في إجابة الطالب"
" لينال نصف الدرجة"

#: models.py:91
msgid "Maximum Number of Attempts"
msgstr "الحد الأقصى لعدد المحاولات"

#: models.py:93
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr "الحد الأقصى للمرات المسموح فيها للطالب بمحاولة حل المسألة"

#: models.py:101
msgid "Maximum Word Count"
msgstr "أقصى عدد للكلمات"

#: models.py:103
msgid "This is the maximum number of words allowed for this question"
msgstr "الحد الأقصى لعدد لكلمات المسموح بها لهذا السؤال"

#: models.py:111
msgid "Minimum Word Count"
msgstr "أقل عدد للكلمات"

#: models.py:113
msgid "This is the minimum number of words required for this question"
msgstr "هذا هو الحد الأدنى لعدد الكلمات المطلوب لهذا السؤال"

#: models.py:121
msgid "Prompt"
msgstr "السؤال"

#: models.py:123
msgid ""
"This is the prompt students will see when asked to enter their response"
msgstr "هذا هو السؤال الذي سيظهر للطلاب عند مطالبتهم بإدخال إجابتهم."

#: models.py:131
msgid "Submission Received Message"
msgstr "رسالة استلام الإجابة"

#: models.py:133
msgid "This is the message students will see upon submitting their response"
msgstr "ستُعرض هذه الرسالة للطلاب أثناء تسليمهم إجاباتهم"

#: models.py:140
msgid "Weight"
msgstr "الثقل"

#: models.py:142
msgid "This assigns an integer value representing the weight of this problem"
msgstr "يحدد ذلك قيمة عدد صحيح يمثل ثقل هذه المسألة"

#: models.py:150
msgid "Draft Received Message"
msgstr "رسالة استلام المسودة"

#: models.py:152
msgid "This is the message students will see upon submitting a draft response"
msgstr "ستُعرض هذه الرسالة للطلاب أثناء تسليمهم مسودة الإجابة"

#: templates/view.html:15
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr "اسمح بعرض إجابتي للمتعلمين الآخرين بعد أن يرسلوا إجاباتهم"

#: templates/view.html:21 templates/view.html:24
msgid "Checking..."
msgstr "جاري التحقق..."

#: templates/view.html:21 templates/view.html:22
msgid "Submit"
msgstr "أرسِل"

#: templates/view.html:24 templates/view.html:25
msgid "Save"
msgstr "احفظ"

#: templates/view.html:34
msgid "Hide"
msgstr "اخفِ"

#: templates/view.html:35
msgid "Show"
msgstr "أظهِر"

#: templates/view.html:36
msgid "peer responses"
msgstr "إجابات الزملاء"

#: templates/view.html:38
msgid "Submissions by others"
msgstr "إجابات الآخرين"

#: templates/view.html:39 templates/view.html:43
msgid "No responses to show at this time"
msgstr "لا توجد إجابات لعرضها حالياً."

#: views.py:126
#, python-brace-format
msgid "{weight} point possible"
msgid_plural "{weight} points possible"
msgstr[0] "لا درجات ممكنة"
msgstr[1] "درجة واحدة ممكنة"
msgstr[2] "درجتان ممكنتان"
msgstr[3] "{weight} درجات ممكنة"
msgstr[4] "{weight} درجة ممكنة"
msgstr[5] "{weight} درجة ممكنة"

#: views.py:134
#, python-brace-format
msgid "{score_string}/{weight} point"
msgid_plural "{score_string}/{weight} points"
msgstr[0] "صفر {score_string}/{weight}"
msgstr[1] "درجة واحدة {score_string}/{weight}"
msgstr[2] "درجتان {score_string}/{weight}"
msgstr[3] "{score_string}/{weight} درجات"
msgstr[4] "{score_string}/{weight} درجة"
msgstr[5] "{score_string}/{weight} درجة"

#: views.py:147
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "لم تستخدم أيّ محاولة من أصل {max_attempts} لإرسال الإجابة"
msgstr[1] "لقد استخدمت محاولة واحدة من أصل {max_attempts} لإرسال الإجابة"
msgstr[2] "لقد استخدمت محاولتين من أصل {max_attempts} لإرسال الإجابة"
msgstr[3] ""
"لقد استخدمت {count_attempts} محاولات من أصل {max_attempts} لإرسال الإجابة"
msgstr[4] ""
"لقد استخدمت {count_attempts} محاولة من أصل {max_attempts} لإرسال الإجابة"
msgstr[5] ""
"لقد استخدمت {count_attempts} محاولة من أصل {max_attempts} لإرسال الإجابة"

#: views.py:171
#, python-brace-format
msgid "Your response must be between {min} and {max} word."
msgid_plural "Your response must be between {min} and {max} words."
msgstr[0] "يجب أن تتراوح إجابتك بين {min} وصفر كلمة."
msgstr[1] "يجب أن تتراوح إجابتك بين {min} وكلمة واحدة."
msgstr[2] "يجب أن تتراوح إجابتك بين {min} وكلمتين."
msgstr[3] "يجب أن تتراوح إجابتك بين {min} و{max} كلمات."
msgstr[4] "يجب أن تتراوح إجابتك بين {min} و{max} كلمةً."
msgstr[5] "يجب أن تتراوح إجابتك بين {min} و{max} كلمةٍ."

#: views.py:267
#, python-brace-format
msgid "Invalid Word Count. {word_count_message}"
msgstr "عدد الكلمات غير صالح. {word_count_message}"
