#: models.py:39
msgid "Display Correctness?"
msgstr "Affichage correct ?"

#: models.py:41
msgid ""
"This is a flag that indicates if the indicator icon should be displayed "
"after a student enters their response"
msgstr ""
"Il s&#39;agit d&#39;un indicateur permettant de savoir si l&#39;icône doit "
"s&#39;afficher après la saisie de la réponse par un étudiant."

#: models.py:49
msgid "Display Other Student Responses"
msgstr "Afficher les réponses des autres étudiants"

#: models.py:51
msgid ""
"This will display other student responses to the student after they submit "
"their response."
msgstr ""
"Cela permettra à l&#39;étudiant de voir les réponses des autres étudiants "
"après qu&#39;il aura soumis sa réponse."

#: models.py:60
msgid "System selected answers to give to students"
msgstr "Le système a sélectionné les réponses à fournir aux élèves"

#: models.py:63
msgid "Display Name"
msgstr "Nom d&#39;affichage"

#: models.py:65
msgid "This is the title for this question type"
msgstr "Voici le titre de ce type de question"

#: models.py:71
msgid "Full-Credit Key Phrases"
msgstr "Phrases clés pour obtenir la totalité des crédits"

#: models.py:73
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive full credit"
msgstr ""
"Voici une liste de mots ou d&#39;expressions dont au moins un doit figurer "
"pour que la réponse de l&#39;élève obtienne la totalité des points."

#: models.py:81
msgid "Half-Credit Key Phrases"
msgstr "Phrases clés pour obtenir un demi-crédit"

#: models.py:83
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive half credit"
msgstr ""
"Il s&#39;agit d&#39;une liste de mots ou d&#39;expressions dont au moins un "
"doit figurer pour que la réponse de l&#39;élève obtienne la moitié des "
"points."

#: models.py:91
msgid "Maximum Number of Attempts"
msgstr "Nombre maximal de tentatives"

#: models.py:93
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr ""
"Il s&#39;agit du nombre maximal de tentatives autorisées pour résoudre le "
"problème."

#: models.py:101
msgid "Maximum Word Count"
msgstr "Nombre maximal de mots"

#: models.py:103
msgid "This is the maximum number of words allowed for this question"
msgstr ""
"Il s&#39;agit du nombre maximal de mots autorisés pour cette question."

#: models.py:111
msgid "Minimum Word Count"
msgstr "Nombre minimum de mots"

#: models.py:113
msgid "This is the minimum number of words required for this question"
msgstr "Voici le nombre minimum de mots requis pour cette question"

#: models.py:121
msgid "Prompt"
msgstr "Rapide"

#: models.py:123
msgid ""
"This is the prompt students will see when asked to enter their response"
msgstr ""
"Voici le message que les élèves verront lorsqu&#39;on leur demandera de "
"saisir leur réponse."

#: models.py:131
msgid "Submission Received Message"
msgstr "Message reçu"

#: models.py:133
msgid "This is the message students will see upon submitting their response"
msgstr ""
"Voici le message que les étudiants verront après avoir soumis leur réponse."

#: models.py:140
msgid "Weight"
msgstr "Poids"

#: models.py:142
msgid "This assigns an integer value representing the weight of this problem"
msgstr ""
"Cela attribue une valeur entière représentant le poids de ce problème."

#: models.py:150
msgid "Draft Received Message"
msgstr "Message reçu (brouillon)"

#: models.py:152
msgid "This is the message students will see upon submitting a draft response"
msgstr ""
"Voici le message que les étudiants verront après avoir soumis une ébauche de"
" réponse."

#: templates/view.html:15
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr ""
"Autoriser ma réponse à être éventuellement visible par d&#39;autres "
"apprenants après avoir soumis leur réponse"

#: templates/view.html:21 templates/view.html:24
msgid "Checking..."
msgstr "Vérification..."

#: templates/view.html:21 templates/view.html:22
msgid "Submit"
msgstr "Soumettre"

#: templates/view.html:24 templates/view.html:25
msgid "Save"
msgstr "Sauvegarder"

#: templates/view.html:34
msgid "Hide"
msgstr "Cacher"

#: templates/view.html:35
msgid "Show"
msgstr "Montrer"

#: templates/view.html:36
msgid "peer responses"
msgstr "réponses des pairs"

#: templates/view.html:38
msgid "Submissions by others"
msgstr "Soumissions d&#39;autres personnes"

#: templates/view.html:39 templates/view.html:43
msgid "No responses to show at this time"
msgstr "Aucune réponse à afficher pour le moment"

#: views.py:126
#, python-brace-format
msgid "{weight} point possible"
msgid_plural "{weight} points possible"
msgstr[0] "{weight} point possible"
msgstr[1] "{weight} points possibles"
msgstr[2] "{weight} points possibles"

#: views.py:134
#, python-brace-format
msgid "{score_string}/{weight} point"
msgid_plural "{score_string}/{weight} points"
msgstr[0] "Point {score_string} / {weight}"
msgstr[1] "Points {score_string} / {weight}"
msgstr[2] "Points {score_string} / {weight}"

#: views.py:147
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "Vous avez utilisé la soumission {count_attempts} de {max_attempts}"
msgstr[1] ""
"Vous avez utilisé les soumissions {count_attempts} de {max_attempts}"
msgstr[2] ""
"Vous avez utilisé les soumissions {count_attempts} de {max_attempts}"

#: views.py:171
#, python-brace-format
msgid "Your response must be between {min} and {max} word."
msgid_plural "Your response must be between {min} and {max} words."
msgstr[0] "Votre réponse doit être comprise entre les mots {min} et {max} ."
msgstr[1] "Votre réponse doit comporter entre les mots {min} et {max} ."
msgstr[2] "Votre réponse doit comporter entre les mots {min} et {max} ."

#: views.py:267
#, python-brace-format
msgid "Invalid Word Count. {word_count_message}"
msgstr "Nombre de mots incorrect. {word_count_message}"
