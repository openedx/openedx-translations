msgid "Random number generated for p. -1 if uninitialized"
msgstr "Nombre aléatoire généré pour p. -1 si non initialisé"

#: feedback.py:89
msgid "How user voted. -1 if didn't vote"
msgstr "Comment l&#39;utilisateur a voté. -1 si n&#39;a pas voté"

#: feedback.py:95
msgid "What percent of the time should this show?"
msgstr "Pendant quel pourcentage du temps cela devrait-il s&#39;afficher ?"

#: feedback.py:105
msgid "A list of user votes"
msgstr "Liste des votes des utilisateurs"

#: feedback.py:109
msgid "Feedback"
msgstr "Retour"

#: feedback.py:112
msgid "Display Name"
msgstr "Nom d&#39;affichage"

#: feedback.py:113
msgid "Provide Feedback"
msgstr "Donnez votre avis"

#: feedback.py:118 templates/html/studio_view.html:17
msgid "Voting message"
msgstr "Message de vote"

#: feedback.py:119
msgid "Thank you for voting!"
msgstr "Merci d&#39;avoir voté !"

#: feedback.py:124 templates/html/studio_view.html:25
msgid "Feedback message"
msgstr "Message de commentaires"

#: feedback.py:125
msgid "Thank you for your feedback!"
msgstr "Merci pour vos commentaires !"

#: feedback.py:130
msgid "Show aggregate to students"
msgstr "Afficher le total aux étudiants"

#: feedback.py:159
msgid "Please reflect on this course material"
msgstr "Veuillez réfléchir au contenu de ce cours"

#: feedback.py:160
msgid ""
"Please take time to meaningfully reflect on your experience with this course"
" material."
msgstr ""
"Veuillez prendre le temps de réfléchir de manière approfondie à votre "
"expérience avec le contenu de ce cours."

#: feedback.py:163
msgid "Please rate your overall experience"
msgstr "Veuillez évaluer votre expérience globale"

#: feedback.py:170
msgid "Please take a moment to thoughtfully reflect."
msgstr "Veuillez prendre un moment pour réfléchir attentivement."

#: feedback.py:387
msgid "Please vote!"
msgstr "Votez !"

#: static/html/feedback_instructor.html:10
msgid "Component"
msgstr "Composant"

#: static/html/feedback_instructor.html:13
msgid "Number of ratings"
msgstr "Nombre d&#39;évaluations"

#: static/html/feedback_instructor.html:16
msgid "Average rating"
msgstr "Note moyenne"

#: static/html/feedback_instructor.html:19
msgid "Feedback "
msgstr "Retour "

#: static/html/feedback_instructor.html:40
msgid "Comment"
msgstr "Commentaire"

#: static/html/feedback_instructor.html:40
