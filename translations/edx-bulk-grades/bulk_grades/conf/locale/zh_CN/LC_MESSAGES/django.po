#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr "CSV 不匹配此问题。检查您是否上传了正确的 CSV。"

#: api.py:130
msgid "Points must be numbers."
msgstr "点必须是数字。"

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "点不得大于 {}。"

#: api.py:134
msgid "Points must be greater than 0"
msgstr "点数必须大于 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "错误的课程id {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "该文件没有数据行。"

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr "未更改任何成绩。请在“new_override”列中输入成绩，然后再次上传文件。"

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "重复的用户_id: "

#: api.py:402
msgid "Grade must be a number"
msgstr "等级必须是数字"

#: api.py:405
msgid "Grade must not be negative"
msgstr "成绩不得为负数"

#: api.py:666
msgid "score must be positive"
msgstr "分数必须为正"
