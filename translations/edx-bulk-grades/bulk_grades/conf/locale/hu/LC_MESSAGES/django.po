#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"A CSV nem felel meg ennek a problémának. Ellenőrizze, hogy a megfelelő CSV-t"
" töltötte-e fel."

#: api.py:130
msgid "Points must be numbers."
msgstr "A pontoknak számoknak kell lenniük."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "A pontok száma nem lehet nagyobb, mint {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "A pontoknak 0-nál nagyobbnak kell lenniük."

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Hibás kurzusazonosító {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "A fájl nem tartalmaz adatsorokat."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Egyetlen jegy sem változott. Add meg a jegyeket egy „new_override” "
"oszlopban, és töltsd fel újra a fájlt."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "Ismétlődő user_id: "

#: api.py:402
msgid "Grade must be a number"
msgstr "A jegynek számnak kell lennie"

#: api.py:405
msgid "Grade must not be negative"
msgstr "A jegy nem lehet negatív."

#: api.py:666
msgid "score must be positive"
msgstr "A pontszámnak pozitívnak kell lennie"
