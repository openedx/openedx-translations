#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"Die CSV passt nicht zu diesem Problem. Überprüfen Sie, ob Sie die richtige "
"CSV-Datei hochgeladen haben."

#: api.py:130
msgid "Points must be numbers."
msgstr "Punkte müssen Zahlen sein."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Punkte dürfen nicht größer als {} sein."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Punkte müssen größer als 0 sein"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Falsche Kurs-ID {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Die Datei enthält keine Datenzeilen."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Es wurden keine Noten geändert. Gib die Noten in eine Spalte „new_override“ "
"ein und lade die Datei erneut hoch."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "Wiederholte Benutzer-ID: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Die Note muss eine Zahl sein"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Die Note darf nicht negativ sein"

#: api.py:666
msgid "score must be positive"
msgstr "Die Punktzahl muss positiv sein"
