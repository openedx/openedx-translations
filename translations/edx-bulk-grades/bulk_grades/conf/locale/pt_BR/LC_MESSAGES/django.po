#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"O CSV não corresponde a este problema. Verifique se você enviou o CSV "
"correto."

#: api.py:130
msgid "Points must be numbers."
msgstr "Os pontos devem ser números."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Os pontos não devem ser maiores que {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Os pontos devem ser maiores que 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Identificação do curso errada {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "O arquivo não tem linhas de dados."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Nenhuma nota foi alterada. Insira as notas em uma coluna \"new_override\" e "
"envie o arquivo novamente."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "ID_do_usuário repetido: "

#: api.py:402
msgid "Grade must be a number"
msgstr "A nota deve ser um número"

#: api.py:405
msgid "Grade must not be negative"
msgstr "A nota não deve ser negativa"

#: api.py:666
msgid "score must be positive"
msgstr "a pontuação deve ser positiva"
