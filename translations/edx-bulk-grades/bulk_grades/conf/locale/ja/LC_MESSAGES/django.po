#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr "CSVがこの問題に一致しません。正しいCSVをアップロードしたか確認してください。"

#: api.py:130
msgid "Points must be numbers."
msgstr "ポイントは数値でなければなりません。"

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "ポイントは{}を超えてはいけません。"

#: api.py:134
msgid "Points must be greater than 0"
msgstr "ポイントは0より大きくなければなりません。"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "コースIDが間違っています {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "ファイルにデータ行がありません。"

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr "成績は変更されませんでした。「new_override」列に成績を入力し、ファイルを再度アップロードしてください。"

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "ユーザーIDの重複: "

#: api.py:402
msgid "Grade must be a number"
msgstr "成績は数値でなければなりません"

#: api.py:405
msgid "Grade must not be negative"
msgstr "成績は負の値にしてはいけません"

#: api.py:666
msgid "score must be positive"
msgstr "スコアは正の数でなければなりません。"
