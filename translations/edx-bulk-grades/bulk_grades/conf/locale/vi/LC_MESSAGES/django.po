#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"CSV không phù hợp với vấn đề này. Kiểm tra xem bạn đã tải lên đúng CSV chưa."

#: api.py:130
msgid "Points must be numbers."
msgstr "Điểm phải là số."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Điểm không được lớn hơn {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Điểm phải lớn hơn 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Id khóa học sai {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Tệp không có hàng dữ liệu."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Không có điểm nào được thay đổi. Vui lòng nhập điểm vào cột \"new_override\""
" và tải lên lại tệp."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "user_id lặp lại: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Điểm phải là một số"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Điểm không được âm"

#: api.py:666
msgid "score must be positive"
msgstr "điểm phải dương"
