#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"El CSV no coincide con este problema. Comprueba que has subido el CSV "
"correcto."

#: api.py:130
msgid "Points must be numbers."
msgstr "Los puntos deben ser números."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Los puntos no deben ser mayores que {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Los puntos deben ser mayores que 0."

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "ID de curso incorrecto {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "El archivo no tiene filas de datos."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"No se modificaron calificaciones. Ingresa las calificaciones en una columna "
"\"new_override\" y carga el archivo nuevamente."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "ID de usuario repetido: "

#: api.py:402
msgid "Grade must be a number"
msgstr "La calificación debe ser un número."

#: api.py:405
msgid "Grade must not be negative"
msgstr "La calificación no debe ser negativa."

#: api.py:666
msgid "score must be positive"
msgstr "la puntuación debe ser positiva"
