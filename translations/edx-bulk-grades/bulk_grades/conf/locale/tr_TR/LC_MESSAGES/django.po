#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr "CSV bu problemle eşleşmiyor. Doğru CSV'yi yüklediğinizden emin olun."

#: api.py:130
msgid "Points must be numbers."
msgstr "Puanlar sayı olmalıdır."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Puanlar {} değerinden büyük olmamalıdır."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Puanlar 0'dan büyük olmalıdır"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Yanlış ders kimliği {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Dosyada veri satırı yok."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Hiçbir not değiştirilmedi. Notları \"new_override\" sütununa girin ve "
"dosyayı tekrar yükleyin."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "Tekrarlanan user_id: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Not bir sayı olmalıdır"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Not negatif olmamalıdır"

#: api.py:666
msgid "score must be positive"
msgstr "puan pozitif olmalı"
