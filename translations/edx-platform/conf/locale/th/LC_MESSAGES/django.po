#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:18
msgid "True if it's possible to hide the tab for a course"
msgstr "เป็นจริงหากสามารถซ่อนแท็บสำหรับหลักสูตรได้"

