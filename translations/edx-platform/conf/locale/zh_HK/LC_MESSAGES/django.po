msgstr "電郵{email_address}無效。"

#: lms/djangoapps/instructor/views/api.py:459
#, python-brace-format
msgid ""
"An account with email {email} exists but the provided username {username} is"
" different. Enrolling anyway with {email}."
msgstr "電郵地址為{email}的帳戶存在，但提供的用戶名{username}不同。無論如何也註冊{email} 。"

