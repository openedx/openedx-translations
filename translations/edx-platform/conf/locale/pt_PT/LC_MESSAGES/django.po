msgid "{profile_name} URL"
msgstr "{profile_name} URL"

#: cms/djangoapps/contentstore/video_storage_handlers.py:515
#: lms/djangoapps/instructor/views/api.py:1498
msgid "Name"
msgstr "Nome"

#: cms/djangoapps/contentstore/video_storage_handlers.py:516
msgid "Duration"
msgstr "Duração"

#: cms/djangoapps/contentstore/video_storage_handlers.py:517
msgid "Date Added"
msgstr "Data Adicionada"

#: cms/djangoapps/contentstore/video_storage_handlers.py:518
#: xmodule/video_block/video_xfields.py:194
msgid "Video ID"
msgstr "ID. do Vídeo"

#: cms/djangoapps/contentstore/video_storage_handlers.py:519
msgid "Status"
msgstr "Estado"

