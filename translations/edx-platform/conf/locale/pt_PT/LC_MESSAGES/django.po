#. listing for videos uploaded through Studio
#: cms/djangoapps/contentstore/video_storage_handlers.py:565
#, python-brace-format
msgid "{course}_video_urls"
msgstr "{course}_video_urls"

#: cms/djangoapps/contentstore/video_storage_handlers.py:958
msgid "A non zero positive integer is expected"
msgstr "É esperado um número inteiro positivo"

#: cms/djangoapps/contentstore/video_utils.py:42
msgid "The image must have name, content type, and size information."
msgstr ""
"A imagem deve ter um nome, tipo de conteúdo e informações sobre o tamanho."

#: cms/djangoapps/contentstore/video_utils.py:44
#, python-brace-format
msgid ""
"This image file type is not supported. Supported file types are "
"{supported_file_formats}."
msgstr ""
"Este tipo de ficheiro de imagem não é suportado. Os tipos de ficheiros "
"suportados são {supported_file_formats}."

#: cms/djangoapps/contentstore/video_utils.py:48
#, python-brace-format
msgid "This image file must be smaller than {image_max_size}."
msgstr ""
"O tamanho deste ficheiro de imagem deve ser menor que {image_max_size}."

#: cms/djangoapps/contentstore/video_utils.py:52
#, python-brace-format
