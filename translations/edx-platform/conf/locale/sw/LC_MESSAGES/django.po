msgstr "Kitambulisho batili cha sasisho la kozi."

#: cms/djangoapps/contentstore/course_info_model.py:126
msgid "Course update not found."
msgstr "Sasisho la kozi halijapatikana."

#: cms/djangoapps/contentstore/courseware_index.py:246
msgid "Could not index item: {}"
msgstr "Haikuweza kuorodhesha kipengee: {}"

#: cms/djangoapps/contentstore/courseware_index.py:269
msgid "General indexing error occurred"
msgstr "Hitilafu ya jumla ya kuorodhesha ilitokea"

#: cms/djangoapps/contentstore/courseware_index.py:352
