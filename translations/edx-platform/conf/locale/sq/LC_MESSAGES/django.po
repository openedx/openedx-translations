#: cms/djangoapps/api/v1/serializers/course_runs.py:49
msgid "Course team user does not exist"
msgstr "Përdoruesi i ekipit të kursit nuk ekziston"

#: cms/djangoapps/contentstore/admin.py:47
#, python-brace-format
msgid ""
"Number of course outline regenerations successfully requested: {regenerates}"
msgstr ""
"Numri i rigjenerimeve të përvijimit të kurseve të kërkuara me sukses: "
"{regenerates}"

#: cms/djangoapps/contentstore/admin.py:51
msgid "Regenerate selected course outlines"
msgstr "Rigjeneroni skicat e zgjedhura të kursit"

#: cms/djangoapps/contentstore/admin.py:59
msgid "All course outline regenerations successfully requested."
msgstr "Të gjitha rigjenerimet e përvijuara të kursit kërkuan me sukses."

#: cms/djangoapps/contentstore/admin.py:60
msgid "Regenerate *all* course outlines"
msgstr "Rigjeneroni *të gjitha* skicat e kursit"

#: cms/djangoapps/contentstore/asset_storage_handlers.py:535
msgid "Upload completed"
msgstr "Ngarkimi përfundoi"

#: cms/djangoapps/contentstore/asset_storage_handlers.py:579
#, python-brace-format
msgid ""
"File {filename} exceeds maximum size of {maximum_size_in_megabytes} MB."
msgstr ""
"Skedari {filename} tejkalon madhësinë maksimale prej "
"{maximum_size_in_megabytes} MB."

#: cms/djangoapps/contentstore/course_group_config.py:63
