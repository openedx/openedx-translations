#: lms/djangoapps/instructor/views/tools.py:241
#: lms/djangoapps/instructor/views/tools.py:253 xmodule/unit_block.py:41
msgid "Unit"
msgstr "Njësia"

#: cms/djangoapps/contentstore/helpers.py:225
#: cms/djangoapps/contentstore/views/component.py:282
msgid "Problem"
msgstr "Problem"

#: cms/djangoapps/contentstore/helpers.py:227
#: cms/djangoapps/contentstore/views/component.py:286
msgid "Library Content"
msgstr "Përmbajtja e Bibliotekës"

#: cms/djangoapps/contentstore/helpers.py:229
#: cms/djangoapps/contentstore/views/component.py:287
msgid "Problem Bank"
msgstr "Banka e Problemeve"

#: cms/djangoapps/contentstore/management/commands/git_export.py:33
msgid ""
"Take the specified course and attempt to export it to a git repository\n"
". Course directory must already be a git repository. Usage:  git_export <course_loc> <git_url>"
msgstr ""
"Merrni kursin e specifikuar dhe përpiquni ta eksportoni atë në një depo git\n"
". Drejtoria e kurseve duhet të jetë tashmë një depo git. Përdorimi: git_export <course_loc> <git_url>"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:46
msgid "COURSE_KEY"
msgstr "KURSI_KEY"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:48
msgid ""
"Recreate links for xblocks under given course keys. For eg. "
"course-v1:edX+DemoX.1+2014"
msgstr ""
"Rikrijo lidhje për xblocks nën çelësat e kursit të dhënë. Për p.sh. kurs-v1:"
" edX+DemoX.1+2014"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:55
msgid ""
"Recreate links for xblocks under all courses. NOTE: this can take long time "
"depending on number of course and xblocks"
msgstr ""
"Rikrijoni lidhje për xblocks në të gjitha kurset. SHËNIM: kjo mund të zgjasë"
" shumë në varësi të numrit të kurseve dhe xblloqeve"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:62
msgid "Recreate links even for completely processed courses."
msgstr "Rikrijoni lidhje edhe për kurse të përpunuara plotësisht."

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:67
msgid "Delete all and create links for given course(s)."
msgstr "Fshini të gjitha dhe krijoni lidhje për kurset e dhëna."

#: cms/djangoapps/contentstore/models.py:95
msgid "Upstream context key i.e., learning_package/library key"
msgstr ""
"Çelësi i kontekstit në rrjedhën e sipërme, p.sh., çelësi i paketës së "
"mësimit/bibliotekës"

#: cms/djangoapps/contentstore/models.py:157
msgid ""
"Upstream block usage key, this value cannot be null and useful to track "
"upstream library blocks that do not exist yet"
msgstr ""
"Çelësi i përdorimit të bllokut në rrjedhën e sipërme, kjo vlerë nuk mund të "
"jetë e pavlefshme dhe e dobishme për të gjurmuar blloqet e bibliotekës në "
"rrjedhën e sipërme që nuk ekzistojnë ende"

#: cms/djangoapps/contentstore/models.py:163
msgid "Component Link"
msgstr "Lidhja e komponentit"

#: cms/djangoapps/contentstore/models.py:164
msgid "Component Links"
msgstr "Lidhjet e komponentëve"

#: cms/djangoapps/contentstore/models.py:190
msgid "The component must be published to access `published_at`"
msgstr "Komponenti duhet të publikohet për të pasur qasje në `published_at`"

#: cms/djangoapps/contentstore/models.py:329
msgid ""
"Upstream block key (e.g. lct:...), this value cannot be null and is useful "
"to track upstream library blocks that do not exist yet or were deleted."
msgstr ""
"Tasti i bllokut në rrjedhën e sipërme (p.sh. lct:...), kjo vlerë nuk mund të"
" jetë nule dhe është e dobishme për të gjurmuar blloqet e bibliotekës në "
"rrjedhën e sipërme që nuk ekzistojnë ende ose janë fshirë."

#: cms/djangoapps/contentstore/models.py:336
msgid "Container Link"
msgstr "Lidhja e kontejnerit"

#: cms/djangoapps/contentstore/models.py:337
msgid "Container Links"
msgstr "Lidhjet e kontejnerëve"

#: cms/djangoapps/contentstore/models.py:363
msgid "The container must be published to access `published_at`"
msgstr "Kontejneri duhet të publikohet për të pasur qasje në `published_at`"

#. Translators: This is listed as the duration for a video that has not
#. yet reached the point in its processing by the servers where its
#. duration is determined.
#: cms/djangoapps/contentstore/models.py:555
#: cms/djangoapps/contentstore/video_storage_handlers.py:532
#: openedx/core/djangoapps/api_admin/models.py:42
msgid "Pending"
msgstr "Në pritje"

#: cms/djangoapps/contentstore/models.py:556
msgid "Processing"
msgstr "Përpunimi"

#. Translators: This is the status for a video that the servers have failed to
#. process
#: cms/djangoapps/contentstore/models.py:557
#: cms/djangoapps/contentstore/video_storage_handlers.py:126
msgid "Failed"
msgstr "Dështoi"

#: cms/djangoapps/contentstore/models.py:558
msgid "Completed"
msgstr "Kompletuar"

#: cms/djangoapps/contentstore/models.py:570
msgid "Linking status for course context key"
msgstr "Lidhja e statusit për çelësin e kontekstit të kursit"

#: cms/djangoapps/contentstore/models.py:575
msgid "Status of links in given learning context/course."
msgstr "Statusi i lidhjeve në kontekstin/kursin e dhënë mësimor."

#: cms/djangoapps/contentstore/models.py:581
#: cms/djangoapps/contentstore/models.py:582
msgid "Learning Context Links status"
msgstr "Statusi i lidhjeve të kontekstit mësimor"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/advanced_settings.py:47
msgid "Marks a field as deprecated."
msgstr "Shënonte një fushë si të vjetëruar."

#: cms/djangoapps/contentstore/rest_api/v0/serializers/advanced_settings.py:48
msgid "User-friendly display name for the field"
msgstr "Emri afishues i përshtatshëm për përdoruesit për fushën"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/advanced_settings.py:49
msgid "Help text that describes the setting."
msgstr "Teksti i ndihmës që përshkruan cilësimin."

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:14
msgid "Tab type"
msgstr "Lloji i skedës"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:15
msgid "Default name for the tab displayed to users"
msgstr "Emri i parazgjedhur për skedën që u shfaqet përdoruesve"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:18
msgid "True if it's possible to hide the tab for a course"
msgstr "Nëse është e mundur, fshih skedën për një kurs."

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:21
msgid "True the tab is hidden for the course"
msgstr "Vërtetë skeda është e fshehur për kursin"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:25
msgid "True if it's possible to reorder the tab in the list of tabs"
msgstr ""
"E vërtetë nëse është e mundur të rirenditni skedën në listën e skedave"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:29
msgid "True if this tab should be displayed only for instructors"
msgstr "E vërtetë nëse kjo skedë duhet të shfaqet vetëm për instruktorët"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:33
#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:37
msgid "Name of the tab displayed to users. Overrides title."
msgstr "Emri i skedës që u shfaqet përdoruesve. Anulon titullin."

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:41
msgid "Additional settings specific to the tab"
msgstr "Cilësimet shtesë specifike për skedën"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:74
msgid "ID of tab to update"
msgstr "ID e skedës për përditësim"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:75
msgid "Location (Usage Key) of tab to update"
msgstr "Vendndodhja e (Çelësi i përdorimit) i skedës për përditësim"

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:89
msgid "Need to supply either a valid tab_id or a tab_location."
msgstr "Duhet të ofrohet ose një tab_id e vlefshme ose një tab_lokacion."

#: cms/djangoapps/contentstore/rest_api/v0/serializers/tabs.py:100
msgid "True to hide the tab, and False to show it."
msgstr "E vërtetë për të fshehur skedën dhe e pavërtetë për ta shfaqur atë."

#: cms/djangoapps/contentstore/rest_api/v0/views/tabs.py:112
msgid "Change the visibility of tabs in a course."
msgstr "Ndryshon dukshmëria e skedave në një kurs."

#: cms/djangoapps/contentstore/transcript_storage_handlers.py:117
msgid "The information you entered is incorrect."
msgstr "Informacioni që futët është i pasaktë."

#: cms/djangoapps/contentstore/transcript_storage_handlers.py:139
#: cms/djangoapps/contentstore/transcript_storage_handlers.py:229
#: cms/djangoapps/contentstore/transcript_storage_handlers.py:254
#: xmodule/video_block/video_handlers.py:405
#, python-brace-format
msgid "The following parameters are required: {missing}."
msgstr "Kërkohen parametrat e mëposhtëm: {missing}."

#: cms/djangoapps/contentstore/transcript_storage_handlers.py:206
#: cms/djangoapps/contentstore/views/transcripts_ajax.py:292
#: xmodule/video_block/video_handlers.py:497
msgid ""
"There is a problem with this transcript file. Try to upload a different "
"file."
msgstr ""
"Ka një problem me këtë skedar transkripti. Provoni të ngarkoni një skedar "
"tjetër."

#: cms/djangoapps/contentstore/transcript_storage_handlers.py:234
#: xmodule/video_block/video_handlers.py:409
#, python-brace-format
msgid "A transcript with the \"{language_code}\" language code already exists."
msgstr "Një transkriptim me kodin e gjuhës \"{language_code}\" ekziston tashmë."

#: cms/djangoapps/contentstore/transcript_storage_handlers.py:238
#: cms/djangoapps/contentstore/views/transcripts_ajax.py:221
#: xmodule/video_block/video_handlers.py:413
msgid "A transcript file is required."
msgstr "Kërkohet një skedar transkripti."

#: cms/djangoapps/contentstore/utils.py:859
msgid "Deleted Group"
msgstr "Grupi i fshirë"

#. Translators: This is building up a list of groups. It is marked for
#. translation because of the
#. comma, which is used as a separator between each group.
#: cms/djangoapps/contentstore/utils.py:927
#, python-brace-format
msgid "{previous_groups}, {current_group}"
msgstr "{previous_groups} , {current_group}"

#: cms/djangoapps/contentstore/utils.py:1090
#: cms/djangoapps/contentstore/views/block.py:277
#: cms/djangoapps/contentstore/views/component.py:281 xmodule/html_block.py:62
msgid "Text"
msgstr "Tekst"

#: cms/djangoapps/contentstore/utils.py:1287
#, python-brace-format
msgid "Duplicate of {0}"
msgstr "Dublikatë e {0}"

#: cms/djangoapps/contentstore/utils.py:1289
#, python-brace-format
msgid "Duplicate of '{0}'"
msgstr "Dublikatë e &quot;{0}&quot;"

#: cms/djangoapps/contentstore/utils.py:1346
msgid "Invalid prerequisite course key"
msgstr "Çelësi i kursit parakusht i pavlefshëm"

#: cms/djangoapps/contentstore/utils.py:1925
msgid "Set Date"
msgstr "Cakto datën"

#. Translators: This is the status of an active video upload
#: cms/djangoapps/contentstore/video_storage_handlers.py:118
msgid "Uploading"
msgstr "Ngarkimi"

#. Translators: This is the status for a video that the servers are currently
#. processing
#: cms/djangoapps/contentstore/video_storage_handlers.py:120
msgid "In Progress"
msgstr "Në progres"

#. Translators: This is the status for a video that the servers have
#. successfully processed
#: cms/djangoapps/contentstore/video_storage_handlers.py:122
#: openedx/core/djangoapps/content_staging/data.py:21
msgid "Ready"
msgstr "Gati"

#. Translators: This is the status for a video that is uploaded completely
#: cms/djangoapps/contentstore/video_storage_handlers.py:124
msgid "Uploaded"
msgstr "Ngarkuar"

#. Translators: This is the status for a video that is cancelled during upload
#. by user
#: cms/djangoapps/contentstore/video_storage_handlers.py:128
msgid "Cancelled"
msgstr "Anuluar"

#. Translators: This is the status for a video which has failed
#. due to being flagged as a duplicate by an external or internal CMS
#: cms/djangoapps/contentstore/video_storage_handlers.py:131
msgid "Failed Duplicate"
msgstr "Dublikatë i dështuar"

#. Translators: This is the status for a video which has duplicate token for
#. youtube
#: cms/djangoapps/contentstore/video_storage_handlers.py:133
msgid "YouTube Duplicate"
msgstr "YouTube Dublikatë"

#. Translators: This is the status for a video for which an invalid
#. processing token was provided in the course settings
#: cms/djangoapps/contentstore/video_storage_handlers.py:136
msgid "Invalid Token"
msgstr "Token i pavlefshëm"

#. Translators: This is the status for a video that was included in a course
#. import
#: cms/djangoapps/contentstore/video_storage_handlers.py:138
msgid "Imported"
msgstr "Importuar"

#. Translators: This is the status for a video that is in an unknown state
#: cms/djangoapps/contentstore/video_storage_handlers.py:140
msgid "Unknown"
msgstr "E panjohur"

#. Translators: This is the status for a video that is having its
#. transcription in progress on servers
#: cms/djangoapps/contentstore/video_storage_handlers.py:142
msgid "Transcription in Progress"
msgstr "Transkriptimi në progres"

#. Translators: This is the status for a video whose transcription is complete
#: cms/djangoapps/contentstore/video_storage_handlers.py:144
msgid "Transcript Ready"
msgstr "Transkripti i gatshëm"

#. Translators: This is the status for a video whose transcription job was
#. failed for some languages
#: cms/djangoapps/contentstore/video_storage_handlers.py:146
msgid "Partial Failure"
msgstr "Dështim i pjesshëm"

#. Translators: This is the status for a video whose transcription job has
#. failed altogether
#: cms/djangoapps/contentstore/video_storage_handlers.py:148
