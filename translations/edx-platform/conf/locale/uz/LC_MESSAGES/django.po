msgstr "Kursni import qilishda nomaʼlum xatolik yuz berdi."

#: cms/djangoapps/contentstore/errors.py:15
msgid "An Unknown error occurred during the unpacking step."
msgstr "Paketni ochish bosqichida noma'lum xatolik yuz berdi."

