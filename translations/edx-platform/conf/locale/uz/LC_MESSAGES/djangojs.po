msgstr ""
"Ro‘yxatga olishning tugash sanasi kurs tugash sanasidan keyin bo‘lishi "
"mumkin emas."

#: cms/static/js/models/settings/course_details.js:83
msgid "The certificate available date must be later than the course end date."
msgstr ""
"Sertifikatning mavjud sanasi kursning tugash sanasidan kechroq bo‘lishi "
"kerak."

