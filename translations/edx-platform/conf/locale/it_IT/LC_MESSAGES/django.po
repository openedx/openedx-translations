msgstr "Ricrea i collegamenti anche per corsi completamente elaborati."

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:67
msgid "Delete all and create links for given course(s)."
msgstr "Elimina tutto e crea collegamenti per i corsi specificati."

