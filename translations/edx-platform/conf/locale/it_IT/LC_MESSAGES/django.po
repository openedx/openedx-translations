msgstr "CHIAVE_CORSO"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:48
msgid ""
"Recreate links for xblocks under given course keys. For eg. "
"course-v1:edX+DemoX.1+2014"
msgstr ""
"Ricrea i link per xblock sotto i corsi specificati. Ad esempio corso "
"-v1:edX+DemoX.1+2014"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:55
msgid ""
"Recreate links for xblocks under all courses. NOTE: this can take long time "
"depending on number of course and xblocks"
msgstr ""
"Ricrea i link per gli xblocks in tutti i corsi. NOTA: questo può richiedere "
"molto tempo a seconda del numero di corsi e xblocks."

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:62
