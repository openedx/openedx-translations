#: cms/djangoapps/contentstore/management/commands/git_export.py:33
msgid ""
"Take the specified course and attempt to export it to a git repository\n"
". Course directory must already be a git repository. Usage:  git_export <course_loc> <git_url>"
msgstr ""
"Παρακολουθήστε το καθορισμένο μάθημα και προσπαθήστε να το εξαγάγετε σε ένα αποθετήριο git\n"
". Ο κατάλογος μαθημάτων πρέπει να είναι ήδη αποθετήριο git. Χρήση: git_export <course_loc> <git_url>"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:46
msgid "COURSE_KEY"
msgstr "COURSE_KEY"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:48
msgid ""
"Recreate links for xblocks under given course keys. For eg. "
"course-v1:edX+DemoX.1+2014"
msgstr ""
"Επαναδημιουργία συνδέσμων για xblocks κάτω από συγκεκριμένα κλειδιά "
"μαθημάτων. Για παράδειγμα: course-v1:edX+DemoX.1+2014"

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:55
msgid ""
"Recreate links for xblocks under all courses. NOTE: this can take long time "
"depending on number of course and xblocks"
msgstr ""
"Επαναδημιουργία συνδέσμων για τα xblocks σε όλα τα μαθήματα. ΣΗΜΕΙΩΣΗ: αυτό "
"μπορεί να πάρει πολύ χρόνο ανάλογα με τον αριθμό των μαθημάτων και των "
"xblocks."

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:62
msgid "Recreate links even for completely processed courses."
msgstr ""
"Επαναδημιουργήστε συνδέσμους ακόμη και για πλήρως επεξεργασμένα μαθήματα."

#: cms/djangoapps/contentstore/management/commands/recreate_upstream_links.py:67
msgid "Delete all and create links for given course(s)."
msgstr "Διαγραφή όλων και δημιουργία συνδέσμων για συγκεκριμένα μαθήματα."

#: cms/djangoapps/contentstore/models.py:95
msgid "Upstream context key i.e., learning_package/library key"
msgstr "Κλειδί πλαισίου ανάντη, δηλ. κλειδί learning_package/βιβλιοθήκης"

#: cms/djangoapps/contentstore/models.py:157
msgid ""
"Upstream block usage key, this value cannot be null and useful to track "
"upstream library blocks that do not exist yet"
msgstr ""
"Κλειδί χρήσης μπλοκ upstream, η τιμή αυτή δεν μπορεί να είναι μηδενική και "
"είναι χρήσιμη για την παρακολούθηση μπλοκ βιβλιοθήκης upstream που δεν "
"υπάρχουν ακόμη."

#: cms/djangoapps/contentstore/models.py:163
msgid "Component Link"
msgstr "Σύνδεσμος συστατικών"

#: cms/djangoapps/contentstore/models.py:164
msgid "Component Links"
msgstr "Σύνδεσμοι στοιχείων"

#: cms/djangoapps/contentstore/models.py:190
