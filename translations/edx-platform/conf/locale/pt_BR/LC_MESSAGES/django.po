msgstr "Totalmente Suportado"

#: common/djangoapps/xblock_django/models.py:66
msgid "Provisionally Supported"
msgstr "Suporta provisoriamente"

#: common/djangoapps/xblock_django/models.py:67
msgid "Unsupported"
msgstr "Não suportado"

