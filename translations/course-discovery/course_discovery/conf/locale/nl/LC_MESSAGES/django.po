#: apps/api/filters.py:48
#, python-brace-format
msgid "No user with the username [{username}] exists."
msgstr "Er bestaat geen gebruiker met de gebruikersnaam [{username}]."

#: apps/api/filters.py:51
msgid ""
"Only staff users are permitted to filter by username. Remove the username "
"parameter."
msgstr ""
"Alleen personeelsgebruikers mogen filteren op gebruikersnaam. Verwijder de "
"gebruikersnaamparameter."

