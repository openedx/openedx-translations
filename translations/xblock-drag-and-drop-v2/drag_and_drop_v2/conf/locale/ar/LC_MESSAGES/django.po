#: default_data.py:36
msgid "Good work! You have completed this drag and drop problem."
msgstr "أحسنت عملاً! لقد أتممت حل مسألة السحب والإفلات هذه."

#: drag_and_drop_v2.py:82
msgid "Title"
msgstr "العنوان"

#: drag_and_drop_v2.py:83
msgid ""
"The title of the drag and drop problem. The title is displayed to learners."
msgstr "عنوان مسألة السحب والإفلات. سيُعرض هذا العنوان للمتعلمين."

#: drag_and_drop_v2.py:85
msgid "Drag and Drop"
msgstr "سحب وإفلات"

