#: enterprise/models.py:3265
#, python-brace-format
msgid ""
"Enter a string that can be used to generate a dynamic subject line for "
"notification emails. The placeholder {course_name} will be replaced with the"
" name of the course or program that was enrolled in."
msgstr ""
"შეიყვანეთ სტრიქონი, რომელიც შეიძლება გამოყენებულ იქნას შეტყობინებების "
"ელფოსტისთვის დინამიური სათაურის გენერირებისთვის. {course_name} ჩანაცვლდება "
"კურსის ან პროგრამის სახელით, რომელზეც ჩაირიცხეთ."

#: enterprise/models.py:3407
msgid "Active"
msgstr "აქტიური"

#: enterprise/models.py:3408
msgid "Include Date"
msgstr "ჩართვა თარიღი"

#: enterprise/models.py:3409
msgid "Include date in the report file name"
msgstr "თარიღის ჩართვა ანგარიშის ფაილის სახელში"

#: enterprise/models.py:3415
msgid "Delivery Method"
msgstr "მიწოდების მეთოდი"

#: enterprise/models.py:3416
msgid "The method in which the data should be sent."
msgstr "მეთოდი, რომლითაც მონაცემები უნდა გაიგზავნოს."

#: enterprise/models.py:3421
msgid ""
"Specifies whether report should be compressed. Without compression files "
"will not be password protected or encrypted."
msgstr ""
"განსაზღვრავს, უნდა იყოს თუ არა ანგარიში დაპრესილი. დაპრესვის გარეშე ფაილები "
"არ იქნება დაცული პაროლით ან დაშიფრული."

#: enterprise/models.py:3428
msgid "PGP Encryption Key"
msgstr "PGP-ის დაშიფვრის გასაღები"

#: enterprise/models.py:3437
msgid "Data Type"
