msgstr ""
"Shenja e sesionit më aktual parashikonte autorizimin për të bërë thirrje API"
" në shembullin e klientit"

#: integrated_channels/cornerstone/models.py:116
msgid "Date time when session token was last provided"
msgstr "Data e kohës kur u dha për herë të fundit token e sesionit"

#: integrated_channels/cornerstone/models.py:124
msgid "If checked, subjects will not be sent to Cornerstone"
msgstr "Nëse zgjidhet, subjektet nuk do të dërgohen në gurin themelor"

