msgstr "Pamja paraprake (programi)"

#: consent/models.py:213
msgid "Name of the user whose consent state is stored."
msgstr "Emri i përdoruesit, gjendja e pëlqimit të të cilit është ruajtur."

#: consent/models.py:215
msgid "Whether consent is granted."
msgstr "Nëse është dhënë pëlqimi."

