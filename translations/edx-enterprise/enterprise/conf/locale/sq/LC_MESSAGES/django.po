msgstr "Çelësi i kursit për të cilin jepet pëlqimi për ndarjen e të dhënave."

#: consent/models.py:266
msgid "Data sharing consent text overrides"
msgstr "Teksti i pëlqimit për ndarjen e të dhënave anashkalon"

#: consent/models.py:269
msgid ""
"Fill in a text for first paragraph of page. The following variables may be "
"available:<br /><ul><li>enterprise_customer_name: A name of enterprise "
"customer.</li><li>platform_name: Name of platform.</li><li>item: A string "
"which is \"course\" or \"program\" depending on the type of "
"consent.</li><li>course_title: Title of course. Available when type of "
"consent is course.</li><li>course_start_date: Course start date. Available "
"when type of consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për paragrafin e parë të faqes. Variablat e mëposhtëm "
"mund të jenë të disponueshëm:<br /><ul><li> Emri_e_konsumatorit: Një emër i "
"klientit të ndërmarrjes.</li><li> platforma_name: Emri i "
"platformës.</li><li> artikull: Një varg i cili është &quot;kurs&quot; ose "
"&quot;program&quot; në varësi të llojit të pëlqimit.</li><li> kurs_title: "
"Titulli sigurisht. Ofrohet kur lloji i pëlqimit është kursi.</li><li> "
"course_start_date: Data e fillimit të kursit. Ofrohet kur lloji i pëlqimit "
"është kursi.</li></ul>"

#: consent/models.py:279
msgid ""
"Fill in a text for policy paragraph at the bottom of page. The following "
"variables may be available:<br /><ul><li>enterprise_customer_name: A name of"
" enterprise customer.</li><li>platform_name: Name of platform.</li><li>item:"
" A string which is \"course\" or \"program\" depending on the type of "
"consent.</li><li>course_title: Title of course. Available when type of "
"consent is course.</li><li>course_start_date: Course start date. Available "
"when type of consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për paragrafin e politikës në fund të faqes. Variablat e"
" mëposhtëm mund të jenë të disponueshëm:<br /><ul><li> Emri_e_konsumatorit: "
"Një emër i klientit të ndërmarrjes.</li><li> platforma_name: Emri i "
"platformës.</li><li> artikull: Një varg i cili është &quot;kurs&quot; ose "
"&quot;program&quot; në varësi të llojit të pëlqimit.</li><li> kurs_title: "
"Titulli sigurisht. Ofrohet kur lloji i pëlqimit është kursi.</li><li> "
"course_start_date: Data e fillimit të kursit. Ofrohet kur lloji i pëlqimit "
"është kursi.</li></ul>"

#: consent/models.py:289
msgid ""
"Fill in a text for left sidebar paragraph. The following variables may be "
"available:<br /><ul><li>enterprise_customer_name: A name of enterprise "
"customer.</li><li>platform_name: Name of platform.</li><li>item: A string "
"which is \"course\" or \"program\" depending on the type of "
"consent.</li><li>course_title: Title of course. Available when type of "
"consent is course.</li><li>course_start_date: Course start date. Available "
"when type of consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për paragrafin e shiritit anësor të majtë. Variablat e "
"mëposhtëm mund të jenë të disponueshëm:<br /><ul><li> Emri_e_konsumatorit: "
"Një emër i klientit të ndërmarrjes.</li><li> platforma_name: Emri i "
"platformës.</li><li> artikull: Një varg i cili është &quot;kurs&quot; ose "
"&quot;program&quot; në varësi të llojit të pëlqimit.</li><li> kurs_title: "
"Titulli sigurisht. Ofrohet kur lloji i pëlqimit është kursi.</li><li> "
"course_start_date: Data e fillimit të kursit. Ofrohet kur lloji i pëlqimit "
"është kursi.</li></ul>"

#: consent/models.py:299
msgid ""
"Fill in a text for dialog which appears when user decline to provide "
"consent. The following variables may be available:<br "
"/><ul><li>enterprise_customer_name: A name of enterprise "
"customer.</li><li>item: A string which is \"course\" or \"program\" "
"depending on the type of consent.</li><li>course_title: Title of course. "
"Available when type of consent is course.</li><li>course_start_date: Course "
"start date. Available when type of consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për dialog i cili shfaqet kur përdoruesi refuzon të japë"
" pëlqimin. Variablat e mëposhtëm mund të jenë të disponueshëm:<br /><ul><li>"
" Emri_e_konsumatorit: Një emër i klientit të ndërmarrjes.</li><li> artikull:"
" Një varg i cili është &quot;kurs&quot; ose &quot;program&quot; në varësi të"
" llojit të pëlqimit.</li><li> kurs_title: Titulli sigurisht. Ofrohet kur "
"lloji i pëlqimit është kursi.</li><li> course_start_date: Data e fillimit të"
" kursit. Ofrohet kur lloji i pëlqimit është kursi.</li></ul>"

#: consent/models.py:309
msgid ""
"Fill in a text for title of the notification which appears on dashboard when"
" user decline to provide consent. The following variables may be "
"available:<br /><ul><li>enterprise_customer_name: A name of enterprise "
"customer.</li><li>course_title: Title of course. Available when type of "
"consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për titullin e njoftimit që shfaqet në panelin e "
"kontrollit kur përdoruesi refuzon të japë pëlqimin. Variablat e mëposhtëm "
"mund të jenë të disponueshëm:<br /><ul><li> Emri_e_konsumatorit: Një emër i "
"klientit të ndërmarrjes.</li><li> kurs_title: Titulli sigurisht. Ofrohet kur"
" lloji i pëlqimit është kursi.</li></ul>"

#: consent/models.py:318
msgid ""
"Fill in a text for message of the notification which appears on dashboard "
"when user decline to provide consent. The following variables may be "
"available:<br /><ul><li>enterprise_customer_name: A name of enterprise "
"customer.</li><li>course_title: Title of course. Available when type of "
"consent is course.</li></ul>"
msgstr ""
"Plotësoni një tekst për mesazhin e njoftimit që shfaqet në panelin e "
"kontrollit kur përdoruesi refuzon të japë pëlqimin. Variablat e mëposhtëm "
"mund të jenë të disponueshëm:<br /><ul><li> Emri_e_konsumatorit: Një emër i "
"klientit të ndërmarrjes.</li><li> kurs_title: Titulli sigurisht. Ofrohet kur"
" lloji i pëlqimit është kursi.</li></ul>"

