msgstr ""
"edX མ་ལག་ནས་རང་འགུལ་ཡིག་ཟམ་གཏོང་མཁན་གྱི་མིང་གཞན་གསལ་བཀོད་བྱེད་པ་གཅིག་ཡོད།"

#: enterprise/models.py:537
msgid ""
"Text shown on the learner portal dashboard for customer specific purposes. "
"Open HTML field."
msgstr ""
"སློབ་སྦྱོང་བྱེད་མཁན་གྱི་དྲ་ཚིགས་སྟེང་དུ་ཚོང་ཤག་གི་དམིགས་བསལ་གྱི་དམིགས་ཡུལ་སྟོན་ཡོད།"
" HTML ཡིག་དུམ་ཁ་ཕྱེ།"

#: enterprise/models.py:867
msgid ""
"Course details were not found for course key {} - Course Catalog API "
