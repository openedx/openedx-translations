#: enterprise/models.py:3446
msgid "The type this report should be sent as, e.g. CSV."
msgstr "སྙན་ཞུ་འདི་གཏོང་དགོས་པའི་རིགས་དཔེར་ན། CSV"

#: enterprise/models.py:3450
msgid "Email"
msgstr "གློག་འཕྲིན།"

#: enterprise/models.py:3451
msgid "The email(s), one per line, where the report should be sent."
msgstr "སྙན་ཞུ་དེ་གཏོང་དགོས་པའི་ཡིག་ཟམ་རེ་ལ་གློག་འཕྲིན་གཅིག་རེ་ཡོད།"

#: enterprise/models.py:3458
msgid "Frequency"
msgstr "ཡང་འཁོར་བསྐྱར་འཁོར"

#: enterprise/models.py:3459
msgid ""
"The frequency interval (daily, weekly, or monthly) that the report should be"
" sent."
msgstr ""
"སྙན་ཞུ་གཏོང་དགོས་པའི་བསྐྱར་ཟློས་བར་མཚམས། (ཉིན་ལྟར་དང་། བདུན་རེར། "
"ཡང་ན་ཟླ་རེར།)"

#: enterprise/models.py:3464
msgid "Day of Month"
msgstr "ཟླ་བའི་ཉིན།"

#: enterprise/models.py:3465
msgid ""
"The day of the month to send the report. This field is required and only "
"valid when the frequency is monthly."
msgstr ""
"སྙན་ཞུ་འབུལ་བའི་ཟླ་བའི་ཉིན་མོ། "
"ས་ཁོངས་འདི་དགོས་ངེས་ཡིན་པ་དང་བསྐྱར་ཟློས་ཟླ་རེའི་སྐབས་རྐྱངམ་གཅིག་ནུས་ལྡན་ཡིན།"

#: enterprise/models.py:3473
msgid "Day of Week"
msgstr "གཟའ་འཁོར་གྱི་ཉིན།"

#: enterprise/models.py:3474
msgid ""
"The day of the week to send the report. This field is required and only "
"valid when the frequency is weekly."
msgstr ""
"སྙན་ཞུ་འབུལ་བའི་གཟའ་ཉིན། "
"ས་ཁོངས་འདི་དགོས་ངེས་ཡིན་པ་དང་བདུན་ཕྲག་རེའི་སྐབས་རྐྱང་ནུས་ལྡན་ཡིན།"

#: enterprise/models.py:3478
msgid "Hour of Day"
msgstr "ཉིན་མོའི་ཆུ་ཚོད།"

#: enterprise/models.py:3479
msgid ""
"The hour of the day to send the report, in Eastern Standard Time (EST). This"
" is required for all frequency settings."
msgstr ""
"སྙན་ཞུ་གཏོང་དུས་ཚོད་ནི་ཉིན་མོའི་ཆུ་ཚོད་ཤར་ཕྱོགས་ཀྱི་ཚད་གཞི་(EST)ནང་ཡོད། "
"འདི་ནི་བསྐྱར་ཟློས་སྒྲིག་སྟངས་ཚང་མར་དགོས་མཁོ་ཡོད།"

#: enterprise/models.py:3487
msgid ""
"This password will be used to secure the zip file. It will be encrypted when"
" stored in the database."
msgstr ""
"གསང་གྲངས་འདི་ zip ཡིག་ཆ་བདེ་འཇགས་ཡོང་བར་བེད་སྤྱོད་བྱེད། "
"གཞི་གྲངས་མཛོད་ནང་གསོག་འཇོག་བྱེད་སྐབས་གསང་བཟོ་བྱེད།"

#: enterprise/models.py:3494
msgid "SFTP Host name"
msgstr "SFTP གཙོ་བོའི་མིང་།"

#: enterprise/models.py:3495
msgid "If the delivery method is sftp, the host to deliver the report to."
msgstr "གལ་ཏེ་སྤྲོད་ཐབས་དེ་sftpཡིན་ན།"

#: enterprise/models.py:3500
msgid "SFTP Port"
msgstr "SFTP མཐུད་ཁ།"

#: enterprise/models.py:3508
msgid "SFTP username"
msgstr "SFTP སྤྱོད་མཁན་མིང་།"

#: enterprise/models.py:3509
msgid ""
"If the delivery method is sftp, the username to use to securely access the "
"host."
msgstr ""
"གལ་ཏེ་སྐྱེལ་འདྲེན་ཐབས་ལམ་དེ་sftpཡིན་ན། "
"སྤྱོད་མཁན་མིང་གིས་མགོ་སྤྱོད་ལ་བརྟེན་ནས་བདེ་འཇགས་སུ་འཛུལ་སྤྱོད་བྱེད་པ་དགོས།"
