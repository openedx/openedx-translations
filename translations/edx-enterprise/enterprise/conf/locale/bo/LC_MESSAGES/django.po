msgstr "ཐོ་འགོད་འདི་མཉམ་སྦྲེལ་བྱས་པའི་ཁེ་ལས་སློབ་མ།"

#: enterprise/models.py:2080
msgid "The ID of the course in which the learner was enrolled."
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་གྱི་སློབ་ཚན་གྱི་ངོ་རྟགས།"

#: enterprise/models.py:2087
msgid ""
"Specifies whether a user marked this course as saved for later in the "
