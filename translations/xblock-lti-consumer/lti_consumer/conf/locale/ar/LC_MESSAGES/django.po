#: lti_1p3/extensions/rest_framework/authentication.py:45
msgid "Invalid token header. No credentials provided."
msgstr "رأس الرمز الوصول (Token header) غير صالح. لم تُقدَّم بيانات اعتماد."

#: lti_1p3/extensions/rest_framework/authentication.py:49
msgid "Invalid token header. Token string should not contain spaces."
msgstr ""
"رأس الرمز الوصول (Token header) غير صالح. يجب ألا تحتوي سلسلة رمز الوصول على"
" مسافات."

#: lti_1p3/extensions/rest_framework/authentication.py:66
msgid "Invalid token signature."
msgstr "توقيع رمز الوصول غير صالِح."

#: lti_xblock.py:134
msgid "No valid user id found in endpoint URL"
msgstr "لم يُعثر على معرّف مستخدم صالح في رابط نقطة النهاية"

#: lti_xblock.py:147
msgid "Configuration on block"
msgstr "إعدادات الكتلة"

#: lti_xblock.py:151
msgid "Database Configuration"
msgstr "إعدادات قاعدة البيانات"

#: lti_xblock.py:154
msgid "Reusable Configuration"
msgstr "الإعدادات الممكن إعادة استخدامها"

#: lti_xblock.py:262
msgid "Display Name"
msgstr "الاسم الظاهر"

#: lti_xblock.py:264
msgid ""
"Enter the name that students see for this component. Analytics reports may "
"also use the display name to identify this component."
msgstr ""
"أدخِل الاسم الذي يراه الطلاب لهذا المكون. قد تستخدم تقارير التحليلات أيضاً "
"الاسم الظاهر لتعريف هذا المكون."

#: lti_xblock.py:268
msgid "LTI Consumer"
msgstr "مستهلك LTI"

#: lti_xblock.py:271
msgid "LTI Application Information"
msgstr "معلومات تطبيق LTI"

#: lti_xblock.py:273
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"أدخِل وصفاً لتطبيق الجهة الخارجية. وفي حال طلب اسم المستخدم و/أو البريد "
"الإلكتروني، فاستخدِم هذا الصندوق النصي لإعلام المستخدمين عن سبب إرسال اسم "
"المستخدم و/أو البريد الإلكتروني الخاص بهم إلى تطبيق لجهة خارجية."

#: lti_xblock.py:286
msgid ""
"Select 'Configuration on block' to configure a new LTI Tool. If the support "
"staff provided you with a pre-configured LTI reusable Tool ID, "
"select'Reusable Configuration' and enter it in the text field below."
msgstr ""
"اختَر \"إعدادات الكتلة\" لإعداد أداة LTI جديدة. إذا زودك فريق الدعم بمعرّف "
"أداة LTI قابلة لإعادة الاستخدام تم إعدادها مسبقاً، فاختَر \"الإعدادات "
"القابلة لإعادة الاستخدام\" وأدخِله في الحقل النصي أدناه. "

#: lti_xblock.py:293
msgid "LTI Version"
msgstr "إصدار LTI"

#: lti_xblock.py:308
msgid "LTI Reusable Configuration ID"
msgstr "معرّف إعدادات LTI الممكن إعادة استخدامها"

#: lti_xblock.py:310
msgid ""
"Enter the reusable LTI external configuration ID provided by the support "
"staff."
msgstr ""
"أدخِل معرّف إعدادات LTI الخارجية الممكن إعادة استخدامها التي حصلت عليها من "
"فريق الدعم."

#: lti_xblock.py:326
msgid ""
"Enter the LTI 1.3 Tool Launch URL. <br />This is the URL the LMS will use to"
" launch the LTI Tool."
msgstr ""
"أدخِل رابط تشغيل أداة بـ LTI 1.3.<br /> هذا هو الرابط الذي سيستخدمه نظام "
"إدارة التعلم لتشغيل أداة LTI."

#: lti_xblock.py:335
msgid ""
"Enter the LTI 1.3 Tool OIDC Authorization url (can also be called login or "
"login initiation URL).<br />This is the URL the LMS will use to start a LTI "
"authorization prior to doing the launch request."
msgstr ""
"أدخِل رابط تفويض OIDC لأداة LTI 1.3 (يمكن أن يُسمى أيضاً رابط تسجيل الدخول "
"أو رابط بدء تسجيل الدخول).<br /> هذا هو الرابط الذي سيستخدمه نظام إدارة "
"التعلم (LMS) لبدء ترخيص LTI قبل إجراء طلب النشر."

#: lti_xblock.py:341
msgid "Registered Redirect URIs"
msgstr "الروابط المسجلة المخصصة لإعادة التوجيه"

#: lti_xblock.py:343
msgid ""
"Valid urls the Tool may request us to redirect the id token to. The redirect"
" uris are often the same as the launch url/deep linking url so if this field"
" is empty, it will use them as the default. If you need to use different "
"redirect uri's, enter them here. If you use this field you must enter all "
"valid redirect uri's the tool may request."
msgstr ""
"الروابط الصالحة التي قد تطلب منا الأداة إعادة توجيه رمز تعريف الهوية (ID "
"Token) إليها. غالباً ما تكون روابط إعادة التوجيه مطابقة لرابط التشغيل أو "
"رابط الربط العميق، فإذا كان هذا الحقل فارغاً، ستُستخدم كروابط افتراضية. إذا "
"كنت تريد استخدام روابط إعادة توجيه مختلفة، فأدخِلها هنا. إذا استخدمت هذا "
"الحقل، فينبغي عليك إدخال جميع روابط إعادة التوجيه التي قد تطلبها الأداة."

#: lti_xblock.py:353
msgid "Tool Public Key Mode"
msgstr "وضع المفتاح العام للأداة"

#: lti_xblock.py:401
msgid "Enable LTI Names and Role Provisioning Services."
msgstr "فعِّل خدمات التزويد الآلي للأسماء والأدوار لـ LTI"

#: lti_xblock.py:408
msgid "Deep linking"
msgstr "الربط العميق"

#: lti_xblock.py:409
msgid "Select True if you want to enable LTI Advantage Deep Linking."
msgstr "يُرجى اختيار \"نعم\" إذا أردت تفعيل الربط العميق لـ LTI Advantage."

#: lti_xblock.py:414
msgid "Deep Linking Launch URL"
msgstr "رابط تشغيل الربط العميق"

#: lti_xblock.py:418
msgid ""
"Enter the LTI Advantage Deep Linking Launch URL. If the tool does not "
"specify one, use the same value as 'Tool Launch URL'."
msgstr ""
"أدخِل رابط تشغيل الربط العميق لـ LTI Advantage. إذا لم تُحدّد الأداة واحداً،"
" فاستخدِم نفس قيمة \"رابط تشغيل الأداة\"."

#: lti_xblock.py:425
msgid "Disabled"
msgstr "معطّل"

#: lti_xblock.py:426
msgid "Allow tools to submit grades only (declarative)"
msgstr "اسمح للإدوات بإرسال الدرجات فقط (تصريحياً)"

#: lti_xblock.py:427
msgid "Allow tools to manage and submit grade (programmatic)"
msgstr "اسمَح للإدوات بإدارة الدرجات وإرسالها (آلياً)"

#: lti_xblock.py:432
msgid ""
"Enable the LTI-AGS service and select the functionality enabled for LTI "
"tools. The 'declarative' mode (default) will provide a tool with a LineItem "
"created from the XBlock settings, while the 'programmatic' one will allow "
"tools to manage, create and link the grades."
msgstr ""
"فعِّل خدمة LTI-AGS وحدد الوظيفة الممكّنة لأدوات LTI. سيوفر وضع "
"\"declarative\" (افتراضياً) أداة تحتوي على LineItem أُنشئ من إعدادات XBlock،"
" بينما سيسمح وضع \"programmatic\" (برمجياً) للأدوات بإدارة الدرجات وإنشائها "
"وربطها. "

#: lti_xblock.py:442
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider. This value must be the same "
"LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"أدخِل معرّف LTI لمزوّد LTI الخارجي. يجب أن تكون هذه القيمة مطابقة لمعرّف LTI"
" الذي أدخلته في إعدادات استيثاق LTI في صفحة الإعدادات المتقدمة.<br />اطّلِع "
"على {docs_anchor_open} وثائق LTI الخاصة بـ إدكس {anchor_close} للمزيد من "
"التفاصيل حول هذا الإعداد."

#: lti_xblock.py:456
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.<br />See the "
"{docs_anchor_open}edX LTI documentation{anchor_close} for more details on "
"this setting."
msgstr ""
"أدخِل رابط الأداة الخارجية التي يشغلها هذا المكون. يُستخدم هذا الإعداد فقط "
"عند تعيين خيار \"اخفِ الأداة الخارجية\" على \"لا\".<br />اطّلِع على "
"{docs_anchor_open}وثائق edX LTI{anchor_close} لعرفة المزيد من التفاصيل حول "
"هذا الإعداد."

#: lti_xblock.py:471
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this component. Ex. "
"[\"page=1\", \"color=white\"]<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"أضِف زوجاً من المفاتيح أو القِيم لأيّ متغيرات مخصصة، مثل الصفحة التي ينبغي "
"أن يُفتح عليها كتابك الإلكتروني أو لون الخلفية لهذا المكون. على سبيل المثال،"
" [\"page=1\", \"color=white\"]<br /> اطّلِع على {docs_anchor_open} وثائق LTI"
" الخاصة بإدكس {anchor_close} للمزيد من التفاصيل حول هذا الإعداد."

#: lti_xblock.py:483
msgid ""
"Select Inline if you want the LTI content to open in an IFrame in the "
"current page. Select Modal if you want the LTI content to open in a modal "
"window in the current page. Select New Window if you want the LTI content to"
" open in a new browser window. This setting is only used when Hide External "
"Tool is set to False."
msgstr ""
"اختَر خيار \"مُضمّن\" إذا كنت تريد أن يُفتح محتوى LTI في IFrame في الصفحة "
"الحالية. اختَر خيار \"نافذة مشروطة\" إذا كنت تريد أن يُفتح محتوى LTI في "
"نافذة مشروطة في الصفحة الحالية. اختَر خيار \"نافذة جديدة\" إذا كنت تريد أن "
"يُفتح محتوى LTI في نافذة متصفح جديدة. يُستخدم هذا الإعداد فقط عند تعيين خيار"
" \"اخفِ الأداة الخارجية\" على \"لا\"."

#: lti_xblock.py:499
msgid ""
"Enter the text on the button used to launch the third party application. "
"This setting is only used when Hide External Tool is set to False and LTI "
"Launch Target is set to Modal or New Window."
msgstr ""
"أدخِل النص الظاهر على الزر المستخدم لتشغيل تطبيق الجهة الخارجية. يُستخدم هذا"
" الإعداد فقط عند تعيين خيار \"اخفِ الأداة الخارجية\" على \"لا\"، وتعيين خيار"
" \"مكان تشغيل LTI\" على \"نافذة منبثقة\" أو \"نافذة جديدة\". "

#: lti_xblock.py:509
msgid ""
"Enter the desired pixel height of the iframe which will contain the LTI "
"tool. This setting is only used when Hide External Tool is set to False and "
"LTI Launch Target is set to Inline."
msgstr ""
"أدخِل ارتفاع البكسل المطلوب لـ iframe الذي سيحتوي على أداة LTI. يُستخدم هذا "
"الإعداد فقط عند تعيين خيار \"اخفِ الأداة الخارجية\" على \"لا\"، وتعيين خيار "
"\"مكان تشغيل LTI\" على \"مُضمّن\"."

#: lti_xblock.py:517
msgid "Modal Height"
msgstr "ارتفاع النافذة المشروطة"

#: lti_xblock.py:519
msgid ""
"Enter the desired viewport percentage height of the modal overlay which will"
" contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"أدخِل النسبة المئوية لارتفاع نافذة العرض المطلوب للنافذة المنبثقة العائمة "
"التي ستحتوي على أداة LTI. يُستخدم هذا الإعداد فقط عند تعيين خيار \"اخفِ "
"الأداة الخارجية\" على \"لا\"، وتعيين خيار \"مكان تشغيل LTI\" على \"نافذة "
"مشروطة\"."

#: lti_xblock.py:527
msgid "Modal Width"
msgstr "عرض النافذة المشروطة"

#: lti_xblock.py:529
msgid ""
"Enter the desired viewport percentage width of the modal overlay which will "
"contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"أدخِل النسبة المئوية لعرض نافذة العرض المطلوب للنافذة المنبثقة العائمة التي "
"ستحتوي على أداة LTI. يُستخدم هذا الإعداد فقط عند تعيين خيار \"اخفِ الأداة "
"الخارجية\" على \"لا\"، وتعيين خيار \"مكان تشغيل LTI\" على \"نافذة مشروطة\"."

#: lti_xblock.py:537
msgid "Scored"
msgstr "مقيّمة"

#: lti_xblock.py:545
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"أدخِل عدد الدرجات الممكنة لهذا المكون. العدد الافتراضي هو 1.0. يُستخدم هذا "
"الإعداد فقط عند تعيين خيار 'Scored' على \"نعم\"."

#: lti_xblock.py:554
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"حُفظت النتيجة في xblock KVS -- وهي نسخة مطابقة للنتيجة المنشورة في قاعدة "
"بيانات django"

#: lti_xblock.py:559
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "التعليق العائد من المصحّح، LTI2.0 spec"

#: lti_xblock.py:564
msgid "Hide External Tool"
msgstr "اخفِ الأداة الخارجية "

#: lti_xblock.py:566
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"اختَر \"نعم\" إذا أردت استخدام هذا المكون كبديل للمزامنة مع نظام تقييم خارجي"
" بدلاً من تشغيل أداة خارجية. سيخفي هذا الإعداد زر التشغيل وكل عناصر IFrames "
"لهذا المكون."

#: lti_xblock.py:574
msgid "Accept grades past deadline"
msgstr "اقبَل الدرجات بعد انقضاء الموعد النهائي "

#: lti_xblock.py:575
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"يُرجى اختيار \"نعم\" للسماح لأنظمة خارجية بنشر الدرجات بعد انقضاء الموعد "
"النهائي."

#. Translators: This is used to request the user's username for a third party
#. service.
#: lti_xblock.py:585
msgid "Select True to request the user's username."
msgstr "يُرجى اختيار \"نعم\" لطلب اسم المستخدم."

#: lti_xblock.py:590
msgid "Request user's full name"
msgstr "اطلب الاسم الكامل للمستخدم"

#. Translators: This is used to request the user's full name for a third party
#. service.
#: lti_xblock.py:592
msgid "Select True to request the user's full name."
msgstr "يُرجى اختيار \"نعم\" لطلب الاسم الكامل للمستخدم."

#: lti_xblock.py:597
msgid "Request user's email"
msgstr "اطلب البريد الإلكتروني للمستخدم"

#. Translators: This is used to request the user's email for a third party
#. service.
#: lti_xblock.py:599
msgid "Select True to request the user's email address."
msgstr "يُرجى اختيار \"نعم\" لطلب البريد الإلكتروني للمستخدم."

#: lti_xblock.py:605
msgid "Send extra parameters"
msgstr "أرسِل معطيات إضافية"

#: lti_xblock.py:606
msgid ""
"Select True to send the extra parameters, which might contain Personally "
"Identifiable Information. The processors are site-wide, please consult the "
"site administrator if you have any questions."
msgstr ""
"يُرجى اختيار \"نعم\" لإرسال معطيات إضافية، والتي قد تتضمن معلومات تعريف "
"شخصية. المعالجات موجودة على مستوى الموقع، لذا يُرجى استشارة مشرف الموقع إذا "
"كانت لديك أيّ أسئلة."

#: lti_xblock.py:688
msgid "Custom Parameters should be strings in \"x=y\" format."
msgstr "يجب أن تكون المعطيات المخصصة سلاسل نصّية بتنسيق \"x=y\". "

#: lti_xblock.py:722
msgid ""
"The specified LTI ID is not configured in this course's Advanced Settings."
msgstr "لم يُضبط معرّف LTI المحدد في الإعدادات المتقدمة لهذا المساق."

#: lti_xblock.py:891
msgid ""
"Could not parse LTI passport: {lti_passport!r}. Should be \"id:key:secret\" "
"string."
msgstr ""
"تعذّر تفسير معلومات استيثاق LTI: {lti_passport!r}. يجب أن تكون سلسلة نصّية "
"بتنسيق \"id:key:secret\". "

#: lti_xblock.py:1101
msgid ""
"Could not parse custom parameter: {custom_parameter!r}. Should be \"x=y\" "
"string."
msgstr ""
"تعذّر تفسير المعطيات المخصصة: {custom_parameter!r}. يجب أن تكون سلسلة نصّية "
"بتنسيق \"x=y\"."

#: lti_xblock.py:1490
msgid "[LTI]: Real user not found against anon_id: {}"
msgstr "[LTI]: لم يُعثر على مستخدم حقيقي يقابل anon_id: {}"

#: models.py:61
msgid "Platform's generated Private key. Keep this value secret."
msgstr "لقد أُنشئ المفتاح الخاص للمنصة. حافِظ على سرّيته!"

#: models.py:159
msgid ""
"LTI Configuration stored on the model for LTI 1.3 must have a value for one "
"of lti_1p3_tool_public_key or lti_1p3_tool_keyset_url."
msgstr ""
"يجب أن تحتوي إعدادات LTI المخزّنة في إصدار LTI 1.3 إمّا على "
"lti_1p3_tool_public_key أو lti_1p3_tool_keyset_url."

#: models.py:203
msgid "Configuration Stored on XBlock fields"
msgstr "الإعدادات المخزّنة في حقول XBlock "

#: models.py:204
msgid "Configuration Stored on this model"
msgstr "الإعدادات المخزّنة في هذا النموذج"

#: models.py:251
msgid "Client key provided by the LTI tool provider."
msgstr "مفتاح العميل الذي يقدمه مزوّد أداة LTI. "

#: models.py:257
msgid "Client secret provided by the LTI tool provider."
msgstr "سر العميل الذي يقدمه مزوّد أداة LTI. "

#: models.py:346
msgid "LTI Configuration stores on XBlock needs a block location set."
msgstr "تحتاج مخازن إعدادات LTI في XBlock إلى تعيين موقع الكتلة."

#: models.py:361
msgid ""
"CONFIG_ON_XBLOCK and CONFIG_EXTERNAL are not supported for LTI 1.3 "
"Proctoring Services."
msgstr ""
"CONFIG_ON_XBLOCK و CONFIG_EXTERNAL ليسا مدعومين لخدمات مُراقَبة LTI 1.3."

#: plugin/views.py:620
msgid "The selected content type is not supported by Open edX."
msgstr "نوع المحتوى الذي اخترته لا تدعمه Open edX."

#: plugin/views.py:635
msgid "You don't have access to save LTI Content Items."
msgstr "ليست لديك صلاحية حفظ عناصر محتوى LTI."

#: plugin/views.py:636
msgid ""
"Please check that you have course staff permissions and double check this "
"block's LTI settings."
msgstr ""
