#: lti_1p3/extensions/rest_framework/authentication.py:41
msgid "Missing LTI 1.3 authentication token."
msgstr "Jeton d'authentification LTI 1.3 manquant."

#: lti_1p3/extensions/rest_framework/authentication.py:45
msgid "Invalid token header. No credentials provided."
msgstr ""
"En-tête de jeton invalide. Aucune information d'identification fournie."

#: lti_1p3/extensions/rest_framework/authentication.py:49
msgid "Invalid token header. Token string should not contain spaces."
msgstr ""
"En-tête de jeton invalide. La chaîne du jeton ne doit pas contenir "
"d'espaces."

#: lti_1p3/extensions/rest_framework/authentication.py:57
msgid "LTI configuration not found."
msgstr "Configuration LTI introuvable."

#: lti_1p3/extensions/rest_framework/authentication.py:66
msgid "Invalid token signature."
msgstr "Signature de jeton invalide."

#: lti_xblock.py:134
msgid "No valid user id found in endpoint URL"
msgstr ""
"Aucun identifiant utilisateur valide trouvé dans l'URL du point de "
"terminaison"

#: lti_xblock.py:147
msgid "Configuration on block"
msgstr "Configuration sur bloc"

#: lti_xblock.py:151
msgid "Database Configuration"
msgstr "Configuration de la base de données"

#: lti_xblock.py:154
msgid "Reusable Configuration"
msgstr "Configuration réutilisable"

#: lti_xblock.py:262
msgid "Display Name"
msgstr "Nom d'affichage"

#: lti_xblock.py:264
msgid ""
"Enter the name that students see for this component. Analytics reports may "
"also use the display name to identify this component."
msgstr ""
"Saisissez le nom que les étudiants verront pour ce composant. Les rapports "
"analytiques pourront également utiliser ce nom pour identifier ce composant."

#: lti_xblock.py:268
msgid "LTI Consumer"
msgstr "Consommateur LTI"

#: lti_xblock.py:271
msgid "LTI Application Information"
msgstr "Informations sur l&#39;application LTI"

#: lti_xblock.py:273
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Saisissez une description de l&#39;application tierce. Si vous demandez un "
"nom d&#39;utilisateur et/ou une adresse électronique, utilisez ce champ de "
"texte pour indiquer aux utilisateurs pourquoi ces informations seront "
"transmises à une application tierce."

#: lti_xblock.py:281
msgid "Configuration Type"
msgstr "Type de configuration"

#: lti_xblock.py:286
msgid ""
"Select 'Configuration on block' to configure a new LTI Tool. If the support "
"staff provided you with a pre-configured LTI reusable Tool ID, "
"select'Reusable Configuration' and enter it in the text field below."
msgstr ""
"Sélectionnez « Configuration sur bloc » pour configurer un nouvel outil LTI."
" Si l’équipe d’assistance vous a fourni un ID d’outil LTI réutilisable "
"préconfiguré, sélectionnez « Configuration réutilisable » et saisissez-le "
"dans le champ de texte ci-dessous."

#: lti_xblock.py:293
msgid "LTI Version"
msgstr "Version LTI"

#: lti_xblock.py:301
msgid ""
"Select the LTI version that your tool supports.<br />The XBlock LTI Consumer"
" fully supports LTI 1.1.1, LTI 1.3 and LTI Advantage features."
msgstr ""
"Sélectionnez la version LTI prise en charge par votre outil.<br /> Le "
"logiciel XBlock LTI Consumer prend entièrement en charge les fonctionnalités"
" LTI 1.1.1, LTI 1.3 et LTI Advantage."

#: lti_xblock.py:308
msgid "LTI Reusable Configuration ID"
msgstr "ID de configuration réutilisable LTI"

#: lti_xblock.py:310
msgid ""
"Enter the reusable LTI external configuration ID provided by the support "
"staff."
msgstr ""
"Saisissez l&#39;identifiant de configuration externe LTI réutilisable fourni"
" par l&#39;équipe d&#39;assistance."

#: lti_xblock.py:315
msgid "Lti 1.3 passport ID that points to Lti1p3Passport table"
msgstr "ID de passeport LTI 1.3 qui pointe vers la table Lti1p3Passport"

#: lti_xblock.py:318
msgid "Passport ID for a reusable keys."
msgstr "ID de passeport pour des clés réutilisables."

#: lti_xblock.py:322
msgid "Tool Launch URL"
msgstr "URL de lancement de l&#39;outil"

#: lti_xblock.py:326
msgid ""
"Enter the LTI 1.3 Tool Launch URL. <br />This is the URL the LMS will use to"
" launch the LTI Tool."
msgstr ""
"Saisissez l&#39;URL de lancement de l&#39;outil LTI 1.3.<br /> Voici "
"l&#39;URL que le LMS utilisera pour lancer l&#39;outil LTI."

#: lti_xblock.py:331
msgid "Tool Initiate Login URL"
msgstr "URL de connexion initiale de l&#39;outil"

#: lti_xblock.py:335
msgid ""
"Enter the LTI 1.3 Tool OIDC Authorization url (can also be called login or "
"login initiation URL).<br />This is the URL the LMS will use to start a LTI "
"authorization prior to doing the launch request."
msgstr ""
"Saisissez l&#39;URL d&#39;autorisation OIDC de l&#39;outil LTI 1.3 "
"(également appelée URL de connexion ou d&#39;initiation de connexion).<br />"
" Il s&#39;agit de l&#39;URL que le LMS utilisera pour démarrer une "
"autorisation LTI avant d&#39;effectuer la requête de lancement."

#: lti_xblock.py:341
msgid "Registered Redirect URIs"
msgstr "URI de redirection enregistrés"

#: lti_xblock.py:343
msgid ""
"Valid urls the Tool may request us to redirect the id token to. The redirect"
" uris are often the same as the launch url/deep linking url so if this field"
" is empty, it will use them as the default. If you need to use different "
"redirect uri's, enter them here. If you use this field you must enter all "
"valid redirect uri's the tool may request."
msgstr ""
"URL valides vers lesquelles l&#39;outil peut nous demander de rediriger le "
"jeton d&#39;identification. Ces URI de redirection sont souvent identiques à"
" l&#39;URL de lancement/l&#39;URL de lien profond ; par conséquent, si ce "
"champ est vide, elles seront utilisées par défaut. Si vous devez utiliser "
"des URI de redirection différentes, veuillez les saisir ici. Si vous "
"utilisez ce champ, vous devez renseigner toutes les URI de redirection "
"valides que l&#39;outil peut demander."

#: lti_xblock.py:353
msgid "Tool Public Key Mode"
msgstr "Mode clé publique de l’outil"

#: lti_xblock.py:361
msgid "Select how the tool's public key information will be specified."
msgstr ""
"Sélectionnez comment les informations de clé publique de l&#39;outil seront "
"spécifiées."

#: lti_xblock.py:365
msgid "Tool Keyset URL"
msgstr "URL du Tool Keyset"

#: lti_xblock.py:369
msgid ""
"Enter the LTI 1.3 Tool's JWK keysets URL.<br />This link should retrieve a "
"JSON file containing public keys and signature algorithm information, so "
"that the LMS can check if the messages and launch requests received have the"
" signature from the tool.<br /><b>This is not required when doing LTI 1.3 "
"Launches without LTI Advantage nor Basic Outcomes requests.</b><br /><br "
"/><b>Changing the public key or keyset URL will cause the client ID, block "
"keyset URL and access token URL to be regenerated if they are shared between"
" blocks. Please check and update them in the LTI tool settings if "
"necessary.</b>"
msgstr ""
"Saisissez l&#39;URL des jeux de clés JWK de l&#39;outil LTI 1.3.<br /> Ce "
"lien devrait permettre de récupérer un fichier JSON contenant les clés "
"publiques et les informations sur l&#39;algorithme de signature, afin que le"
" LMS puisse vérifier si les messages et les requêtes de lancement reçus "
"possèdent la signature de l&#39;outil.<br /> <b>Cela n&#39;est pas "
"nécessaire lors des lancements LTI 1.3 sans LTI Advantage ni demandes de "
"résultats de base.</b><br /><br /> <b>Modifier l&#39;URL de la clé publique "
"ou du jeu de clés entraînera la régénération de l&#39;ID client, de "
"l&#39;URL du jeu de clés du bloc et de l&#39;URL du jeton d&#39;accès "
"s&#39;ils sont partagés entre les blocs. Veuillez les vérifier et les mettre"
" à jour dans les paramètres de l&#39;outil LTI si nécessaire.</b>"

#: lti_xblock.py:382
msgid "Tool Public Key"
msgstr "Clé publique de l'outil"

#: lti_xblock.py:387
msgid ""
"Enter the LTI 1.3 Tool's public key.<br />This is a string that starts with "
"'-----BEGIN PUBLIC KEY-----' and is required so that the LMS can check if "
"the messages and launch requests received have the signature from the "
"tool.<br /><b>This is not required when doing LTI 1.3 Launches without LTI "
"Advantage nor Basic Outcomes requests.</b><br /><br /><b>Changing the public"
" key or keyset URL will cause the client ID, block keyset URL and access "
"token URL to be regenerated if they are shared between blocks. Please check "
"and update them in the LTI tool settings if necessary.</b>"
msgstr ""
"Saisissez la clé publique de l&#39;outil LTI 1.3.<br /> Il s&#39;agit "
"d&#39;une chaîne de caractères qui commence par &#39;-----BEGIN PUBLIC "
"KEY-----&#39; et qui est requise pour que le LMS puisse vérifier si les "
"messages et les demandes de lancement reçus comportent la signature de "
"l&#39;outil.<br /> <b>Cela n&#39;est pas nécessaire lors des lancements LTI "
"1.3 sans LTI Advantage ni demandes de résultats de base.</b><br /><br /> "
"<b>Modifier l&#39;URL de la clé publique ou du jeu de clés entraînera la "
"régénération de l&#39;ID client, de l&#39;URL du jeu de clés du bloc et de "
"l&#39;URL du jeton d&#39;accès s&#39;ils sont partagés entre les blocs. "
"Veuillez les vérifier et les mettre à jour dans les paramètres de "
"l&#39;outil LTI si nécessaire.</b>"

#: lti_xblock.py:400
msgid "Enable LTI NRPS"
msgstr "Activer LTI NRPS"

#: lti_xblock.py:401
msgid "Enable LTI Names and Role Provisioning Services."
msgstr "Activer les services de provisionnement de noms et de rôles LTI."

#: lti_xblock.py:408
msgid "Deep linking"
msgstr "Deep linking"

#: lti_xblock.py:409
msgid "Select True if you want to enable LTI Advantage Deep Linking."
msgstr ""
"Sélectionnez « Vrai » si vous souhaitez activer la fonctionnalité de liens "
"profonds LTI Advantage."

#: lti_xblock.py:414
msgid "Deep Linking Launch URL"
msgstr "URL de lancement Deep Linking."

#: lti_xblock.py:418
msgid ""
"Enter the LTI Advantage Deep Linking Launch URL. If the tool does not "
"specify one, use the same value as 'Tool Launch URL'."
msgstr ""
"Saisissez l&#39;URL de lancement du lien profond LTI Advantage. Si "
"l&#39;outil n&#39;en spécifie pas, utilisez la même valeur que « URL de "
"lancement de l&#39;outil »."

#: lti_xblock.py:423
msgid "LTI Assignment and Grades Service"
msgstr "Service d&#39;attribution et de notation LTI"

#: lti_xblock.py:425
msgid "Disabled"
msgstr "Désactivé"

#: lti_xblock.py:426
msgid "Allow tools to submit grades only (declarative)"
msgstr "Autoriser les outils à soumettre uniquement des notes (déclaratif)"

#: lti_xblock.py:427
msgid "Allow tools to manage and submit grade (programmatic)"
msgstr ""
"Autoriser les outils à gérer et à soumettre les notes (par programmation)"

#: lti_xblock.py:432
msgid ""
"Enable the LTI-AGS service and select the functionality enabled for LTI "
"tools. The 'declarative' mode (default) will provide a tool with a LineItem "
"created from the XBlock settings, while the 'programmatic' one will allow "
"tools to manage, create and link the grades."
msgstr ""
"Activez le service LTI-AGS et sélectionnez les fonctionnalités activées pour"
" les outils LTI. Le mode « déclaratif » (par défaut) fournit à l&#39;outil "
"un élément de ligne créé à partir des paramètres XBlock, tandis que le mode "
"« programmatique » permet aux outils de gérer, créer et lier les notes."

#: lti_xblock.py:440
msgid "LTI ID"
msgstr "LTI ID"

#: lti_xblock.py:442
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider. This value must be the same "
"LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Saisissez l&#39;identifiant LTI du fournisseur LTI externe. Cette valeur "
"doit correspondre à l&#39;identifiant LTI que vous avez saisi dans les "
"paramètres LTI Passports de la page Paramètres avancés.<br /> Consultez la "
"documentation edX LTI {docs_anchor_open} {anchor_close} pour plus de détails"
" sur ce paramètre."

#: lti_xblock.py:454
msgid "LTI URL"
msgstr "URL LTI"

#: lti_xblock.py:456
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.<br />See the "
"{docs_anchor_open}edX LTI documentation{anchor_close} for more details on "
"this setting."
msgstr ""
"Saisissez l&#39;URL de l&#39;outil externe que ce composant lance. Ce "
"paramètre n&#39;est utilisé que lorsque l&#39;option « Masquer l&#39;outil "
"externe » est désactivée.<br /> Consultez la documentation edX LTI "
"{docs_anchor_open} {anchor_close} pour plus de détails sur ce paramètre."

#: lti_xblock.py:469
msgid "Custom Parameters"
msgstr "Paramètres personnalisés"

#: lti_xblock.py:471
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this component. Ex. "
"[\"page=1\", \"color=white\"]<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Ajoutez la paire clé/valeur pour chaque paramètre personnalisé, comme la "
"page d&#39;ouverture de votre livre numérique ou la couleur d&#39;arrière-"
"plan de ce composant. Ex. : [&quot;page=1&quot;, &quot;color=white&quot;]<br"
" /> Consultez la documentation edX LTI {docs_anchor_open} {anchor_close} "
"pour plus de détails sur ce paramètre."

#: lti_xblock.py:481
msgid "LTI Launch Target"
msgstr "Cible de lancement LTI"

#: lti_xblock.py:483
msgid ""
"Select Inline if you want the LTI content to open in an IFrame in the "
"current page. Select Modal if you want the LTI content to open in a modal "
"window in the current page. Select New Window if you want the LTI content to"
" open in a new browser window. This setting is only used when Hide External "
"Tool is set to False."
msgstr ""
"Sélectionnez « Intégré » si vous souhaitez que le contenu LTI s&#39;ouvre "
"dans une iframe de la page actuelle. Sélectionnez « Modal » si vous "
"souhaitez que le contenu LTI s&#39;ouvre dans une fenêtre modale de la page "
"actuelle. Sélectionnez « Nouvelle fenêtre » si vous souhaitez que le contenu"
" LTI s&#39;ouvre dans une nouvelle fenêtre du navigateur. Ce paramètre "
"n&#39;est utilisé que si l&#39;option « Masquer l&#39;outil externe » est "
"désactivée."

#: lti_xblock.py:497
msgid "Button Text"
msgstr "Texte du bouton"

#: lti_xblock.py:499
msgid ""
"Enter the text on the button used to launch the third party application. "
"This setting is only used when Hide External Tool is set to False and LTI "
"Launch Target is set to Modal or New Window."
msgstr ""
"Saisissez le texte du bouton permettant de lancer l&#39;application tierce. "
"Ce paramètre n&#39;est utilisé que si l&#39;option « Masquer l&#39;outil "
"externe » est désactivée et que la cible de lancement LTI est définie sur "
"« Modulaire » ou « Nouvelle fenêtre »."

#: lti_xblock.py:507
msgid "Inline Height"
msgstr "Hauteur en ligne"

#: lti_xblock.py:509
msgid ""
"Enter the desired pixel height of the iframe which will contain the LTI "
"tool. This setting is only used when Hide External Tool is set to False and "
"LTI Launch Target is set to Inline."
msgstr ""
"Saisissez la hauteur en pixels souhaitée de l&#39;iframe qui contiendra "
"l&#39;outil LTI. Ce paramètre n&#39;est utilisé que si l&#39;option "
"« Masquer l&#39;outil externe » est désactivée et que la cible de lancement "
"LTI est définie sur « Intégrée »."

#: lti_xblock.py:517
msgid "Modal Height"
msgstr "Hauteur modale"

#: lti_xblock.py:519
msgid ""
"Enter the desired viewport percentage height of the modal overlay which will"
" contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"Saisissez le pourcentage de hauteur souhaité pour la fenêtre d&#39;affichage"
" de la fenêtre modale contenant l&#39;outil LTI. Ce paramètre n&#39;est "
"utilisé que si l&#39;option « Masquer l&#39;outil externe » est désactivée "
"et que la cible de lancement LTI est définie sur « Modal »."

#: lti_xblock.py:527
msgid "Modal Width"
msgstr "Largeur modale"

#: lti_xblock.py:529
msgid ""
"Enter the desired viewport percentage width of the modal overlay which will "
"contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"Saisissez la largeur en pourcentage de la fenêtre d&#39;affichage souhaitée "
"pour la fenêtre modale contenant l&#39;outil LTI. Ce paramètre n&#39;est "
"utilisé que si l&#39;option « Masquer l&#39;outil externe » est désactivée "
"et que la cible de lancement LTI est définie sur « Modal »."

#: lti_xblock.py:537
msgid "Scored"
msgstr "Score"

#: lti_xblock.py:538
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Sélectionnez Vrai si ce composant recevra un score numérique du système LTI "
"externe."

#: lti_xblock.py:545
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Saisissez le nombre de points possibles pour cette composante. La valeur par"
" défaut est 1,0. Ce paramètre n&#39;est utilisé que si l&#39;option "
"« Score » est activée."

#: lti_xblock.py:554
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"La note conservée dans le xblock KVS -- duplicata de la note publiée dans "
"Django DB"

#: lti_xblock.py:559
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "Rétroaction renvoyé par la notation, spécification LTI2.0"

#: lti_xblock.py:564
msgid "Hide External Tool"
msgstr "Masquer l'outil externe"

#: lti_xblock.py:566
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Sélectionnez « Vrai » si vous souhaitez utiliser ce composant comme espace "
"réservé pour la synchronisation avec un système de notation externe plutôt "
"que pour lancer un outil externe. Ce paramètre masque le bouton « Lancer » "
"et toutes les iFrames associées à ce composant."

#: lti_xblock.py:574
msgid "Accept grades past deadline"
msgstr "Accepter les notes après la date limite"

#: lti_xblock.py:575
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Sélectionnez « Vrai » pour autoriser les systèmes tiers à publier les notes "
"après la date limite."

#: lti_xblock.py:583
msgid "Request user's username"
msgstr "Demander le nom d&#39;utilisateur de l&#39;utilisateur"

#. Translators: This is used to request the user's username for a third party
#. service.
#: lti_xblock.py:585
msgid "Select True to request the user's username."
msgstr ""
"Sélectionnez Vrai pour demander le nom d&#39;utilisateur de "
"l&#39;utilisateur."

#: lti_xblock.py:590
msgid "Request user's full name"
msgstr "Demander le nom complet de l&#39;utilisateur"

#. Translators: This is used to request the user's full name for a third party
#. service.
#: lti_xblock.py:592
msgid "Select True to request the user's full name."
msgstr "Sélectionnez Vrai pour demander le nom complet de l&#39;utilisateur."

#: lti_xblock.py:597
msgid "Request user's email"
msgstr "Demander l&#39;adresse e-mail de l&#39;utilisateur"

#. Translators: This is used to request the user's email for a third party
#. service.
#: lti_xblock.py:599
msgid "Select True to request the user's email address."
msgstr ""
"Sélectionnez « Vrai » pour demander l&#39;adresse e-mail de "
"l&#39;utilisateur."

#: lti_xblock.py:605
msgid "Send extra parameters"
msgstr "Envoyer des paramètres supplémentaires"

#: lti_xblock.py:606
msgid ""
"Select True to send the extra parameters, which might contain Personally "
"Identifiable Information. The processors are site-wide, please consult the "
"site administrator if you have any questions."
msgstr ""
"Sélectionnez « Vrai » pour envoyer les paramètres supplémentaires, qui "
"peuvent contenir des informations personnelles. Ces paramètres sont "
"appliqués à l’ensemble du site ; veuillez contacter l’administrateur du site"
" pour toute question."

#: lti_xblock.py:681
msgid "Custom Parameters must be a list"
msgstr "Les paramètres personnalisés doivent être une liste"

#: lti_xblock.py:688
msgid "Custom Parameters should be strings in \"x=y\" format."
msgstr "Les paramètres personnalisés doivent être des chaînes au format \"x=y\"."

#: lti_xblock.py:698
msgid ""
"Reusable configuration ID must be set when using external config (Example: "
"\"x:y\")."
msgstr ""
"L'ID de configuration réutilisable doit être défini lors de l'utilisation "
"d'une configuration externe (Exemple : \"x:y\")."

#: lti_xblock.py:722
msgid ""
"The specified LTI ID is not configured in this course's Advanced Settings."
msgstr ""
"L'ID LTI spécifié n'est pas configuré dans les paramètres avancés de ce "
"cours."

#: lti_xblock.py:851 lti_xblock.py:1168
msgid "Could not get user data for current request"
msgstr "Impossible d'obtenir les données utilisateur pour la demande actuelle"

#: lti_xblock.py:891
msgid ""
"Could not parse LTI passport: {lti_passport!r}. Should be \"id:key:secret\" "
"string."
msgstr ""
"Impossible d'analyser le passeport LTI : {lti_passport!r}. Doit être une "
"chaîne \"id:key:secret\"."

#: lti_xblock.py:909 lti_xblock.py:923 lti_xblock.py:939
msgid "Could not get user id for current request"
msgstr "Impossible d'obtenir l'ID utilisateur pour la demande en cours"

#: lti_xblock.py:1101
msgid ""
"Could not parse custom parameter: {custom_parameter!r}. Should be \"x=y\" "
"string."
msgstr ""
"Impossible d'analyser le paramètre personnalisé : {custom_parameter!r}. Doit"
