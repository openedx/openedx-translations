#: done.py:39
msgid "Is the student done?"
msgstr "هل انتهى الطالب؟"

#: done.py:45
msgid "Align left/right/center"
msgstr "محاذاة اليسار / اليمين / الوسط"

#: done.py:132
msgid "Display name"
msgstr "الاسم الظاهر"

#: done.py:137
msgid ""
"ISO-8601 formatted string representing the start date of this assignment. We"
" ignore this."
msgstr "نصّ بتنسيق ISO-8601 يدل على موعد بدء هذا الواجب. نحن نتجاهل هذا."

#: done.py:142
msgid ""
"ISO-8601 formatted string representing the due date of this assignment. We "
"ignore this."
msgstr "نصّ بتنسيق ISO-8601 يدل على موعد تسليم هذا الواجب. نحن نتجاهل هذا."

#: done.py:146
msgid "Problem Weight"
msgstr "ثقل المسألة"

#: done.py:148
msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" the problem is worth the sum of the option point values."
msgstr ""
"يحدّد عدد الدرجات التي تستحقها كل مسألة. وإذا لم تُحدَّد القيمة، فإن درجة "
"المسألة تساوي مجموع قيم الدرجات المخصصة لخياراتها."

#: templates/done.html:8
msgid "X"
msgstr "X"

#: templates/done.html:9
msgid "I have completed this"
msgstr "أكملت هذا"

#: templates/done.html:11
msgid "Unmark"
msgstr "أزِل العلامة"

#: templates/done.html:12
msgid "Mark as complete"
msgstr "أشِّره كمكتمل"
